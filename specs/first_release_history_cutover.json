  "replay_tests": [
    {
      "path": "crates/iroha_core/src/sumeragi/node/tests/history_cutover_tests.rs",
      "test": "current_genesis_history_replays_from_reopened_stores_to_the_identical_state",
      "package": "iroha_core",
      "target": "lib",
      "covers": "four validators on on-disk stores: every store is closed, reopened from its directory and replayed with no supplied genesis and no snapshot; each reproduces its World root and execution tip, the persisted frames are byte-identical before and after reopen and replay, and the cluster restarts on the reopened stores and extends the chain"
    },
    {
      "path": "crates/iroha_core/src/sumeragi/node/tests/history_cutover_tests.rs",
      "test": "pinned_history_of_an_earlier_build_replays_to_its_pinned_state",
      "package": "iroha_core",
      "target": "lib",
      "covers": "replay across builds: the committed frames of fixtures/core/first_release_history are stored, read back from disk and replayed to the pinned block hashes, World root and execution tip; one flipped byte of a persisted frame stops startup"
    },
    {
      "path": "crates/iroha_core/src/sumeragi/node/tests/history_cutover_tests.rs",
      "test": "a_store_never_replays_under_another_genesis",
      "package": "iroha_core",
      "target": "lib",
      "covers": "another genesis is another history: a reopened old store is refused by its durable network binding in the empty-state preflight and when a State of the new network is anchored, a supplied foreign genesis is refused by startup, the old store stays replayable under its own genesis, and the new genesis starts on a fresh store"
    },
    {
      "path": "crates/iroha_core/src/sumeragi/node/tests/history_cutover_tests.rs",
      "test": "stored_block_wire_is_exactly_the_framed_first_release_layout",
      "package": "iroha_core",
      "target": "lib",
      "covers": "block wire version 1 only; the decoder storage and distribution use refuses other versions, headerless payloads and other Norito header layouts"
    },
    {
      "path": "crates/iroha_core/src/sumeragi/node.rs",
      "test": "idle_chain_never_advances_and_real_work_survives_restart",
      "package": "iroha_core",
      "target": "lib",
      "covers": "four validators restart on their in-memory store handles and hold the World root they had before shutdown"
    },
    {
      "path": "crates/iroha_core/src/sumeragi/node.rs",
      "test": "all_seat_restart_reproduces_missing_original_context_archives_from_certified_execution",
      "package": "iroha_core",
      "target": "lib",
      "covers": "replay reproduces the exact certified execution projections; conflicting archives are refused, never overwritten"
    },
    {
      "path": "crates/iroha_core/src/sumeragi/node.rs",
      "test": "replay_rejects_a_block_whose_certified_result_differs",
      "package": "iroha_core",
      "target": "lib",
      "covers": "replay compares every re-executed block with its certified result"
    },
    {
      "path": "crates/iroha_core/src/sumeragi/test_chain/world_state_tests.rs",
      "test": "replay_from_scratch_reproduces_the_world_state_accumulator",
      "package": "iroha_core",
      "target": "lib",
      "covers": "replay from genesis reproduces the complete World state accumulator"
    },
    {
      "path": "crates/iroha_core/src/sumeragi/test_chain/world_state_tests.rs",
      "test": "replay_rejects_a_tampered_world_and_startup_rejects_a_stale_accumulator",
      "package": "iroha_core",
      "target": "lib",
      "covers": "a forged or stale World cannot pass replay or the startup cold capture"
    },
    {
      "path": "crates/iroha_core/src/kura/tests/01_support_snapshot_bootstrap_and_rewrite.rs",
      "test": "native_storage_original_frames_and_certificates_survive_strict_restart",
      "package": "iroha_core",
      "target": "lib",
      "covers": "a store reopened from disk returns the byte-identical canonical frames and certificates"
    },
    {
      "path": "crates/iroha_genesis/src/genesis_tail_tests.rs",
      "test": "completed_default_genesis_source_template_uses_the_single_framed_block_wire",
      "package": "iroha_genesis",
      "target": "lib",
      "covers": "the canonical default genesis template signs into the single framed block wire and round-trips byte for byte"
    },
    {
      "path": "crates/iroha_genesis/src/genesis_tail_tests.rs",
      "test": "completed_default_genesis_source_template_proposal_roundtrips",
      "package": "iroha_genesis",
      "target": "lib",
      "covers": "the canonical default genesis template keeps its execution policy and consensus metadata through signing and decode"
    },
    {
      "path": "integration_tests/tests/sumeragi.rs",
      "test": "validators_restart_one_and_all",
      "package": "integration_tests",
      "target": "test:sumeragi",
      "covers": "real peer processes: one validator, then the whole cluster, restart from Kura and commit again"
    },
    {
      "path": "integration_tests/tests/sumeragi_lanes.rs",
      "test": "a_fixed_lane_carries_transactions_over_p2p_across_a_restart",
      "package": "integration_tests",
      "target": "test:sumeragi_lanes",
      "covers": "real peer processes: lane blocks and their merge survive a restart"
    }
  ],
