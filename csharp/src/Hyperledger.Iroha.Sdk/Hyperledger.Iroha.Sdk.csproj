<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Hyperledger.Iroha.Sdk</AssemblyName>
    <Authors>Hyperledger Iroha Contributors</Authors>
    <Description>Managed .NET SDK for interacting with Hyperledger Iroha.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <IsPackable>true</IsPackable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageId>Hyperledger.Iroha.Sdk</PackageId>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/hyperledger-iroha/iroha</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>iroha;hyperledger;blockchain;dlt;sdk;csharp;dotnet</PackageTags>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/hyperledger-iroha/iroha</RepositoryUrl>
    <RootNamespace>Hyperledger.Iroha</RootNamespace>
    <TargetFramework>net8.0</TargetFramework>
    <Version>0.1.0</Version>
    <IrohaRepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../..'))</IrohaRepositoryRoot>
    <IrohaNativePackageRoot Condition="'$(IrohaNativePackageRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../artifacts/native-package'))</IrohaNativePackageRoot>
    <IrohaNativePackagePython Condition="'$(IrohaNativePackagePython)' == ''">python3</IrohaNativePackagePython>
    <IrohaNativePackageScript>$(IrohaRepositoryRoot)/scripts/package_csharp_native_artifacts.py</IrohaNativePackageScript>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NetSparkleUpdater.Chaos.NaCl" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(IrohaNativePackageRoot)/runtimes/linux-x64/native/libconnect_norito_bridge.so" Pack="true" PackagePath="runtimes/linux-x64/native/libconnect_norito_bridge.so" Visible="false" />
    <None Include="$(IrohaNativePackageRoot)/runtimes/linux-arm64/native/libconnect_norito_bridge.so" Pack="true" PackagePath="runtimes/linux-arm64/native/libconnect_norito_bridge.so" Visible="false" />
    <None Include="$(IrohaNativePackageRoot)/runtimes/osx-x64/native/libconnect_norito_bridge.dylib" Pack="true" PackagePath="runtimes/osx-x64/native/libconnect_norito_bridge.dylib" Visible="false" />
    <None Include="$(IrohaNativePackageRoot)/runtimes/osx-arm64/native/libconnect_norito_bridge.dylib" Pack="true" PackagePath="runtimes/osx-arm64/native/libconnect_norito_bridge.dylib" Visible="false" />
    <None Include="$(IrohaNativePackageRoot)/runtimes/win-x64/native/connect_norito_bridge.dll" Pack="true" PackagePath="runtimes/win-x64/native/connect_norito_bridge.dll" Visible="false" />
  </ItemGroup>

  <Target Name="ValidateIrohaNativePackageAssets" BeforeTargets="GenerateNuspec">
    <Exec Command="&quot;$(IrohaNativePackagePython)&quot; -I &quot;$(IrohaNativePackageScript)&quot; verify-stage --stage-root &quot;$(IrohaNativePackageRoot)&quot; --source-root &quot;$(IrohaRepositoryRoot)&quot;" />
  </Target>

</Project>
