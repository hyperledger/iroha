DISABLING_ATTRIBUTES = (
    "#[ignore]", "#[cfg(any())]", "#[should_panic]", "#[cfg(\n    any()\n)]",
    '#[should_panic(expected = "#[test]")]',
)


@pytest.mark.parametrize("attribute", DISABLING_ATTRIBUTES)
