DAEMON_PREFLIGHT = """                preflight_threshold_signer_startup_readiness_v1(
                    Arc::clone(&state),
                    local_consensus_peer.clone(),
                    runtime_deps.clone(),
                )
                .await
                .map_err(|message| Report::new(StartError::StartP2p).attach(message))?;
