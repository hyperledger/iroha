    ("snapshot.record(),", "foreign.record(),"),
    ("&self.budget,", "&foreign_budget,"),
    ("self.finalized = Some(finalized);", "self.finalized = None;"),
    ("return Err(GlobalThresholdBeaconError::IncompleteDkgEdges.into());", "return Ok(existing);"),
