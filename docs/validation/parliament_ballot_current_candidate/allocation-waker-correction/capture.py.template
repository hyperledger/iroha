#!/usr/bin/env python3
"""Retain corrected current-source allocation ownership tests and exact inputs.

Requires Python 3.11+, the repository Rust toolchain and explicit root/output/
target paths. No environment overrides are set. Existing receipts are refused.
Each Cargo child gets 1,200 seconds; timeout records its PID without killing it.
This capture is component test evidence, never resource or profile qualification.
"""
from __future__ import annotations

import argparse
from datetime import datetime, timezone
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import time


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    for name in ("root", "output", "target"):
        parser.add_argument("--" + name, type=Path, required=True)
    args = parser.parse_args()
    root, output, target = (getattr(args, name).resolve() for name in ("root", "output", "target"))
    if (output / "receipt.json").exists():
        raise ValueError("use a fresh output directory; prior receipts are immutable")
    output.mkdir(parents=True, exist_ok=True)
    crate = root / "crates/iroha_allocation"
    paths = {path for path in crate.rglob("*") if path.is_file()}
    paths.update(root / name for name in ("Cargo.toml", "Cargo.lock", "rust-toolchain.toml"))
    paths.add(Path(__file__).resolve())
    paths.update(path for path in (output / "sources-before").rglob("*") if path.is_file())
    paths.update(output / name for name in ("sources-before.json", "correction.patch"))
    optional = {crate / "build.rs"}
    for ancestor in (root, *root.parents):
        optional.update(ancestor / ".cargo" / name for name in ("config", "config.toml"))
    cargo_home = Path(os.environ.get("CARGO_HOME", str(Path.home() / ".cargo")))
    optional.update(cargo_home / name for name in ("config", "config.toml"))
    paths.update(path for path in optional if path.is_file())
    absent = sorted(str(path) for path in optional if not path.exists())
    digest = lambda path: hashlib.sha256(Path(path).read_bytes()).hexdigest()
    before = {str(path): digest(path) for path in sorted(paths)}
    environment_names = (
        "RUSTFLAGS", "RUSTDOCFLAGS", "CARGO_ENCODED_RUSTFLAGS", "CARGO_ENCODED_RUSTDOCFLAGS",
        "RUSTC_WRAPPER", "RUSTC_WORKSPACE_WRAPPER", "CARGO_BUILD_TARGET", "CARGO_TARGET_DIR",
    )
    environment = {
        name: None if name not in os.environ else hashlib.sha256(os.environ[name].encode()).hexdigest()
        for name in environment_names
    }
    receipt = {
        "schema": "parliament-current-allocation-waker-correction-tests-v1",
        "started_at_utc": datetime.now(timezone.utc).isoformat(),
        "root": str(root), "target": str(target), "timeout_seconds_per_command": 1200,
        "source_before": before, "source_after": {}, "source_changes": {},
        "guarded_absent_paths": absent, "absence_changed": [],
        "build_environment_sha256": environment,
        "commands": [], "tool_versions": {}, "source_stable": False,
        "scope": "All files under iroha_allocation, root Cargo manifest/lock/toolchain, applicable Cargo config presence/bytes, pre-correction archive/diff and this recipe are guarded. Other workspace packages are not compiled by these selected crate commands. This is not a hermetic compiler/native/runtime dependency certificate.",
        "complete_workspace_certificate": False, "full_workspace_suite_run": False,
        "profile_qualified": False, "production_gate_changed": False,
    }
    receipt_path = output / "receipt.json"
    receipt_path.write_text(json.dumps(receipt, indent=2) + "\n")
    for program in ("cargo", "rustc", "rustdoc"):
        version = subprocess.run([program, "-Vv"], cwd=root, capture_output=True, text=True, check=True)
        receipt["tool_versions"][program] = version.stdout
    selected = (
        ("shared", ["--lib", "shared"]),
        ("charged-shared-custody", ["--test", "charged_shared_custody"]),
    )
    overall = 0
    for label, selection in selected:
        command = ["cargo", "test", "--release", "--locked", "-p", "iroha_allocation", *selection,
                   "--target-dir", str(target)]
        log = output / (label + ".txt")
        start = time.monotonic()
        with log.open("x") as stream:
            child = subprocess.Popen(command, cwd=root, stdout=stream, stderr=subprocess.STDOUT)
            try:
                code = child.wait(timeout=1200)
            except subprocess.TimeoutExpired:
                code = None
        after_paths = set(before) | {str(path) for path in crate.rglob("*") if path.is_file()}
        after = {path: digest(path) if Path(path).is_file() else None for path in sorted(after_paths)}
        changes = {path: {"before": before.get(path), "after": after[path]}
                   for path in after if after[path] != before.get(path)}
        appeared = [path for path in absent if Path(path).exists()]
        row = {"label": label, "command": command, "exit": code,
               "elapsed_seconds": time.monotonic() - start,
               "log": str(log), "log_sha256": digest(log),
               "source_changes": changes, "absence_changed": appeared}
        text = log.read_text()
        row["test_summaries"] = re.findall(r"test result: [^\n]+", text)
        if code is None:
            row["still_running_pid"] = child.pid
            row["log_complete"] = False
        else:
            row["log_complete"] = True
        receipt["commands"].append(row)
        receipt.update(source_after=after, source_changes=changes, absence_changed=appeared,
                       source_stable=not changes and not appeared)
        receipt["observed_at_utc"] = datetime.now(timezone.utc).isoformat()
        receipt_path.write_text(json.dumps(receipt, indent=2) + "\n")
        print(json.dumps(row), flush=True)
        if code is None or changes or appeared:
            return 1
        if code != 0:
            overall = 1
    receipt["all_requested_commands_passed"] = overall == 0
    receipt_path.write_text(json.dumps(receipt, indent=2) + "\n")
    return overall


if __name__ == "__main__":
    raise SystemExit(main())
