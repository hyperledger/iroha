                ('historical current-path observation changed', name))
    for name, expected in BUNDLES.items():
        path = ROOT / 'docs/validation' / name / 'SHA256SUMS'
        require(sha(path) == expected, ('late component manifest change', name))
        require(retained_files(path.parent) == bundle_files[name], ('component membership changed', name))
        verify_manifest(path)


