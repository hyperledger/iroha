def require(condition, message):
    if not condition:
        raise RuntimeError(str(message))


def sha(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


def read(path):
    return json.loads(Path(path).read_text())


def inventory(path):
    entries = {}
    for line in path.read_text().splitlines():
        expected, name = line.split('  ', 1)
        require(name not in entries and re.fullmatch(r'[0-9a-f]{64}', expected), (path, name))
        entries[name] = expected
    return entries


def bind(path, expected=None):
    """Retain an already checked identity; never replace it at publication."""
    path = ROOT / path
    expected = sha(path) if expected is None else expected
    require(sha(path) == expected, ('input changed', path))
    key = str(path)
    require(key not in VALIDATED or VALIDATED[key] == expected,
            ('conflicting input identities', path))
    VALIDATED[key] = expected


def bind_pins(pins):
    for name, expected in pins.items():
        bind(name, expected)


def retained_files(folder):
    return {str(p) for p in folder.rglob('*')
            if p.is_file() and '__pycache__' not in p.parts and p.name != '.DS_Store'}


def verify_manifest(path):
    entries = inventory(path)
    for name, expected in entries.items():
        base = ROOT if name.startswith(('docs/', 'scripts/', 'specs/', 'crates/')) else path.parent
        bind(base / name, expected)
    bind(path)
    return {'path': str(path.relative_to(ROOT)), 'sha256': sha(path), 'entries': len(entries)}


def drift(pins):
    changes = {}
    for name, expected in pins.items():
        path = ROOT / name
        actual = sha(path) if path.is_file() else None
        if actual != expected:
            changes[name] = {'before': expected, 'after': actual}
    return changes


def bind_retained_pins(label, pins, expected_drift):
    """Resolve captured bytes separately from later live-path identities."""
    changes = drift(pins)
    require(changes == expected_drift, ('unexpected post-capture change', label, changes))
    resolved = {}
    for name, expected in pins.items():
        path = ROOT / name
        if name not in changes:
            bind(path, expected)
            continue
        # A reviewed child manifest must already bind the exact old content.
        archives = sorted(p for p, value in VALIDATED.items()
                          if value == expected and p.startswith(str(ROOT / 'docs/validation') + '/'))
        require(archives, ('missing original captured content', label, name, expected))
        bind(archives[0], expected)
        bind(path, changes[name]['after'])
        resolved[name] = {'sha256': expected, 'archive': archives[0]}
    RETAINED_SCOPES[label] = {
        'recorded_inputs': len(pins), 'current_path_drift': changes,
        'resolved_originals': resolved, 'current_source_applicability': not bool(changes),
    }


