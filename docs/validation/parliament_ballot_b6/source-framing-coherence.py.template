def require(condition, message):
    if not condition:
        raise RuntimeError(str(message))


def sha(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


def read(path):
    return json.loads(Path(path).read_text())


def inventory(path):
    result = {}
    for line in path.read_text().splitlines():
        expected, name = line.split('  ', 1)
        require(name not in result and re.fullmatch(r'[0-9a-f]{64}', expected), (path, name))
        result[name] = expected
    return result


def bind(path, expected=None):
    path = (ROOT / path).resolve()
    expected = sha(path) if expected is None else expected
    require(sha(path) == expected, ('input differs', path))
    name = str(path)
    require(name not in VALIDATED or VALIDATED[name] == expected, ('conflicting identities', path))
    VALIDATED[name] = expected


def files(folder):
    return {str(p.resolve()) for p in folder.rglob('*') if p.is_file()
            and '__pycache__' not in p.parts and p.name != '.DS_Store'}


def drift(pins):
    result = {}
    for name, expected in pins.items():
        path = ROOT / name
        current = sha(path) if path.is_file() else None
        if current != expected:
            result[name] = {'before': expected, 'after': current}
    return result


def reviewed_drift(changed, context):
    """Authorize exact historical deltas; mutable document/guard scope is explicit."""
    editorial = {(ROOT / path).resolve() for path in DOCUMENTS | GUARDS | {'status.md'}}
    for name, change in changed.items():
        path = (ROOT / name).resolve()
        relative = path.relative_to(ROOT).as_posix()
        if path in editorial:
            continue
        if relative in HISTORICAL_RECIPE_CHANGE:
            require(change == HISTORICAL_RECIPE_CHANGE[relative], ('unreviewed recipe delta', context, name, change))
        elif relative in HISTORICAL_SOURCE_CHANGE:
            require(change in HISTORICAL_SOURCE_CHANGE[relative], ('unreviewed source delta', context, name, change))
        else:
            require(False, ('unreviewed source drift', context, name, change))


def retained_inputs(pins):
    """Find exact historical bytes in authenticated archives; also bind live state."""
    changed = drift(pins)
    reviewed_drift(changed, 'child or prior capture')
    resolved = {}
    for name, expected in pins.items():
        if name not in changed:
            bind(name, expected)
            continue
        archives = sorted(path for path, value in VALIDATED.items()
                          if value == expected and '/docs/validation/' in path)
        require(archives, ('original bytes unavailable', name, expected))
        bind(archives[0], expected)
        require(changed[name]['after'] is not None, ('live source removed', name))
        bind(name, changed[name]['after'])
        resolved[name] = {'sha256': expected, 'archive': archives[0]}
    return {'recorded_input_count': len(pins), 'current_path_drift': changed,
            'resolved_originals': resolved, 'current_source_applicability': not bool(changed)}


