        and not regressions['setup_teardown_errors'] and not regressions['collection_errors'],
        'complete source regression suite did not pass')
nodeids = []
for record, name in ((collection, 'final-collection.json'), (regressions, 'full.json')):
    require(not record['source_changes'] and not record['path_existence_changes'], ('regression input drift', name))
    config = record['effective_pytest_config']
    require(not config['keyword'] and not config['markexpr'] and config['maxfail'] == 0,
            ('regression selection or fail-fast', name))
    require(config['collectonly'] == (name == 'final-collection.json'), ('regression phase mismatch', name))
    scope = captures[str((regression_folder / name).relative_to(ROOT))]
    expected_drift = expected_current_source_delta if name == 'full.json' else {}
    require(scope['current_path_drift'] == expected_drift, ('unreviewed regression post-capture drift', name))
    # The full pass remains historical; final collection only read checker/test/config inputs.
    for source in GUARDS:
        require(record['source_after'][source] == fixed_guard[source],
                ('regressions use another checker/test pair', name, source))
    bind(record['nodeids'], record['nodeids_sha256'])
    bind(record['log'], record['log_sha256'])
    ids = read(ROOT / record['nodeids'])
    require(len(ids) == len(set(ids)) == record['collected_count'], ('duplicate or missing test ids', name))
    nodeids.append(set(ids))
    for source, exists in record['guarded_path_existence_before'].items():
        path = str((ROOT / source).resolve())
        require(Path(path).exists() == exists, ('guarded existence changed', path))
        require(path not in EXISTENCE or EXISTENCE[path] == exists, ('conflicting existence', path))
        EXISTENCE[path] = exists
require(nodeids[0] == nodeids[1], 'full execution differs from final collected inventory')

links, broken = [], []
for name in DOCUMENTS | {'specs/parliament_ballot_b6_write_framing.md'}:
    path = ROOT / name
    for target in re.findall(r'\]\(([^)]+)\)', path.read_text()):
        if '://' in target or target.startswith('#'):
            continue
        destination = (path.parent / target.split('#')[0]).resolve()
        (links if destination.exists() else broken).append({'source': name, 'target': target})
require(not broken, ('broken local links', broken))
checks = []
for label, paths in [('scoped', sorted(DOCUMENTS | GUARDS | NEW_SOURCES | QUALIFICATION_SOURCES)), ('shared-status', ['status.md'])]:
    command = ['git', 'diff', '--check', '--', *paths]
    completed = subprocess.run(command, cwd=ROOT, capture_output=True, text=True)
    log = B6 / ('source-framing-' + label + '-diff.txt')
    require(not log.exists(), ('refusing log overwrite', log))
    log.write_text(completed.stdout + completed.stderr)
    require(completed.returncode == 0, ('diff check failed', command))
    bind(log)
    checks.append({'command': command, 'exit': completed.returncode,
                   'log': str(log.relative_to(ROOT)), 'log_sha256': sha(log)})

# Recheck all captured identities and membership, never silently repin at publish.
for name, expected in VALIDATED.items():
    require(sha(name) == expected, ('late input change', name))
for name, exists in EXISTENCE.items():
    require(Path(name).exists() == exists, ('late existence change', name))
for name, expected in bundle_members.items():
    require(files(ROOT / 'docs/validation' / name) == expected, ('bundle membership changed', name))
require(drift(old) == changed_index and drift(previous['validated_recorded_input_sha256']) == previous_drift,
        'historical drift changed during validation')
require(INDEX.read_bytes() == PRIOR.read_bytes(), 'index changed during validation')
value = {
    'schema': 'parliament-source-framing-coherence-v2',
    'observed_at_utc': datetime.datetime.now(datetime.timezone.utc).isoformat(),
    'prior_manifest_sha256': sha(PRIOR), 'prior_entries': len(old),
    'component_manifests': manifests, 'updated_live_entries': changed_index,
    'previous_coherence_sha256': sha(B6 / 'current-resource-coherence.json'),
    'previous_coherence_current_scope': prior_scope,
    'prior_index_current_scope': prior_index_scope, 'retained_child_capture_scopes': captures,
    'source_guard_checks': guard_checks,
    'qualification_dispatch_checks': {
        'receipt_sha256': sha(dispatch_folder / 'receipt.json'),
        'freeze_receipt_sha256': sha(dispatch_folder / 'freeze-review.json'),
        'current_scope': captures[str((dispatch_folder / 'receipt.json').relative_to(ROOT))],
        'watched_inputs': 69, 'exact_snapshots': 73,
        'final_checks': dispatch['final_checks'], 'initial_bridge_exit_codes': dispatch['initial_bridge_exit_codes'],
        'full_compiler_dependency_closure_observed': False,
        'prior_worker_or_device_results_transferred': False,
    },
    'write_framing_checks': {'receipt_sha256': sha(framing_folder / 'receipt.json'),
        'report_sha256': sha(framing_folder / 'report.json'), 'controls': 11,
        'source_inputs': 69, 'executing_artifacts': 6,
        'qualification_refusal_exit': framing['exit_codes']['qualification_refusal']},
    'complete_source_regression_checks': {'receipt_sha256': sha(regression_folder / 'full.json'),
        'final_collection_sha256': sha(regression_folder / 'final-collection.json'),
        'collected': regressions['collected_count'], 'outcomes': regressions['call_outcomes'],
        'source_inputs': regressions['source_count'], 'elapsed_seconds': regressions['elapsed_seconds'],
        'current_scope': captures[str((regression_folder / 'full.json').relative_to(ROOT))],
        'historical_result_only': True, 'rerun_after_reviewed_source_deltas': False,
        'result_transferred_to_current_snapshot': False},
    'checks': checks, 'local_links_checked': len(links), 'broken_links': broken,
    'validated_recorded_input_sha256': VALIDATED,
    'validated_recorded_path_existence': EXISTENCE,
    'reviewed_historical_recipe_change': HISTORICAL_RECIPE_CHANGE,
    'reviewed_historical_source_change': HISTORICAL_SOURCE_CHANGE,
    'preflight_record_sha256': {name: sha(ROOT / name) for name in PREFLIGHT_RECORDS},
    'binding_ballot_available': False, 'qualified_attempt_latency_ms': None,
    'profile_qualified': False, 'complete_workspace_certificate': False,
    'complete_quantum_resource_vector': False, 'full_workspace_suite_run': False,
    'scope': 'Reviewed structural source evidence and conditional write-frame circuit accounting. The current post-merge source-only CLI is separate from the historical passing Result and complete 1755-test captures; their passing outcomes are not transferred. Previous builds retain their exact historical source scope, including the reviewed qualification-dispatch source changes. Child receipts state actual commands, failures and trusted premises; the separately captured bridge host checks/tests are limited to their selected watched inputs and do not establish a new ballot worker build, full workspace suite, physical-device performance, complete resource proof, independent cryptographic review or production qualification.',
}
RECEIPT.write_text(json.dumps(value, indent=2, sort_keys=True) + '\n')
bind(RECEIPT)
publish = set(old) | NEW_SOURCES | QUALIFICATION_SOURCES | PREFLIGHT_RECORDS | {str(RECIPE.relative_to(ROOT)), str(RECEIPT.relative_to(ROOT)), str(PRIOR.relative_to(ROOT))}
publish |= {str(Path(path).relative_to(ROOT)) for members in bundle_members.values() for path in members}
publish |= {str(Path(path).relative_to(ROOT)) for path in files(archives)}
publish |= {entry['log'] for entry in checks}
for name in publish:
    require(str(ROOT / name) in VALIDATED, ('unvalidated publication', name))
    require(sha(ROOT / name) == VALIDATED[str(ROOT / name)], ('publication drift', name))
INDEX.write_text(''.join(VALIDATED[str(ROOT / name)] + '  ' + name + '\n' for name in sorted(publish)))
require(not drift(inventory(INDEX)), 'published manifest mismatch')
print(json.dumps({'entries': len(publish), 'manifest_sha256': sha(INDEX), 'receipt_sha256': sha(RECEIPT),
                  'validated_inputs': len(VALIDATED), 'links': len(links)}))
