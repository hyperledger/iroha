"""Capture focused repaired guard controls and their observed source reads.

Run once with the explicit pytest -k expression supplied on the command line.
This retains a local structural check, not a Rust/concurrency proof.
"""
from pathlib import Path
import contextlib
import datetime
import hashlib
import json
import re
import sys

root = Path.cwd()
folder = root / "docs/validation/parliament_ballot_b6"
receipt = folder / "kura-claim-guard-controls.json"
log = folder / "kura-claim-guard-controls.txt"
if receipt.exists() or log.exists():
    raise RuntimeError("refuse overwriting final guard controls")
if len(sys.argv) != 2:
    raise RuntimeError("supply one explicit focused pytest expression")
before = {}


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def pin(name):
    value = sha(root / name)
    if name in before and before[name] != value:
        raise RuntimeError("input changed during controls: " + name)
    before[name] = value


tests = "scripts/tests/check_sora_parliament_source_contract_test.py"
for name in ("scripts/formal/check_sora_parliament_source_contract.py",
             "scripts/formal/rust_text.py", tests,
             str(Path(__file__).resolve().relative_to(root))):
    pin(name)
sys.path.insert(0, str(root))
import pytest
from scripts.formal import check_sora_parliament_source_contract as guard

original_read = guard.read


def observed_read(name):
    pin(name)
    content = original_read(name)
    pin(name)
    return content


guard.read = observed_read
arguments = ["-q", tests, "-k", sys.argv[1]]
with log.open("x") as stream, contextlib.redirect_stdout(stream), contextlib.redirect_stderr(stream):
    result = int(pytest.main(arguments))
after = {name: sha(root / name) for name in before}
summary = re.findall(r"\b(\d+) passed\b", log.read_text())
passed = int(summary[-1]) if summary else 0
value = {
    "schema": "parliament-kura-claim-guard-controls-v1",
    "observed_at_utc": datetime.datetime.now(datetime.timezone.utc).isoformat(),
    "command": [sys.executable, str(Path(__file__).relative_to(root) if Path(__file__).is_absolute() else Path(__file__)), sys.argv[1]],
    "pytest_arguments": arguments, "pytest_version": pytest.__version__,
    "exit": result, "passed": passed,
    "log": str(log.relative_to(root)), "log_sha256": sha(log),
    "source_before": before, "source_after": after, "source_unchanged": before == after,
    "observed_read_count": len(before), "profile_qualified": False,
    "scope": "Focused Python structural controls on the repaired declaration/owner locator, signed gas and retained Kura claims. Observed guard.read inputs and executing code are pinned; no full Rust or concurrency qualification follows.",
}
receipt.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n")
if result or before != after or passed <= 36:
    raise RuntimeError("controls failed, missing expected coverage, or input drift; evidence retained")
print(json.dumps({"receipt_sha256": sha(receipt), "exit": result,
                  "source_count": len(before), "passed": passed}))
