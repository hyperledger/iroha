def test_huge_query_cap_is_explicit_geometry_not_a_theorem_or_runtime_bound(source):
    plan = a.Plan(source, budget(valid=0, invalid=0, queries=1 << 80))
    assert plan.query_slot((1 << 80)-1)['output'].start+2112 == plan.work_start
    result = plan.resources()
    assert result['coordinatewise_body_gate_upper']['base_xor_oracle_calls'] == 1 << 81
    assert result['external_lookup_cap_is_not_theorem_query_bound'] is True
    for field in ('initial_quantum_state_checked', 'entry_and_witness_contract_checked',
                  'controller_execution_priced', 'preparation_physically_executed',
                  'full_adaptive_game_implemented', 'full_joint_quantum_theorem_proved',
                  'complete_resource_vector', 'physical_workspace_bound', 'primitive_entry_bridge_proved',
                  'current_candidate_qualified', 'production_gate_changed'):
        assert result[field] is False
    assert len(result['unknown_terms']) == 8
