@pytest.mark.parametrize('operation', ['preparation', 'acknowledge', 'reg', 'vote', 'rejected', 'lookup', 'resources', 'emit', 'inverse'])
def test_selected_byte_drift_refused_at_every_online_boundary(source, operation):
    arena = a.OnlineArena(a.Plan(source, budget()))
    if operation not in ('preparation', 'acknowledge'):
        arena.acknowledge_prepared_banks(a.PREPARED)
    if operation == 'emit':
        arena.bind_rejected(0, entry_contract=a.REJECTED)
    if operation == 'inverse':
        arena.bind_rejected(0, entry_contract=a.REJECTED)
        tuple(arena.emit_next())
    before = (arena.trace, arena.counts, arena.phase)
    path = ROOT/'target/parliament-adaptive-arena-stage/arena.py'
    original = Path.read_bytes
    def drift(file):
        data = original(file)
        return data+b'\n# independent drift\n' if file == path else data
    with patch.object(Path, 'read_bytes', drift):
        with pytest.raises(ValueError, match='source drift'):
            if operation == 'preparation': arena.emit_preparation()
            elif operation == 'acknowledge': arena.acknowledge_prepared_banks(a.PREPARED)
            elif operation == 'reg': arena.bind_reg(a.PublicShape('REG'), entry_contract=a.VALID)
            elif operation == 'vote': arena.bind_vote(a.PublicShape('VOTE', list_count=3), entry_contract=a.INVALID)
            elif operation == 'rejected': arena.bind_rejected(0, entry_contract=a.REJECTED)
            elif operation == 'lookup': arena.bind_lookup(query_contract=a.QUERY)
            elif operation == 'resources': arena.resources()
            elif operation == 'emit': arena.emit_next()
            else: arena.emit_chosen_inverse()
    assert (arena.trace, arena.counts, arena.phase) == before


def test_partial_abandoned_preparation_and_body_are_not_execution_or_reusable_slots(source):
    arena = a.OnlineArena(a.Plan(source, budget(valid=0, invalid=1, queries=0)))
    preparation = arena.emit_preparation()
    assert arena.phase == 'preparing'
    prefix = tuple(islice(preparation, 4))
    slot = arena.plan.request_slot(0)
    assert prefix == (('h', slot['coins'].start), ('cx', slot['coins'].start, slot['purifier'].start),
                      ('h', slot['coins'].start+1), ('cx', slot['coins'].start+1, slot['purifier'].start+1))
    preparation.close()
    assert arena.phase == 'preparing'
    for operation in (arena.emit_preparation, lambda: arena.acknowledge_prepared_banks(a.PREPARED),
                      lambda: arena.bind_rejected(0, entry_contract=a.REJECTED), arena.emit_chosen_inverse):
        with pytest.raises(ValueError): operation()
    body = ready(source, valid=0, invalid=2, queries=0)
    body.bind_rejected(0, entry_contract=a.REJECTED)
    stream = body.emit_next()
    next(stream)
    stream.close()
    assert body.resources()['stream_consumed_calls'] == 0 and body.counts == (0, 1, 0)
    for operation in (body.emit_next, body.emit_chosen_inverse,
                      lambda: body.bind_rejected(2, entry_contract=a.REJECTED)):
        with pytest.raises(ValueError): operation()
    assert body.resources()['iterator_consumption_is_not_execution_evidence'] is True


