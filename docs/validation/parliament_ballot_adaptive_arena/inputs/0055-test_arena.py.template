@pytest.mark.parametrize('t,i,q',[(0,0,0),(0,0,1),(1,2,3)])
def test_initial_internal_zero_budget_is_distinct_from_coin_preparation_and_caller_inputs(source,t,i,q):
    plan = a.Plan(source,budget(valid=t,invalid=i,queries=q))
    report = plan.resources()
    shared = plan.geometry.log_bits+plan.geometry.counter_bits+plan.work
    assert 'private_initial_zero_bits' not in report
    assert report['coin_and_purifier_initial_zero_bits'] == 2*(t+i)*plan.coins
    assert report['initial_log_zero_bits'] == plan.geometry.log_bits
    assert report['initial_counter_zero_bits'] == plan.geometry.counter_bits
    assert report['initial_boundary_clean_work_bits'] == plan.work
    assert report['initial_log_counter_and_work_zero_bits'] == shared
    assert report['explicit_preparation_total_internal_zero_bits'] == shared+2*(t+i)*plan.coins
    caller = (t+i)*(plan.public+plan.output)+q*plan.query_stride
    assert report['explicit_preparation_total_internal_zero_bits']+caller == plan.size
    for key in ('requires_initial_zero_log_and_counter','requires_boundary_clean_work',
                'requires_external_no_write_to_log_counter_work',
                'requires_private_coin_purifier_and_future_bank_noninterference',
                'requires_actual_source_component_contracts',
                'zero_input_budget_applies_to_explicit_H_CX_construction',
                'supplied_Bell_state_acknowledgment_does_not_claim_zero_coins'):
        assert report[key] is True
    assert not report['initial_quantum_state_checked'] and not report['preparation_physically_executed']


def test_scope_retains_unknown_entry_and_all_qualification_flags(source):
    arena = ready(source)
    report = arena.resources()
    assert report['valid_cap'] == report['invalid_typed_body_cap'] == 2
    assert report['log_sizing_total_calls'] == 4
    assert len(report['source_sha256']) == 165
    assert report['unknown_terms'] and report['all_unused_banks_charged']
    for key in ('entry_and_witness_contract_checked','controller_execution_priced',
                'preparation_physically_executed','full_adaptive_game_implemented',
                'full_joint_quantum_theorem_proved','complete_resource_vector',
                'physical_workspace_bound','primitive_entry_bridge_proved',
                'current_candidate_qualified','production_gate_changed'):
        assert report[key] is False
