@pytest.mark.parametrize('category',['valid','invalid','query'])
def test_each_budget_refused_before_mutation_or_factory(source,category):
    changes = dict(valid=0,invalid=0,queries=0)
    arena = ready(source,**changes)
    before = (arena.trace,arena.counts,arena.phase)
    with patch.object(a,'actual_transition',side_effect=AssertionError('no factory')), \
         patch.object(a,'actual_rejected_vote',side_effect=AssertionError('no factory')), \
         patch.object(a,'actual_lookup',side_effect=AssertionError('no factory')):
        with pytest.raises(ValueError,match='budget exhausted'):
            if category == 'valid':arena.bind_reg(a.PublicShape('REG'),entry_contract=a.VALID)
            elif category == 'invalid':arena.bind_rejected(0,entry_contract=a.REJECTED)
            else:arena.bind_lookup(query_contract=a.QUERY)
    assert before == (arena.trace,arena.counts,arena.phase)


@pytest.mark.parametrize('operation',[lambda x:x.bind_reg(a.PublicShape('REG'),entry_contract='witness-invalid'),
    lambda x:x.bind_vote(a.PublicShape('VOTE',list_count=2),entry_contract=a.INVALID),
    lambda x:x.bind_vote(a.PublicShape('VOTE',row='comparator',list_count=3),entry_contract=a.VALID),
    lambda x:x.bind_rejected(1025,entry_contract=a.REJECTED),
    lambda x:x.bind_rejected(3,entry_contract=a.REJECTED),
    lambda x:x.bind_lookup(query_contract='noncanonical'),
    lambda x:x.bind_reg({'role':'REG'},entry_contract=a.VALID)])
def test_unsupported_paths_are_unknown_and_refused_before_trace_mutation(source,operation):
    arena = ready(source)
    before = (arena.trace,arena.counts,arena.phase)
    with pytest.raises(ValueError):operation(arena)
    assert before == (arena.trace,arena.counts,arena.phase)


def test_preparation_and_atomic_lifecycle_never_treat_iterator_creation_as_completion(source):
    arena = a.OnlineArena(a.Plan(source,budget(valid=0,invalid=1,queries=0)))
    iterator = arena.emit_preparation()
    assert arena.phase == 'preparing'
    first = next(iterator)
    assert first == ('h',arena.plan.request_slot(0)['coins'].start)
    with pytest.raises(ValueError):arena.emit_preparation()
    with pytest.raises(ValueError):arena.acknowledge_prepared_banks(a.PREPARED)
    with pytest.raises(ValueError):arena.bind_rejected(0,entry_contract=a.REJECTED)
    active = ready(source,valid=0,invalid=2,queries=0)
    active.bind_rejected(0,entry_contract=a.REJECTED)
    with pytest.raises(ValueError):active.bind_rejected(1,entry_contract=a.REJECTED)
    pending = active.emit_next()
    with pytest.raises(ValueError):active.emit_next()
    with pytest.raises(ValueError):active.bind_rejected(1,entry_contract=a.REJECTED)
    with pytest.raises(ValueError):active.emit_chosen_inverse()
    tuple(pending)
    active.bind_rejected(1,entry_contract=a.REJECTED)
    assert active.counts == (0,2,0)


def test_sources_verified_before_every_bind_emission_and_after_consumption(source):
    arena = ready(source,valid=0,invalid=1,queries=0)
    original = Path.read_bytes
    selected = a.ROOT/'target/parliament-sequential-composition-stage/sequence.py'
    def changed(path):
        return original(path)+(b'\n' if path == selected else b'')
    with patch.object(Path,'read_bytes',changed):
        with pytest.raises(ValueError,match='source drift'):arena.bind_rejected(0,entry_contract=a.REJECTED)
    assert arena.trace == () and arena.counts == (0,0,0)
    arena.bind_rejected(0,entry_contract=a.REJECTED)
    with patch.object(Path,'read_bytes',changed):
        with pytest.raises(ValueError,match='source drift'):arena.emit_next()
    stream = arena.emit_next()
    next(stream)
    with patch.object(Path,'read_bytes',changed):
        with pytest.raises(ValueError,match='source drift'):tuple(stream)
    assert arena.resources()['stream_consumed_calls'] == 0
    with pytest.raises(ValueError):arena.emit_chosen_inverse()


def test_wrong_origin_dependency_outside_expected_relative_suffix_is_refused(source):
    arena = ready(source,valid=0,invalid=1,queries=0)
    module = a.sys.modules['public_machine']
    with patch.object(module,'__file__','/other/public_machine.py'):
