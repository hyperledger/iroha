HERE=Path(__file__).resolve().parent;ROOT=HERE.parents[1]
sys.path.insert(0,str(HERE))
import envelope as e

@pytest.fixture(scope='module')
def catalog():return e.Catalog(ROOT)

@pytest.mark.parametrize('row',['candidate','comparator'])
def test_exact_REG_endpoint_reproduces_full_frozen_observation(catalog,row):
    raw=json.loads((ROOT/e.base.OBSERVATION).read_bytes())
    old=next(c['resources'] for c in raw['source_cases'] if (c['row'],c['role'])==(row,'REG'))
    value=e.request(catalog,row,'REG',1 << 44,64,body=4096,contexts=(256,)*6)
    assert value['gates']==old['gates']
    for field in ('retained_derived_bits','shared_work_bits','persistent_log_bits','persistent_counter_bits','caller_output_bits','total_logical_bits'):
        assert value[field]==old[field]
    assert value['original_coin_bits']==old['original_private_coin_bits']
    assert value['public_input_bits']+value['original_coin_bits']==old['original_input_bits']

@pytest.mark.parametrize('row',['candidate','comparator'])
@pytest.mark.parametrize('n',[3,1000])
def test_exact_content_case_reproduces_full_frozen_observation(catalog,row,n):
    raw=json.loads((ROOT/e.CONTENT_PATH).read_bytes())
    old=next(c['family_resources'] for c in raw['cases'] if (c['row'],c['list_count'])==(row,n))
