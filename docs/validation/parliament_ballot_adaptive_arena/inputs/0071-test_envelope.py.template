def test_frozen_catalog_mutation_and_source_drift_refused(catalog):
    with pytest.raises(FrozenInstanceError):catalog.votes=()
    with pytest.raises(FrozenInstanceError):catalog.votes[0].stages=()
    original=Path.read_bytes;selected=ROOT/(e.COMPONENT+'vote-census.csv')
    def changed(path):return original(path)+(b'\n' if path==selected else b'')
    with patch.object(Path,'read_bytes',changed):
        with pytest.raises(ValueError,match='source drift'):e.Catalog(ROOT)

def test_scope_remains_conditional_full_body_not_full_experiment(catalog):
    for role in ('REG','VOTE'):
        r=e.envelope(catalog,'candidate',role,1,64)
        assert r['conditional_full_typed_request_body_family_bound'] is True
        assert r['log_capacity_parameter_is_not_an_invalid_request_budget'] is True
        assert r['source_theorem_valid_request_bound'] is None
        for name in ('full_adaptive_driver_executed','complete_experiment_resource_vector','complete_resource_vector',
            'input_or_coin_preparation_priced','primitive_bridge_proved','physical_workspace_bound',
            'current_candidate_qualified','independent_cryptographic_review','profile_qualified','production_gate_changed'):
            assert r[name] is False
        assert all(v is None for v in r['unknown_external_terms'].values())
