"""Compare the final report to an independent dead-code-inclusive body universe."""
import argparse,bisect,gzip,hashlib,importlib.util,json,re,sys
from pathlib import Path
ROOT=Path.cwd().resolve();STAGE=ROOT/'target/parliament-exception-coverage-stage';REVIEW=ROOT/'target/parliament-exception-graph-review'
EXPECTED_RAW='9460da92323a358a6bdf13cb27ad286bb6ee5799ab88189b1db05bcd3c1dce70'
