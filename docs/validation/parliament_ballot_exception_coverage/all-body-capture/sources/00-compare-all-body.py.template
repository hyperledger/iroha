 need(all('_OUTLINED_FUNCTION_' in names[s] for s in extra_functions),'extra functions are not outlined helpers')
 called=set()
 for pc in local_gap:
  op,args_text=instructions[pc]
  if op in ('bl','b'):
   match=re.match(r'(0x[0-9a-f]+)(?:\s|$)',args_text)
   if match and int(match[1],16) in instructions:called.add(owner(int(match[1],16)))
 need(set(extra_functions)<=called,'extra helper not called from omitted body')
 need({name:sha(folder/name) for name in pins}==pins,'late text drift')
 results[mode]=dict(input_sha256=pins,all_body_census=census,augmented_functions=len(actual_functions),augmented_instructions=len(actual),augmented_function_subset=True,augmented_instruction_subset=True,all_body_instruction_addresses=[hex(pc) for pc in sorted(universe)],additional_instructions=[dict(pc=hex(pc),owner=hex(owner(pc)),owner_name=names[owner(pc)],op=instructions[pc][0],operands=instructions[pc][1]) for pc in difference],additional_functions=[dict(address=hex(s),name=names[s]) for s in extra_functions],unresolved_indirect_branch=dict(pc=hex(branch),owner=hex(owner(branch)),owner_name=names[owner(branch)],op=instructions[branch][0],operands=instructions[branch][1]),native_direct_sites_identical=True,native_direct_site_count=len(native),additional_indirect_sites=[hex(pc) for pc in sorted(indirect-indirect_actual)],gap_proven_dead=False,indirect_targets_resolved=False)
