value=dict(schema='parliament-final-exception-whole-body-comparison-v1',status='PASS',final_raw_report_sha256=EXPECTED_RAW,independent_reference_sha256=REFERENCE_SHA,modes=results,scope='Independent complete-body direct-edge overapproximation over the same retained decoded text. The final augmented graph is a subset; omitted instructions remain unresolved, not proven dead. No worker, loaded unwinder, CFI execution, native semantics or complete resource certificate.',complete_exception_semantics=False,complete_workspace_certificate=False,applies_to_current_checkout=False,profile_qualified=False,production_gate_changed=False,worker_executed=False)
with args.out.open('x') as f:f.write(json.dumps(value,indent=2,sort_keys=True)+'\n')
print(json.dumps({mode:{'functions':len(value['all_body_census']['members']),'instructions':value['all_body_census']['all_body_instruction_count'],'additional_instructions':len(value['additional_instructions']),'native_direct_sites':value['native_direct_site_count']} for mode,value in results.items()},sort_keys=True))
