results={}
for mode,expected_functions,expected_instructions,branch in [('portable',287,32998,0x100032348),('accel',291,31299,0x1000300b0)]:
 folder=ROOT/'docs/validation/parliament_ballot_current_candidate/stack'/mode
 pins={name:sha(folder/name) for name in ('disassembly.txt','starts.txt','stubs.txt')}
 need(pins=={name:report['input_sha256_after'][mode+'_'+name[:-4]] for name in pins},'final report/census input mismatch')
 census=module.analyze(mode,folder)
 need(census['captured_inputs']==pins,'reference input mismatch')
 text=(folder/'disassembly.txt').read_text().split('Disassembly of section __TEXT,__text:\n',1)[1].split('\nDisassembly of section ',1)[0]
 instructions={int(m[1],16):(m[2],m[3].split(';',1)[0].strip()) for m in re.finditer(r'(?m)^([0-9a-f]+):[ \t]+(\S+)[ \t]*(.*)$',text)}
 starts=sorted(int(m[1],16) for m in re.finditer(r'(?m)^([0-9a-f]{16})\s+\S+',(folder/'starts.txt').read_text()))
 names={int(m[1],16):m[2] for m in re.finditer(r'(?m)^([0-9a-f]+) <(.+)>:$',text)}
