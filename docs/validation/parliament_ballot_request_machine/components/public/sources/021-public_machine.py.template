def guard_public_sources(root):
    """Authenticate selected semantic sources, not their compiler/dependency closure."""
    root=Path(root)
    pins=dict(SOURCE_PINS)
    pins.update({path:expected for path,expected in TABLES.values()})
    for path,expected in pins.items():
        require(hashlib.sha256((root/path).read_bytes()).hexdigest()==expected,
                "public source changed: "+path)
    return pins
