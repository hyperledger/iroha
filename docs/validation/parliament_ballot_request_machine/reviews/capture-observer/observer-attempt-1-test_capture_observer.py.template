"""Actual pytest controls for parent identities and retained subtest failures."""
import hashlib
import json
import os
from pathlib import Path
import subprocess
import xml.etree.ElementTree as ET

import pytest


OBSERVER = Path(__file__).with_name('capture_observer.py')
PYTEST = Path('/opt/homebrew/bin/pytest')


@pytest.mark.parametrize('failed_subtest', (False, True), ids=('two-pass', 'retained-failure'))
def test_actual_parent_and_subtest_reports(tmp_path, failed_subtest):
    """A failing subtest must survive even though its parent call passes."""
    case = tmp_path/'test_observed_case.py'
    case.write_text(
        'def test_parent(subtests):\n'
        '    for value in range(2):\n'
        '        with subtests.test(value=value):\n'
        f'            assert not ({failed_subtest!r} and value == 1)\n')
    observation = tmp_path/'observation.json'
    junit = tmp_path/'junit.xml'
    command = [str(PYTEST), '-o', 'addopts=', '-p', 'no:cacheprovider',
        '--noconftest', '-p', 'capture_observer', '-k', '', '-m', '',
        '--maxfail=0', '--basetemp='+str(tmp_path/'pytest-temp'),
        '--junitxml='+str(junit), '-q', str(case)]
    env = dict(os.environ, PYTHONDONTWRITEBYTECODE='1',
        PYTEST_DISABLE_PLUGIN_AUTOLOAD='1', PYTEST_ADDOPTS='', PYTEST_PLUGINS='',
        PYTHONPATH=str(OBSERVER.parent), PARLIAMENT_CAPTURE_OBSERVATION=str(observation))
    before = hashlib.sha256(OBSERVER.read_bytes()).hexdigest()
    result = subprocess.run(command,cwd=tmp_path,env=env,capture_output=True,check=False)
    (tmp_path/'command.json').write_text(json.dumps(command,indent=2)+'\n')
    (tmp_path/'stdout.txt').write_bytes(result.stdout)
    (tmp_path/'stderr.txt').write_bytes(result.stderr)
    assert hashlib.sha256(OBSERVER.read_bytes()).hexdigest()==before
    assert result.returncode == int(failed_subtest)
    report=json.loads(observation.read_text())
    assert report['exitstatus'] == int(failed_subtest)
    assert len(report['collected']) == 1
    assert report['collected'][0].endswith('test_observed_case.py::test_parent')
    assert len(report['calls']) == 3
    assert all(type(call['is_subtest']) is bool for call in report['calls'])
    parents=[call for call in report['calls'] if not call['is_subtest']]
    children=[call for call in report['calls'] if call['is_subtest']]
    assert [call['nodeid'] for call in parents] == report['collected']
    assert parents[0]['outcome'] == 'passed'
    assert len(children)==2
    assert all(call['nodeid']==parents[0]['nodeid'] for call in children)
    assert [call['outcome'] for call in children] == ['passed','failed' if failed_subtest else 'passed']
    assert all(call['outcome']=='passed' for call in report['calls']) is (not failed_subtest)
    # Failed child remains visible in JUnit too; report count is not used as
    # collected parent membership because child reports share the same node ID.
    tree=ET.parse(junit)
    assert len(tree.findall('.//failure'))==int(failed_subtest)
    assert not tree.findall('.//error')
    assert not tree.findall('.//skipped')
