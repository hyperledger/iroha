def test_one_relation_round_uses_field_keys_degree_alignment_not_boolean_keccak(concrete):
    cs=VerifierCircuit(1,0,1600*256,*concrete)
    base=cs.regions["public"][0]
    keys=[Key(base+256*i,1) for i in range(1600)]
    outputs=relation_round(cs,keys,0,8)
    block=cs.b.finish(tuple(w for key in outputs[:8] for w in range(key.register,key.register+256)))
    rng=random.Random(620);delta=17;state=[rng.getrandbits(256) for _ in range(1600)]
    parity=[state[i]^state[i+320]^state[i+640]^state[i+960]^state[i+1280] for i in range(320)]
    theta=[state[t]^parity[64*((t%320//64+4)%5)+t%64]^parity[64*((t%320//64+1)%5)+(t%64+63)%64] for t in range(1600)]
    # Derive the rho/pi source through an independent forward coordinate scatter.
    rotated=[None]*1600;x,y=1,0;offsets={(0,0):0}
    for index in range(24):offsets[x,y]=(index+1)*(index+2)//2%64;x,y=y,(2*x+3*y)%5
    for y in range(5):
        for x in range(5):
            for z in range(64):rotated[64*(y+5*((2*x+3*y)%5))+(z+offsets[x,y])%64]=theta[64*(x+5*y)+z]
    expected=[]
    for z in range(8):
        value=mul(rotated[z],delta)^mul(rotated[64+z]^delta,rotated[128+z])
        if z==0:value^=mul(delta,delta)
        expected.append(value)
    values=[0]*block.inputs;values[:256]=bits(delta,256)
    values[base:]=word_input(state,[256]*1600)
    actual=block.evaluate(values)
    assert [unpack(actual[i:i+256]) for i in range(0,2048,256)]==expected
    assert all(k.degree==2 for k in outputs[:8])
