def test_missing_reverse_leaves_joint_workspace_dirty():
    b=FieldBuilder(512,ToyKernel(),ToyKernel(True))
    square=b.multiply(0,0);out=b.xor(square,256)
    block=b.finish(range(out,out+256))
    state=[1]*block.inputs+[0]*(block.history+block.work+256)
    for gate in block.emit():state[gate[-1]]^=int(all(state[w] for w in gate[1:-1]))
    for i,source in enumerate(block.outputs):state[block.output_start+i]^=state[source]
    assert state[block.output_start:]==list(block.evaluate((1,)*block.inputs))
    assert any(state[block.inputs:block.output_start])


class ToyKernel:
    """Routing-only test kernel; this does not supply field arithmetic evidence."""
    outputs=256;work=0;cost=Cost(cx=512)
    def __init__(self,short=False):self.inputs=320 if short else 512;self.name="toy64" if short else "toy256"
    def evaluate(self,values):return tuple(values[i]^values[256+i%(self.inputs-256)] for i in range(256))
    def emit(self,inputs,outputs,work):
        assert not work and len(set(inputs+outputs))==len(inputs+outputs)
        for i,out in enumerate(outputs):
            yield ("cx",inputs[i],out)
            yield ("cx",inputs[256+i%(self.inputs-256)],out)


@pytest.mark.parametrize("stage",["r0","r1"])
def test_full_clean_assembly_arbitrary_targets_counts_and_kernel_alias_copies(stage):
    kernels=(ToyKernel(),ToyKernel(True))
    if stage=="r0":block=VoleResponse(2,*kernels).build()
    else:
        cs=VerifierCircuit(2,1,0,*kernels);cs.booleanity();cs.constrain(cs.mul(cs.witness(0),cs.witness(0)))
        block,_=cs.finish()
    rng=random.Random(995);values=tuple(rng.randrange(2) for _ in range(block.inputs))
    expected=block.evaluate(values);z=[rng.randrange(2) for _ in expected]
    state=list(values)+[0]*(block.history+block.work)+z+[1,0,1]
    original=state.copy();census=Counter()
    for gate in block.emit_clean():
        kind,*wires=gate
        assert len(set(wires))==len(wires)
        assert all(0<=w<len(state)-3 for w in wires)
        state[wires[-1]]^=int(all(state[w] for w in wires[:-1]));census[kind]+=1
    assert state[:block.inputs]==list(values) and state[-3:]==[1,0,1]
    assert not any(state[block.inputs:block.output_start])
    assert state[block.output_start:-3]==[a^b for a,b in zip(z,expected)]
    assert all(census[k]==block.resources()["gates"][k] for k in ("x","cx","ccx"))
    for gate in block.emit_clean():state[gate[-1]]^=int(all(state[w] for w in gate[1:-1]))
    assert state==original


@pytest.mark.parametrize("delta,public_column",[(0,0),(7,0),(0,3),(13,3)])
def test_selector_zero_normalization_only_at_degree4_consumer(concrete,delta,public_column):
    cs=VerifierCircuit(1,0,2048,*concrete)
    start=cs.regions["public"][0]
    output=Key(cs.b.constant(31),4)
    products=[Key(cs.b.constant(7),2),Key(cs.b.constant(9),2)]
    normalized=multiplex_at_degree4(cs,output,products,start,0)
    selected=Key(cs.zero,0)
    for i,p in enumerate(products):
        if public_column>>i&1:selected=cs.add(selected,p)
    source=cs.add(output,selected)
    block=cs.b.finish(tuple(range(normalized.register,normalized.register+256))+tuple(range(source.register,source.register+256)))
    values=[0]*block.inputs;values[:256]=bits(delta,256)
    values[start]=public_column&1;values[start+1024]=(public_column>>1)&1
    result=block.evaluate(values)
    assert result[:256]==result[256:]
    with pytest.raises(ValueError):multiplex_at_degree4(cs,Key(output.register,3),products,start,0)


