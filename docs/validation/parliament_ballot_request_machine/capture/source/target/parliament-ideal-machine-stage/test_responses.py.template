@pytest.mark.parametrize("ell,delta",[(1,0),(1,MASK),(3,17)])
def test_r0_order_exact_five_horner_lanes_and_delta_products(concrete,ell,delta):
    rng=random.Random(881+ell)
    q=[rng.getrandbits(256) for _ in range(ell)]
    masks=[rng.getrandbits(256) for _ in range(10)]
    r=[rng.getrandbits(256) for _ in range(4)];s=[rng.getrandbits(256) for _ in range(4)]
    t=rng.getrandbits(64);u=[rng.getrandbits(256) for _ in range(4)]
    values=word_input([delta,*q,*masks,*r,*s,t,*u],[256]*(1+ell+10+8)+[64]+[256]*4)
    y=[0]*5
    for value in q+masks[:6]:
        y=[mul(y[j],s[j] if j<4 else t)^value for j in range(5)]
    expected=[mul(r[j],y[0])^y[j+1]^masks[6+j]^mul(delta,u[j]) for j in range(4)]
    c=VoleResponse(ell,*concrete).build()
    assert [unpack(c.evaluate(values)[i:i+256]) for i in range(0,1024,256)]==expected
    counts=dict(c.operation_counts)
    assert counts[concrete[0].name]==4*(ell+6)+8
    assert counts[concrete[1].name]==ell+6
    assert counts["xor"]==5*(ell+6)+12
    # Count-only traversal must be the identical schedule and register geometry.
    counted=VoleResponse(ell,*concrete).build(record=False)
    assert c.resources()==counted.resources() and c.outputs==counted.outputs


def qs_values(cs,delta,rng):
    values=[0]*cs.b.inputs
    fields={}
    for name,(start,width) in cs.regions.items():
        value=delta if name=="delta" else rng.getrandbits(width)
        values[start:start+width]=bits(value,width) if width else ()
        fields[name]=value
    return tuple(values),fields


@pytest.mark.parametrize("delta",[0,1,0x1234567])
def test_r1_mixed_degrees_masks_and_coefficients_match_equation(concrete,delta):
    cs=VerifierCircuit(2,3,0,*concrete)
    values,fields=qs_values(cs,delta,random.Random(981))
    k=[(fields["q"]>>(256*i)&MASK)^mul((fields["d"]>>i)&1,delta) for i in range(2)]
    cs.booleanity()
    cs.constrain(cs.witness(0))
    cs.constrain(cs.constant(29))
    cs.constrain(cs.add(cs.mul(cs.witness(0),cs.witness(1)),cs.witness(0)))
    block,meta=cs.finish()
    assert meta["error"] is None and meta["constraint_degrees"]=={0:1,1:1,2:3}
    raw=[(mul(k[0],k[0]^delta),2),(mul(k[1],k[1]^delta),2),(k[0],1),(29,0),
         (mul(k[0],k[1])^mul(k[0],delta),2)]
    lifted=[mul(v,power(delta,7-degree)) for v,degree in raw]
    challenge=fields["challenge2"];r0=challenge&MASK;r1=(challenge>>256)&MASK
    s=(challenge>>512)&MASK;t=challenge>>768
    h0=h1=0
    for value in lifted:h0=mul(h0,s)^value;h1=mul(h1,t)^value
    expected=mul(r0,h0)^mul(r1,h1)
    for j in range(6):
        expected^=mul(fields["qbar"]>>(256*j)&MASK,power(delta,j))
        expected^=mul(fields["coefficients"]>>(256*j)&MASK,power(delta,j+1))
    result=block.evaluate(values)
    assert unpack(result[:256])==expected and not any(result[256:])
    # Last four qbar entries are not QuickSilver masks.
    changed=list(values);start=cs.regions["qbar"][0]+6*256
    for i in range(start,start+4*256):changed[i]^=1
    assert block.evaluate(changed)==result


@pytest.mark.parametrize("fault,code,ordinal",[("short",1,1),("long",1,3),("index",2,1),("overflow",3,1),("index_overflow",2,1)])
def test_degree_error_precedence_latching_and_materialized_error(concrete,fault,code,ordinal):
    cs=VerifierCircuit(1,1,0,*concrete);cs.booleanity()
    if fault=="long":cs.constrain(cs.witness(0));cs.constrain(cs.witness(0))
    elif fault=="index":cs.constrain(cs.witness(1))
    elif fault in ("overflow","index_overflow"):
        value=cs.witness(0)
        for _ in range(7):value=cs.mul(value,cs.witness(0))
        if fault=="index_overflow":value=cs.add(value,cs.witness(1))
        cs.constrain(value)
    block,meta=cs.finish()
    assert meta["error"] is not None
    result=block.evaluate((0,)*block.inputs)
    assert unpack(result[:256])==0 and unpack(result[256:])==code+(ordinal<<2)
    # First error is never replaced by later malformed constraints.
    previous=cs.error;cs.constrain(cs.witness(999));assert cs.error==previous


def test_bad_index_dominates_overflow_and_degree_limit():
    for left,right in [("index","overflow"),("overflow","index"),(7,"index")]:
        assert combined_degree(left,right)=="index"
        assert combined_degree(left,right,True)=="index"
    assert combined_degree(3,4,True)==7
    assert combined_degree(4,4,True)=="overflow"
    assert combined_degree(4,4)==4


