ROOT=Path(__file__).resolve().parents[2]
MASK=2**256-1
MOD=(1<<256)|(1<<10)|(1<<5)|(1<<2)|1


def mul(a,b):
    raw=0
    while b:
        bit=b&-b;raw^=a<<(bit.bit_length()-1);b^=bit
    while raw.bit_length()>256:raw^=MOD<<(raw.bit_length()-257)
    return raw


def power(a,n):
    out=1
    for _ in range(n):out=mul(out,a)
    return out


def word_input(values,widths):
    return tuple(bit for value,width in zip(values,widths) for bit in bits(value,width))


@pytest.fixture(scope="module")
def concrete():
    module=load_field(ROOT)
