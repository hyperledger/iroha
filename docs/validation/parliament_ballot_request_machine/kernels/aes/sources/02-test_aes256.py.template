def test_complete_relocated_clean_map_gate_count_and_inverse():
    kernel = AES256Kernel()
    # Disjoint reversed labels check relocation rather than relying on layout equality.
    width = kernel.inputs + kernel.outputs + kernel.work
    inputs = tuple(range(width-1,width-1-kernel.inputs,-1))
    outputs = tuple(range(kernel.outputs))
    work = tuple(range(kernel.outputs,width-kernel.inputs))
    source = bytes(range(32)) + bytes.fromhex('00112233445566778899aabbccddeeff')
    destination = bytes.fromhex('a52e8436095bf648135925adbace6307')
    state = [0]*width
    for register,value in ((inputs,encode(source)),(outputs,encode(destination))):
        for wire,bit in zip(register,value): state[wire] = bit
    before = list(state)
    counts = Counter()
    def counted():
        for gate in kernel.emit(inputs,outputs,work):
            counts[gate[0]] += 1
            yield gate
    apply_gates(state,counted())
    assert tuple(state[w] for w in inputs) == encode(source)
    assert not any(state[w] for w in work)
    result = bytes(a ^ b for a,b in zip(destination,bytes.fromhex('8ea2b7ca516745bfeafc49904b496089')))
    assert tuple(state[w] for w in outputs) == encode(result)
    cost = kernel.cost.as_dict()
    assert (counts['x'],counts['cx'],counts['ccx']) == tuple(cost[n] for n in ('x','cx','ccx'))
    assert cost['base_xor_oracle_calls'] == 0
    apply_gates(state,kernel.emit(inputs,outputs,work))
    assert state == before


@pytest.mark.parametrize('mutation', ('width','alias','bool','negative','list'))
def test_kernel_rejects_bad_registers(mutation):
    k = AES256Kernel()
    ins = tuple(range(k.inputs))
    outs = tuple(range(k.inputs,k.inputs+k.outputs))
    work = tuple(range(k.inputs+k.outputs,k.inputs+k.outputs+k.work))
    if mutation == 'width': work = work[:-1]
    elif mutation == 'alias': outs = ins[:k.outputs]
    elif mutation == 'bool': ins = (True,)+ins[1:]
    elif mutation == 'negative': work = (-1,)+work[1:]
    else: ins = list(ins)
    with pytest.raises(ValueError):
        next(k.emit(ins,outs,work))


def test_report_ordinary_and_refusal_match_and_never_qualify(tmp_path):
    normal, refused = tmp_path / 'normal.json', tmp_path / 'refused.json'
    assert REPORT.main(['--out', str(normal)]) == 0
    assert REPORT.main(['--out', str(refused), '--require-qualified']) == 2
    assert normal.read_bytes() == refused.read_bytes()
    value = json.loads(normal.read_text())
    assert value['source_before'] == value['source_after']
    assert value['checked_component_construction'] is True
    assert value['gates']['elementary_gates'] == 1230412
    assert all(value[flag] is False for flag in REPORT.FLAGS)
    with pytest.raises(FileExistsError):
        REPORT.main(['--out', str(normal)])


def test_report_refuses_source_drift_and_module_substitution(monkeypatch, tmp_path):
    pins = dict(REPORT.PINS)
    pins[IR] = '0'*64
    with monkeypatch.context() as changed:
        changed.setattr(REPORT,'PINS',pins)
        assert REPORT.main(['--out',str(tmp_path/'drift.json')]) == 1
        result = json.loads((tmp_path/'drift.json').read_text())
        assert result['checked_component_construction'] is False
        assert all(result[flag] is False for flag in REPORT.FLAGS)
    with monkeypatch.context() as changed:
        changed.setattr(REPORT.aes256,'__file__',str(tmp_path/'foreign.py'))
        with pytest.raises(ValueError, match='loaded AES path'):
            REPORT.observed()
    assert REPORT.digest(STAGE/'aes256.py') == hashlib.sha256((STAGE/'aes256.py').read_bytes()).hexdigest()


def test_report_detects_mid_computation_identity_drift(monkeypatch):
    original = REPORT.observed
    calls = 0
    def changed_observation():
        nonlocal calls
        calls += 1
        current = original()
        if calls == 2:
            current['changed'] = '0'*64
        return current
    monkeypatch.setattr(REPORT,'observed',changed_observation)
    with pytest.raises(ValueError, match='source changed during report'):
        REPORT.report()

