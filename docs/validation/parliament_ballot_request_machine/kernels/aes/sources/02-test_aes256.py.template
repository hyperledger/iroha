def gf_reference(a, b):
    """Independent Russian-peasant byte multiplication, with integer state."""
    result = 0
    for _ in range(8):
        if b & 1:
            result ^= a
        a = ((a << 1) ^ (0x11b if a & 128 else 0)) & 255
        b >>= 1
    return result


def encode(value):
    """Bytes to low-bit-first input wires, independently of cipher construction."""
    return tuple((b >> i) & 1 for b in value for i in range(8))


def decode(value):
    """Output wires back to byte order."""
    assert len(value) % 8 == 0
    return bytes(sum(value[start+i] << i for i in range(8)) for start in range(0, len(value), 8))


def test_byte_helpers_reject_missing_and_out_of_range_wires():
    b = Builder(16)
    for value in ((), list(range(8)), (True,)*8, (-1,)*8, (16,)*8):
        with pytest.raises(ValueError):
            byte(b, value)
    with pytest.raises(ValueError):
        xor_bytes(b, tuple(range(8)))
    for value in (-1, 256, True):
        with pytest.raises(ValueError):
            xor_constant(b, tuple(range(8)), value)


def test_xor_and_constants_all_byte_values():
    b = Builder(16)
    a, c = tuple(range(8)), tuple(range(8,16))
    block = b.finish(xor_bytes(b, a, c) + xor_constant(b, a, 0xa5))
    for x in range(256):
        y = (197*x + 53) % 256
        assert decode(block.evaluate(encode(bytes((x,y))))) == bytes((x ^ y, x ^ 0xa5))


def test_polynomial_linear_maps_exhaustive():
    b = Builder(8)
    a = tuple(range(8))
    block = b.finish(xtime(b, a) + square(b, a))
    for value in range(256):
        assert decode(block.evaluate(encode(bytes((value,))))) == bytes((gf_reference(value,2), gf_reference(value,value)))


def test_polynomial_product_basis_and_random_pairs():
    b = Builder(16)
    block = b.finish(multiply(b, tuple(range(8)), tuple(range(8,16))))
    pairs = [(x, 1 << bit) for x in range(256) for bit in range(8)]
    rng = random.Random(197)
    pairs += [(rng.randrange(256), rng.randrange(256)) for _ in range(512)]
    pairs += [(x,x) for x in range(256)]
    for x,y in pairs:
        assert unpack(block.evaluate(encode(bytes((x,y))))) == gf_reference(x,y)


def test_sbox_all_256_values_against_literal_fips_table():
    b = Builder(8)
    block = b.finish(substitute(b, tuple(range(8))))
    assert len(SBOX) == 256
    for value, expected in enumerate(SBOX):
        assert unpack(block.evaluate(bits(value,8))) == expected


def test_sbox_emitted_clean_map_and_arbitrary_output():
    b = Builder(8)
    block = b.finish(substitute(b, tuple(range(8))))
    gates = tuple(block.emit_clean())
    for value in range(256):
        initial = list(bits(value,8) + (0,)*block.derived + bits(value ^ 0xa5,8))
        state = list(initial)
        apply_gates(state, gates)
        assert state[:8] == initial[:8]
        assert not any(state[8:-8])
        assert unpack(state[-8:]) == (value ^ 0xa5 ^ SBOX[value])
    counts = Counter(g[0] for g in gates)
    reported = block.clean_resources()["gates"]
    assert (counts['x'], counts['cx'], counts['ccx']) == tuple(reported[n] for n in ('x','cx','ccx'))


def test_shift_rows_literal_column_major_permutation_and_shape():
    assert shift_rows(tuple(range(16))) == (0,5,10,15,4,9,14,3,8,13,2,7,12,1,6,11)
    with pytest.raises(ValueError):
        shift_rows(tuple(range(15)))


def test_mix_columns_independent_matrix_and_nist_round():
    b = Builder(128)
    block = b.finish(tuple(w for x in mix_columns(b, tuple(tuple(range(8*i,8*i+8)) for i in range(16))) for w in x))
    matrix = ((2,3,1,1),(1,2,3,1),(1,1,2,3),(3,1,1,2))
    inputs = [bytes(16), bytes(range(16)), bytes.fromhex('2b7e7062e22fd0892528fc3442b028f8')]
    inputs += [bytes(1 << (i % 8) if j == i//8 else 0 for j in range(16)) for i in range(128)]
    for data in inputs:
        expected = bytes(gf_reference(data[col*4],row[0]) ^ gf_reference(data[col*4+1],row[1])
                         ^ gf_reference(data[col*4+2],row[2]) ^ gf_reference(data[col*4+3],row[3])
                         for col in range(4) for row in matrix)
        assert decode(block.evaluate(encode(data))) == expected
    assert decode(block.evaluate(encode(inputs[2]))).hex() == 'c62513b7f75ef6cbfa5eb2d39fb9b1b5'
    with pytest.raises(ValueError):
        mix_columns(b, ())


def test_key_schedule_against_independent_byte_algorithm():
    b = Builder(256)
    key = tuple(tuple(range(8*i,8*i+8)) for i in range(32))
    block = b.finish(tuple(w for byte in expand_key(b,key) for w in byte))
    raw = bytes(range(32))
    words = [bytearray(raw[i:i+4]) for i in range(0,32,4)]
    for i in range(8,60):
        temp = words[i-1][:]
        if i % 8 == 0:
            temp = bytearray(SBOX[x] for x in temp[1:]+temp[:1])
            temp[0] ^= 1 << (i//8-1)
        elif i % 8 == 4:
            temp = bytearray(SBOX[x] for x in temp)
        words.append(bytearray(a ^ c for a,c in zip(words[i-8],temp)))
    assert decode(block.evaluate(encode(raw))) == b''.join(words)
    with pytest.raises(ValueError):
        expand_key(b, key[:16])


