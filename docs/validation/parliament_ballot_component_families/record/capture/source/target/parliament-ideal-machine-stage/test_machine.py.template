ROOT = Path(__file__).resolve().parents[2]


def counted(gates):
    """Independent emitted-gate census."""
    out = Counter(g[0] for g in gates)
    return dict(x=out["x"], cx=out["cx"], ccx=out["ccx"],
                elementary_gates=out["x"] + out["cx"] + 5 * out["ccx"],
                base_xor_oracle_calls=0)


class BitIRTests(unittest.TestCase):
    """Structural errors and actual clean maps, rather than formula-only tests."""
    def test_complete_boolean_basis_and_arbitrary_output(self):
        b = Builder(3)
        nodes = [b.bit("and", 0, 1), b.bit("xor", 0, 2), b.bit("not", 1),
                 b.bit("copy", 2), b.bit("one"), b.bit("zero"), b.bit("and", 2, 2),
                 b.bit("xor", 1, 1)]
        circuit = b.finish((*nodes, nodes[0], 0))
        expected_cost = circuit.clean_resources()["gates"]
        gates = tuple(circuit.emit_clean())
        self.assertEqual(counted(gates), expected_cost)
        for value in range(8):
            x = bits(value, 3)
            f = (x[0] & x[1], x[0] ^ x[2], x[1] ^ 1, x[2], 1, 0, x[2], 0,
                 x[0] & x[1], x[0])
            self.assertEqual(circuit.evaluate(x), f)
            for zvalue in (0, 341, 1023):
                z = bits(zvalue, len(f))
                state = list(x + (0,) * (circuit.derived + circuit.work) + z)
                before = list(state)
                apply_gates(state, gates)
                self.assertEqual(state[:3], before[:3])
                self.assertEqual(state[3:3 + circuit.derived + circuit.work],
                                 [0] * (circuit.derived + circuit.work))
                self.assertEqual(tuple(state[-len(f):]), tuple(a ^ b for a, b in zip(f, z)))
                apply_gates(state, reversed(gates))
                self.assertEqual(state, before)

    def test_all_small_increment_values_flags(self):
        for width in range(1, 7):
            b = Builder(width + 1)
            circuit = b.finish(b.increment(tuple(range(width)), width))
            for value in range(1 << width):
                for flag in (0, 1):
                    self.assertEqual(unpack(circuit.evaluate(bits(value, width) + (flag,))),
                                     (value + flag) % (1 << width))

    def test_mux_all_tuples(self):
        b = Builder(5)
        c = b.finish(b.select(0, (1, 2), (3, 4)))
        for value in range(32):
            x = bits(value, 5)
            self.assertEqual(c.evaluate(x), x[1:3] if x[0] else x[3:5])

    def test_snapshot_of_builder(self):
        b = Builder(2)
        c = b.finish((b.bit("xor", 0, 1),))
        frozen = tuple(c.emit_clean())
        b.nodes.clear()
        b.nodes.append(Node("and", (0, 1)))
        self.assertEqual(tuple(c.emit_clean()), frozen)

    def test_invalid_nodes_and_wires(self):
        cases = [dict(inputs=True, nodes=(), outputs=()),
                 dict(inputs=1, nodes=[], outputs=()),
                 dict(inputs=1, nodes=(Node("copy", (1,)),), outputs=(0,)),
                 dict(inputs=1, nodes=(Node("copy", (-1,)),), outputs=(0,)),
                 dict(inputs=1, nodes=(Node("copy", (True,)),), outputs=(0,)),
                 dict(inputs=2, nodes=(Node("and", (0, 0)),), outputs=(0,)),
                 dict(inputs=2, nodes=(Node("xor", (0, 0)),), outputs=(0,)),
                 dict(inputs=1, nodes=(Node("unknown", ()),), outputs=(0,)),
                 dict(inputs=1, nodes=(Node("kernel", (0,), kernel="unregistered"),), outputs=(0,)),
                 dict(inputs=1, nodes=(Node("copy", (0,), width=2),), outputs=(0,)),
                 dict(inputs=1, nodes=(), outputs=(1,))]
        for case in cases:
            with self.subTest(case=case), self.assertRaises(ValueError):
                Block(**case)

    def test_interpreter_refuses_aliases_and_invalid_values(self):
        for gate in (("ccx", 0, 0, 1), ("cx", 0, 0), ("bad", 0), ("x", 2)):
            with self.subTest(gate=gate), self.assertRaises(ValueError):
                apply_gates([1, 0], [gate])
        with self.assertRaises(ValueError):
            Block(1, (), (0,)).evaluate((True,))
        with self.assertRaises(ValueError):
            Cost(ccx=-1)
        for value in (-1, True, 2):
            with self.subTest(value=value), self.assertRaises(ValueError):
                Builder(2).bit("xor", value, value)


class ScheduleTests(unittest.TestCase):
    """All control branches, bit significance, actual emitted gates and cleanup."""
    @classmethod
    def setUpClass(cls):
        cls.module = load_predicate(ROOT)
        # All low index choices admitted; the high grinding bit gives both paths.
        cls.geometry = cls.module.Geometry(2, 3, 0, 1, 7)
        cls.kernel = AdmissibilityKernel(cls.module, cls.geometry)

    @staticmethod
    def reference(primary, auxiliary, kernel):
        accepted = lambda value: kernel.evaluate(bits(value, kernel.inputs))[0] == 1
        p = next((i for i, v in enumerate(primary) if accepted(v)), None)
        if p is not None:
            return dict(selected=primary[p], counter=p, primary_count=p + 1, auxiliary_count=0,
                        exhausted=0, fallback=0, write_flags=[int(i <= p) for i in range(len(primary))])
        a = next((i for i, v in enumerate(auxiliary) if accepted(v)), None)
        return dict(selected=auxiliary[a] if a is not None else 0, counter=0,
                    primary_count=len(primary), auxiliary_count=a + 1 if a is not None else len(auxiliary),
                    exhausted=1, fallback=int(a is None), write_flags=[1] * len(primary))

    def test_all_small_acceptance_patterns(self):
        for cap in (1, 2, 3, 4):
            circuit = Schedule(self.kernel, cap)
            for flags in itertools.product((0, 1), repeat=2 * cap):
                # Different low bits catch first-selection versus last-selection bugs.
                tape = [i % 16 if ok else 16 + i % 16 for i, ok in enumerate(flags)]
                primary, auxiliary = tape[:cap], tape[cap:]
                self.assertEqual(circuit.evaluate(primary, auxiliary),
                                 self.reference(primary, auxiliary, self.kernel))

    def test_finite_emitter_clean_map_and_exact_count(self):
        circuit = Schedule(self.kernel, 2)
        p = circuit.wiring()
        gates = tuple(circuit.emit_clean())
        self.assertEqual(counted(gates), circuit.resources()["clean_gates"])
        rand = random.Random(1486)
        for primary, auxiliary in [([1, 2], [3, 4]), ([16, 7], [4, 5]),
                                   ([16, 17], [3, 5]), ([16, 17], [18, 5]),
                                   ([16, 17], [18, 19])]:
            tape = tuple(b for value in primary + auxiliary for b in bits(value, self.kernel.inputs))
            expected = self.reference(primary, auxiliary, self.kernel)
            result = (bits(expected["selected"], self.kernel.inputs) + bits(expected["counter"], 32)
                      + bits(expected["primary_count"], circuit.count_bits)
                      + bits(expected["auxiliary_count"], circuit.count_bits)
                      + (expected["exhausted"], expected["fallback"]) + tuple(expected["write_flags"]))
            output = tuple(rand.randrange(2) for _ in result)
            state = list(tape + (0,) * (p["output_start"] - len(tape)) + output)
            before = list(state)
            apply_gates(state, gates)
            self.assertEqual(state[:len(tape)], list(tape))
            self.assertEqual(state[len(tape):p["output_start"]], [0] * (p["output_start"] - len(tape)))
            self.assertEqual(tuple(state[p["output_start"]:]), tuple(a ^ b for a, b in zip(result, output)))
            apply_gates(state, reversed(gates))
            self.assertEqual(state, before)

    def test_inactive_auxiliary_tape_has_no_public_effect(self):
        circuit = Schedule(self.kernel, 3)
        fixed = circuit.evaluate([16, 5, 7], [0, 0, 0])
        for aux in itertools.product((0, 7, 16, 31), repeat=3):
            self.assertEqual(circuit.evaluate([16, 5, 7], aux), fixed)
        self.assertEqual(fixed["write_flags"], [1, 1, 0])

    def test_partial_machine_and_full_cap_resource_scope(self):
        value = report(ROOT)
        for row in value["rows"].values():
            self.assertEqual(row["cap"], 1 << 20)
            self.assertEqual(row["count_bits"], 21)
            self.assertEqual(row["random_tape_bits"], 2 * (1 << 20) * 256)
            self.assertEqual(row["predicate_calls_forward"], 2 << 20)
            self.assertEqual(row["predicate_calls_clean_embedding"], 4 << 20)
            self.assertEqual(row["forward_gates"]["base_xor_oracle_calls"], 0)
            self.assertFalse(row["complete_resource_vector"])
            self.assertFalse(row["profile_qualified"])
        self.assertFalse(value["complete_simulator_coverage"])

    def test_missing_final_uncompute_control(self):
        circuit = Schedule(self.kernel, 1)
        p = circuit.wiring()
        state = [0] * p["size"]
        apply_gates(state, tuple(circuit.emit_clean())[:-1])
        self.assertEqual(state[p["active"]], 1)

    def test_schedule_refusal_boundaries(self):
        for cap in (0, -1, True, (1 << 20) + 1):
            with self.subTest(cap=cap), self.assertRaises(ValueError):
                Schedule(self.kernel, cap)
        for p, a in (([0], []), ([True], [0]), ([-1], [0]), ([32], [0])):
            with self.subTest(p=p, a=a), self.assertRaises(ValueError):
                Schedule(self.kernel, 1).evaluate(p, a)
        with self.assertRaises(ValueError):
            Schedule(self.kernel, 33).wiring()

    def test_production_repeat_layout_is_lazy_and_finite(self):
        circuit = Schedule(self.kernel, 1 << 20)
        p = circuit.repeat_layout()
        self.assertNotIn("frames", p)
        self.assertNotIn("outputs", p)
        self.assertEqual(next(circuit.emit_clean()), ("x", p["active"]))
        for phase in ("primary", "auxiliary"):
            for index in (0, 1, (1 << 20) - 1):
                block, inputs, start = circuit.repeat_frame(p, phase, index)
                self.assertEqual(len(inputs), block.inputs)
                self.assertEqual(len(set(inputs)), len(inputs))
                self.assertLess(max(inputs), start)
                self.assertLess(start + block.derived, p["output_start"])


class OpeningTests(unittest.TestCase):
    """Source-ordered geometry, exact canonical output and padding dependencies."""
    @classmethod
    def setUpClass(cls):
        cls.module = load_predicate(ROOT)
        cls.geometry = cls.module.Geometry(2, 3, 0, 1, 7)
        cls.kernel = GeometryKernel(cls.module, cls.geometry)

    def test_all_constant_comparisons(self):
        for width in range(1, 7):
            for constant in range(1 << width):
                b = Builder(width)
                circuit = b.finish((greater_constant(b, tuple(range(width)), constant),))
                for value in range(1 << width):
                    self.assertEqual(circuit.evaluate(bits(value, width)), (int(value > constant),))

    def independent_geometry(self, g, challenge):
        # Ancestor sets rather than the implementation's descending OR fold.
        marked, indices, offset = set(), [], 0
        half = 1 << (g.k - 1)
        for vector, depth in enumerate(g.depths):
            j = (challenge >> offset) & ((1 << depth) - 1)
            offset += depth
            indices.append(j)
            leaf_offset = g.tau * j + vector if j < half else g.tau * half + g.tau1 * (j - half) + vector
            node = g.leaves - 1 + leaf_offset
            while True:
                marked.add(node)
                if node == 0: break
                node = (node - 1) // 2
        frontier = [node for node in range(1, 2 * g.leaves - 1)
                    if node not in marked and (node - 1) // 2 in marked]
        ordered = sorted(frontier, key=lambda node: (node - 1) // 2, reverse=True)
        flags = tuple(int(any((node - 1) // 2 == p for node in ordered))
                      for p in reversed(range(g.leaves - 1)))
        return tuple(int(i in marked) for i in range(2 * g.leaves - 1)), flags, len(ordered), indices

    def test_geometry_all_toy_indices_and_grinding_values(self):
        for tau1 in (0, 1, 2):
            g = self.module.Geometry(2, 3, tau1, 1, 2)
            kernel = GeometryKernel(self.module, g)
            d = (g.leaves - 1).bit_length()
            for value in range(1 << g.challenge_bits):
                marks, flags, count, _ = self.independent_geometry(g, value)
                self.assertEqual(kernel.evaluate(bits(value, g.challenge_bits)),
                                 marks + bits(count, d) + flags)

    def test_geometry_actual_gates_cleanup_and_counts(self):
        k = self.kernel
        inputs = tuple(range(k.inputs))
        outputs = tuple(range(k.inputs, k.inputs + k.outputs))
        work = tuple(range(k.inputs + k.outputs, k.inputs + k.outputs + k.work))
        gates = tuple(k.emit(inputs, outputs, work))
        self.assertEqual(counted(gates), k.cost.as_dict())
        for value in range(1 << k.inputs):
            result = k.evaluate(bits(value, k.inputs))
            initial_output = bits(value % (1 << k.outputs), k.outputs)
            state = list(bits(value, k.inputs) + initial_output + (0,) * k.work)
            before = list(state)
            apply_gates(state, gates)
            self.assertEqual(state[:k.inputs], before[:k.inputs])
            self.assertEqual(tuple(state[k.inputs:k.inputs + k.outputs]),
                             tuple(a ^ b for a, b in zip(initial_output, result)))
            self.assertEqual(state[-k.work:], [0] * k.work)
            apply_gates(state, gates)
            self.assertEqual(state, before)

    def test_complete_opening_circuit_and_clean_output(self):
        opening = Opening(self.kernel)
        block = opening.block()
        gates = tuple(block.emit_clean())
        self.assertEqual(counted(gates), opening.resources()["gates"])
        g, w = self.geometry, self.kernel.inputs
        # Fixed fresh-material tape represented as arbitrary supplied basis bits.
        material = tuple((i * 7 + i // 13) % 2 for i in range(block.inputs - w))
        for value in (0, 3, 9):
            inputs = bits(value, w) + material
            desired = block.evaluate(inputs)
            output = tuple(i % 3 == 1 for i in range(len(desired)))
            output = tuple(int(x) for x in output)
            state = list(inputs + (0,) * (block.derived + block.work) + output)
            apply_gates(state, gates)
            self.assertEqual(state[:block.inputs], list(inputs))
            self.assertEqual(state[block.inputs:block.inputs + block.derived + block.work],
                             [0] * (block.derived + block.work))
            self.assertEqual(tuple(state[-len(desired):]), tuple(a ^ b for a, b in zip(desired, output)))
            self.check_opening_output(g, value, material, desired)

    def check_opening_output(self, g, challenge, material, actual):
        marks, flags, count, hidden = self.independent_geometry(g, challenge)
        commitment_width = 112 * 8 * g.tau
        expected = (material[:commitment_width + 256 * min(count, g.opening_limit)]
                    + (0,) * (256 * max(0, g.opening_limit - count)))
        expected += tuple(b for index in hidden for b in bits(index, 16))
        expected += marks + bits(count, (g.leaves - 1).bit_length()) + flags
        self.assertEqual(actual, expected)

    def test_both_actual_zero_fallback_openings(self):
        for row, expected_count, expected_bytes in (("candidate", 11, 11024), ("comparator", 12, 9664)):
            g = self.module.row(row)
            opening = Opening(GeometryKernel(self.module, g))
            block = opening.block()
            material = (1,) * (block.inputs - g.challenge_bits)
            result = block.evaluate((0,) * g.challenge_bits + material)
            self.check_opening_output(g, 0, material, result)
            commitment_width = 112 * 8 * g.tau
            self.assertEqual(sum(result[commitment_width:8 * expected_bytes]), expected_count * 256)
            self.assertEqual(opening.resources()["canonical_opening_bytes"], expected_bytes)
            self.assertFalse(opening.resources()["heap_key_routing_implemented"])

    def test_unused_key_tape_suffix_has_no_output_effect(self):
        block = Opening(self.kernel).block()
        w = self.kernel.inputs
        count = self.independent_geometry(self.geometry, 0)[2]
        prefix = 112 * 8 * self.geometry.tau + 256 * count
        a = (0,) * block.inputs
        b = (0,) * (w + prefix) + (1,) * (block.inputs - w - prefix)
        self.assertEqual(block.evaluate(a), block.evaluate(b))

    def test_geometry_refuses_aliases(self):
        k = self.kernel
        with self.assertRaises(ValueError):
            tuple(k.emit((0,) * k.inputs, tuple(range(k.inputs, k.inputs + k.outputs)),
                         tuple(range(k.inputs + k.outputs, k.inputs + k.outputs + k.work))))


class CoverageTests(unittest.TestCase):
    """Coverage may refuse source drift but cannot promote unfinished phases."""
    def test_current_report_and_complete_refusal(self):
        root = Path(__file__).resolve().parent
        command = [sys.executable, str(root / "machine.py"), "--root", str(ROOT)]
        environment = dict(os.environ, PYTHONDONTWRITEBYTECODE="1")
        ordinary = subprocess.run(command, capture_output=True, env=environment, check=False)
        refused = subprocess.run(command + ["--require-complete"], capture_output=True, env=environment, check=False)
        self.assertEqual((ordinary.returncode, refused.returncode), (0, 2))
        self.assertEqual(ordinary.stdout, refused.stdout)
        value = json.loads(ordinary.stdout)
        self.assertEqual(value["source_sha256_before"], value["source_sha256_after"])
        self.assertEqual(len(value["source_sha256_before"]), 38)
        self.assertEqual(value["executing_sha256_before"], value["executing_sha256_after"])
        self.assertEqual(value["implemented_pending_review"], ["S0", "B0", "B1", "V0", "V1"])
        self.assertEqual(len(value["unimplemented"]), 7)
        for name in ("complete_simulator_coverage", "complete_resource_vector", "actual_input_entry_bridge",
                     "primitive_advantage_assumed", "independent_cryptographic_review", "profile_qualified",
                     "production_gate_changed"):
            self.assertIs(value[name], False)

    def test_registry_and_source_mutations_refused(self):
        stage = Path(__file__).resolve().parent
        baseline = json.loads((stage / "coverage.json").read_text())
        def qualified(value): value["complete_resource_vector"] = True
        def omitted(value): value["stages"].pop()
        def completed(value): value["stages"][0]["status"] = "implemented_pending_review"
        def future_dependency(value): value["stages"][0]["depends_on"] = ["L0"]
        def drift(value):
            path = next(iter(value["source_sha256"]))
            value["source_sha256"][path] = "0" * 64
            for row in value["stages"]:
                if path in row["source_sha256"]:
                    row["source_sha256"][path] = "0" * 64
        for mutate in (qualified, omitted, completed, future_dependency, drift):
            with self.subTest(mutate=mutate.__name__), tempfile.TemporaryDirectory(dir=stage) as tmp:
                value = json.loads(json.dumps(baseline))
                mutate(value)
                (Path(tmp) / "coverage.json").write_text(json.dumps(value))
                with self.assertRaises(ValueError):
                    machine.verify_coverage(ROOT, Path(tmp))

    def test_execution_path_cannot_be_replaced_by_unloaded_snapshot(self):
        with self.assertRaises(ValueError):
            machine.report(ROOT, Path(__file__).resolve().parent / "elsewhere")


class FrontierRoutingTests(unittest.TestCase):
    """Independent ancestor/frontier order, zero keys, mixed vector sizes."""
    @classmethod
    def setUpClass(cls):
        cls.module = load_predicate(ROOT)

    def test_all_small_equalities(self):
        for width in range(1, 7):
            for constant in range(1 << width):
                b = Builder(width)
                block = b.finish((equal_constant(b, tuple(range(width)), constant),))
                for value in range(1 << width):
                    self.assertEqual(block.evaluate(bits(value, width)), (int(value == constant),))

    def expected(self, g, challenge, slots):
        helper = OpeningTests()
        marks, _, r, _ = helper.independent_geometry(g, challenge)
        # Derive the frontier independently from membership and sort by parent.
        frontier = [v for v in range(1, 2 * g.leaves - 1) if marks[(v - 1) // 2] and not marks[v]]
        frontier.sort(key=lambda v: (v - 1) // 2, reverse=True)
        keys = [0] * (2 * g.leaves - 1)
        for key, v in zip(slots, frontier):
            keys[v] = key
        return marks, keys, r

    def test_all_small_mixed_shapes_and_zero_first_key(self):
        for tau1 in (0, 1, 2):
            g = self.module.Geometry(2, 3, tau1, 1, (2 + tau1) * 4 - 1)
            route = FrontierRouting(g.leaves, g.opening_limit, key_bits=4)
            slots = tuple(i % 16 for i in range(g.opening_limit))
            for challenge in range(1 << sum(g.depths)):
                marks, keys, count = self.expected(g, challenge, slots)
                self.assertEqual(route.evaluate(marks, slots), (keys, count))

    def test_clean_emitter_and_derived_count_with_duplicate_keys(self):
        g = self.module.Geometry(2, 3, 1, 1, 11)
        route = FrontierRouting(g.leaves, g.opening_limit, key_bits=4)
        slots = (0, 7, 7, 0, 13, 2, 3, 5, 8, 1, 1)
        p = route.layout()
        gates = tuple(route.emit_clean())
        self.assertEqual(counted(gates), route.resources()["clean_gates"])
        self.assertEqual(len(tuple(route.output_sources(p))), route.output_bits)
        for challenge in (0, 7, 17, 31):
            marks, keys, count = self.expected(g, challenge, slots)
            inputs = marks + tuple(bit for key in slots for bit in bits(key, route.key_bits))
            wanted = tuple(bit for key in keys for bit in bits(key, route.key_bits)) + bits(count, route.rank_bits)
            outputs = tuple(i % 2 for i in range(len(wanted)))
            state = list(inputs + (0,) * (p["output_start"] - len(inputs)) + outputs)
            before = list(state)
            apply_gates(state, gates)
            self.assertEqual(state[:len(inputs)], list(inputs))
            self.assertEqual(state[len(inputs):p["output_start"]], [0] * (p["output_start"] - len(inputs)))
            self.assertEqual(tuple(state[p["output_start"]:]), tuple(a ^ b for a, b in zip(wanted, outputs)))
            apply_gates(state, reversed(gates))
            self.assertEqual(state, before)

    def test_actual_row_wire_mapping_is_lazy_and_source_ordered(self):
        for row in ("candidate", "comparator"):
            g = self.module.row(row)
            route = FrontierRouting(g.leaves, g.opening_limit)
            p = route.layout()
            self.assertNotIn("frames", p)
            for index in (0, 1, g.leaves // 2, g.leaves - 2):
                inputs, start = route.frame(p, index)
                parent = g.leaves - 2 - index
                self.assertEqual(inputs[route.rank_bits:route.rank_bits + 2],
                                 (2 * parent + 1, 2 * parent + 2))
                self.assertEqual(len(inputs), p["block"].inputs)
                self.assertLess(max(inputs), start)
            self.assertFalse(route.resources()["complete_B1_coverage"])

    def test_out_of_range_rank_is_total_zero_lookup(self):
        route = FrontierRouting(8, 5, key_bits=2)
        b = route.block()
        inputs = bits(7, route.rank_bits) + (0, 1) + tuple(bit for v in (1, 2, 3, 2, 1) for bit in bits(v, 2))
        result = b.evaluate(inputs)
        self.assertEqual(result[route.rank_bits:], (0,) * 4)
        self.assertEqual(unpack(result[:route.rank_bits]), 0)  # Defined modulo-width extension.

    def test_routing_boundaries_refused(self):
        for args in ((3, 1, 4), (8, 0, 4), (8, 8, 4), (8, 2, 0), (8, 2, True)):
            with self.subTest(args=args), self.assertRaises(ValueError):
                FrontierRouting(*args)


