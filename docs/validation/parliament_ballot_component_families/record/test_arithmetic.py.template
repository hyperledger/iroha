def test_reg_interior_x_max_and_endpoint_other_maxima(tables):
    # Independent bounds: both hash block counts and all seven popcounts reach
    # their maxima at this same witness, hence this is an actual maximum.
    assert max(n.bit_count() for n in range(4097)) == 4095 .bit_count() == 12
    assert max(n.bit_count() for n in range(257)) == 255 .bit_count() == 8
    assert (40+4095)//72 == (40+4096)//72
    assert (343+4095+6*255)//72 == (343+4096+6*256)//72
    for row in tables:
        high_x = p1(row,tables[row],'REG',4095,(255,)*6)
        endpoint = p1(row,tables[row],'REG',4096,(256,)*6)
        assert high_x['gates']['x'] == endpoint['gates']['x']+234
        assert high_x['gates']['elementary_gates'] < endpoint['gates']['elementary_gates']
        assert high_x['total_clean_work_bits'] == endpoint['total_clean_work_bits']
    # Worst carries are bounded over the entire allowed coordinates. Even with
    # no block-count growth, CX growth dominates each possible X loss.
    assert min(128+6*((b+1).bit_count()-b.bit_count()) for b in range(4096)) == 62
    assert min(64+4*((c+1).bit_count()-c.bit_count()) for c in range(256)) == 36


def test_nonmonotone_x_control_and_reg_shape_difference(tables):
    for b,c in [(0,0),(3,3),(4,4),(31,255),(4095,255),(4096,256)]:
        actual=p1('candidate',tables['candidate'],'REG',b,(c,)*6)['gates']
        baseline=p1('candidate',tables['candidate'],'REG')['gates']
        variable=reg_variable(b,(c,)*6); zero=reg_variable(0,(0,)*6)
        assert {k:actual[k]-baseline[k] for k in variable} == {k:variable[k]-zero[k] for k in variable}
    assert reg_variable(4,(0,)*6)['x'] == reg_variable(3,(0,)*6)['x']-6
    assert reg_variable(0,(4,0,0,0,0,0))['x'] == reg_variable(0,(3,0,0,0,0,0))['x']-4


@pytest.mark.parametrize('row',['candidate','comparator'])
def test_all_998_vote_scalar_shapes_are_monotone(row,tables):
    previous0=p0(3); previous1=p1(row,tables[row],'VOTE',count=3)
    for n in range(4,1001):
        current0=p0(n); current1=p1(row,tables[row],'VOTE',count=n)
        for previous,current in ((previous0,current0),(previous1,current1)):
            for key in ('x','cx','ccx','elementary_gates','base_xor_oracle_calls'):
                assert previous['gates'][key] <= current['gates'][key]
            assert previous['total_clean_work_bits'] <= current['total_clean_work_bits']
        previous0,previous1=current0,current1


def test_r1_actual_count_only_affine_item_increment():
    from field_kernel import FieldKernel, load_field
    from r1_machine import QuickSilverResponse
    field=load_field(ROOT); mul=FieldKernel(field,'gf256_mul'); short=FieldKernel(field,'gf256_mul_u64')
    left=QuickSilverResponse('vote',3,mul,short).resources()
    right=QuickSilverResponse('vote',4,mul,short).resources()
    for key,delta in R1_PER_ITEM.items():
        assert (right['gates'][key]-left['gates'][key] if key in right['gates'] else
                right[key]-left[key]) == delta
    # 1 full multiply, 1025 field XORs, 1024 bit-controlled field copies.
    assert right['operations']['source-gf256_mul']-left['operations']['source-gf256_mul'] == 1
    assert right['operations']['xor']-left['operations']['xor'] == 1025
    assert right['operations']['select']-left['operations']['select'] == 1024
    assert left['shared_kernel_work_bits']==right['shared_kernel_work_bits']==1023


