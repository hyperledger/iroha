@pytest.mark.parametrize('n', [32, 1000])
def test_r1_affine_count_across_selector_rows(n):
    import json
    from field_kernel import FieldKernel, load_field
    from r1_machine import QuickSilverResponse
    field = load_field(ROOT)
    mul, short = FieldKernel(field,'gf256_mul'), FieldKernel(field,'gf256_mul_u64')
    actual = QuickSilverResponse('vote',n,mul,short).resources()
    observation = json.loads((ROOT/'target/parliament-content-resources-stage/capture/observation.json').read_text())
    case = next(c for c in observation['cases'] if c['row']=='candidate' and c['list_count']==3)
    previous = next(s for s in case['stages'] if s['name']=='R1')
    for key in ('x','cx','ccx','base_xor_oracle_calls','elementary_gates'):
        assert actual['gates'][key] == previous['gates'][key]+(n-3)*R1_PER_ITEM[key]
    assert actual['total_clean_work_bits'] == previous['work']+(n-3)*524800
    assert actual['input_bits'] == previous['inputs']+(n-3)*1024
    assert actual['output_bits']==previous['outputs']==322


def test_sha3_all_reg_and_vote_hash_lengths_vs_frozen_kernel(module):
    from public_hash import Sha3_512_64, Shake256_64
    lengths = set(range(40,4137)) | set(range(343,5976))
    lengths |= {536+128*n for n in range(3,1001)} | {114+128*n for n in range(3,1001)}
    for n in sorted(lengths):
        c = Census(); c.hash(n)
        k = Sha3_512_64(n,module.Keccak1600Kernel())
        assert (c.x,c.cx,c.ccx,c.f)==(k.cost.x,k.cost.cx,k.cost.ccx,k.cost.base_calls)
        assert c.work==k.work and c.history==k.outputs==512
    for n in (1,135,136,137,83704,84304):
        c = Census(); c.hash(n,shake=True)
        k = Shake256_64(n,module.Keccak1600Kernel())
        assert (c.x,c.cx,c.ccx,c.f)==(k.cost.x,k.cost.cx,k.cost.ccx,k.cost.base_calls)
        assert c.work==k.work and c.history==k.outputs==512


def test_p0_p1_and_r1_match_frozen_four_content_cases(tables):
    import json
    observed = json.loads((ROOT/'target/parliament-content-resources-stage/capture/observation.json').read_text())
    first = next(c for c in observed['cases'] if c['row']=='candidate' and c['list_count']==3)
    base = next(s for s in first['stages'] if s['name']=='R1')
    for case in observed['cases']:
        n,row = case['list_count'],case['row']
        for name,expected in [('P0',p0(n)), ('P1',p1(row,tables[row],'VOTE',count=n))]:
            actual = next(s for s in case['stages'] if s['name']==name)
            assert actual['gates']==expected['gates']
            assert actual['work']==expected['total_clean_work_bits']
            assert actual['outputs']==expected['output_bits']
        actual = next(s for s in case['stages'] if s['name']=='R1')
        for key in actual['gates']:
            assert actual['gates'][key]==base['gates'][key]+(n-3)*R1_PER_ITEM[key]
        assert actual['work']==base['work']+(n-3)*R1_PER_ITEM['total_clean_work_bits']


def test_census_records_all_admitted_shapes_and_retains_scope(tmp_path):
    import csv
    import hashlib
    from census import run
    report = run(ROOT,tmp_path)
    raw = (tmp_path/'vote-census.csv').read_bytes()
    rows = list(csv.DictReader(raw.decode().splitlines()))
    assert len(rows)==report['census_rows']==1996
    assert [(r['row'],int(r['list_count'])) for r in rows] == [
        (row,n) for row in ('candidate','comparator') for n in range(3,1001)]
    assert hashlib.sha256(raw).hexdigest()==report['census_sha256']
    for name in ('full_request_family_bound','complete_resource_vector',
                 'full_gate_stream_executed','native_workspace_qualified',
                 'independent_cryptographic_review','profile_qualified','production_gate_changed'):
        assert report[name] is False
    for row in ('candidate','comparator'):
        assert report['reg_p1'][row]['maximum_x_extra_over_endpoint']==234
        assert report['vote_components'][row]['maximum_case']['list_count']==1000
        assert report['vote_components'][row]['count']==998
