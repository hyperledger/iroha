from public_machine import PublicShape, prepare_public, vote_validation, table_bytes
from public_hash import load_public_keccak


@pytest.fixture(scope='module')
def module(): return load_public_keccak(ROOT)


@pytest.fixture(scope='module')
def tables(): return {row: table_bytes(ROOT, row) for row in ('candidate', 'comparator')}


@pytest.mark.parametrize('row,role,body,contexts,count', [
    ('candidate','REG',0,(0,)*6,0),
    ('candidate','REG',3,(3,)*6,0),
    ('candidate','REG',4,(4,)*6,0),
    ('candidate','REG',31,(0,)*6,0),
    ('candidate','REG',32,(0,)*6,0),
    ('candidate','REG',33,(0,)*6,0),
    ('candidate','REG',0,(0,1,3,4,7,1),0),
    ('candidate','REG',0,(0,1,3,4,7,2),0),
    ('candidate','REG',0,(0,1,3,4,7,3),0),
    ('candidate','REG',2345,(0,1,7,128,255,256),0),
    ('candidate','REG',4095,(255,)*6,0),
    ('candidate','REG',4096,(256,)*6,0),
    ('comparator','REG',4096,(256,)*6,0),
    ('candidate','VOTE',0,(0,)*6,3),
    ('candidate','VOTE',0,(0,)*6,1000),
    ('comparator','VOTE',0,(0,)*6,1000),
])
def test_p1_independent_call_tree_vs_actual_builder(module,tables,row,role,body,contexts,count):
    shape = PublicShape(role,row,body,contexts,count)
    actual = prepare_public(shape,module,ROOT).resources()
    expected = p1(row,tables[row],role,body,contexts,count)
    assert {k:actual[k] for k in expected} == expected


