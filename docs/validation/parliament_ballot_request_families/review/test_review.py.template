@pytest.fixture(scope='module')
def catalog(): return e.Catalog(ROOT)


@pytest.mark.parametrize('row,role,body,contexts,count,t,b',[
    ('candidate','REG',37,(0,1,7,63,255,256),0,3,23),
    ('comparator','VOTE',0,(0,)*6,257,7,4096),
])
def test_new_interior_shape_matches_complete_frozen_factory(catalog,row,role,body,contexts,count,t,b):
    from public_machine import PublicShape
    from request_transition import actual_transition
    from content_request import actual_content_request
    from request_family import ContentFamily
    shape=PublicShape(role,row,body,contexts,count)
    if role=='REG':
        model=actual_transition(ROOT,shape,t,length_bits=b)
    else:
        model=ContentFamily(actual_content_request(ROOT,shape,t,length_bits=b))
    actual=model.resources()
    calculated=e.request(catalog,row,role,t,b,body=body,contexts=contexts,count=count)
    assert actual['gates']==calculated['gates']
    for key in ('retained_derived_bits','shared_work_bits','persistent_log_bits',
                'persistent_counter_bits','caller_output_bits','total_logical_bits'):
        assert actual[key]==calculated[key]
    assert actual['original_private_coin_bits']==calculated['original_coin_bits']
    assert actual['original_input_bits']==calculated['original_coin_bits']+calculated['public_input_bits']
    for source,key in (('generator','generator_forward_and_inverse_gates'),
                       ('writes','writes_gates'),('returns','returns_gates')):
        component=actual['components'][source]
        name='forward_and_inverse_gates' if source=='generator' else 'gates'
        assert component[name]==calculated[key]


