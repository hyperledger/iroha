@pytest.mark.parametrize('row',['candidate','comparator'])
def test_all_vote_counts_recomputed_without_using_envelope_csv(catalog,row):
    from public_machine import table_bytes
    table=table_bytes(ROOT,row)
    observed=json.loads((ROOT/e.CONTENT_PATH).read_bytes())
    first=next(c for c in observed['cases'] if (c['row'],c['list_count'])==(row,3))['family_resources']
    zero0=p0(3);zero1=p1(row,table,'VOTE',count=3)
    shared=e.interface(1 << 44,64)
    previous=None
    for n in range(3,1001):
        actual=e.compute(catalog,row,'VOTE',shared,count=n)
        c0=p0(n);c1=p1(row,table,'VOTE',count=n)
        for key in first['gates']:
            delta=c0['gates'][key]-zero0['gates'][key]+c1['gates'][key]-zero1['gates'][key]
            delta+=(n-3)*R1_PER_ITEM[key]
            assert actual['gates'][key]==first['gates'][key]+2*delta
        assert actual['retained_derived_bits']==first['retained_derived_bits']+1024*(n-3)
        assert actual['shared_work_bits']==first['shared_work_bits']
        assert actual['total_logical_bits']==first['total_logical_bits']+2048*(n-3)
        assert actual['caller_output_bits']==first['caller_output_bits']
        if previous is not None:
            assert actual['gates']['elementary_gates']>previous['gates']['elementary_gates']
        previous=actual


@pytest.mark.parametrize('row',['candidate','comparator'])
def test_REG_simultaneous_upper_vector_is_not_exact_elementary_maximum(catalog,row):
    result=e.envelope(catalog,row,'REG',1,23)
    exact=result['maximum_elementary_witness']
    other=result['maximum_x_witness']
    upper=result['coordinatewise_gate_upper_vector']
    assert other['gates']['x']-exact['gates']['x']==468
    assert exact['gates']['cx']-other['gates']['cx']==1024
    assert exact['gates']['elementary_gates']-other['gates']['elementary_gates']==556
    assert exact['total_logical_bits']-other['total_logical_bits']==56
    assert upper['elementary_gates']==exact['gates']['elementary_gates']+468
    assert result['exact_coordinate_maxima']['elementary_gates']==exact['gates']['elementary_gates']
    assert upper['elementary_gates']==upper['x']+upper['cx']+5*upper['ccx']
    assert result['maximum_total_logical_bits']==exact['total_logical_bits']


