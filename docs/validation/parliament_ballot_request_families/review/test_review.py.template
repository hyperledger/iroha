@pytest.mark.parametrize('when',[1,2])
def test_source_change_refused_at_both_accounting_boundaries(catalog,when):
    original=Path.read_bytes;selected=ROOT/e.COMPONENT/'census.json';calls=0
    def changed(path):
        nonlocal calls
        raw=original(path)
        if path==selected:
            calls+=1
            if calls==when:return raw+b'\n'
        return raw
    with patch.object(Path,'read_bytes',changed):
        with pytest.raises(ValueError,match='source drift'):
            e.envelope(catalog,'candidate','REG',1,23)
    assert calls==when


def test_fixed_stage_scratch_dominates_all_variable_and_W_E_widths(catalog):
    for row in ('candidate','comparator'):
        peak=max(s.work for s in dict(catalog.fixed_votes)[row])
        maxcase=e.request(catalog,row,'VOTE',1 << 64,4096,count=1000)
        assert maxcase['generator_clean_work_bits']==peak
        assert maxcase['write_clean_work_bits']<peak and maxcase['return_clean_work_bits']<peak
        for n in range(3,1001):
            assert max(s.work for s in catalog.vote(row,n).stages)<peak
        reg=e.envelope(catalog,row,'REG',1 << 64,4096)['maximum_storage_witness']
        assert dict(catalog.reg_p1)[row].work<reg['generator_clean_work_bits']
        assert reg['write_clean_work_bits']<reg['generator_clean_work_bits']
        assert reg['return_clean_work_bits']<reg['generator_clean_work_bits']


def test_no_entry_adversary_or_native_terms_silently_closed(catalog):
    for role in ('REG','VOTE'):
        result=e.envelope(catalog,'candidate',role,1,23)
        assert result['conditional_full_typed_request_body_family_bound'] is True
        for key in ('full_adaptive_driver_executed','complete_experiment_resource_vector',
                    'complete_resource_vector','input_or_coin_preparation_priced',
                    'primitive_bridge_proved','physical_workspace_bound','current_candidate_qualified',
                    'independent_cryptographic_review','profile_qualified','production_gate_changed'):
            assert result[key] is False
        assert all(v is None for v in result['unknown_external_terms'].values())
        assert result['source_theorem_valid_request_bound'] is None
        assert result['log_capacity_parameter_is_not_an_invalid_request_budget'] is True
