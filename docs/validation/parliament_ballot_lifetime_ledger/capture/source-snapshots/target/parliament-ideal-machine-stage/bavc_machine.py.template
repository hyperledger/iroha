"""B1 work in progress: explicit source-order frontier-key heap routing.

This is the first operation of BAVC reconstruction. Tree expansion, affine
leaf commitments and H0/H1 are still required before B1 is complete. Keys may
be zero or collide; routing uses hidden marks, never key-value sentinels.
"""
from __future__ import annotations

from dataclasses import dataclass

from bit_ir import Builder, Cost, integer, require, bits, unpack


def equal_constant(builder, word, value):
    """Charge each bit comparison and AND; no secret table-address primitive."""
    integer(value, 0, (1 << len(word)) - 1, "equality constant")
    result = builder.bit("one")
    for i, source in enumerate(word):
        agree = source if (value >> i) & 1 else builder.bit("not", source)
        result = builder.bit("and", result, agree)
    return result


def routing_block(slots, rank_bits, key_bits=256):
    """One descending parent: scan every opening slot, route its other child.

    Inputs are rank, left/right hidden marks, and the complete fixed key-slot
    array. Outputs are new rank and both children's initial heap key values.
    These are all fresh SSA outputs, permitting direct repeated-frame wiring.
    """
    integer(slots, 1, 229, "key slots")
    integer(rank_bits, 1, 16, "rank bits")
    integer(key_bits, 1, 256, "key bits")
    require(slots < (1 << rank_bits), "rank width must hold the consumed-slot count")
    width = rank_bits + 2 + slots * key_bits
    b = Builder(width)
    rank = tuple(range(rank_bits))
    left, right = rank_bits, rank_bits + 1
    selected = (b.bit("zero"),) * key_bits
    for slot in range(slots):
        match = equal_constant(b, rank, slot)
        source = rank_bits + 2 + slot * key_bits
        selected = tuple(b.bit("xor", old, b.bit("and", match, source + bit))
                         for bit, old in enumerate(selected))
    frontier = b.bit("xor", left, right)
    to_left = b.bit("and", frontier, b.bit("not", left))
    to_right = b.bit("and", frontier, b.bit("not", right))
    next_rank = b.increment(rank, frontier)
    left_key = tuple(b.bit("and", to_left, v) for v in selected)
    right_key = tuple(b.bit("and", to_right, v) for v in selected)
    return b.finish((*next_rank, *left_key, *right_key))


@dataclass(frozen=True)
class FrontierRouting:
    """Fixed descending parent scan, without storing/looking up secret pointers."""
    leaves: int
    slots: int
    key_bits: int = 256

    def __post_init__(self):
        integer(self.leaves, 4, 61440, "leaves")
        integer(self.slots, 1, min(229, self.leaves - 1), "slots")
        integer(self.key_bits, 1, 256, "key bits")

    @property
    def rank_bits(self):
        """Represent the consumed value slots itself, including complete use."""
        return self.slots.bit_length()

    @property
    def input_bits(self):
        """All marks plus all canonical opening key bits are retained inputs."""
        return 2 * self.leaves - 1 + self.slots * self.key_bits

    @property
    def output_bits(self):
        """All heap node keys including zero root, then final consumed count."""
        return (2 * self.leaves - 1) * self.key_bits + self.rank_bits

    def block(self):
        """Checked repeated transition; same template for every public parent."""
        return routing_block(self.slots, self.rank_bits, self.key_bits)

    def resources(self):
        """Price only initial heap placement; B1 expansion is still unimplemented."""
        block = self.block()
        forward = block.cost.times(self.leaves - 1)
        history = block.derived * (self.leaves - 1)
        initial = self.key_bits + self.rank_bits  # root key and initial rank are zero.
        return dict(forward_gates=forward.as_dict(),
                    clean_gates=(forward.times(2) + Cost(cx=self.output_bits)).as_dict(),
                    input_bits=self.input_bits, output_bits=self.output_bits,
                    initial_zero_state_bits=initial, ssa_history_bits=history,
                    clean_kernel_work_bits=0, total_clean_work_bits=initial + history,
                    exact_for_defined_lazy_emitter=True,
                    requires_source_hidden_marks_and_admissible_frontier=True,
                    zero_or_duplicate_key_values_allowed=True,
                    tree_expansion_implemented=False, leaf_commitment_implemented=False,
                    complete_B1_coverage=False, complete_simulator_coverage=False,
                    complete_resource_vector=False, profile_qualified=False,
                    production_gate_changed=False)

    def layout(self):
        """Closed-form regions and fresh-output invariant for arbitrary repeat count."""
        block = self.block()
        require(all(w >= block.inputs for w in block.outputs), "routing state/output freshness")
        initial_root = tuple(range(self.input_bits, self.input_bits + self.key_bits))
        initial_rank = tuple(range(self.input_bits + self.key_bits,
                                   self.input_bits + self.key_bits + self.rank_bits))
        start = self.input_bits + self.key_bits + self.rank_bits
        output_start = start + (self.leaves - 1) * block.derived
        return dict(block=block, initial_root=initial_root, initial_rank=initial_rank,
                    start=start, output_start=output_start, size=output_start + self.output_bits)

    def frame(self, layout, iteration):
        """Visit source parent L-2-i; both child indices are public constants."""
        integer(iteration, 0, self.leaves - 2, "routing iteration")
        b = layout["block"]
        start = layout["start"] + iteration * b.derived
        parent = self.leaves - 2 - iteration
        if iteration == 0:
            rank = layout["initial_rank"]
        else:
            rank = tuple(start - b.derived + w - b.inputs for w in b.outputs[:self.rank_bits])
        marks = (2 * parent + 1, 2 * parent + 2)
        keys = tuple(range(2 * self.leaves - 1, self.input_bits))
        inputs = rank + marks + keys
        require(len(inputs) == b.inputs and len(set(inputs)) == len(inputs), "routing frame aliases")
        return inputs, start

    def output_sources(self, p):
        """Heap order is independent of the reversed parent computation order."""
        yield from p["initial_root"]
        b = p["block"]
        for node in range(1, 2 * self.leaves - 1):
            parent, child_side = (node - 1) // 2, (node - 1) % 2
            iteration = self.leaves - 2 - parent
            start = p["start"] + iteration * b.derived
            offset = self.rank_bits + child_side * self.key_bits
            for wire in b.outputs[offset:offset + self.key_bits]:
                yield start + wire - b.inputs
        final_start = p["start"] + (self.leaves - 2) * b.derived
        for wire in b.outputs[:self.rank_bits]:
            yield final_start + wire - b.inputs

    def emit_clean(self):
        """General lazy scan, output copy, and reverse scan; zero base queries."""
        p = self.layout()
        b = p["block"]
        def emit_frame(index, inverse):
            inputs, start = self.frame(p, index)
            def wire(local):
                return inputs[local] if local < b.inputs else start + local - b.inputs
            for gate in b.emit(inverse=inverse):
                yield (gate[0], *(wire(w) for w in gate[1:]))
        for index in range(self.leaves - 1):
            yield from emit_frame(index, False)
        for i, source in enumerate(self.output_sources(p)):
            yield ("cx", source, p["output_start"] + i)
        for index in reversed(range(self.leaves - 1)):
            yield from emit_frame(index, True)

    def evaluate(self, marks, key_slots):
        """Finite classical meaning of the checked template loop."""
        require(type(marks) in (tuple, list) and len(marks) == 2 * self.leaves - 1
                and all(type(x) is int and x in (0, 1) for x in marks), "hidden marks")
        require(type(key_slots) in (tuple, list) and len(key_slots) == self.slots, "key slots")
        for key in key_slots:
            integer(key, 0, (1 << self.key_bits) - 1, "key value")
        b, rank = self.block(), (0,) * self.rank_bits
        keys = [0] * (2 * self.leaves - 1)
        key_bits = tuple(bit for key in key_slots for bit in bits(key, self.key_bits))
        for parent in reversed(range(self.leaves - 1)):
            out = b.evaluate(rank + tuple(marks[2 * parent + 1:2 * parent + 3]) + key_bits)
            rank = out[:self.rank_bits]
            keys[2 * parent + 1] = unpack(out[self.rank_bits:self.rank_bits + self.key_bits])
            keys[2 * parent + 2] = unpack(out[self.rank_bits + self.key_bits:])
        return keys, unpack(rank)
