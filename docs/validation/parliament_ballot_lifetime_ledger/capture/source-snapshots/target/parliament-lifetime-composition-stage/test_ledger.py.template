def test_popsum_independent_finite_and_large():
    for n in range(257):
        assert l.popsum(n)==sum(i.bit_count() for i in range(n))
    for n in (1 << 64,(1 << 80)+3471):
        assert l.popsum(n)==periodic_pop_sum(n)


def test_source_drift_load_and_account_before_after(catalog):
    original=l.digest
    with patch.object(l,'digest',lambda p:'0'*64 if str(p).endswith('request_family.py') else original(p)):
        with pytest.raises(ValueError,match='source drift'):l.Catalog(ROOT)
    e=experiment(0,0)
    calls=0
    def changed_after_first_pass(path):
        nonlocal calls
        calls+=1
        return '0'*64 if calls>len(catalog.pins) else original(path)
    with patch.object(l,'digest',changed_after_first_pass):
        with pytest.raises(ValueError,match='source drift'):
            l.account(catalog,e,())


def test_fail_closed_scope(catalog):
