def test_caps_ids_message_envelope(catalog):
    e=experiment(1,1);a=accepted(e)
    with pytest.raises(ValueError,match='request cap'):
        l.account(catalog,e,(a,replace(a,event_id='extra')))
    q=l.Query('q',e.interface,l.MIN_MESSAGE)
    with pytest.raises(ValueError,match='query capacity'):
        l.account(catalog,e,(q,replace(q,event_id='extra')))
    with pytest.raises(ValueError,match='duplicate event'):
        l.account(catalog,e,(q,q))
    with pytest.raises(ValueError,match='length envelope'):
        l.account(catalog,e,(replace(q,message_bytes=l.MIN_MESSAGE+1),))


def test_placement_overlap_size_missing_extra_and_relocation(catalog):
    e=experiment(1);events=(accepted(e),)
    original=l.account(catalog,e,events)
    layout=tuple(l.Allocation(**x) for x in original['ownership']['allocations'])
    moved=tuple(replace(x,start=x.start+123) for x in layout)
    out=l.account(catalog,e,events,moved)
    assert out['ownership']['known_allocated_bits']==original['ownership']['known_allocated_bits']
    assert out['ownership']['address_span_bits']==original['ownership']['address_span_bits']+123
    for bad in (layout[:-1],layout+(l.Allocation('extra',10**100,1),),
                (replace(layout[0],bits=layout[0].bits+1),*layout[1:])):
        with pytest.raises(ValueError,match='membership and widths'):
            l.account(catalog,e,events,bad)
    bad=(layout[0],replace(layout[1],start=0),*layout[2:])
    with pytest.raises(ValueError,match='overlapping'):
        l.account(catalog,e,events,bad)


