@pytest.fixture(scope='module')
def catalog():
    return l.Catalog(ROOT)


def experiment(t=3,q=2,b=64,coins='classical-retained'):
    return l.Experiment(t,q,b,l.MIN_MESSAGE,'one immutable F','agreed complete function',coins)


def accepted(e,row='candidate',role='REG',name='accepted'):
    body,contexts,n=(4096,(256,)*6,0) if role=='REG' else (0,(0,)*6,1000)
    return l.AcceptedRequest(name,e.interface,row,role,body,contexts,n)


def periodic_pop_sum(n):
    return sum((n//(2 << b))*(1 << b)+max(0,n%(2 << b)-(1 << b))
               for b in range(n.bit_length()))


def independent_w(e,row,role):
    # This formula is derived from the three scatter formats and controlled
    # append ladder, without calling the production formula or factory.
    n=e.interface.capacity;d=max(2,n.bit_length());k=e.length_bits+8*215150
    tau,g=(33,704) if row=='candidate' else (22,696)
    ell=35840 if role=='REG' else 53504
    lens=[254+(tau-1)*ell//8+10*g//8,598+ell//8,410]
    sx=[x.bit_count()+sum(v.bit_count() for v in b'PARL/FAEST/v1')+domain.bit_count()
        for x,domain in zip(lens,[9,10,11])]
    cx=[(x-14+v)*8 for x,v in zip(lens,[264,104,32])]
    appx=4*sum(d-(i.bit_count()) for i in range(n)) if n<32 else 4*(d*n-periodic_pop_sum(n))
    x=(l.M+2)*appx+2*(sx[0]+sx[1]+l.M*sx[2])+4+2*periodic_pop_sum(l.M)
    c=(l.M+2)*(n+1)+2*(cx[0]+cx[1]+l.M*cx[2])+2*l.M
    t=(l.M+2)*(n*(4*d-2+k+l.V)+(d-1)**2)
    return l.Gates(x,c,t),1+k+l.V+d+32


def test_catalog_pins_cases_and_immutable(catalog):
    assert len(catalog.pins)==72 and len(catalog.cases)==4
    assert dict(catalog.pins)[l.OBSERVATION]==l.OBSERVATION_SHA
    with pytest.raises(FrozenInstanceError):
        catalog.cases=()
    with pytest.raises(FrozenInstanceError):
        catalog.cases[0].public=0


@pytest.mark.parametrize('row',['candidate','comparator'])
@pytest.mark.parametrize('role',['REG','VOTE'])
def test_original_geometry_reproduces_observation(catalog,row,role):
    raw=json.loads((ROOT/l.OBSERVATION).read_text())
    old=next(x['resources'] for x in raw['source_cases'] if (x['row'],x['role'])==(row,role))
    e=experiment(1 << 44)
    result=l.account(catalog,e,(accepted(e,row,role),))
    assert result['body_gates']==old['gates']
    assert result['ownership']['known_allocated_bits']==old['total_logical_bits']
    item=result['events'][0]
    assert item['public_input_bits']+item['original_coin_bits']==old['original_input_bits']
    assert item['caller_output_bits']==97+8*old['components']['returns']['proof_bytes']
    assert item['return_encoding'].startswith('accepted-only')
    assert item['actual_appends'] is None
    assert result['capacity']['actual_occupancy'] is None


@pytest.mark.parametrize('b',[23,64,4096])
@pytest.mark.parametrize('t',[1,2,1 << 44,1 << 64])
def test_rebase_allocation_and_w_formula(catalog,b,t):
    e=experiment(t,b=b)
    event=accepted(e)
    result=l.account(catalog,e,(event,))
    item=result['events'][0];cost,work=independent_w(e,'candidate','REG')
    assert item['rebased_writes']==dict(gates=cost.report(),clean_work_bits=work,
        counter_bits=e.interface.counter_bits,log_bits=e.interface.log_bits)
    assert item['shared_work_bits']==max(catalog.accepted(event).generator_work,work,1)
    assert result['ownership']['reusable_clean_bits']==item['retained_derived_bits']+item['shared_work_bits']
    alloc=result['ownership']['allocations']; previous=0
    for region in alloc:
        assert region['start']==previous
        previous+=region['bits']
    assert previous==result['ownership']['known_allocated_bits']


@pytest.mark.parametrize('n',[0,1,2,1001,65539,(1 << 32)+1,(1 << 64)-1])
@pytest.mark.parametrize('row',['candidate','comparator'])
def test_rejected_full_width_storage_and_no_log_effect(catalog,n,row):
    e=experiment(1)
    result=l.account(catalog,e,(l.RejectedVote('size-error',e.interface,row,n),))
    item=result['events'][0]
    assert item['public_input_bits']==3608+1024*n
    assert item['caller_output_bits']==253+8*({'candidate':233012,'comparator':158074}[row])
    assert item['gates']==l.Gates(569+2*n.bit_count(),872,888).report()
    assert item['borrowed_list_bits']==1024*n and item['list_bits_read']==0
    assert item['original_coin_bits']==item['actual_appends']==0
    assert result['capacity']['reserved_upper']==0
    assert result['ownership']['reusable_clean_bits']==519


@pytest.mark.parametrize('t',[0,1,1 << 44])
def test_query_cost_full_message_storage(catalog,t):
    e=experiment(t)
    out=l.account(catalog,e,(l.Query('full-query',e.interface,l.MIN_MESSAGE),))
    n=e.interface.capacity;k=e.length_bits+8*l.W
    expected=(l.Gates(4*k*n+4*n+2,4*k*n,n*(4*k+6+l.V)+l.V+2,2)
              if n else l.Gates(ccx=l.V,f=2))
    assert out['body_gates']==expected.report()
    regions={v['name']:v['bits'] for v in out['ownership']['allocations']}
    assert regions['event.full-query.query']==e.length_bits+8*l.MIN_MESSAGE
    assert regions['event.full-query.enable']==1 and regions['event.full-query.response']==l.V
    assert regions['persistent.counter']==e.interface.counter_bits
    assert ('persistent.log' in regions)==bool(n)
    assert out['ownership']['reusable_clean_bits']==(2*n+k+l.V+2 if n else l.V)


def test_mixed_trace_sum_ownership_and_capacity(catalog):
    e=experiment(3,2)
    events=(accepted(e,name='first'),l.Query('q1',e.interface,l.MIN_MESSAGE),
            l.RejectedVote('reject',e.interface,'candidate',2),
            accepted(e,'comparator','VOTE','second'),l.Query('q2',e.interface,l.MIN_MESSAGE))
    result=l.account(catalog,e,events)
    one=[l.account(catalog,e,(event,)) for event in events]
    for key in result['body_gates']:
        assert result['body_gates'][key]==sum(x['body_gates'][key] for x in one)
    assert result['body_gates']['base_xor_oracle_calls']==6200+5960+4
    assert result['capacity']['reserved_upper']==2*(l.M+2)
    assert result['capacity']['slots']==3*(l.M+2)
    assert result['event_counts']==dict(requests=3,queries=2,generating=2)
    assert [x['conservative_log_occupancy_upper'] for x in result['events']]==[
        l.M+2,l.M+2,l.M+2,2*(l.M+2),2*(l.M+2)]
    regions=result['ownership']['allocations']
    assert len([x for x in regions if x['name']=='reusable.clean'])==1
    expected=sum(x['ownership']['known_allocated_bits']-x['ownership']['persistent_log_bits']-
                 x['ownership']['counter_bits']-x['ownership']['reusable_clean_bits'] for x in one)
    expected+=e.interface.log_bits+e.interface.counter_bits+max(x['ownership']['reusable_clean_bits'] for x in one)
    assert result['ownership']['known_allocated_bits']==expected


def test_purification_cost_not_silently_folded(catalog):
    plain=experiment(1); pure=replace(plain,coins='purified-retained')
    a=l.account(catalog,plain,(accepted(plain),));b=l.account(catalog,pure,(accepted(pure),))
    coins=b['events'][0]['original_coin_bits']
    assert a['body_gates']==b['body_gates']
    assert b['ownership']['known_allocated_bits']==a['ownership']['known_allocated_bits']+coins
    assert b['coin_preparation']['hadamard']==b['coin_preparation']['cx']==coins
    assert b['coin_preparation']['requires_clean_coin_and_purifier_inputs']
    assert b['coin_preparation']['executed'] is False
    assert a['coin_preparation']['cost'] is None


