    assert r['unknown_external_terms'] and all(v is None for v in r['unknown_external_terms'].values())
    assert any('entire quantum support' in x for x in r['caller_assertions_not_verified'])


def test_json_cli_normal_refusal_identical_and_invalid(tmp_path):
    e=experiment(0,1)
    value={'experiment':l.asdict(e),'events':[dict(kind='query',event_id='q',interface=l.asdict(e.interface),message_bytes=l.MIN_MESSAGE)]}
    path=tmp_path/'events.json';path.write_text(json.dumps(value))
    cmd=[sys.executable,'-B',str(HERE/'ledger.py'),'--root',str(ROOT),'--events',str(path)]
    env={**os.environ,'PYTHONDONTWRITEBYTECODE':'1'}
    normal=subprocess.run(cmd,env=env,capture_output=True)
    refusal=subprocess.run(cmd+['--require-qualified'],env=env,capture_output=True)
    assert normal.returncode==0 and refusal.returncode==2
    assert normal.stdout==refusal.stdout and not normal.stderr and not refusal.stderr
    value['events'][0]['interface']['oracle']='different';path.write_text(json.dumps(value))
    invalid=subprocess.run(cmd,env=env,capture_output=True)
    assert invalid.returncode==1 and not invalid.stdout and b'mismatch' in invalid.stderr


def test_only_authenticated_observation_bytes_are_parsed():
    original=Path.read_bytes
    def replaced_read(path):
        data=original(path)
        if path==ROOT/l.OBSERVATION:
            value=json.loads(data)
            value['source_cases'][0]['resources']['original_input_bits']+=1
            return json.dumps(value).encode()
        return data
    # A separately queried digest could still claim the expected original file;
    # the constructor must hash its own exact parse buffer.
    with patch.object(Path,'read_bytes',replaced_read), patch.object(l,'digest',lambda p:l.OBSERVATION_SHA):
        with pytest.raises(ValueError,match='observation source drift'):
            l.Catalog(ROOT)


