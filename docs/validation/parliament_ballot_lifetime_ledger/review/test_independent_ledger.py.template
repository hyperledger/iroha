def test_request_and_query_caps_count_rejected_calls_too(catalog):
    ex=experiment(t=1,q=1)
    r=ledger.RejectedVote('r',ex.interface,'candidate',0)
    q=ledger.Query('q',ex.interface,ledger.MIN_MESSAGE)
    with pytest.raises(ValueError,match='request cap'):
        ledger.account(catalog,ex,(r,dataclasses.replace(r,event_id='r2')))
    with pytest.raises(ValueError,match='query capacity'):
        ledger.account(catalog,ex,(q,dataclasses.replace(q,event_id='q2')))
    with pytest.raises(ValueError,match='duplicate event'):
        ledger.account(catalog,ex,(r,r))
    with pytest.raises(ValueError,match='length envelope'):
        ledger.account(catalog,ex,(dataclasses.replace(q,message_bytes=ex.message_bytes+1),))


def test_exact_disjoint_allocation_rejects_alias_missing_and_wrong_width(catalog):
    ex=experiment(t=1,q=0);ev=(ledger.RejectedVote('r',ex.interface,'candidate',0),)
    out=ledger.account(catalog,ex,ev)
    p=tuple(ledger.Allocation(**a) for a in out['ownership']['allocations'])
    shifted=tuple(dataclasses.replace(a,start=a.start+73) for a in p)
    moved=ledger.account(catalog,ex,ev,shifted)
    assert moved['body_gates']==out['body_gates']
    assert moved['ownership']['known_allocated_bits']==out['ownership']['known_allocated_bits']
    assert moved['ownership']['address_span_bits']==out['ownership']['address_span_bits']+73
    with pytest.raises(ValueError,match='overlapping'):
        ledger.account(catalog,ex,ev,(p[0],dataclasses.replace(p[1],start=0),*p[2:]))
    for bad in (p[:-1],(dataclasses.replace(p[0],bits=p[0].bits+1),*p[1:]),(*p[:-1],p[0])):
        with pytest.raises(ValueError,match='membership'):
            ledger.account(catalog,ex,ev,bad)


