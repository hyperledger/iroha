def test_before_and_after_source_verification_refuses_drift(catalog,monkeypatch):
    original=ledger.digest
    watched=catalog.root/catalog.pins[0][0]
    seen=0
    def changing(path):
        nonlocal seen
        if Path(path)==watched:
            seen+=1
            if seen==2:
                return '0'*64
        return original(path)
    monkeypatch.setattr(ledger,'digest',changing)
    with pytest.raises(ValueError,match='source drift'):
        ledger.account(catalog,experiment(t=0,q=0),())
    assert seen==2


