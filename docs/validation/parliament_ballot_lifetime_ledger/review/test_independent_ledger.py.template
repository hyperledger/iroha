def accepted(cat,ex,row='candidate',role='REG',name='a'):
    case=next(c for c in cat.cases if (c.row,c.role)==(row,role))
    return ledger.AcceptedRequest(name,ex.interface,row,role,*case.shape)


def popsum_reference(n):
    # Independently sum each binary column over complete and partial periods.
    answer=0
    for bit in range(n.bit_length()):
        half=1<<bit; period=half<<1
        answer+=(n//period)*half+max(0,n%period-half)
    return answer


@pytest.mark.parametrize('n',[0,1,2,3,4,7,8,31,32,33,255,256,257,(1<<64)+23])
def test_population_sum_by_independent_columns(n):
    assert ledger.popsum(n)==popsum_reference(n)
    if n<300:
        assert ledger.popsum(n)==sum(i.bit_count() for i in range(n))


@pytest.mark.parametrize('row,role',[('candidate','REG'),('candidate','VOTE'),('comparator','REG'),('comparator','VOTE')])
@pytest.mark.parametrize('t,b',[(1,23),(2,64),(1<<44,4096),(1<<64,64)])
def test_rebased_w_matches_frozen_component_and_independent_append(row,role,t,b):
    ex=experiment(t=t,b=b);i=ex.interface
    w=ProgrammedWrites(actual_frames(ROOT,row,'registration' if role=='REG' else 'vote'),
                       1<<20,i.capacity,b,215150)
    result,work=ledger.write_resources(i,row,role)
    assert result.report()==w.resources()['gates']
    assert work==w.resources()['clean_work_bits']
    a=w.append();n=i.capacity;d=max(2,n.bit_length());q=b+8*215150+2112
    raw=a.resources()['gates']
    assert (raw['x'],raw['cx'],raw['ccx'])==(4*(d*n-popsum_reference(n)),n+1,
            n*(4*d-2+q)+(d-1)**2)
    assert i.log_bits==n*(1+q)==w.layout()['log_bits']
    assert i.counter_bits==d==a.counter_bits
    assert work==1+q+d+32
    assert result.f==0


@pytest.mark.parametrize('t,b',[(0,23),(1,64),(7,4096),(1<<64,64)])
def test_lookup_exact_frozen_component_and_no_duplicate_counter(t,b):
    ex=experiment(t=t,b=b);i=ex.interface
    old=OverlayLookup(i.capacity,b,215150,ex.message_bytes)
    count,work=ledger.query_resources(i)
    assert count.report()==old.resources()['gates']
    assert work==old.resources()['clean_work_bits']
    assert count.f==2
    assert old.resources()['append_counter_bits_excluded'] is True


def test_catalog_authenticates_exact_selected_case_inventory(catalog):
    raw=json.loads((ROOT/ledger.OBSERVATION).read_text())
    assert len(catalog.pins)==72
    assert len(catalog.cases)==4
    for c in catalog.cases:
        original=next(x['resources'] for x in raw['source_cases'] if (x['row'],x['role'])==(c.row,c.role))
        assert c.public+c.coins==original['original_input_bits']
        assert c.output==original['caller_output_bits']
        proof={('candidate','REG'):160148,('candidate','VOTE'):233012,
               ('comparator','REG'):109498,('comparator','VOTE'):158074}[c.row,c.role]
        assert c.output==97+8*proof
        tau,g,opening=(33,704,229) if c.row=='candidate' else (22,696,225)
        ell=35840 if c.role=='REG' else 53504
        assert c.coins==512*(1<<20)+256*opening+896*tau+tau*ell+10*g+736*8
        assert c.generator.f==(6200 if c.row=='candidate' else 5960)


def test_mixed_trace_counts_actual_source_parts_and_once_only_storage(catalog):
    ex=experiment()
    a=accepted(catalog,ex)
    r=ledger.RejectedVote('r',ex.interface,'comparator',(1<<63)+3)
    q=ledger.Query('q',ex.interface,ledger.MIN_MESSAGE)
    out=ledger.account(catalog,ex,(a,q,r))
    c=catalog.accepted(a);w,ww=ledger.write_resources(ex.interface,a.row,a.role)
    lc,lw=ledger.query_resources(ex.interface)
    rejected=RejectedVoteFamily(r.list_count,158074).resources()
    expected=c.generator+w+c.returns+lc+ledger.Gates.from_report(rejected['gates'])
    assert out['body_gates']==expected.report()
    allocations={x['name']:x for x in out['ownership']['allocations']}
    assert allocations['event.a.public']['bits']==c.public
    assert allocations['event.a.coins']['bits']==c.coins
    assert allocations['event.a.output']['bits']==c.output
    assert allocations['event.r.public']['bits']==3608+1024*r.list_count
    assert allocations['event.r.output']['bits']==253+158074*8
    assert 'event.r.coins' not in allocations
    assert allocations['event.q.query']['bits']==ex.length_bits+8*q.message_bytes
    assert allocations['event.q.response']['bits']==2112
    assert allocations['event.q.enable']['bits']==1
    assert set(k for k in allocations if k.startswith('persistent.'))=={'persistent.log','persistent.counter'}
    work=max(c.retained+max(c.generator_work,ww,1),lw,519)
    assert allocations['reusable.clean']['bits']==work
    assert out['ownership']['known_allocated_bits']==sum(x['bits'] for x in allocations.values())
    assert out['capacity']['reserved_upper']==(1<<20)+2
    assert out['capacity']['actual_occupancy'] is None
    assert [x['conservative_log_occupancy_upper'] for x in out['events']]==[(1<<20)+2]*3
    assert out['events'][2]['actual_appends']==0
    assert out['events'][0]['actual_appends'] is None


