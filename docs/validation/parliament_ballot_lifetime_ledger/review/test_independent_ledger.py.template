def test_selected_helper_drift_refuses_catalog(tmp_path,catalog):
    for name,_ in catalog.pins:
        dst=tmp_path/name;dst.parent.mkdir(parents=True,exist_ok=True)
        if name.endswith('/request_family.py'):
            dst.write_bytes((ROOT/name).read_bytes()+b'\n# changed bytes\n')
        else:
            dst.symlink_to(ROOT/name)
    with pytest.raises(ValueError,match='source drift'):
        ledger.Catalog(tmp_path)


def test_cli_normal_and_qualification_refusal_identical_report(tmp_path):
    import os
    import subprocess
    value={'experiment':dataclasses.asdict(experiment(t=0,q=0)),'events':[]}
    path=tmp_path/'trace.json';path.write_text(json.dumps(value))
    cmd=[sys.executable,str(STAGE/'ledger.py'),'--root',str(ROOT),'--events',str(path)]
    env=dict(os.environ,PYTHONDONTWRITEBYTECODE='1')
    ordinary=subprocess.run(cmd,capture_output=True,text=True,env=env,check=False)
    refused=subprocess.run([*cmd,'--require-qualified'],capture_output=True,text=True,env=env,check=False)
    assert ordinary.returncode==0 and refused.returncode==2
    assert not ordinary.stderr and not refused.stderr
    assert ordinary.stdout==refused.stdout
    report=json.loads(ordinary.stdout)
    assert report['complete_resource_vector'] is False
    value['events']=[{'kind':'unpriced_content_p0'}]
    path.write_text(json.dumps(value))
    unknown=subprocess.run(cmd,capture_output=True,text=True,env=env,check=False)
    assert unknown.returncode==1 and not unknown.stdout
