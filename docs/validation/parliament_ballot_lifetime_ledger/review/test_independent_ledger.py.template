def test_purification_adds_one_purifier_and_separate_h_cx_per_coin(catalog):
    normal=experiment(t=1,q=0)
    purified=dataclasses.replace(normal,coins='purified-retained')
    a=accepted(catalog,normal)
    x=ledger.account(catalog,normal,(a,));y=ledger.account(catalog,purified,(a,))
    n=catalog.accepted(a).coins
    assert x['body_gates']==y['body_gates']
    assert y['ownership']['known_allocated_bits']-x['ownership']['known_allocated_bits']==n
    assert y['coin_preparation']==dict(model='canonical retained purification',hadamard=n,cx=n,
                                       additional_to_body=True,executed=False,requires_clean_coin_and_purifier_inputs=True)


