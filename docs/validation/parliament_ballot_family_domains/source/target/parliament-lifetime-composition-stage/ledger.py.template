M = 1 << 20
W = 215150
V = 2112
MIN_MESSAGE = 6882996
OBSERVATION = 'target/parliament-ideal-machine-stage/request-accepted-observation.json'
OBSERVATION_SHA = '81ffb1db693c94f73f41239da3cd8164893d9c84ddd805d873ec3ede974f4f4c'
EXTRA_PINS = {
    'target/parliament-ideal-machine-stage/request_family.py': '26a91d48a98a538de02b5d38d7875ef224fac1bbffc78bfa7b41155897f34041',
    'target/parliament-ideal-machine-stage/request_dispatch.py': '94729ac8325800e40dbbe2011ff7c1fbf39937dd128960ade269ccfac7e927bb',
    'target/parliament-ideal-machine-stage/l0_machine.py': 'e10d3d6b49e778c9abdde8655188513d0dddf910da73e095ff19da6ddd0fba23',
