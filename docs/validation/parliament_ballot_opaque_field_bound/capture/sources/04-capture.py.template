"""Retain staged Python checks only; never execute a worker or replace evidence."""
import argparse
import datetime
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys
import time
import xml.etree.ElementTree as ET

ROOT = Path.cwd().resolve()
STAGE = ROOT / "target/parliament-opaque-field-bound-stage"
OUT = STAGE / "capture"
HELPER = STAGE / "scripts/parliament_ballot_opaque_field_bound.py"
TEST = STAGE / "scripts/tests/parliament_ballot_opaque_field_bound_test.py"
README = STAGE / "README.md"
PYTEST = Path("/opt/homebrew/bin/pytest")


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def save(name, value):
    with (OUT / name).open("x") as stream:
        stream.write(json.dumps(value, indent=2, sort_keys=True) + "\n")


parser = argparse.ArgumentParser(description=__doc__)
for name in ("helper", "test", "readme"):
    parser.add_argument("--" + name + "-sha", required=True)
parser.add_argument("--expected-test-cases", type=int, required=True)
args = parser.parse_args()
if args.expected_test_cases <= 0:
    parser.error("expected testcase count must be positive")
if OUT.exists():
    raise RuntimeError("refuse existing capture directory")
for path, expected in ((HELPER, args.helper_sha), (TEST, args.test_sha), (README, args.readme_sha)):
    if sha(path) != expected:
        raise RuntimeError("reviewed staged source differs: " + str(path))
paths = [HELPER, TEST, README, ROOT / "pytest.ini", Path(__file__).resolve()]
conftests = [p / "conftest.py" for p in TEST.parent.parents if p == ROOT or p.is_relative_to(ROOT)]
conftests.append(TEST.parent / "conftest.py")
paths += [p for p in conftests if p.is_file()]
absent = [str(p) for p in conftests if not p.exists()]
before = {str(p): sha(p) for p in paths}
runtime_paths = [PYTEST, Path(PYTEST.read_text().splitlines()[0][2:]).resolve(), Path(sys.executable).resolve()]
runtime = {str(p): sha(p) for p in runtime_paths}
OUT.mkdir()
(OUT / "sources").mkdir()
for index, path in enumerate(paths):
    data = path.read_bytes()
    if hashlib.sha256(data).hexdigest() != before[str(path)]:
        raise RuntimeError("source changed during snapshot")
    (OUT / "sources" / f"{index:02}-{path.name}.template").write_bytes(data)
env = dict(os.environ, PYTHONDONTWRITEBYTECODE="1", PYTEST_DISABLE_PLUGIN_AUTOLOAD="1",
           PYTEST_ADDOPTS="", PYTEST_PLUGINS="", PYTHONPATH="")
commands = [
    ("tests", [str(PYTEST), "-c", str(ROOT / "pytest.ini"), "-o", "addopts=",
               "--confcutdir=" + str(ROOT), "--import-mode=importlib", "-p", "no:cacheprovider",
               "--maxfail=0", "--tb=short", "--basetemp=" + str(OUT / "pytest-tmp"),
               "-q", str(TEST), "--junitxml=" + str(OUT / "tests.xml")], 0),
    ("analysis", [sys.executable, "-B", str(HELPER), "--root", str(ROOT), "--out", str(OUT / "analysis.json")], 0),
    ("require-qualified", [sys.executable, "-B", str(HELPER), "--root", str(ROOT), "--out", str(OUT / "refusal.json"), "--require-qualified"], 2),
]
records, error = [], None
try:
    for name, command, expected in commands:
        started = time.monotonic()
        with (OUT / (name + ".stdout.txt")).open("x") as stdout, (OUT / (name + ".stderr.txt")).open("x") as stderr:
            result = subprocess.run(command, cwd=ROOT, env=env, stdout=stdout, stderr=stderr)
        after = {p: sha(Path(p)) for p in before}
        record = dict(name=name, command=command, exit_code=result.returncode, expected_exit_code=expected,
                      seconds=time.monotonic() - started, source_after=after)
        records.append(record)
        save(name + ".command.json", record)
        if after != before or any(Path(p).exists() for p in absent):
            raise RuntimeError("source/config drift; actual command outputs retained")
        if result.returncode != expected:
            raise RuntimeError("unexpected exit; actual command outputs retained")
    cases = list(ET.parse(OUT / "tests.xml").getroot().iter("testcase"))
    if len(cases) != args.expected_test_cases or any(c.find(tag) is not None for c in cases for tag in ("failure", "error", "skipped")):
        raise RuntimeError("JUnit does not establish all focused cases passing")
    if (OUT / "analysis.json").read_bytes() != (OUT / "refusal.json").read_bytes():
        raise RuntimeError("qualification refusal changed report")
    report = json.loads((OUT / "analysis.json").read_text())
    if report["verdict"] != "PASS_UNDER_STATED_PREMISES" or report["input_sha256"] != report["input_after_sha256"]:
        raise RuntimeError("conditional report failed or drifted")
    for key in ("applies_to_current_checkout", "complete_constructor_cost_certificate", "complete_native_cost_certificate",
                "complete_workspace_certificate", "physical_cost_calibrated", "profile_qualified", "production_gate_changed"):
        if report[key] is not False:
            raise RuntimeError("unexpected scope promotion")
except Exception as exc:
    error = f"{type(exc).__name__}: {exc}"
after = {p: sha(Path(p)) if Path(p).is_file() else None for p in before}
runtime_after = {p: sha(Path(p)) if Path(p).is_file() else None for p in runtime}
if after != before or runtime_after != runtime or any(Path(p).exists() for p in absent):
    error = error or "late source/runtime/config drift"
outputs = {str(p.relative_to(OUT)): sha(p) for p in sorted(OUT.rglob("*")) if p.is_file()}
receipt = dict(schema="parliament-opaque-field-stage-capture-v1", status="PASS" if error is None else "FAIL",
               error=error, recorded_at_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),
               source_before=before, source_after=after, absent_conftests=absent,
               runtime_before=runtime, runtime_after=runtime_after, capture_python_version=sys.version,
               command_line=sys.argv, commands=records, output_sha256=outputs,
               expected_test_cases=args.expected_test_cases,
               environment_overrides={k: env[k] for k in ("PYTHONDONTWRITEBYTECODE", "PYTEST_DISABLE_PLUGIN_AUTOLOAD", "PYTEST_ADDOPTS", "PYTEST_PLUGINS", "PYTHONPATH")},
               scope="Ignored staged checker/tests, conditional retained-image analysis. Report guards original evidence without duplicating its 2000-plus inputs. Non-atomic observation, interpreter/pytest dependencies, cache coherence and unobserved child reads remain trusted; no Rust build or worker execution.",
               applies_to_current_checkout=False, complete_workspace_certificate=False, profile_qualified=False,
               production_gate_changed=False)
save("receipt.json", receipt)
with (OUT / "SHA256SUMS").open("x") as stream:
    for path in sorted(p for p in OUT.rglob("*") if p.is_file() and p.name != "SHA256SUMS"):
        stream.write(sha(path) + "  " + str(path.relative_to(ROOT)) + "\n")
print(json.dumps({"status": receipt["status"], "error": error, "receipt_sha256": sha(OUT / "receipt.json"),
                  "manifest_sha256": sha(OUT / "SHA256SUMS")}))
if error is not None:
    raise SystemExit(1)
