#!/usr/bin/env python3
"""Record focused checks and the independent current Core blocker; no qualification."""
import datetime
import hashlib
import json
from pathlib import Path
import re
import subprocess
import time

root = Path.cwd()
out = root / "docs/validation/parliament_ballot_fatal_control"
def sha(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()
paths = ["scripts/check_parliament_ballot_memory_entry.py", "scripts/prepare_parliament_ballot_memory_entry.py", "scripts/parliament_ballot_memory_supervisor.py", "scripts/check_parliament_ballot_zero_challenge.py", "scripts/check_parliament_ballot_resource_contract.py", "scripts/formal/check_sora_parliament_source_contract.py", "scripts/check_no_legacy_codec.sh", "crates/iroha_core/src/queue.rs", "crates/iroha_core/src/state.rs", "crates/iroha_core/src/smartcontracts/isi/sccp/parliament_iface.rs", "crates/iroha_core/Cargo.toml", "crates/iroha_torii/Cargo.toml", "crates/iroha_parliament_ballot_proof/examples/memory_entry/driver.rs", "crates/iroha_parliament_ballot_proof/examples/memory_entry/staging.rs", "crates/iroha_parliament_ballot_proof/examples/memory_entry/fatal.rs"]
tests = ["scripts/tests/parliament_ballot_memory_prepare_test.py", "scripts/tests/parliament_ballot_memory_entry_test.py", "scripts/tests/parliament_ballot_memory_supervisor_test.py", "scripts/tests/parliament_ballot_zero_challenge_test.py"]
paths += tests
before = {p: sha(root / p) for p in paths}
commands = [
    ("fatal-control-tests", [str(root / ".venv/bin/python"), "-m", "pytest", "-q", *tests]),
    ("fatal-control-format", ["rustfmt", "--edition", "2024", "--check", "--config", "skip_children=true", *[p for p in paths if "/memory_entry/" in p and p.endswith(".rs")]]),
    ("fatal-control-codec", ["bash", "scripts/check_no_legacy_codec.sh"]),
    ("fatal-control-source-contract", [str(root / ".venv/bin/python"), "scripts/formal/check_sora_parliament_source_contract.py"]),
]
rows=[]
for label, command in commands:
    log=out / (label + ".txt")
    if log.exists(): raise SystemExit("refuse overwriting check evidence")
    start=time.monotonic()
    result=subprocess.run(command, cwd=root, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    log.write_text(result.stdout)
    rows.append({"label":label,"command":command,"exit":result.returncode,"elapsed_seconds":time.monotonic()-start,"log":str(log.relative_to(root)),"log_sha256":sha(log)})
    print(json.dumps(rows[-1]), flush=True)
after={p:sha(root / p) for p in paths}
gate=(root / "crates/iroha_core/src/smartcontracts/isi/sccp/parliament_iface.rs").read_text()
false_gate=bool(re.search(r"fn parliament_binding_ballot_available\(\) -> bool \{\s*false\s*\}",gate))
none_latency=bool(re.search(r"fn parliament_sccp_attempt_latency_ms\(\) -> Option<u64> \{\s*None\s*\}",gate))
no_deps=all(not re.search(r"iroha_(parliament_ballot_proof|zkp_vole)",(root/p).read_text()) for p in ("crates/iroha_core/Cargo.toml","crates/iroha_torii/Cargo.toml"))
report={"schema":"parliament-fatal-control-checks-v1","observed_at_utc":datetime.datetime.now(datetime.timezone.utc).isoformat(),"commands":rows,"source_before":before,"source_after":after,"source_changes":{p:{"before":v,"after":after[p]} for p,v in before.items() if after[p]!=v},"scope":"Focused helper, source gate and touched-source checks; Core failure is retained separately. This is not a complete workspace run.","binding_ballot_available":False if false_gate else "UNKNOWN","qualified_attempt_latency_ms":None if none_latency else "UNKNOWN","no_experimental_core_torii_dependencies":no_deps,"complete_workspace_suite_run":False,"complete_workspace_certificate":False,"profile_qualified":False}
(out / "fatal-control-checks.json").write_text(json.dumps(report,indent=2,sort_keys=True)+"\n")
