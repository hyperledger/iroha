//! One-invocation native worker and allocator routing. Allocation failure exits
//! this diagnostic process with an explicit status; it is never proof rejection.

use std::{
    alloc::{GlobalAlloc, Layout, System},
    ptr,
    sync::atomic::{AtomicBool, AtomicPtr, Ordering},
};

use iroha_parliament_ballot_proof::{
    profile::{Role, Row},
    proving::{StatementError, VerifyError},
    test_codec::TestCodecError,
};
use norito::json::JsonSerialize;

use super::{
    arena::{Arena, HEAP_BYTES},
    budget::{Budget, VerificationError},
    native,
};

static ARENA: AtomicPtr<Arena> = AtomicPtr::new(ptr::null_mut());
static INVOKED: AtomicBool = AtomicBool::new(false);
static ACTIVE: AtomicBool = AtomicBool::new(false);

struct Routed;

// SAFETY: while armed, every default allocation is served by the fixed arena.
// Deallocation dispatches by pointer provenance, including after disarming.
// Before/after the single joined worker, ordinary runtime allocation uses System.
unsafe impl GlobalAlloc for Routed {
    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
        if ACTIVE.load(Ordering::Acquire) {
            let arena = ARENA.load(Ordering::Acquire);
            if arena.is_null() {
                unsafe { libc::_exit(74) };
            }
            let pointer = unsafe { &*arena }.allocate(layout);
            if pointer.is_null() {
                exhausted();
            }
            pointer
        } else {
            unsafe { System.alloc(layout) }
        }
    }

    unsafe fn dealloc(&self, pointer: *mut u8, layout: Layout) {
        let arena = ARENA.load(Ordering::Acquire);
        if !arena.is_null() && unsafe { &*arena }.contains(pointer) {
            unsafe { (&*arena).release(pointer, layout) };
        } else {
            unsafe { System.dealloc(pointer, layout) };
        }
    }
}

#[global_allocator]
static ALLOCATOR: Routed = Routed;

fn exhausted() -> ! {
    super::fatal::exhausted()
}

#[derive(Clone, Copy)]
pub struct Options<'a> {
    pub row: Row,
    pub role: Role,
    /// Immutable caller bytes retained until the synchronous worker join.
    pub record: &'a [u8],
    pub heap_limit: usize,
    pub units: u64,
    pub input_bytes: u64,
}

#[derive(Clone, Copy)]
struct ResultState {
    outcome: &'static str,
    stage: &'static str,
    exit: i32,
    charged_units: u64,
    charged_bytes: u64,
}

impl ResultState {
    const fn failure(outcome: &'static str, stage: &'static str, exit: i32) -> Self {
        Self {
            outcome,
            stage,
            exit,
            charged_units: 0,
            charged_bytes: 0,
        }
    }
}

struct Request {
    // Derived from the same borrowed slice in run; never supplied separately.
    record: *const u8,
    record_length: usize,
    row: Row,
    role: Role,
    units: u64,
    input_bytes: u64,
    stack: *mut u8,
    result: ResultState,
}

#[derive(Debug, JsonSerialize)]
// These independent public evidence flags are deliberately separate from the
// feature identity and cannot be collapsed into one qualification verdict.
#[allow(clippy::struct_excessive_bools)]
pub struct Report {
    pub accelerated: bool,
    pub outcome: &'static str,
    pub verifier_stage: &'static str,
    pub charged_units: u64,
    pub charged_bytes: u64,
    pub heap_reserved_bytes: usize,
    pub metadata_reserved_bytes: usize,
    pub stack_usable_bytes: usize,
    pub guard_bytes: usize,
    pub control_reserved_bytes: usize,
    pub workspace_reserved_bytes: usize,
    pub fatal_control_reserved_bytes: usize,
    pub heap_limit_bytes: usize,
    pub arena_peak_block_bytes: usize,
    pub arena_peak_requested_bytes: usize,
    pub arena_live_exit_block_bytes: usize,
    pub arena_live_exit_requested_bytes: usize,
    pub arena_allocations: usize,
    pub arena_enforced: bool,
    pub complete_workspace_certificate: bool,
    pub profile_qualified: bool,
}

pub fn run(options: Options<'_>) -> Result<(Report, i32), native::NativeError> {
    if INVOKED
        .compare_exchange(false, true, Ordering::AcqRel, Ordering::Acquire)
        .is_err()
    {
        return Err(native::NativeError("repeated_invocation", 0));
    }
    if options.heap_limit > HEAP_BYTES {
        return Err(native::NativeError("options_bounds", 0));
    }
    if std::mem::size_of::<Arena>() > 4096
        || std::mem::size_of::<Request>() > native::CONTROL_BYTES - 4096
    {
        return Err(native::NativeError("control_layout", 0));
    }
    let fatal_control_reserved_bytes = super::fatal::reserved_bytes()
        .map_err(|error| native::NativeError(error.0, error.1))?;
    let mapping = native::Mapping::new(options.heap_limit)?;
    let workspace_reserved_bytes = mapping.length().checked_add(fatal_control_reserved_bytes)
        .filter(|bytes| *bytes <= native::WORKSPACE_LIMIT)
        .ok_or(native::NativeError("workspace_with_fatal_control", 0))?;
    // mmap is page aligned and control starts at a 4096-byte aligned offset.
    #[allow(clippy::cast_ptr_alignment)]
    let request = mapping.control().cast::<Request>();
    // SAFETY: the fixed control partition is aligned and large enough for
    // Request. Its read-only pointer is derived from options.record; that
    // borrow remains valid until run returns after joining any started worker.
    unsafe {
        request.write(Request {
            record: options.record.as_ptr(),
            record_length: options.record.len(),
            row: options.row,
            role: options.role,
            units: options.units,
            input_bytes: options.input_bytes,
            stack: mapping.stack(),
            result: ResultState::failure("worker_error", "not_started", 4),
        });
    }
    if ARENA
        .compare_exchange(
            ptr::null_mut(),
            mapping.arena(),
            Ordering::AcqRel,
            Ordering::Acquire,
        )
        .is_err()
    {
        return Err(native::NativeError("concurrent_invocation", 0));
    }
    // SAFETY: callback cannot unwind (C ABI aborts); request and stack remain
    // valid through join, and nothing returned owns an arena allocation.
    let joined = unsafe { mapping.run(worker, request.cast()) };
    ACTIVE.store(false, Ordering::Release);
    let stats = unsafe { &*mapping.arena() }.stats();
    if stats.live_blocks != 0 || stats.live_requested != 0 {
        // Retaining an arena allocation across unmapping would be unsound.
        unsafe { libc::_exit(74) };
    }
    let guard_bytes = mapping.guard_bytes();
    // This is a one-invocation process. Retain the published mapping until the
    // OS reclaims it at exit: a concurrent GlobalAlloc caller may already have
    // loaded ARENA, so clearing it and unmapping would require hazard-pointer
    // synchronization. Retention also makes subsequent run() attempts refuse.
    std::mem::forget(mapping);
    joined?;
    let result = unsafe { (*request).result };
    Ok((
        Report {
            accelerated: cfg!(feature = "accel"),
            outcome: result.outcome,
            verifier_stage: result.stage,
            charged_units: result.charged_units,
            charged_bytes: result.charged_bytes,
            heap_reserved_bytes: HEAP_BYTES,
            metadata_reserved_bytes: native::METADATA_BYTES,
            stack_usable_bytes: native::STACK_BYTES,
            guard_bytes,
            control_reserved_bytes: native::CONTROL_BYTES,
            workspace_reserved_bytes,
            fatal_control_reserved_bytes,
            heap_limit_bytes: options.heap_limit,
            arena_peak_block_bytes: stats.peak_blocks,
            arena_peak_requested_bytes: stats.peak_requested,
            arena_live_exit_block_bytes: stats.live_blocks,
            arena_live_exit_requested_bytes: stats.live_requested,
            arena_allocations: stats.allocations,
            arena_enforced: true,
            complete_workspace_certificate: false,
            profile_qualified: false,
        },
        result.exit,
    ))
}

extern "C" fn worker(argument: *mut libc::c_void) -> *mut libc::c_void {
    // SAFETY: run supplies an exclusive Request in the retained control region.
    let request = unsafe { &mut *argument.cast::<Request>() };
    let stack_matches = native::current_stack()
        .is_ok_and(|(base, size)| base == request.stack && size == native::STACK_BYTES);
    if !stack_matches {
        request.result = ResultState::failure("worker_error", "native_stack_mismatch", 4);
        return ptr::null_mut();
    }
    request.result = execute(request);
    // All record/statement/verifier/error ownership has ended in execute.
    ACTIVE.store(false, Ordering::Release);
    ptr::null_mut()
}

fn execute(request: &Request) -> ResultState {
    let length = request.record_length;
    let mut budget = Budget::new(request.units, request.input_bytes);
    let Ok(reservation) = budget.reserve(length) else {
        return ResultState::failure("admission_rejected", "reserve", 2);
    };
    let charge = reservation.charge();
    debug_assert_eq!(
        budget.remaining_units(),
        request.units - charge.verification_units
    );
    debug_assert_eq!(
        budget.remaining_input_bytes(),
        request.input_bytes - charge.input_bytes
    );
    super::fatal::admit(charge.verification_units, charge.input_bytes);
    ACTIVE.store(true, Ordering::Release);
    let mut result = ResultState::failure("worker_error", "not_verified", 4);
    result.charged_units = charge.verification_units;
    result.charged_bytes = charge.input_bytes;
    let mut record = vec![0u8; length];
    // SAFETY: run derived pointer and length from one live immutable slice;
    // it cannot return before this worker joins. reserve checked the actual
    // length before ACTIVE and before this owned arena copy. The borrowed
    // caller capacity is never adopted by the arena.
    let staged = unsafe { std::slice::from_raw_parts(request.record, length) };
    record.copy_from_slice(staged);
    let receipt = reservation.verify(request.row, request.role, &record);
    result.charged_units = receipt.charge.verification_units;
    result.charged_bytes = receipt.charge.input_bytes;
    match receipt.result {
        Ok(()) => {
            result.outcome = "accepted";
            result.stage = "complete";
            result.exit = 0;
        }
        Err(error) => {
            (result.outcome, result.stage, result.exit) = classify(error);
        }
    }
    result
}

fn classify(error: VerificationError) -> (&'static str, &'static str, i32) {
    match error {
        VerificationError::InputLengthChanged { .. } => ("input_error", "input_length", 3),
        VerificationError::Profile(_)
        | VerificationError::Codec(TestCodecError::Statement(StatementError::Profile(_)))
        | VerificationError::Proof(VerifyError::Statement(StatementError::Profile(_))) => {
            ("worker_error", "profile", 4)
        }
        VerificationError::Proof(VerifyError::Backend(_)) => ("worker_error", "backend", 4),
        VerificationError::Codec(_) => ("rejected", "codec", 1),
        VerificationError::Proof(_) => ("rejected", "proof", 1),
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn operational_failures_are_never_invalid_proofs() {
        use iroha_parliament_ballot_proof::profile::ProfileError;
        use iroha_zkp_vole::proof::ProofError;
        let profile = ProfileError::DescriptorLength { actual: 0 };
        for error in [
            VerificationError::Profile(profile),
            VerificationError::Codec(TestCodecError::Statement(StatementError::Profile(profile))),
            VerificationError::Proof(VerifyError::Statement(StatementError::Profile(profile))),
            VerificationError::Proof(VerifyError::Backend(ProofError::ChallengeMismatch)),
        ] {
            let (outcome, _, exit) = classify(error);
            assert_eq!((outcome, exit), ("worker_error", 4));
        }
        assert_eq!(
            classify(VerificationError::InputLengthChanged {
                expected: 1,
                actual: 2
            }),
            ("input_error", "input_length", 3)
        );
        assert_eq!(
            classify(VerificationError::Codec(TestCodecError::Truncated)),
            ("rejected", "codec", 1)
        );
        assert_eq!(
            classify(VerificationError::Proof(VerifyError::Rejected)),
            ("rejected", "proof", 1)
        );
    }
}
