"""Independent scoped controls for fixed classical sequence wiring only."""
from collections import Counter
from dataclasses import replace
from pathlib import Path
import sys

import pytest

ROOT = Path(__file__).resolve().parents[2]
sys.path[:0] = [str(ROOT/'target/parliament-sequential-composition-stage'),
               str(ROOT/'target/parliament-ideal-machine-stage')]

from content_request import ContentRequest
from l0_machine import OverlayLookup
from request_family import ContentFamily
from sequence import Call, Geometry, Relocation, Segment, Sequence
from test_content_request import fixture as content_fixture
from test_request_transition import synthetic


def put(state, start, width, value):
    for index in range(width):
        state[start+index] = (value >> index) & 1


def number(state, start, width):
    return sum(state[start+index] << index for index in range(width))


def apply(state, gates):
    """Independent deterministic toy F interpreter, not a source oracle model."""
    counts = Counter()
    for opcode, *args in gates:
        counts[opcode] += 1
        if opcode == 'F:variable':
            length, width, message, capacity, output, values = args
            n = number(state, length, width)
            assert n <= capacity
            # A single total byte-string function, unaffected by capacity.
            v = 1 + sum((i+1)*number(state, message+8*i, 8) for i in range(n))
            for index in range(values):
                state[output+index] ^= (v >> index) & 1
        else:
            assert opcode in ('x', 'cx', 'ccx')
            assert len(args) == {'x': 1, 'cx': 2, 'ccx': 3}[opcode]
            assert len(set(args)) == len(args)
            assert all(type(i) is int and 0 <= i < len(state) for i in args)
            state[args[-1]] ^= int(all(state[i] for i in args[:-1]))
    return counts


@pytest.mark.parametrize('kind', ['accepted', 'content', 'common'])
@pytest.mark.parametrize('bad', [-1, True, 1.5, None, '2', [], 10**9])
def test_untrusted_coin_geometry_is_refused_before_arithmetic(kind, bad):
    if kind == 'accepted':
        machine = synthetic()
        machine = replace(machine, generator=replace(machine.generator,
                          original_private_coin_bits=bad))
    else:
        content = content_fixture()
        generator = replace(content.generator, original_private_coin_bits=bad)
        content = ContentRequest(replace(content.base, generator=generator))
        machine = content if kind == 'content' else ContentFamily(content)
    with pytest.raises(ValueError, match='coin'):
        Sequence(Geometry(6, 4, 8, 256, 'toy', 'same'), (Call('call', machine),))


@pytest.mark.parametrize('bad', [None, [], {}, object(), 0.0, True, '0'])
@pytest.mark.parametrize('position', [1, 3, 5])
def test_variable_wire_types_are_refused_without_sorting_foreign_values(bad, position):
    relocation = Relocation(2147, (Segment(0, 2147, 91),))
    gate = ['F:variable', 0, 3, 3, 4, 35, 2112]
    gate[position] = bad
    with pytest.raises(ValueError):
        relocation.gate(tuple(gate))


@pytest.mark.parametrize('bad', [None, [], {}, object(), 0.0, True, '0'])
def test_elementary_wire_types_are_refused_before_hashing(bad):
    relocation = Relocation(10, (Segment(0, 10, 20),))
    with pytest.raises(ValueError):
        relocation.gate(('cx', 1, bad))


def test_variable_width_cap_rejects_before_unbounded_shift():
    relocation = Relocation(2147, (Segment(0, 2147, 0),))
    with pytest.raises(ValueError, match='geometry'):
        relocation.gate(('F:variable', 0, 10**100, 3, 4, 35, 2112))


def test_sparse_coherent_support_preserves_correlated_outputs_and_spectator_phases():
    """Four finite basis controls imply the same map on this explicit support.

    This tests a synthetic request, a toy F, and four chosen amplitudes. It is
    not the full source component theorem or an arbitrary adaptive adversary.
    """
    request = synthetic()
    request = replace(request, writes=replace(request.writes, capacity=8))
    lookup = OverlayLookup(8, 4, 8, 12, 256)
    sequence = Sequence(Geometry(8, 4, 8, 256, 'toy-F', 'same completion'),
        (Call('a', request), Call('qa', lookup), Call('b', request), Call('qb', lookup)))
    regions = {name: (start, width) for name, start, width in sequence.allocations}
    field_positions = {name: (offset, width) for name, (_, offset, width)
                       in request.generator.fields}
    prefix = b'P\x01\x02\x09'
    inputs = {}
    images = {}
    for label, amplitude in enumerate((0.5, 0.5j, -0.5, -0.5j)):
        state = [0]*(sequence.size+2)
        put(state, sequence.size, 2, label)
        for name, value in (('a', 3+2*label), ('b', 19+3*label)):
            start, _ = regions['event.'+name+'.input']
            for field, v in (('namespace_digest', 1), ('mu', 2), ('challenge_1', value),
                             ('primary_flags', 1), ('challenge', value)):
                off, width = field_positions[field]
                put(state, start+off, width, v)
        for name in ('qa', 'qb'):
            start, _ = regions['event.'+name+'.query']
            put(state, start, 4, len(prefix))
            for i, value in enumerate(prefix):
                put(state, start+4+8*i, 8, value)
            start, _ = regions['event.'+name+'.enable']
            state[start] = label % 2 if name == 'qa' else 1
        for name, (start, width) in regions.items():
            if name.endswith('.output'):
                put(state, start, width, 123+label)
        before = tuple(state)
        inputs[before] = amplitude
        counts = Counter()
        for index in range(len(sequence.calls)):
            counts += apply(state, sequence.emit_call(index))
            start, width = regions['reusable.clean']
            assert not any(state[start:start+width])
        for name, wanted in (('qa', (3+2*label) if label % 2 else 0),
                             ('qb', 19+3*label)):
            start, width = regions['event.'+name+'.output']
            assert number(state, start, width) == (123+label)^wanted
        assert number(state, *regions['persistent.counter']) == 6
        assert number(state, sequence.size, 2) == label
        for name, (start, width) in regions.items():
            if name.endswith(('.input', '.query', '.enable')):
                assert tuple(state[start:start+width]) == before[start:start+width]
        assert tuple(state) not in images
        images[tuple(state)] = amplitude
        advertised = sequence.resources()['gates']
        assert counts == {**{k: advertised[k] for k in ('x', 'cx', 'ccx')},
                          'F:variable': advertised['base_xor_oracle_calls']}
        apply(state, sequence.emit(inverse=True))
        assert tuple(state) == before
    restored = {}
    for basis, amplitude in images.items():
        state = list(basis)
        apply(state, sequence.emit(inverse=True))
        assert tuple(state) not in restored
        restored[tuple(state)] = amplitude
    assert restored == inputs
    assert sum(abs(a)**2 for a in images.values()) == 1
    assert not sequence.resources()['full_joint_quantum_theorem_proved']
    assert not sequence.resources()['source_dependency_closure_authenticated']
