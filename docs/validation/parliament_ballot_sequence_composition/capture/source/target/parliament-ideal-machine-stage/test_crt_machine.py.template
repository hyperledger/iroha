"""Independent CRT/visible-H5 references, joint cleanup and table orientation."""
from pathlib import Path
import hashlib
import random
import re
import tempfile
import unittest

from bit_ir import bits,unpack
from crt_machine import Matrix,CrtReconstruction,load_matrices
from mask_fold import TABLE_PINS
from test_hash_machine import apply

ROOT=Path(__file__).resolve().parents[2]


def padded(values): return tuple(values)+(0,)*(256-len(values))


def image(matrix,value):
    return sum(((row&value).bit_count()%2) << i for i,row in enumerate(matrix.rows))


def reference(c,inputs):
    value=unpack(inputs)
    prefix=(value&((1<<1000)-1)).to_bytes(125,'little')
    selector=(value>>1000)&((1<<256)-1)
    columns=[(value>>(1256+i*c.width_bits))&((1<<c.width_bits)-1) for i in range(c.n_delta)]
    share_start=1256+c.column_bits
    shares=[(value>>(share_start+m*c.share_width))&((1<<c.share_width)-1) for m in range(10)]
    corrections=value>>(share_start+10*c.share_width)
    rows=[sum(((column>>j)&1)<<i for i,column in enumerate(columns)) for j in range(c.ell)]
    delta=image(c.w_crt,selector)
    q=[image(c.w_crt,row) for row in rows]
    tags=[image(c.w_tree,s) for s in shares]
    messages=[]
    gate_rows=[0]*10
    for e,g in enumerate(c.g_matrix.rows):
        label=0
        for i,column in enumerate(columns):
            if (g>>i)&1: label ^= column&((1<<256)-1)
        message=prefix+e.to_bytes(4,'little')+label.to_bytes(32,'little')+b'\5'
        messages.append(message)
        result=int.from_bytes(hashlib.shake_256(message).digest(2),'little')&1023
        gamma=(g&selector).bit_count()%2
        for m in range(10):
            gate_rows[m] |= (((result>>m)&1) ^ (gamma&((corrections>>(m*c.gates+e))&1)))<<e
    tags=[tag^image(c.w_gate,row) for tag,row in zip(tags,gate_rows)]
    return tuple(bit for field in (delta,*q,*tags) for bit in bits(field,256)),messages


class CrtMachineTests(unittest.TestCase):
    def toy(self):
        # Asymmetric rows/columns: catches transposition and word-order mistakes.
        return CrtReconstruction(256,272,Matrix(3,(3,6,0,1,2,4,5,7)),
            Matrix(3,padded((1,6,3,5))),Matrix(3,padded((4,3,6))),
            Matrix(8,padded((1,3,2,0,3,128,64,129))))

    def test_joint_map_arbitrary_outputs_shared_F_cleanup_inverse_and_exact_cost(self):
        rng=random.Random(697)
        c=self.toy();p=c.layout()
        for sample in range(3):
            inputs=tuple(rng.randrange(2) for _ in range(c.input_bits))
            wanted,messages=reference(c,inputs)
            z=tuple(rng.randrange(2) for _ in range(c.output_bits))
            original=list(inputs+(0,)*(p['output_start']-c.input_bits)+z)
            state=original.copy()
            census,queries=apply(state,c.emit_clean())
            self.assertEqual(queries,[message for m in messages for message in (m,)*4])
            self.assertEqual(state[:c.input_bits],list(inputs))
            self.assertEqual(state[c.input_bits:p['output_start']],[0]*(p['output_start']-c.input_bits))
            self.assertEqual(tuple(state[p['output_start']:]),tuple(a^b for a,b in zip(z,wanted)))
            cost=c.resources()['gates']
            for key in ('x','cx','ccx'): self.assertEqual(census[key],cost[key])
            self.assertEqual(census['F'],cost['base_xor_oracle_calls'])
            apply(state,c.emit_clean())
            self.assertEqual(state,original)
            self.assertFalse(c.resources()['complete_resource_vector'])

    def test_zero_labels_gamma_and_corrections_are_total(self):
        c=self.toy();p=c.layout()
        inputs=(0,)*c.input_bits
        wanted,messages=reference(c,inputs)
        self.assertEqual(messages[0][125:129],bytes(4))
        self.assertEqual(messages[1][125:129],b'\1\0\0\0')
        state=[0]*p['size']
        apply(state,c.emit_clean())
        self.assertEqual(tuple(state[p['output_start']:]),wanted)
        self.assertEqual(state[:p['output_start']],[0]*p['output_start'])
        # Omitting one required response uncompute leaves a detectable work bit.
        state=[0]*p['size'];seen=0
        def broken():
            nonlocal seen
            for gate in c.emit_clean():
                if gate[0].startswith('F:'):
                    seen+=1
                    if seen==2: continue
                yield gate
        apply(state,broken())
        self.assertNotEqual(state[c.input_bits:p['output_start']],[0]*(p['output_start']-c.input_bits))

    def test_actual_source_rows_use_little_endian_words_and_full_declared_geometry(self):
        for row in TABLE_PINS:
            matrices=load_matrices(ROOT,row)
            text=(ROOT/TABLE_PINS[row][0]).read_text()
            for name,matrix in matrices.items():
                body=text.split('pub static '+name+': ',1)[1].split('= [',1)[1].split('];',1)[0]
                words=[int(word.replace('_',''),16) for word in re.findall(r'0x[0-9a-f_]+',body)]
                stride=(matrix.columns+63)//64
                self.assertEqual(len(words),stride*len(matrix.rows))
                for i,rowvalue in enumerate(matrix.rows):
                    for j in range(matrix.columns):
                        self.assertEqual((rowvalue>>j)&1,(words[i*stride+j//64]>>(j%64))&1)
                    self.assertEqual(rowvalue>>matrix.columns,0)
            c=CrtReconstruction(35840,35920 if row=='candidate' else 35960,
                                matrices['G'],matrices['W_CRT'],matrices['W_TREE'],matrices['W_GATE'])
            self.assertEqual(c.resources()['gates']['base_xor_oracle_calls'],4*(704 if row=='candidate' else 696))
            self.assertEqual(c.resources()['total_clean_work_bits'],3707)
            self.assertFalse(c.resources()['whole_request_composition_implemented'])

    def test_bad_public_matrices_and_source_drift_refused(self):
        for args in ((True,(1,)),(3,[1]),(3,(8,)),(0,(0,)),(3,(False,))):
            with self.subTest(args=args),self.assertRaises(ValueError): Matrix(*args)
        c=self.toy()
        for ell,width in ((255,272),(257,272),(256,271),(272,256)):
            with self.assertRaises(ValueError): CrtReconstruction(ell,width,c.g_matrix,c.w_crt,c.w_tree,c.w_gate)
        with self.assertRaises(ValueError): CrtReconstruction(256,272,c.g_matrix,c.w_crt,c.w_tree,Matrix(1,padded((1,))))
        for row in ('unknown',None,[],True):
            with self.assertRaises(ValueError): load_matrices(ROOT,row)
        with self.assertRaises(ValueError):
            CrtReconstruction(256,272,Matrix(3,(3,6)),c.w_crt,c.w_tree,Matrix(2,padded((1,2))))
        with tempfile.TemporaryDirectory(dir=ROOT/'target') as directory:
            for row,(path,_) in TABLE_PINS.items():
                target=Path(directory)/path;target.parent.mkdir(parents=True,exist_ok=True)
                target.write_bytes((ROOT/path).read_bytes()+b'\n')
                with self.assertRaises(ValueError): load_matrices(Path(directory),row)


if __name__=='__main__': unittest.main()
