+        .expect_err("the caller's full output buffer must fail");
+    assert_eq!(
+        error
+            .downcast_ref::<std::io::Error>()
+            .expect("output error")
+            .kind(),
+        std::io::ErrorKind::WriteZero
+    );
+}
