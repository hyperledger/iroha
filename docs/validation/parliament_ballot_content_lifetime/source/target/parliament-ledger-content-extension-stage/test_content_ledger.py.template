def experiment(t=2,q=1,b=64,coins='classical-retained'):
    return l.Experiment(t,q,b,l.base.MIN_MESSAGE,'immutable-F','agreed-completion',coins)


def event(ex,row='candidate',n=3,name='content'):
    return l.ContentRequest(name,ex.interface,row,n)


@pytest.mark.parametrize('row',['candidate','comparator'])
@pytest.mark.parametrize('n',[3,1000])
def test_original_full_cap_totals_and_allocation(catalog,row,n):
    ex=experiment(t=1 << 44)
    r=l.account(catalog,ex,(event(ex,row,n),))
    raw=json.loads((ROOT/l.OBS_PATH).read_bytes())
    c=next(x for x in raw['cases'] if (x['row'],x['list_count'])==(row,n))
    original=c['family_resources'];item=r['events'][0]
    assert r['body_gates']==original['gates']
    assert r['ownership']['known_allocated_bits']==original['total_logical_bits']
    assert item['caller_output_bits']==original['caller_output_bits']==253+8*c['base_return_resources']['proof_bytes']
    assert item['public_input_bits']==3608+1024*n
    assert item['original_coin_bits']==original['original_private_coin_bits']
    assert item['public_input_bits']+item['original_coin_bits']==original['original_input_bits']
    assert item['retained_derived_bits']==original['retained_derived_bits']
    assert item['shared_work_bits']==original['shared_work_bits']
    assert item['rebased_writes']['gates']==original['components']['writes']['gates']
    assert item['content_validity'] is None and item['actual_appends'] is None
    assert item['covers_valid_and_invalid_content'] and item['invalid_content_log_identity']
    assert item['invalid_content_still_charged_full_gates']
    assert r['capacity']['reserved_upper']==l.base.M+2


@pytest.mark.parametrize('t,b',[(1,23),(2,64),(1 << 44,4096),(1 << 64,64)])
@pytest.mark.parametrize('row',['candidate','comparator'])
@pytest.mark.parametrize('n',[3,1000])
def test_rebase_validated_w_and_all_dimensions(catalog,t,b,row,n):
    ex=experiment(t=t,b=b);ev=event(ex,row,n);case=catalog.content(ev)
    r=l.account(catalog,ex,(ev,));one=r['events'][0]
    ordinary,work=l.base.write_resources(ex.interface,row,'VOTE')
    expected=l.Gates(ordinary.x-4,ordinary.cx+4-2*l.base.M,ordinary.ccx+2*l.base.M)
    assert one['rebased_writes']==dict(gates=expected.report(),clean_work_bits=work,
        counter_bits=max(2,ex.interface.capacity.bit_length()),log_bits=ex.interface.log_bits)
    assert r['body_gates']==(case.generator+expected+case.returns).report()
    assert one['shared_work_bits']==max(case.generator_work,work,case.return_work)
    assert r['ownership']['reusable_clean_bits']==case.retained+one['shared_work_bits']
    assert r['ownership']['counter_bits']==ex.interface.counter_bits
    assert r['ownership']['persistent_log_bits']==ex.interface.log_bits


def test_p0_plus_legacy_n1000_only_and_return_delta(catalog):
    for row in ('candidate','comparator'):
        ex=experiment()
        c=catalog.content(event(ex,row,1000))
        old=next(x for x in catalog.legacy.cases if x.row==row and x.role=='VOTE')
        assert c.public==old.public and c.coins==old.coins
        assert c.retained==old.retained+60
        assert c.output==old.output+156
        assert c.return_work==old.output+2
        assert c.generator.f==old.generator.f
        assert c.generator.x>=old.generator.x and c.generator.cx>=old.generator.cx
        assert c.generator.ccx>=old.generator.ccx


def test_mixed_order_caps_prefix_reservation_and_storage(catalog):
    ex=experiment(t=4,q=2)
    seq=(event(ex,name='content-1'),l.Query('q1',ex.interface,l.base.MIN_MESSAGE),
         l.RejectedVote('reject',ex.interface,'candidate',2),
         l.AcceptedRequest('reg',ex.interface,'comparator','REG',4096,(256,)*6,0),
         event(ex,'comparator',1000,'content-2'),l.Query('q2',ex.interface,l.base.MIN_MESSAGE))
    result=l.account(catalog,ex,seq)
    singles=[l.account(catalog,ex,(x,)) for x in seq]
    assert result['event_counts']==dict(requests=4,queries=2,generating=3,content_family=2)
    assert result['body_gates']['base_xor_oracle_calls']==6200+5960+5960+4
    for key in result['body_gates']:
        assert result['body_gates'][key]==sum(x['body_gates'][key] for x in singles)
    unit=l.base.M+2
    assert [x['conservative_log_occupancy_upper'] for x in result['events']]==[unit,unit,unit,2*unit,3*unit,3*unit]
    assert result['capacity']['reserved_upper']==3*unit<ex.interface.capacity
    shared=max(x['ownership']['reusable_clean_bits'] for x in singles)
    interface_sum=sum(x['ownership']['known_allocated_bits']-ex.interface.log_bits-
        ex.interface.counter_bits-x['ownership']['reusable_clean_bits'] for x in singles)
    assert result['ownership']['known_allocated_bits']==interface_sum+ex.interface.log_bits+ex.interface.counter_bits+shared


def test_legacy_only_body_ownership_unchanged(catalog):
    ex=experiment()
    events=(l.AcceptedRequest('accepted',ex.interface,'candidate','VOTE',0,(0,)*6,1000),
            l.Query('query',ex.interface,l.base.MIN_MESSAGE))
    old=l.base.account(catalog.legacy,ex,events);new=l.account(catalog,ex,events)
    for key in ('body_gates','ownership','capacity','unknown_external_terms','coin_preparation'):
        assert old[key]==new[key]
    assert old['events']==new['events']
    assert new['event_counts']['content_family']==0


def test_retained_purification_additional_inputs_and_preparation(catalog):
    ex=experiment(coins='purified-retained')
    events=(event(ex,name='c'),l.AcceptedRequest('a',ex.interface,'candidate','REG',4096,(256,)*6,0))
    pure=l.account(catalog,ex,events)
    mixed=l.account(catalog,replace(ex,coins='classical-retained'),events)
    coins=sum(x['original_coin_bits'] for x in pure['events'])
    assert pure['body_gates']==mixed['body_gates']
    assert pure['coin_preparation']['cx']==pure['coin_preparation']['hadamard']==coins
    assert pure['ownership']['known_allocated_bits']==mixed['ownership']['known_allocated_bits']+coins
    assert pure['coin_preparation']['requires_clean_coin_and_purifier_inputs']
    assert pure['coin_preparation']['executed'] is False


