def test_union_caps_duplicates_and_common_interface(catalog):
    ex=experiment(t=1,q=1);c=event(ex)
    bad=(c,l.RejectedVote('reject',ex.interface,'candidate',1))
    with pytest.raises(ValueError,match='request cap'):l.account(catalog,ex,bad)
    with pytest.raises(ValueError,match='duplicate event'):l.account(catalog,ex,(c,c))
    for changes in (dict(capacity=0),dict(length_bits=23),dict(oracle='different'),dict(completion='different')):
        with pytest.raises(ValueError,match='N/b/F/completion'):
            l.account(catalog,ex,(replace(c,interface=replace(ex.interface,**changes)),))


def test_disjoint_allocations_and_borrowed_outputs(catalog):
    ex=experiment();events=(event(ex),)
    normal=l.account(catalog,ex,events)
    allocations=tuple(l.Allocation(**x) for x in normal['ownership']['allocations'])
    wrong=(allocations[0],replace(allocations[1],start=0),*allocations[2:])
    with pytest.raises(ValueError,match='overlapping'):l.account(catalog,ex,events,wrong)
    wrong=(replace(allocations[0],bits=allocations[0].bits+1),*allocations[1:])
    with pytest.raises(ValueError,match='membership and widths'):l.account(catalog,ex,events,wrong)
    moved=tuple(replace(x,start=x.start+10) for x in allocations)
    relocated=l.account(catalog,ex,events,moved)
    assert relocated['ownership']['known_allocated_bits']==normal['ownership']['known_allocated_bits']
    assert relocated['ownership']['address_span_bits']==normal['ownership']['address_span_bits']+10


def test_catalog_sources_exact_parse_buffers_and_immutability(catalog):
    assert len(catalog.pins)==154
    with pytest.raises(FrozenInstanceError):catalog.cases=()
    original=Path.read_bytes
    def corrupted(path):
        data=original(path)
        if path==ROOT/l.OBS_PATH:return data+b' '
        return data
    with patch.object(Path,'read_bytes',corrupted):
        with pytest.raises(ValueError,match='source drift'):l.Catalog(ROOT)
    def bad_base(path):
        data=original(path)
        if path==ROOT/l.BASE_PATH:return data+b'\n'
        return data
    with patch.object(Path,'read_bytes',bad_base):
        with pytest.raises(ValueError,match='source drift'):l.load_base(ROOT)


def test_final_source_drift_refused(catalog):
    original=l.authenticated_bytes;calls=0
    def change(path,expected):
        nonlocal calls
        calls+=1
        if calls>len(catalog.pins):raise ValueError('source drift: injected after check')
        return original(path,expected)
    with patch.object(l,'authenticated_bytes',change):
        with pytest.raises(ValueError,match='source drift'):
            l.account(catalog,experiment(t=0),())


