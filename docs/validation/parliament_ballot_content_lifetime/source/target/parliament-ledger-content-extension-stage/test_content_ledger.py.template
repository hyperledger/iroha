def test_json_cli_refuses_qualification_and_unsupported_shape(tmp_path):
    ex=experiment()
    doc=dict(experiment=asdict(ex),events=[dict(kind='content',event_id='c',interface=asdict(ex.interface),
                                              row='comparator',list_count=1000)])
    path=tmp_path/'events.json';path.write_text(json.dumps(doc))
    cmd=[sys.executable,'-B',str(HERE/'content_ledger.py'),'--root',str(ROOT),'--events',str(path)]
    env=dict(os.environ,PYTHONDONTWRITEBYTECODE='1')
    normal=subprocess.run(cmd,env=env,capture_output=True)
    refusal=subprocess.run(cmd+['--require-qualified'],env=env,capture_output=True)
    assert normal.returncode==0 and refusal.returncode==2
    assert normal.stdout==refusal.stdout and not normal.stderr and not refusal.stderr
    doc['events'][0]['list_count']=4;path.write_text(json.dumps(doc))
    bad=subprocess.run(cmd,env=env,capture_output=True)
    assert bad.returncode==1 and not bad.stdout and b'unsupported ContentFamily' in bad.stderr


