def test_unsupported_content_api_types_do_not_enter_accounting(catalog):
    ex=experiment()
    class Forged(l.ContentRequest):pass
    with pytest.raises(ValueError,match='unsupported event type'):
        l.account(catalog,ex,(Forged('c',ex.interface,'candidate',3),))
    with pytest.raises(ValueError,match='immutable event sequence'):
        l.account(catalog,ex,[l.ContentRequest('c',ex.interface,'candidate',3)])


def test_independent_population_matches_small_exhaustive_sums():
    for n in range(1000):
        assert independent_population(n)==sum(i.bit_count() for i in range(n))
