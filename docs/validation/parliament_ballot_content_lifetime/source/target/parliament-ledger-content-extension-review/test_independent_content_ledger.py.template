@pytest.mark.parametrize('count',[0,1,2,1001,1024,1 << 63,(1 << 64)-1])
@pytest.mark.parametrize('row',['candidate','comparator'])
def test_size_rejection_keeps_full_borrowed_storage_and_no_slot_refund_problem(catalog,count,row):
    ex=experiment(t=2,q=0)
    content=l.ContentRequest('content',ex.interface,row,3)
    rejected=l.RejectedVote('size',ex.interface,row,count)
    result=l.account(catalog,ex,(content,rejected));item=result['events'][1]
    proof=233012 if row=='candidate' else 158074
    assert item['gates']==census(569+2*count.bit_count(),872,888)
    assert item['public_input_bits']==3608+1024*count
    assert item['caller_output_bits']==253+8*proof
    assert item['borrowed_list_bits']==1024*count and item['list_bits_read']==0
    assert item['original_coin_bits']==item['reserved_append_slots']==item['actual_appends']==0
    assert item['reusable_work_bits']==519
    assert result['event_counts']['requests']==2
    assert result['capacity']['reserved_upper']==(1 << 20)+2
    with pytest.raises(ValueError,match='request cap'):
        l.account(catalog,replace(ex,requests=1),(
            replace(content,interface=replace(ex,requests=1).interface),
            replace(rejected,interface=replace(ex,requests=1).interface)))


@pytest.mark.parametrize('t,b',[(0,23),(1,23),(3,64),(1 << 64,4096)])
def test_l0_resource_coordinates_are_separate_from_full_query_storage(catalog,t,b):
    ex=experiment(t=t,b=b);query=l.Query('q',ex.interface,l.base.MIN_MESSAGE+37)
    report=l.account(catalog,ex,(query,));n=t*((1 << 20)+2);k=b+8*215150;v=2112
    expected=census(4*k*n+4*n+2,4*k*n,n*(4*k+6+v)+v+2,2) if n else census(0,0,v,2)
    assert report['body_gates']==expected
    assert report['ownership']['reusable_clean_bits']==(2*n+k+v+2 if n else v)
    widths={x['name']:x['bits'] for x in report['ownership']['allocations']}
    assert widths['event.q.query']==b+8*query.message_bytes
    assert widths['event.q.response']==v and widths['event.q.enable']==1
    assert report['event_counts']['requests']==0
    assert report['unknown_external_terms']['base_oracle_implementation_and_state'] is None


