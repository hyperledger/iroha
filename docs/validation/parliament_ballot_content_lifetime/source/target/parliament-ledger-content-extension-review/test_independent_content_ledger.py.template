def test_zero_budget_empty_and_query_only(catalog):
    ex=experiment(t=0)
    empty=l.account(catalog,ex,())
    assert empty['body_gates']==census(0,0,0)
    assert empty['ownership']['known_allocated_bits']==2
    query=l.account(catalog,ex,(l.Query('q',ex.interface,l.base.MIN_MESSAGE),))
    assert query['body_gates']==census(0,0,2112,2)
    assert query['capacity']['reserved_upper']==0


def test_unsupported_legal_families_and_all_qualification_flags(catalog):
    ex=experiment()
    for n in (4,255,999):
        with pytest.raises(ValueError,match='unsupported ContentFamily'):
            l.account(catalog,ex,(l.ContentRequest('c',ex.interface,'candidate',n),))
    for body,contexts in [(0,(0,)*6),(4095,(256,)*6),(4096,(255,)*6)]:
        with pytest.raises(ValueError,match='unsupported accepted shape'):
            l.account(catalog,ex,(l.AcceptedRequest('a',ex.interface,'candidate','REG',body,contexts,0),))
    report=l.account(catalog,ex,(l.ContentRequest('c',ex.interface,'candidate',3),))
    for name in ('full_quantum_joint_state_theorem_proved','full_adaptive_driver_executed',
        'family_wide_resource_maximum_proved','complete_resource_vector','actual_input_primitive_bridge',
        'independent_cryptographic_review','physical_workspace_bound','current_candidate_qualified',
        'profile_qualified','production_gate_changed','actual_content_validity_evaluated'):
        assert report[name] is False
    assert all(value is None for value in report['unknown_external_terms'].values())


