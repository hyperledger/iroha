"""Run only owned tests, recording exact membership and loaded repository files."""
import argparse
import hashlib
import json
from pathlib import Path
import platform
import sys

import pytest

ROOT = Path(__file__).resolve().parents[2]


class Membership:
    def __init__(self):
        self.collected = []
        self.reports = []

    def pytest_collection_finish(self, session):
        self.collected = [item.nodeid for item in session.items]

    def pytest_runtest_logreport(self, report):
        self.reports.append(dict(nodeid=report.nodeid, when=report.when, outcome=report.outcome))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--report', type=Path, required=True)
    parser.add_argument('--temporary', type=Path, required=True)
    args = parser.parse_args()
    if args.report.exists():
        raise ValueError('test report already exists')
    plugin = Membership()
    result = pytest.main(['-q', '-c', '/dev/null', '-o', 'addopts=', '--rootdir', str(ROOT),
                         '--noconftest', '-p', 'no:cacheprovider', '--basetemp', str(args.temporary),
                         str(ROOT/'target/parliament-coin-preparation-stage/test_purification.py')],
                        plugins=[plugin])
    loaded = {}
    for module in tuple(sys.modules.values()):
        filename = getattr(module, '__file__', None)
        if filename:
            path = Path(filename).resolve()
            if path.is_file() and path.is_relative_to(ROOT):
                loaded[path.relative_to(ROOT).as_posix()] = hashlib.sha256(path.read_bytes()).hexdigest()
    report = dict(exit_code=int(result), collected=plugin.collected, reports=plugin.reports,
                  loaded_repository_modules=loaded,
                  runtime=dict(python=platform.python_version(), executable=sys.executable,
                               pytest=pytest.__version__))
    args.report.write_text(json.dumps(report, indent=2, sort_keys=True)+'\n')
    raise SystemExit(int(result))


if __name__ == '__main__':
    main()
