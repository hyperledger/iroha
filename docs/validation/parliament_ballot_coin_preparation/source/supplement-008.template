def schema_only_generator(shape, inputs, coins):
    """Deliberately NOT actual source semantics; only structural-schema controls."""
    b = Builder(1)
    stage = Invocation('mock', CleanMap.block(b.finish((0,))), ((inputs[0][0], 0, 1),))
    return Generator(RetainedPlan(inputs, (stage,)), (), shape, 2, coins)


@pytest.mark.parametrize('mutation', ['reorder', 'same_total_widths', 'renamed', 'wrong_coins', 'bool_coins'])
def test_source_generator_schema_mutations_refused(mutation):
    shape = PublicShape('REG')
    schema = source_schema(ROOT, shape, 2)
    inputs, coins = list(schema.inputs), schema.coin_bits
    if mutation == 'reorder': inputs[1], inputs[2] = inputs[2], inputs[1]
    elif mutation == 'same_total_widths':
        inputs[0] = (inputs[0][0], inputs[0][1]-1)
        inputs[1] = (inputs[1][0], inputs[1][1]+1)
    elif mutation == 'renamed': inputs[0] = ('renamed_public', inputs[0][1])
    elif mutation == 'wrong_coins': coins += 1
    else: coins = True
    generator = schema_only_generator(shape, tuple(inputs), coins)
    with pytest.raises(ValueError):
        source_generator_coins(ROOT, generator)


def test_source_schema_matches_all_eight_frozen_resource_observations():
    path = ROOT/'target/parliament-ideal-machine-stage/request-accepted-observation.json'
    raw = path.read_bytes()
    assert hashlib.sha256(raw).hexdigest() == '81ffb1db693c94f73f41239da3cd8164893d9c84ddd805d873ec3ede974f4f4c'
    for case in json.loads(raw)['source_cases']:
        shape = dict(case['public_shape'])
        shape['context_bytes'] = tuple(shape['context_bytes'])
        schema = source_schema(ROOT, PublicShape(**shape), 1 << 20)
        resources = case['resources']
        assert schema.coin_bits == resources['original_private_coin_bits']
        assert schema.input_bits == resources['original_input_bits']
        assert schema.public_bits+schema.coin_bits == schema.input_bits
        assert schema.coins[0] == CoinInterval('iv_pre', schema.public_bits, 128)
        assert schema.coins[1] == CoinInterval('salt', schema.public_bits+128, 256)
        assert case['field_positions']['iv_pre'][0] != schema.coins[0].start
        assert case['field_positions']['salt'][0] != schema.coins[1].start
        assert validate_intervals(schema.coins, schema.input_bits, schema.coin_bits) == schema.coins
    path = ROOT/'target/parliament-content-resources-stage/capture/observation.json'
    raw = path.read_bytes()
    assert hashlib.sha256(raw).hexdigest() == 'c2f75e568d9b9192940fd53d4974ea71094d1ce7b48a69d194b7914a0857803e'
    for case in json.loads(raw)['cases']:
        schema = source_schema(ROOT, PublicShape('VOTE', row=case['row'], list_count=case['list_count']), 1 << 20)
        r = case['family_resources']
        assert schema.coin_bits == r['original_private_coin_bits']
        assert schema.input_bits == r['original_input_bits']


