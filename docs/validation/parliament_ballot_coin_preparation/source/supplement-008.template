def test_schema_source_drift_refused(tmp_path):
    for name in SCHEMA_PINS:
        dest = tmp_path/name
        dest.parent.mkdir(parents=True, exist_ok=True)
        dest.write_bytes((ROOT/name).read_bytes())
    assert authenticate_schema_sources(tmp_path) == tuple(sorted(SCHEMA_PINS.items()))
    file = tmp_path/'target/parliament-ideal-machine-stage/public_machine.py'
    file.write_bytes(file.read_bytes()+b'\n# drift\n')
    with pytest.raises(ValueError, match='identity'):
        source_schema(tmp_path, PublicShape('REG'), 2)


@pytest.mark.parametrize('field', ['iv_pre', 'salt'])
def test_shifted_original_public_coin_regions_refused(monkeypatch, field):
    original = PublicShape.input_regions
    def shifted(shape):
        return tuple((name, tuple(w+1 for w in wires) if name == field else wires)
                     for name, wires in original(shape))
    monkeypatch.setattr(PublicShape, 'input_regions', shifted)
    with pytest.raises(ValueError, match='original public coin geometry'):
        source_schema(ROOT, PublicShape('REG'), 2)


