def test_modes_and_toy_contract_membership_and_flags_refused():
    wrapper, _, _ = toy_fixture()
    s = wrapper.sequence
    with pytest.raises(ValueError): PurifiedSequence(s)
    with pytest.raises(ValueError): PurifiedSequence(s, source_root=ROOT, toy_coin_intervals=())
    with pytest.raises(ValueError): PurifiedSequence(s, toy_coin_intervals=[])
    with pytest.raises(ValueError): PurifiedSequence(s, toy_coin_intervals=())
    with pytest.raises(ValueError): PurifiedSequence(s, toy_coin_intervals=(('q1', ()),))
    with pytest.raises(ValueError): PurifiedSequence(s, toy_coin_intervals=(('first', ()), ('first', ())))
    with pytest.raises(ValueError): PurifiedSequence(object(), toy_coin_intervals=())
    with pytest.raises(ValueError): CoinInterval('x', True, 1)
    with pytest.raises(ValueError): CoinInterval('', 0, 1)
    with pytest.raises(ValueError): CoinInterval('x', 0, 0)
    with pytest.raises(ValueError): request_generator(object())
    with pytest.raises(ValueError): source_generator_coins(ROOT, object())
    with pytest.raises(ValueError): authenticate_schema_sources(5)
    with pytest.raises(ValueError): next(wrapper.emit_preparation(inverse=1))
    with pytest.raises(ValueError): next(wrapper.emit(inverse=1))


