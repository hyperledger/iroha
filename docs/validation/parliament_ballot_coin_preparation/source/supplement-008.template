def put(basis, start, width, value):
    mask = ((1 << width)-1) << start
    return (basis & ~mask) | (value << start)


def read(basis, start, width):
    return (basis >> start) & ((1 << width)-1)


def evolve(state, gates):
    """Sparse amplitudes over full integer wire labels with a fixed toy F."""
    state = dict(state)
    for op, *args in gates:
        updated = {}
        for basis, amplitude in state.items():
            if op == 'h':
                bit = 1 << args[0]
                zero = basis & ~bit
                updated[zero] = updated.get(zero, 0)+amplitude/sqrt(2)
                one = zero | bit
                updated[one] = updated.get(one, 0)+(amplitude/sqrt(2))*(-1 if basis & bit else 1)
                continue
            if op == 'F:variable':
                length, width, message, capacity, output, values = args
                n = read(basis, length, width)
                assert n <= capacity
                value = 1+sum((i+1)*read(basis, message+8*i, 8) for i in range(n))
                target = basis ^ ((value & ((1 << values)-1)) << output)
            else:
                assert op in ('x', 'cx', 'ccx')
                assert len(set(args)) == len(args)
                target = basis ^ (1 << args[-1]) if all((basis >> w)&1 for w in args[:-1]) else basis
            updated[target] = updated.get(target, 0)+amplitude
        state = {basis: amplitude for basis, amplitude in updated.items() if abs(amplitude) > 1e-12}
    return state


def density(state, wires):
    """Partial trace of every wire except an explicit ordered finite selection."""
    mask = sum(1 << w for w in wires)
    groups = {}
    for basis, amplitude in state.items():
        index = sum(((basis >> wire)&1) << j for j, wire in enumerate(wires))
        groups.setdefault(basis & ~mask, {})[index] = amplitude
    result = [[0j]*(1 << len(wires)) for _ in range(1 << len(wires))]
    for vector in groups.values():
        for i, a in vector.items():
            for j, b in vector.items():
                result[i][j] += a*b.conjugate()
    return result


def assert_state(actual, expected):
    assert set(actual) == set(expected)
    assert all(abs(actual[b]-a) < 1e-10 for b, a in expected.items())


def assert_matrix(actual, expected):
    assert len(actual) == len(expected)
    assert all(abs(a-b) < 1e-10 for ra, rb in zip(actual, expected) for a, b in zip(ra, rb))


def toy_fixture():
    original = synthetic()
    request = replace(original, writes=replace(original.writes, capacity=8),
                      generator=replace(original.generator, original_private_coin_bits=1))
    lookup = OverlayLookup(8, 4, 8, 12, 256)
    sequence = Sequence(Geometry(8, 4, 8, 256, 'fixed toy F', 'same completion'),
                        (Call('first', request), Call('q1', lookup),
                         Call('second', request), Call('q2', lookup)))
    fields = {name: (start, width) for name, (_, start, width) in request.generator.fields}
    offset, _ = fields['challenge_1']
    wrapper = PurifiedSequence(sequence, toy_coin_intervals=(
        ('first', (CoinInterval('toy_challenge_bit', offset, 1),)),
        ('second', (CoinInterval('toy_challenge_bit', offset, 1),))))
    allocations = {name: (start, width) for name, start, width in wrapper.allocations}
    basis = 0
    for name in ('first', 'second'):
        start, _ = allocations['event.'+name+'.input']
        for field, value in (('namespace_digest', 1), ('mu', 2), ('primary_flags', 1)):
            off, width = fields[field]
            basis = put(basis, start+off, width, value)
    for name in ('q1', 'q2'):
        start, _ = allocations['event.'+name+'.query']
        raw = b'P\x01\x02\x09'
        basis = put(basis, start, 4, len(raw))
        for i, value in enumerate(raw):
            basis = put(basis, start+4+8*i, 8, value)
        start, _ = allocations['event.'+name+'.enable']
        basis |= 1 << start
        start, width = allocations['event.'+name+'.output']
        basis = put(basis, start, width, 123)
    return wrapper, basis, allocations


def test_bell_preparation_partial_trace_and_arbitrary_entangled_complement():
    wrapper, basis, allocations = toy_fixture()
    # An unmeasured application-input bit is entangled with an outside spectator.
    public, _ = allocations['event.first.input']
    public += wrapper.sequence.calls[0].machine.generator.plan.inputs[0][1]-1
    spectator = wrapper.size
    initial = {basis: 1/sqrt(2), basis ^ (1 << public) ^ (1 << spectator): 1j/sqrt(2)}
    state = evolve(initial, wrapper.emit_preparation())
    coins = tuple(p.coin for p in wrapper.intervals)
    purifiers = tuple(p.purifier for p in wrapper.intervals)
    assert len(state) == 8
    assert_matrix(density(state, coins), [[0.25 if i == j else 0 for j in range(4)] for i in range(4)])
    assert_matrix(density(state, (public, spectator)), density(initial, (public, spectator)))
    bell = [[0.5 if i in (0, 3) and j in (0, 3) else 0 for j in range(4)] for i in range(4)]
    for pair in zip(coins, purifiers):
        assert_matrix(density(state, pair), bell)
    assert_state(evolve(state, wrapper.emit_preparation(inverse=True)), initial)
    gates = tuple(wrapper.emit_preparation())
    assert tuple(wrapper.emit_preparation(inverse=True)) == tuple(reversed(gates))


def test_future_private_pair_freshness_full_body_inverse_and_no_early_erasure():
    wrapper, basis, allocations = toy_fixture()
    initial = {basis: 1.0+0j}
    prepared = evolve(initial, wrapper.emit_preparation())
    state = evolve(prepared, wrapper.sequence.emit_call(0))
    future = wrapper.intervals[1]
    bell = [[0.5 if i in (0, 3) and j in (0, 3) else 0 for j in range(4)] for i in range(4)]
    assert_matrix(density(state, (future.coin, future.purifier)), bell)
    for i in range(1, len(wrapper.sequence.calls)):
        state = evolve(state, wrapper.sequence.emit_call(i))
        start, width = allocations['reusable.clean']
        assert all(read(b, start, width) == 0 for b in state)
    assert_state(state, evolve(initial, wrapper.emit()))
    assert len(state) == 4
    for b in state:
        for query, pair in zip(('q1', 'q2'), wrapper.intervals):
            start, width = allocations['event.'+query+'.output']
            assert read(b, start, width) == (123 ^ read(b, pair.coin, 1))
            assert read(b, pair.coin, 1) == read(b, pair.purifier, 1)
        assert read(b, *allocations['persistent.counter']) == 6
    assert_state(evolve(state, wrapper.emit(inverse=True)), initial)
    wrong = evolve(state, wrapper.emit_preparation(inverse=True))
    assert set(wrong) != set(initial)
    assert any(read(b, p.coin, 1) or read(b, p.purifier, 1) for b in wrong for p in wrapper.intervals)


def test_nonzero_coin_is_not_reset_or_claimed_as_checked():
    wrapper, basis, _ = toy_fixture()
    coin, purifier = wrapper.intervals[0].coin, wrapper.intervals[0].purifier
    bad_initial = {basis | (1 << coin): 1.0}
    state = evolve(bad_initial, wrapper.emit_preparation())
    rho = density(state, (coin, purifier))
    assert abs(rho[0][3]+0.5) < 1e-10  # Bell-minus; no implicit reset.
    assert_state(evolve(state, wrapper.emit_preparation(inverse=True)), bad_initial)
    assert not wrapper.resources()['initial_quantum_state_checked']


def test_resources_separate_H_and_preserve_body_counts_and_allocations():
    wrapper, _, _ = toy_fixture()
    body = wrapper.sequence.resources()
    result = wrapper.resources()
    assert result['body_gates'] == body['gates']
    assert result['preparation_gates'] == {'h': 2, 'cx': 2}
    assert result['aggregate_gate_vector']['cx'] == body['gates']['cx']+2
    assert result['aggregate_gate_vector']['x'] == body['gates']['x']
    assert result['non_h_elementary_gates'] == body['gates']['elementary_gates']+2
    assert result['hadamard_gates'] == 2 and not result['hadamard_cost_merged_into_non_h']
    assert result['logical_bits'] == wrapper.sequence.size+2
    assert result['original_coin_and_purifier_zero_bits_required'] == 4
    assert sum(width for _, _, width in result['allocations']) == wrapper.size
    assert result['contract'] == 'toy' and not result['source_input_schema_authenticated']
    for flag in ('full_cap_stream_executed', 'full_adaptive_driver_implemented',
                 'full_joint_quantum_theorem_proved', 'complete_resource_vector',
                 'physical_workspace_qualification', 'profile_qualified', 'production_gate_changed'):
        assert result[flag] is False
    with pytest.raises(FrozenInstanceError):
        wrapper.coins = 3


def test_lookup_and_size_rejection_have_no_preparation():
    q = OverlayLookup(0, 3, 1, 4, 2)
    bad = RejectedVoteFamily(1001, 5)
    s = Sequence(Geometry(0, 3, 1, 2, 'toy', 'completion'), (Call('q', q), Call('bad', bad)))
    for wrapper in (PurifiedSequence(s, toy_coin_intervals=()), PurifiedSequence(s, source_root=ROOT)):
        assert wrapper.coins == 0 and wrapper.size == s.size
        assert not wrapper.intervals and tuple(wrapper.emit_preparation()) == ()
        assert tuple(islice(wrapper.emit(), 5)) == tuple(islice(s.emit(), 5))
        assert wrapper.resources()['retained_purifier_bits'] == 0
    assert request_generator(q) is None and request_generator(bad) is None


