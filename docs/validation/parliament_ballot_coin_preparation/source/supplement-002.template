"""Capture owned tests and one metadata case from archived source buffers.

The selected source/loaded-module inventory is not a runtime dependency closure.
"""
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[2]
HERE = Path(__file__).resolve().parent
OUT = HERE/'capture'
PREVIOUS = ROOT/'target/parliament-sequential-composition-stage/capture'
PREVIOUS_MANIFEST = 'b3033bbf656d63500fdfef5136d384bf9e042110f03d75a0e29b9f4a95f1d367'
PREVIOUS_RECEIPT = '5472577d2daca72943bd173bb0f1fdff0b47b62b4542e0007a68d61abde70498'
PREVIOUS_OBSERVATION = '5d927aeb43f75a219243893e34eb9e593bf0fb11c0564455c34bfca18c63c008'
PRELIMINARY_TEST_RECEIPT = 'e23aba743bf8d7fbc0e7b7aa62e0c0fe7597c6b2b43c334ddc9bc1efddb95807'
OWN = tuple('target/parliament-coin-preparation-stage/'+name for name in (
    'purification.py', 'test_purification.py', 'observe.py', 'README.md', 'capture.py',
    'run_tests.py', 'capture_tests.py'))


def digest(data):
    return hashlib.sha256(data).hexdigest()


def require(condition, message):
    if not condition:
        raise ValueError(message)


def checked(path, expected):
    data = path.read_bytes()
    require(digest(data) == expected, 'input identity: '+str(path))
    return data


def safe(name):
    path = Path(name)
    require(not path.is_absolute() and '..' not in path.parts, 'relative source path')
    return path


def main():
    require(not OUT.exists(), 'capture destination already exists')
    manifest = checked(PREVIOUS/'SHA256SUMS', PREVIOUS_MANIFEST)
    for line in manifest.decode().splitlines():
        h, name = line.split('  ', 1)
        checked(PREVIOUS/safe(name), h)
    prior_bytes = checked(PREVIOUS/'receipt.json', PREVIOUS_RECEIPT)
    prior = json.loads(prior_bytes)
    require(len(prior['source_sha256_before']) == 159, 'prior159 inputs')
    inputs = {name: checked(PREVIOUS/'source'/(name+'.template'), h)
              for name, h in prior['source_sha256_before'].items()}
    inputs['target/parliament-sequential-composition-stage/capture/receipt.json'] = prior_bytes
    inputs['target/parliament-sequential-composition-stage/capture/observation.stdout'] = checked(
        PREVIOUS/'observation.stdout', PREVIOUS_OBSERVATION)
    preliminary_path = 'target/parliament-coin-preparation-stage/test-capture/receipt.json'
    preliminary_bytes = checked(ROOT/preliminary_path, PRELIMINARY_TEST_RECEIPT)
    inputs[preliminary_path] = preliminary_bytes
    preliminary = json.loads(preliminary_bytes)
    expected_names = [name.rsplit('::', 1)[-1] for name in preliminary['collected']]
    require(len(expected_names) == len(set(expected_names)) == 31, 'expected exact31 test membership')
    for name in OWN:
        inputs[name] = (ROOT/name).read_bytes()
    test_path = 'target/parliament-coin-preparation-stage/test_purification.py'
    require(digest(inputs[test_path]) == preliminary['source_sha256_before'][test_path],
            'same previously recorded test source')
    pins = {name: digest(data) for name, data in inputs.items()}
    live_before = {name: digest((ROOT/name).read_bytes()) for name in inputs}
    drift = {name: dict(expected=pins[name], actual=h) for name, h in live_before.items() if h != pins[name]}
    require(set(drift) <= {'crates/iroha_parliament_ballot_proof/Cargo.toml'}, 'unexpected live source drift')
    OUT.mkdir()
    execution = OUT/'execution-root'
    for name, data in inputs.items():
        for base, suffix in ((execution, ''), (OUT/'source', '.template')):
            dest = base/safe(name+suffix)
            dest.parent.mkdir(parents=True, exist_ok=True)
            dest.write_bytes(data)
    environment = dict(os.environ, PYTHONDONTWRITEBYTECODE='1', PYTEST_DISABLE_PLUGIN_AUTOLOAD='1',
                       PYTEST_ADDOPTS='', PYTEST_PLUGINS='', PYTHONPATH='')
    commands = []
    def run(name, command):
        result = subprocess.run(command, cwd=execution, env=environment, capture_output=True)
        (OUT/(name+'.stdout')).write_bytes(result.stdout)
        (OUT/(name+'.stderr')).write_bytes(result.stderr)
        commands.append(dict(name=name, command=command, exit_code=result.returncode))
        require(result.returncode == 0, 'command failed: '+name)
        return result.stdout
    run('tests', ['/opt/homebrew/opt/python@3.11/bin/python3.11', '-B',
        'target/parliament-coin-preparation-stage/run_tests.py', '--report', str(OUT/'tests-report.json'),
        '--temporary', str(OUT/'test-temp')])
    tests = json.loads((OUT/'tests-report.json').read_bytes())
    names = [name.rsplit('::', 1)[-1] for name in tests['collected']]
    calls = [r for r in tests['reports'] if r['when'] == 'call']
    require(names == expected_names and len(calls) == 31 and
            [r['nodeid'] for r in calls] == tests['collected'], 'exact ordered test membership')
    require(all(r['outcome'] == 'passed' for r in tests['reports']), 'all31 tests passed')
    require(all(pins.get(name) == h for name, h in tests['loaded_repository_modules'].items()),
            'loaded test repository modules in frozen inputs')
    observed = run('observation', [sys.executable, '-B', 'target/parliament-coin-preparation-stage/observe.py',
                                   '--source-root', str(execution)])
    observation = json.loads(observed)
    require(observation['status'] == 'PASS', 'source metadata observation')
    require(observation['source_sha256_before'] == observation['source_sha256_after']
            == prior['source_sha256_before'], 'unchanged159 component inputs')
    require(all(pins.get(name) == h for name, h in observation['loaded_frozen_repository_modules'].items()),
            'loaded observer repository modules in frozen inputs')
    for key in ('full_stream_executed', 'full_cap_quantum_state_allocated', 'physical_preparation_executed',
                'initial_state_checked', 'full_adaptive_driver', 'full_joint_quantum_theorem',
                'complete_resource_vector', 'current_candidate_qualified', 'profile_qualified',
                'production_gate_changed'):
        require(observation[key] is False, 'qualification flag: '+key)
    restored_after = {name: digest((execution/name).read_bytes()) for name in pins}
    snapshot_after = {name: digest((OUT/'source'/(name+'.template')).read_bytes()) for name in pins}
    live_after = {name: digest((ROOT/name).read_bytes()) for name in pins}
    require(pins == restored_after == snapshot_after, 'execution and snapshot source stability')
    require(live_before == live_after, 'selected live inputs changed')
    outputs = {p.name: digest(p.read_bytes()) for p in OUT.iterdir() if p.is_file()}
    receipt = dict(status='PASS', prior_capture_manifest_sha256=PREVIOUS_MANIFEST,
        prior_capture_receipt_sha256=PREVIOUS_RECEIPT, preliminary_tests_receipt_sha256=PRELIMINARY_TEST_RECEIPT,
        input_count=len(pins), source_sha256_before=pins, captured_source_sha256_after=restored_after,
        live_source_sha256_before=live_before, live_source_sha256_after=live_after,
        live_source_differences=drift, execution_inputs_stable=True, live_inputs_stable=True,
        parent_tests=31, exact_ordered_membership=tests['collected'],
        loaded_test_repository_modules=tests['loaded_repository_modules'],
        loaded_observation_repository_modules=observation['loaded_frozen_repository_modules'],
        loaded_repository_modules_within_selected=True, output_sha256=outputs, commands=commands,
        test_runtime=tests['runtime'], observer_python=sys.executable, observer_python_version=sys.version,
        full_stream_executed=False, source_dependency_closure_authenticated=False,
        full_adaptive_driver=False, full_joint_quantum_theorem=False, complete_resource_vector=False,
        physical_preparation_executed=False, current_candidate_qualified=False,
        profile_qualified=False, production_gate_changed=False)
    (OUT/'receipt.json').write_text(json.dumps(receipt, indent=2, sort_keys=True)+'\n')
    files = sorted(p for p in OUT.rglob('*') if p.is_file() and
                   p.relative_to(OUT).parts[0] not in ('execution-root', 'test-temp'))
    (OUT/'SHA256SUMS').write_text(''.join(digest(p.read_bytes())+'  '+p.relative_to(OUT).as_posix()+'\n'
                                       for p in files))
    print(json.dumps(dict(tests=31, inputs=len(pins), receipt_sha256=digest((OUT/'receipt.json').read_bytes()),
                         manifest_sha256=digest((OUT/'SHA256SUMS').read_bytes()))))


if __name__ == '__main__':
    main()
