 // Same-scope tests for treasury authorization and conserved reward obligations.
 
+use iroha_data_model::nexus::{
+    PublicLaneMonetaryScopeV1, PublicLaneRewardClaimPlanV1, PublicLaneRewardClaimSourceV1,
+    PublicLaneRewardRecordRefV1, public_lane_reward_record_commitment,
+};
+use std::collections::BTreeSet;
+
+/// Build the exact signed terms a recipient would inspect before authorizing a claim.
+fn reward_claim(
+    stx: &StateTransaction<'_, '_>,
+    lane_id: LaneId,
+    account: &AccountId,
+    upto_epoch: Option<u64>,
+) -> ClaimPublicLaneRewards {
+    let expected_state = stx
+        .world
+        .public_lane_reward_claims
+        .get(&(lane_id, account.clone()))
+        .copied();
+    let after_epoch = expected_state.and_then(|state| state.through_epoch);
+    let mut records = Vec::new();
+    let mut touched_sources = BTreeSet::new();
+    let mut new_entitlement: BTreeMap<AssetId, Quantity> = BTreeMap::new();
+    for ((record_lane, epoch), record) in stx.world.public_lane_rewards.iter() {
+        if *record_lane != lane_id
+            || after_epoch.is_some_and(|after| *epoch <= after)
+            || upto_epoch.is_some_and(|upto| *epoch > upto)
+        {
+            continue;
+        }
+        records.push(PublicLaneRewardRecordRefV1 {
+            epoch: *epoch,
+            record_hash: public_lane_reward_record_commitment(record)
+                .expect("canonical fixture reward record commitment"),
+        });
+        touched_sources.insert(record.asset.clone());
+        let entitlement = new_entitlement
+            .entry(record.asset.clone())
+            .or_insert_with(Quantity::zero);
+        for share in record
+            .shares
+            .iter()
+            .filter(|share| &share.account == account)
+        {
+            *entitlement = entitlement
+                .checked_add(&share.amount)
+                .expect("bounded fixture reward entitlement");
+        }
+    }
+    for ((accrual_lane, claimant, source), _) in stx.world.public_lane_reward_accruals.iter() {
+        if *accrual_lane == lane_id && claimant == account {
+            touched_sources.insert(source.clone());
+        }
+    }
+    let sources = touched_sources
+        .into_iter()
+        .map(|source_asset| {
+            let expected_accrued = stx
+                .world
+                .public_lane_reward_accruals
+                .get(&(lane_id, account.clone(), source_asset.clone()))
+                .cloned();
+            let additional = new_entitlement
+                .get(&source_asset)
+                .cloned()
+                .unwrap_or_else(Quantity::zero);
+            let total = expected_accrued
+                .clone()
+                .unwrap_or_else(Quantity::zero)
+                .checked_add(&additional)
+                .expect("bounded fixture accrued reward");
+            let payout = if &total >= &stx.nexus.staking.reward_dust_threshold {
+                total
+            } else {
+                Quantity::zero()
+            };
+            PublicLaneRewardClaimSourceV1 {
+                destination_asset: AssetId::new(source_asset.definition().clone(), account.clone()),
+                source_asset,
+                expected_accrued,
+                payout,
+            }
+        })
+        .collect();
+    let claim_plan = PublicLaneRewardClaimPlanV1 {
+        network_scope: PublicLaneMonetaryScopeV1::Network(*stx.network_id()),
+        valid_until_height: stx.block_height(),
+        expected_state,
+        records,
+        sources,
+    };
+    assert!(
+        claim_plan.has_canonical_shape(account),
+        "fixture claim terms"
+    );
+    ClaimPublicLaneRewards {
+        lane_id,
+        account: account.clone(),
+        claim_plan,
+    }
+}
