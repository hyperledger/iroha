+//! Unregistered, unfunded two-player/two-tick Arena movement proof fixture.
+
+use iroha_core::execution_proofs::{
+    arena_movement_research::{
+        ArenaMovementResearchStatementV1, prove_research_movement_v1, research_genesis_root_v1,
+        research_geometry_v1, research_manifest_v1, research_map_hash_v1, research_rules_hash_v1,
+        verify_research_movement_v1,
+    },
+    compiled_execution_profile_v1, initial_game_state_root_v1,
+};
+use iroha_crypto::{Algorithm, Hash, HashOf, KeyPair, Signature};
+use iroha_data_model::{
+    NetworkId,
+    account::AccountId,
+    block::BlockHeader,
+    game::{
+        GameAdmissionBodyV1, GameAdmissionParticipantV1, GameCommitmentSetV1, GameForcedBatchV1,
+        GameInputCommitmentV1, GameInputRevealV1, GameSlotSignatureV1, game_commitment_set_hash_v1,
+        game_input_commitment_v1, game_input_message_hash_v1, game_message_hash_v1,
+    },
+};
+use iroha_primitives::numeric::Quantity;
+
+fn input_keys() -> [KeyPair; 2] {
+    [
+        KeyPair::try_from_seed(vec![71; 32], Algorithm::Ed25519).unwrap(),
+        KeyPair::try_from_seed(vec![72; 32], Algorithm::Ed25519).unwrap(),
+    ]
+}
+
+fn input(move_x: i8, yaw: u16) -> [u8; 8] {
+    let yaw = yaw.to_le_bytes();
+    [0, 0, move_x as u8, 0, yaw[0], yaw[1], 0, 0]
+}
+
+fn fixture() -> ArenaMovementResearchStatementV1 {
+    let network_id = NetworkId::from_genesis_hash(HashOf::<BlockHeader>::from_untyped_unchecked(
+        Hash::new(b"arena-movement-research-isolated-network"),
+    ));
+    let session_id = Hash::new(b"arena-movement-research-unfunded-session");
+    let keys = input_keys();
+    let manifest = research_manifest_v1();
+    let admission = GameAdmissionBodyV1 {
+        version: 1,
+        participants: (0..2)
+            .map(|slot| {
+                let wallet =
+                    KeyPair::try_from_seed(vec![slot as u8 + 1; 32], Algorithm::Ed25519).unwrap();
+                GameAdmissionParticipantV1 {
+                    account: AccountId::new(wallet.public_key().clone()),
+                    input_key: keys[slot].public_key().clone(),
+                    deposit: Quantity::zero(),
+                    application_data: vec![0, 0, 0],
+                }
+            })
+            .collect(),
+        wagers: vec![],
+        resources: vec![],
+    };
+    let genesis_root =
+        research_genesis_root_v1(&network_id, session_id, &manifest, &admission).unwrap();
+    let inputs = vec![
+        [input(127, 0), input(64, 16_384)].concat(),
+        [input(-64, 32_768), input(-127, 49_152)].concat(),
+    ];
+    let batch = GameForcedBatchV1 {
+        epoch: 0,
+        start_tick: 0,
+        inputs,
+        dnf_slots: vec![],
+    };
+    let reveals: Vec<_> = (0..2)
+        .map(|slot| GameInputRevealV1 {
+            session_id,
+            epoch: 0,
+            start_tick: 0,
+            slot: slot as u8,
+            payload: batch.inputs[slot].clone(),
+            salt: Hash::new([slot as u8, 17, 4, 9]),
+        })
+        .collect();
+    let commitments: Vec<_> = (0..2)
+        .map(|slot| {
+            let mut item = GameInputCommitmentV1 {
+                session_id,
+                epoch: 0,
+                start_tick: 0,
+                slot: slot as u8,
+                commitment: game_input_commitment_v1(&network_id, &reveals[slot]),
+                signature: Signature::new(keys[slot].private_key(), b"temporary"),
+            };
+            let digest = game_input_message_hash_v1(&network_id, &item);
+            item.signature = Signature::new(keys[slot].private_key(), digest.as_ref());
+            item
+        })
+        .collect();
+    let parent_transcript_root = game_message_hash_v1(
+        &network_id,
+        "arena-movement-research-empty-transcript",
+        &(session_id, genesis_root),
+    );
+    let mut commitment_set = GameCommitmentSetV1 {
+        session_id,
+        epoch: 0,
+        start_tick: 0,
+        parent_transcript_root,
+        commitments: commitments.iter().map(|item| item.commitment).collect(),
+        signatures: vec![],
+    };
+    let digest = game_commitment_set_hash_v1(&network_id, &commitment_set);
+    commitment_set.signatures = (0..2)
+        .map(|slot| GameSlotSignatureV1 {
+            slot: slot as u8,
+            signature: Signature::new(keys[slot].private_key(), digest.as_ref()),
+        })
+        .collect();
+    ArenaMovementResearchStatementV1 {
+        network_id,
+        session_id,
+        manifest,
+        admission,
+        genesis_root,
+        rules_hash: research_rules_hash_v1(),
+        map_hash: research_map_hash_v1(),
+        commitments,
+        commitment_set,
+        reveals,
+        batch,
+        positions: [
+            [[18_000, 0], [-18_000, 0]],
+            [[18_080, 0], [-17_960, 0]],
+            [[18_080, 40], [-17_960, 80]],
+        ],
+    }
+}
+
+#[test]
+fn admission_history_mutations_fail_closed_and_research_profile_is_unregistered() {
+    let valid = fixture();
+    valid.validate().unwrap();
+    assert!(compiled_execution_profile_v1(&valid.manifest.profile_id).is_none());
+    assert!(
+        initial_game_state_root_v1(&valid.network_id, &valid.manifest, &valid.admission).is_err(),
+        "generic session genesis must reject the unregistered Arena relation"
+    );
+    let (width, constraints, maximum_wire) = research_geometry_v1(valid.clone()).unwrap();
+    eprintln!(
+        "movement_research_width={width} constraints={constraints} maximum_wire_bytes={maximum_wire}"
+    );
+    let mut cases = Vec::new();
+    let mut altered = valid.clone();
+    altered.admission.participants[1].application_data[2] = 12;
+    cases.push(altered);
+    let mut altered = valid.clone();
+    altered.admission.participants[0].deposit = Quantity::from(10_u32);
+    cases.push(altered);
+    let mut altered = valid.clone();
+    altered.batch.inputs[0][0] = 1; // attack button
+    cases.push(altered);
+    let mut altered = valid.clone();
+    altered.batch.inputs[0][2] = 128; // -128 is not a canonical Arena move input
+    cases.push(altered);
+    let mut altered = valid.clone();
+    altered.reveals[1].payload[2] ^= 1;
+    cases.push(altered);
+    let mut altered = valid.clone();
+    altered.commitment_set.signatures.swap(0, 1);
+    cases.push(altered);
+    let mut altered = valid.clone();
+    altered.rules_hash = Hash::new(b"different-rules");
+    cases.push(altered);
+    let mut altered = valid.clone();
+    altered.map_hash = Hash::new(b"different-map");
+    cases.push(altered);
+    let mut altered = valid.clone();
+    altered.positions[2][0][0] += 1;
+    cases.push(altered); // validates identity but not algebra; proof must reject
+    for (index, case) in cases.iter().enumerate().take(8) {
+        assert!(
+            case.validate().is_err(),
+            "invalid research statement {index}"
+        );
+    }
+    assert!(cases[8].validate().is_ok());
+}
+
+#[test]
+#[ignore = "actual native STARK proof takes minutes; run explicitly"]
+fn prove_and_save_movement_research() {
+    let path = std::env::var("ARENA_MOVEMENT_PROOF_PATH").expect("proof path");
+    let statement = fixture();
+    let started = std::time::Instant::now();
+    let proof = prove_research_movement_v1(statement.clone()).unwrap();
+    let prove_ms = started.elapsed().as_millis();
+    assert!(proof.len() <= 4 * 1024 * 1024);
+    std::fs::write(&path, &proof).unwrap();
+    eprintln!(
+        "movement_prove_ms={prove_ms} movement_proof_bytes={}",
+        proof.len()
+    );
+    verify_research_movement_v1(statement, &proof).unwrap();
+}
+
+#[test]
+#[ignore = "verify a proof file generated in a separate process"]
+fn independently_verify_saved_movement_research() {
+    let path = std::env::var("ARENA_MOVEMENT_PROOF_PATH").expect("proof path");
+    let proof = std::fs::read(&path).unwrap();
+    let statement = fixture();
+    let started = std::time::Instant::now();
+    verify_research_movement_v1(statement.clone(), &proof).unwrap();
+    eprintln!(
+        "movement_independent_verify_ms={}",
+        started.elapsed().as_millis()
+    );
+    let mut altered = statement.clone();
+    altered.positions[2][0][0] += 1;
+    assert!(verify_research_movement_v1(altered, &proof).is_err());
+    let mut altered = statement.clone();
+    altered.batch.inputs[0][2] = 126;
+    assert!(verify_research_movement_v1(altered, &proof).is_err());
+    let mut altered = statement.clone();
+    altered.session_id = Hash::new(b"different-session");
+    assert!(verify_research_movement_v1(altered, &proof).is_err());
+    let mut tampered = proof.clone();
+    let position = tampered.len() / 2;
+    tampered[position] ^= 1;
+    assert!(verify_research_movement_v1(statement, &tampered).is_err());
+}
