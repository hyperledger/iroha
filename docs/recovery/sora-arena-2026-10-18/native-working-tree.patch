+/// Build one explicit native game or NFT wallet action without exposing a wallet key.
+/// The returned scaffold must be wallet-signed and finalized before submission.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn connect_norito_native_transaction_scaffold_build_v1(
+    json_ptr: *const c_uchar,
+    json_len: c_ulong,
+    out_scaffold_ptr: *mut *mut c_uchar,
+    out_scaffold_len: *mut c_ulong,
+    out_json_ptr: *mut *mut c_uchar,
+    out_json_len: *mut c_ulong,
+) -> c_int {
+    clear_bridge_output(out_scaffold_ptr, out_scaffold_len);
+    clear_bridge_output(out_json_ptr, out_json_len);
+    let result = (|| {
+        let json_len =
+            usize::try_from(json_len).map_err(|_| BridgeError::DetachedTransactionScaffold)?;
+        if json_ptr.is_null() || json_len == 0 || json_len > DETACHED_TRANSACTION_JSON_MAX_BYTES {
+            return Err(BridgeError::DetachedTransactionScaffold);
+        }
+        let input = unsafe { slice::from_raw_parts(json_ptr, json_len) };
+        let (scaffold, inspection) = build_native_detached_transaction_scaffold(input)?;
+        unsafe {
+            write_detached_transaction_pair(
+                out_scaffold_ptr,
+                out_scaffold_len,
+                &scaffold,
+                out_json_ptr,
+                out_json_len,
+                &inspection,
+            )
+        }
+    })();
+    bridge_result_to_code(result)
+}
