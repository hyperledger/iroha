+/// Deterministic fixture construction from the independent integer formula.
+/// Verification uses native AIR for these fractions, not this host calculation.
+#[must_use]
+pub fn reference_plane_rows_v1() -> Vec<[i64; PLANE_VALUES]> {
+    (0..PLANE_COUNT)
+        .map(|index| {
+            let [start, end, bound] = expected_plane_inputs(index);
+            let delta = end - start;
+            let denominator = if delta == 0 { 1 } else { delta.abs() };
+            let mut numerator = (bound - start) * Q20;
+            if delta < 0 {
+                numerator = -numerator;
+            }
+            let fraction = (numerator / denominator).clamp(-1, Q20 + 1);
+            [start, end, bound, fraction, i64::from(delta != 0)]
+        })
+        .collect()
+}
+
+struct PlaneAir {
+    air: IntegerAirV1,
+    inputs: [Value; 3],
+    outputs: [Value; 2],
+}
+
+impl PlaneAir {
+    fn compile() -> Self {
+        let mut air = IntegerAirV1::default();
+        let inputs = std::array::from_fn(|_| {
+            bounded_input_v1(&mut air, -COORDINATE_LIMIT, COORDINATE_LIMIT)
+                .expect("bounded research plane coordinate")
+        });
+        let plane = plane_v1(&mut air, inputs[0], inputs[1], inputs[2]);
+        let outputs = [plane.fraction, plane.nonzero];
+        for (index, value) in inputs.iter().copied().chain(outputs).enumerate() {
+            air.equate(value, Value::fixed(index, value.low, value.high));
+        }
+        Self {
+            air,
+            inputs,
+            outputs,
+        }
+    }
+}
+
+struct Adapter {
+    statement: ArenaRangedResearchStatementV1,
+    plane: PlaneAir,
+    damage: ArenaDamageAirV1,
+}
+
+impl Adapter {
+    fn new(statement: ArenaRangedResearchStatementV1) -> Result<Self, String> {
+        statement.validate()?;
+        let plane = PlaneAir::compile();
+        let mut damage = ArenaDamageAirV1::compile().map_err(|error| error.to_string())?;
+        for (index, value) in damage.inputs.iter().copied().enumerate() {
+            damage
+                .air
+                .equate(value, Value::fixed(index, value.low, value.high));
+        }
+        for (index, value) in plane
+            .inputs
+            .iter()
+            .copied()
+            .chain(plane.outputs)
+            .enumerate()
+        {
+            let Source::Column(_) = value.source else {
+                return Err(format!("ranged plane column {index} changed"));
+            };
+        }
+        Ok(Self {
+            statement,
+            plane,
+            damage,
+        })
+    }
+
+    fn air_width(&self) -> usize {
+        self.plane.air.width().max(self.damage.air.width())
+    }
+
+    fn stage_values(&self, stage: usize) -> [i64; FIXED_VALUES] {
+        let mut values = [0_i64; FIXED_VALUES];
+        if stage < PLANE_COUNT {
+            values[..PLANE_VALUES].copy_from_slice(&self.statement.plane_rows[stage]);
+        } else {
+            values[..DAMAGE_INPUT_COUNT].copy_from_slice(&self.statement.damage_row);
+            values[DAMAGE_INPUT_COUNT] = 1;
+        }
+        values
+    }
+
+    fn columns(&self) -> Vec<Vec<F>> {
+        let width = self.air_width();
+        let mut columns = vec![vec![F::ZERO; TRACE_SIZE]; NOTE_COPY_WIDTH_V1 + width];
+        for stage in 0..STAGES {
+            let values = self.stage_values(stage);
+            let witness = if stage < PLANE_COUNT {
+                self.plane
+                    .air
+                    .witness(&values[..3], &values[..PLANE_VALUES])
+            } else {
+                self.damage
+                    .air
+                    .witness(&values[..DAMAGE_INPUT_COUNT], &values[..DAMAGE_INPUT_COUNT])
+            };
+            for (column, value) in witness.into_iter().enumerate() {
+                for row in (stage..TRACE_SIZE).step_by(STAGES) {
+                    columns[NOTE_COPY_WIDTH_V1 + column][row] = field(value);
+                }
+            }
+        }
+        columns
+    }
+}
