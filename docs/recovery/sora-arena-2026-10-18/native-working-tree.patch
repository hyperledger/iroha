+    fn base_width_v1(&self) -> usize {
+        NOTE_COPY_WIDTH_V1 + self.air_width()
+    }
+    fn profile_aux_width_v1(&self) -> usize {
+        0
+    }
+    fn profile_fixed_width_v1(&self) -> usize {
+        FIXED_VALUES
+    }
+    fn profile_constraint_count_v1(&self) -> usize {
+        self.plane.air.constraint_count() + self.tick.air.constraint_count()
+    }
+    fn copy_schedule_v1(&self) -> Result<NoteCopyScheduleV1, NativeError> {
+        Ok(NoteCopyScheduleV1 {
+            policies: vec![[NoteCopyCellPolicyV1::Inactive; NOTE_COPY_WIDTH_V1]; TRACE_SIZE],
+            sigma: (0..TRACE_SIZE)
+                .map(|row| std::array::from_fn(|col| (row * NOTE_COPY_WIDTH_V1 + col + 1) as u32))
+                .collect(),
+        })
+    }
+    fn profile_fixed_columns_v1(&self) -> Result<Vec<Vec<F>>, NativeError> {
+        Ok((0..FIXED_VALUES)
+            .map(|index| {
+                (0..TRACE_SIZE)
+                    .map(|row| field(self.stage_values(row % STAGES)[index]))
+                    .collect()
+            })
+            .collect())
+    }
+    fn derive_profile_challenges_v1(
+        &self,
+        _: &mut TransparentTranscriptV1,
+        _: NoteCopyChallengesV1,
+    ) -> Result<(), NativeError> {
+        Ok(())
+    }
+    fn build_profile_aux_columns_v1(
+        &self,
+        _: &[Vec<F>],
+        _: &[Vec<F>],
+        _: &[Vec<F>],
+        _: NoteCopyChallengesV1,
+        _: &(),
+    ) -> Result<Vec<Vec<F>>, NativeError> {
+        Ok(vec![])
+    }
+    fn profile_constraint_residues_v1(
+        &self,
+        current: &[F],
+        next: &[F],
+        _: &[F],
+        _: &[F],
+        fixed: &[F],
+        _: NoteCopyChallengesV1,
+        _: &(),
+    ) -> Result<Vec<F>, NativeError> {
+        let marker = fixed[NOTE_COPY_FIXED_WIDTH_V1 + arena_kill_air::INPUT_COUNT];
+        let plane_gate = F::ONE.sub(marker);
+        let plane = self.plane.air.residues(
+            &current[NOTE_COPY_WIDTH_V1..NOTE_COPY_WIDTH_V1 + self.plane.air.width()],
+            &next[NOTE_COPY_WIDTH_V1..NOTE_COPY_WIDTH_V1 + self.plane.air.width()],
+            &fixed[NOTE_COPY_FIXED_WIDTH_V1..NOTE_COPY_FIXED_WIDTH_V1 + PLANE_VALUES],
+        );
+        let tick = self.tick.air.residues(
+            &current[NOTE_COPY_WIDTH_V1..NOTE_COPY_WIDTH_V1 + self.tick.air.width()],
+            &next[NOTE_COPY_WIDTH_V1..NOTE_COPY_WIDTH_V1 + self.tick.air.width()],
+            &fixed
+                [NOTE_COPY_FIXED_WIDTH_V1..NOTE_COPY_FIXED_WIDTH_V1 + arena_kill_air::INPUT_COUNT],
+        );
+        Ok(plane
+            .into_iter()
+            .map(|value| value.mul(plane_gate))
+            .chain(tick.into_iter().map(|value| value.mul(marker)))
+            .collect())
+    }
+}
+
+fn preflight(adapter: &Adapter) -> Result<usize, String> {
+    let protocol = adapter.protocol_v1();
+    protocol.validate().map_err(|error| error.to_string())?;
+    let layout = AggregateProofLayoutV1::new(
+        protocol.parameters,
+        vec![AggregateTraceGroupLayoutV1 {
+            native_trace_log2: TRACE_LOG,
+            segment_instances: 1,
+            base_width: adapter.base_width_v1(),
+            aux_width: NOTE_COPY_AUX_WIDTH_V1,
+        }],
+    )
+    .map_err(|error| error.to_string())?;
+    let maximum = maximum_encoded_proof_with_deep_bytes_v1(protocol.parameters, &layout)
+        .map_err(|error| error.to_string())?;
+    if maximum > MAX_PROOF_BYTES {
+        return Err(format!(
+            "staged kill proof maximum wire {maximum} exceeds {MAX_PROOF_BYTES} bytes"
+        ));
+    }
+    Ok(maximum)
+}
+
+/// Bound native width, constraints and conservative 4 MiB wire size.
+pub fn research_geometry_v1(
+    statement: ArenaKillResearchStatementV1,
+) -> Result<(usize, usize, usize), String> {
+    let adapter = Adapter::new(statement)?;
+    let maximum = preflight(&adapter)?;
+    Ok((
+        adapter.air_width(),
+        adapter.profile_constraint_count_v1(),
+        maximum,
+    ))
+}
+
+/// Produce the fixed research proof without calling custody code.
+pub fn prove_research_kill_v1(statement: ArenaKillResearchStatementV1) -> Result<Vec<u8>, String> {
+    let adapter = Adapter::new(statement)?;
+    preflight(&adapter)?;
+    prove_proof_managed_note_stark_v1(&adapter, &adapter.columns())
+        .map_err(|error| error.to_string())
+}
+
+/// Independently verify the exact peer-signed bounded scene and native proof.
+pub fn verify_research_kill_v1(
+    statement: ArenaKillResearchStatementV1,
+    proof: &[u8],
+) -> Result<(), String> {
+    let adapter = Adapter::new(statement)?;
+    preflight(&adapter)?;
+    verify_proof_managed_note_stark_v1(&adapter, proof).map_err(|error| error.to_string())
+}
