+//! Whole-match shape and resource tests, outside the unrelated Core unit-test fixtures.
+
+use iroha_core::execution_proofs::{
+    arena_capacity_research::{
+        ARENA_RESEARCH_BATCH_TICKS_V1, ARENA_RESEARCH_INPUT_BYTES_V1,
+        ARENA_RESEARCH_MAX_BATCHES_V1, ARENA_RESEARCH_MAX_RAW_INPUT_BYTES_V1,
+        ARENA_RESEARCH_MAX_SLOTS_V1, ARENA_RESEARCH_MAX_TICKS_V1, ArenaResearchCapacityErrorV1,
+        arena_capacity_research_id_v1, validate_arena_capacity_research_manifest_v1,
+        validate_full_arena_capacity_research_history_v1,
+    },
+    compiled_execution_profile_v1, validate_game_manifest_v1,
+};
+use iroha_crypto::Hash;
+use iroha_data_model::game::{GameAccessV1, GameForcedBatchV1, GameManifestV1, GamePayoutPolicyV1};
+use norito::codec::Encode;
+
+fn manifest() -> GameManifestV1 {
+    GameManifestV1 {
+        version: 1,
+        application_id: Hash::new(b"arena-capacity-research-application"),
+        profile_id: arena_capacity_research_id_v1(),
+        application_parameters: Vec::new(),
+        min_participants: 2,
+        max_participants: ARENA_RESEARCH_MAX_SLOTS_V1,
+        batch_ticks: ARENA_RESEARCH_BATCH_TICKS_V1,
+        max_ticks: ARENA_RESEARCH_MAX_TICKS_V1,
+        max_input_bytes: ARENA_RESEARCH_INPUT_BYTES_V1,
+        max_participant_data_bytes: 0,
+        access: GameAccessV1::Public,
+        payout_policy: GamePayoutPolicyV1::NoPayout,
+    }
+}
+
+fn full_history() -> Vec<GameForcedBatchV1> {
+    (0..ARENA_RESEARCH_MAX_BATCHES_V1)
+        .map(|index| GameForcedBatchV1 {
+            epoch: index as u64,
+            start_tick: (index as u32) * u32::from(ARENA_RESEARCH_BATCH_TICKS_V1),
+            inputs: vec![
+                vec![0; usize::from(ARENA_RESEARCH_INPUT_BYTES_V1)];
+                usize::from(ARENA_RESEARCH_MAX_SLOTS_V1)
+            ],
+            dnf_slots: Vec::new(),
+        })
+        .collect()
+}
+
+#[test]
+fn whole_match_is_bounded_research_but_native_catalog_rejects_it() {
+    let manifest = manifest();
+    let capacity = validate_arena_capacity_research_manifest_v1(&manifest).unwrap();
+    assert_eq!(capacity.batches, 18_000);
+    assert!(
+        capacity.batches > 4_096,
+        "native opening must still reject this size"
+    );
+    assert_eq!(capacity.raw_input_bytes, 3_456_000);
+    assert!(capacity.raw_input_bytes <= ARENA_RESEARCH_MAX_RAW_INPUT_BYTES_V1);
+    assert!(compiled_execution_profile_v1(&manifest.profile_id).is_none());
+    assert!(validate_game_manifest_v1(&manifest).is_err());
+
+    let batches = full_history();
+    assert_eq!(
+        validate_full_arena_capacity_research_history_v1(&manifest, &batches).unwrap(),
+        capacity
+    );
+    // This is a canonical retained-state size, not a proof or transaction.
+    let encoded_bytes = batches.encode().len();
+    assert_eq!(encoded_bytes, 6_030_008);
+    assert!(encoded_bytes <= 8 * 1024 * 1024);
+    eprintln!("Arena research: 18000 batches, {encoded_bytes} canonical forced-history bytes");
+}
+
+#[test]
+fn oversized_or_financial_manifest_is_rejected_before_allocating_history() {
+    let original = manifest();
+    for mutation in 0..9 {
+        let mut bad = original.clone();
+        match mutation {
+            0 => bad.profile_id = Hash::new(b"caller-selected-profile"),
+            1 => bad.max_ticks = 36_002,
+            2 => bad.max_ticks = 35_999,
+            3 => bad.max_participants = 13,
+            4 => bad.max_input_bytes = 17,
+            5 => bad.batch_ticks = 1,
+            6 => bad.payout_policy = GamePayoutPolicyV1::VerifiedAllocations,
+            7 => bad.application_parameters = vec![0; 65_537],
+            8 => bad.min_participants = 1,
+            _ => unreachable!(),
+        }
+        assert_eq!(
+            validate_arena_capacity_research_manifest_v1(&bad),
+            Err(ArenaResearchCapacityErrorV1::Manifest),
+            "mutation {mutation}"
+        );
+    }
+    let mut one_batch = original;
+    one_batch.max_ticks = 2;
+    assert_eq!(
+        validate_arena_capacity_research_manifest_v1(&one_batch)
+            .unwrap()
+            .batches,
+        1
+    );
+}
+
+#[test]
+fn complete_history_rejects_gaps_extra_batches_and_bad_inputs() {
+    let manifest = manifest();
+    let mut batches = full_history();
+    for mutation in 0..7 {
+        let mut bad = batches.clone();
+        match mutation {
+            0 => {
+                bad.pop();
+            }
+            1 => bad.push(bad.last().unwrap().clone()),
+            2 => bad[9_000].epoch += 1,
+            3 => bad[9_000].start_tick += 2,
+            4 => {
+                bad[9_000].inputs.pop();
+            }
+            5 => bad[9_000].inputs[11].push(0),
+            6 => bad[9_000].dnf_slots.push(11),
+            _ => unreachable!(),
+        }
+        assert_eq!(
+            validate_full_arena_capacity_research_history_v1(&manifest, &bad),
+            Err(ArenaResearchCapacityErrorV1::History),
+            "mutation {mutation}"
+        );
+    }
+    batches[9_000].inputs[11][15] ^= 1;
+    assert!(
+        validate_full_arena_capacity_research_history_v1(&manifest, &batches).is_ok(),
+        "structural validation cannot authenticate controls; the later proof must"
+    );
+}
