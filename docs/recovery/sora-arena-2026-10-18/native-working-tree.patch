+fn registration_monetary_plan(
+    stx: &StateTransaction<'_, '_>,
+    stake_account: &AccountId,
+    amount: Quantity,
+    activation_height: u64,
+) -> PublicLaneMonetaryPlanV1 {
+    let stake = stake_context(
+        &stx.world,
+        &stx.nexus.dataspace_catalog,
+        &stx.nexus.staking,
+        stake_account,
+        stx.block_unix_timestamp_ms(),
+    )
+    .expect("fixture stake context");
+    let plan = PublicLaneMonetaryPlanV1 {
+        network_scope: iroha_data_model::nexus::PublicLaneMonetaryScopeV1::Network(
+            *stx.network_id(),
+        ),
+        valid_until_height: stx.block_height(),
+        source_asset: stake.staker_asset,
+        destination_asset: stake.escrow_asset,
+        amount,
+        precondition: PublicLaneMonetaryPreconditionV1::Registration(
+            iroha_data_model::nexus::PublicLaneRegistrationPreconditionV1 { activation_height },
+        ),
+    };
+    assert!(plan.has_canonical_shape(), "fixture registration plan");
+    plan
+}
+
+fn current_registration_monetary_plan(
+    stx: &StateTransaction<'_, '_>,
+    stake_account: &AccountId,
+    amount: Quantity,
+) -> PublicLaneMonetaryPlanV1 {
+    let activation_height =
+        scheduled_validator_eligibility_height(stx).expect("fixture election boundary");
+    registration_monetary_plan(stx, stake_account, amount, activation_height)
+}
