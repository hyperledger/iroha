+/// Exact public AIR rows derived from every pair of state boundaries.
+#[must_use]
+pub fn reference_tick_rows_v1() -> Vec<[i64; arena_kill_history_air::INPUT_COUNT]> {
+    let states = expected_states_v1();
+    (0..TICKS)
+        .map(|tick| tick_row(&states[tick], &states[tick + 1], tick))
+        .collect()
+}
+
+impl ArenaKillHistoryResearchStatementV2 {
+    /// Check exact admission, signatures/history, public scene and AIR row binding.
+    pub fn validate(&self) -> Result<(), String> {
+        validate_admission(&self.manifest, &self.admission)?;
+        if self.rules_hash != research_rules_hash_v1()
+            || self.map_hash != research_map_hash_v1()
+            || self.equipment_hash != research_equipment_hash_v1()
+            || self.manifest_hash
+                != game_message_hash_v1(&self.network_id, "session-manifest", &self.manifest)
+            || self.roster_hash
+                != game_roster_hash_v1(&self.network_id, &self.session_id, &self.admission)
+            || self.outcome != expected_outcome_v2()
+            || self.outcome_hash
+                != game_message_hash_v1(&self.network_id, "session-outcome", &self.outcome)
+        {
+            return Err("kill rules, map, equipment, admission or outcome identity changed".into());
+        }
+        let genesis = research_genesis_root_v1(
+            &self.network_id,
+            self.session_id,
+            &self.manifest,
+            &self.admission,
+        )?;
+        if self.genesis_root != genesis || self.states != expected_states_v1() {
+            return Err("kill genesis or 26-tick state projection differs".into());
+        }
+        let controls = validate_history_v2(self)?;
+        if self.plane_rows.len() != PLANE_COUNT {
+            return Err("omitted or extra wall/body slab".into());
+        }
+        for (index, row) in self.plane_rows.iter().enumerate() {
+            if row[..3] != expected_plane_inputs(index)
+                || !(-1..=Q20 + 1).contains(&row[3])
+                || !matches!(row[4], 0 | 1)
+            {
+                return Err("altered slab source or claimed fraction domain".into());
+            }
+        }
+        for shooter in 0..SHOOTERS {
+            let selected = select_target(&self.plane_rows, shooter)?;
+            if selected != 3 || self.selected_targets[shooter] != selected {
+                return Err("selected kill target differs from ordered proved slabs".into());
+            }
+        }
+        if self.tick_rows.len() != TICKS {
+            return Err("omitted or extra combat transition".into());
+        }
+        for (tick, row) in self.tick_rows.iter().enumerate() {
+            if *row != tick_row(&self.states[tick], &self.states[tick + 1], tick) {
+                return Err("tick AIR row is not bound to complete projected boundaries".into());
+            }
+            if row[arena_kill_history_air::FIRE0] != i64::from(controls[0][tick * 8] & 1)
+                || row[arena_kill_history_air::FIRE1] != i64::from(controls[1][tick * 8] & 1)
+            {
+                return Err("proved fire columns differ from signed P2P controls".into());
+            }
+        }
+        let final_state = &self.states[TICKS];
+        if final_state.reserve.iter().sum::<u64>() + final_state.earnings.iter().sum::<u64>()
+            != 3000
+        {
+            return Err("terminal deposit and award sum is not conserved".into());
+        }
+        Ok(())
+    }
+}
+
+struct PlaneAir {
+    air: IntegerAirV1,
+    inputs: [Value; 3],
+    outputs: [Value; 2],
+}
+impl PlaneAir {
+    fn compile() -> Self {
+        let mut air = IntegerAirV1::default();
+        let inputs = std::array::from_fn(|_| {
+            bounded_input_v1(&mut air, -COORDINATE_LIMIT, COORDINATE_LIMIT)
+                .expect("bounded plane coordinate")
+        });
+        let plane = plane_v1(&mut air, inputs[0], inputs[1], inputs[2]);
+        let outputs = [plane.fraction, plane.nonzero];
+        for (index, value) in inputs.iter().copied().chain(outputs).enumerate() {
+            air.equate(value, Value::fixed(index, value.low, value.high));
+        }
+        Self {
+            air,
+            inputs,
+            outputs,
+        }
+    }
+}
+
+struct Adapter {
+    statement: ArenaKillHistoryResearchStatementV2,
+    plane: PlaneAir,
+    tick: ArenaKillTickAirV1,
+}
+impl Adapter {
+    fn new(statement: ArenaKillHistoryResearchStatementV2) -> Result<Self, String> {
+        statement.validate()?;
+        let plane = PlaneAir::compile();
+        let tick = ArenaKillTickAirV1::compile();
+        for (index, value) in tick.inputs.iter().copied().enumerate() {
+            let Source::Column(_) = value.source else {
+                return Err(format!("kill tick input {index} is not a witness column"));
+            };
+        }
+        for (index, value) in plane
+            .inputs
+            .iter()
+            .copied()
+            .chain(plane.outputs)
+            .enumerate()
+        {
+            let Source::Column(_) = value.source else {
+                return Err(format!("kill plane column {index} changed"));
+            };
+        }
+        Ok(Self {
+            statement,
+            plane,
+            tick,
+        })
+    }
+    fn air_width(&self) -> usize {
+        self.plane.air.width().max(self.tick.air.width())
+    }
+    fn stage_values(&self, stage: usize) -> [i64; FIXED_VALUES] {
+        let mut values = [0_i64; FIXED_VALUES];
+        if stage < TICKS {
+            values[..arena_kill_history_air::INPUT_COUNT]
+                .copy_from_slice(&self.statement.tick_rows[stage]);
+            values[arena_kill_history_air::INPUT_COUNT] = 1;
+        } else {
+            let plane = (stage - TICKS).min(PLANE_COUNT - 1);
+            values[..PLANE_VALUES].copy_from_slice(&self.statement.plane_rows[plane]);
+        }
+        values
+    }
+    fn columns(&self) -> Vec<Vec<F>> {
+        let mut columns = vec![vec![F::ZERO; TRACE_SIZE]; NOTE_COPY_WIDTH_V1 + self.air_width()];
+        for stage in 0..STAGES {
+            let values = self.stage_values(stage);
+            let witness = if stage < TICKS {
+                self.tick.air.witness(
+                    &values[..arena_kill_history_air::INPUT_COUNT],
+                    &values[..arena_kill_history_air::INPUT_COUNT],
+                )
+            } else {
+                self.plane
+                    .air
+                    .witness(&values[..3], &values[..PLANE_VALUES])
+            };
+            for (column, value) in witness.into_iter().enumerate() {
+                for row in (stage..TRACE_SIZE).step_by(STAGES) {
+                    columns[NOTE_COPY_WIDTH_V1 + column][row] = field(value);
+                }
+            }
+        }
+        columns
+    }
+}
