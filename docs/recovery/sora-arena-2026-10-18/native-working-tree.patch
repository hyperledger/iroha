+#[test]
+fn catalog_terms_and_native_interfaces_have_complete_binary_and_json_roundtrips() {
+    use iroha_data_model::isi::{
+        InstructionBox,
+        game_equipment::{PublishGameEquipmentCatalogV1, RegisterGameEquipmentPublisherV1},
+    };
+    use iroha_data_model::query::{
+        SingularQueryBox, SingularQueryOutputBox,
+        game::{FindGameEquipmentCatalogById, FindGameEquipmentPublisherById},
+    };
+    use norito::codec::DecodeAll;
+    let (ledger, catalog, _) = fixture();
+    let (id, record) = publish(&ledger, &catalog).unwrap();
+    let publisher = catalog.publisher_terms();
+    macro_rules! roundtrip {
+        ($value:expr, $ty:ty) => {{
+            let value = $value;
+            let bytes = value.encode();
+            assert_eq!(<$ty>::decode_all(&mut bytes.as_slice()).unwrap(), value);
+            let json = norito::json::to_json(&value).unwrap();
+            assert_eq!(norito::json::from_str::<$ty>(&json).unwrap(), value);
+        }};
+    }
+    roundtrip!(catalog.clone(), GameEquipmentCatalogV1);
+    roundtrip!(publisher.clone(), GameEquipmentPublisherV1);
+    roundtrip!(record.clone(), GameEquipmentCatalogRecordV1);
+    roundtrip!(
+        RegisterGameEquipmentPublisherV1::new(publisher.clone()),
+        RegisterGameEquipmentPublisherV1
+    );
+    roundtrip!(
+        PublishGameEquipmentCatalogV1::new(catalog.clone()),
+        PublishGameEquipmentCatalogV1
+    );
+    roundtrip!(
+        SingularQueryBox::FindGameEquipmentCatalogById(FindGameEquipmentCatalogById::new(id)),
+        SingularQueryBox
+    );
+    roundtrip!(
+        SingularQueryBox::FindGameEquipmentPublisherById(FindGameEquipmentPublisherById::new(
+            publisher.id()
+        )),
+        SingularQueryBox
+    );
+    roundtrip!(
+        SingularQueryOutputBox::GameEquipmentCatalog(record),
+        SingularQueryOutputBox
+    );
+    roundtrip!(
+        SingularQueryOutputBox::GameEquipmentPublisher(publisher.clone()),
+        SingularQueryOutputBox
+    );
+    iroha_data_model::isi::set_instruction_registry(
+        iroha_data_model::instruction_registry::default(),
+    );
+    let instruction: InstructionBox = PublishGameEquipmentCatalogV1::new(catalog.clone()).into();
+    let decoded = InstructionBox::decode_all(&mut instruction.encode().as_slice()).unwrap();
+    assert_eq!(
+        decoded
+            .as_any()
+            .downcast_ref::<PublishGameEquipmentCatalogV1>()
+            .unwrap()
+            .catalog,
+        catalog
+    );
+    let mut json = norito::json::to_value(&catalog).unwrap();
+    json.as_object_mut().unwrap().remove("publisher");
+    assert!(norito::json::from_value::<GameEquipmentCatalogV1>(json).is_err());
+    let mut json = norito::json::to_value(&publisher).unwrap();
+    json.as_object_mut()
+        .unwrap()
+        .insert("trusted".into(), norito::json::Value::Bool(true));
+    assert!(norito::json::from_value::<GameEquipmentPublisherV1>(json).is_err());
+
+    // The first release has one requirement layout: the former clause-shaped
+    // requirement does not implicitly select any catalog.
+    use iroha_data_model::game_resources::{
+        GameResourceRequirementV1, GameResourceReservationClauseV1,
+    };
+    let clause = GameResourceReservationClauseV1 {
+        nft_id: catalog.members[0].nft_id.clone(),
+        expected_metadata_hash: catalog.members[0].metadata_hash,
+        role_id: catalog.role_id,
+        policy: catalog.policy,
+    };
+    assert!(GameResourceRequirementV1::decode_all(&mut clause.encode().as_slice()).is_err());
+    assert!(
+        norito::json::from_value::<GameResourceRequirementV1>(
+            norito::json::to_value(&clause).unwrap()
+        )
+        .is_err()
+    );
+}
