+//! Signed-genesis equipment publisher trust and immutable catalog publication.
+use super::*;
+isi! {
+ /// Install exact immutable publisher terms in signed genesis only.
+ #[derive(crate::DeriveJsonSerialize, crate::DeriveJsonDeserialize)]
+ #[norito(deny_unknown_fields)]
+ #[norito_schema(name = "iroha_data_model::isi::game_equipment::RegisterGameEquipmentPublisherV1")]
+ pub struct RegisterGameEquipmentPublisherV1 {
+  /// Complete exact terms; omissions and unknown fields are rejected.
+  pub publisher: crate::game_equipment::GameEquipmentPublisherV1,
+ }
+}
+impl crate::seal::Instruction for RegisterGameEquipmentPublisherV1 {}
+impl RegisterGameEquipmentPublisherV1 {
+    /// Construct the instruction with its complete immutable terms.
+    #[must_use]
+    pub fn new(publisher: crate::game_equipment::GameEquipmentPublisherV1) -> Self {
+        Self { publisher }
+    }
+}
+impl<'a> norito::core::DecodeFromSlice<'a> for RegisterGameEquipmentPublisherV1 {
+    fn decode_from_slice(bytes: &'a [u8]) -> Result<(Self, usize), norito::core::Error> {
+        let flags = norito::core::effective_decode_flags()
+            .unwrap_or_else(norito::core::default_encode_flags);
+        if flags & norito::core::header_flags::PACKED_STRUCT != 0 {
+            return super::decode_packed_instruction_payload::<Self>(bytes);
+        }
+        let mut offset = 0;
+        let publisher = super::decode_aos_canonical_field::<
+            crate::game_equipment::GameEquipmentPublisherV1,
+        >(super::read_aos_field(bytes, &mut offset, flags)?, flags)?;
+        if offset != bytes.len() {
+            return Err(norito::core::Error::LengthMismatch);
+        }
+        norito::core::note_payload_access(bytes, offset);
+        Ok((Self { publisher }, offset))
+    }
+}
+isi! {
+ /// Publish exact reviewed NFT identities and metadata under a trusted publisher scope.
+ #[derive(crate::DeriveJsonSerialize, crate::DeriveJsonDeserialize)]
+ #[norito(deny_unknown_fields)]
+ #[norito_schema(name = "iroha_data_model::isi::game_equipment::PublishGameEquipmentCatalogV1")]
+ pub struct PublishGameEquipmentCatalogV1 {
+  /// Complete exact terms; omissions and unknown fields are rejected.
+  pub catalog: crate::game_equipment::GameEquipmentCatalogV1,
+ }
+}
+impl crate::seal::Instruction for PublishGameEquipmentCatalogV1 {}
+impl PublishGameEquipmentCatalogV1 {
+    /// Construct the instruction with its complete immutable terms.
+    #[must_use]
+    pub fn new(catalog: crate::game_equipment::GameEquipmentCatalogV1) -> Self {
+        Self { catalog }
+    }
+}
+impl<'a> norito::core::DecodeFromSlice<'a> for PublishGameEquipmentCatalogV1 {
+    fn decode_from_slice(bytes: &'a [u8]) -> Result<(Self, usize), norito::core::Error> {
+        let flags = norito::core::effective_decode_flags()
+            .unwrap_or_else(norito::core::default_encode_flags);
+        if flags & norito::core::header_flags::PACKED_STRUCT != 0 {
+            return super::decode_packed_instruction_payload::<Self>(bytes);
+        }
+        let mut offset = 0;
+        let catalog = super::decode_aos_canonical_field::<
+            crate::game_equipment::GameEquipmentCatalogV1,
+        >(super::read_aos_field(bytes, &mut offset, flags)?, flags)?;
+        if offset != bytes.len() {
+            return Err(norito::core::Error::LengthMismatch);
+        }
+        norito::core::note_payload_access(bytes, offset);
+        Ok((Self { catalog }, offset))
+    }
+}
