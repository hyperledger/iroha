+#!/usr/bin/env python3
+"""Compile the actual Arena hit AIR and native STARK wire layout; do not prove.
+
+This is a bounded research measurement. It uses the native relation, field and
+aggregate-proof codec with pinned workspace rlibs, but never calls a prover or
+registers a game profile. A successful report is not a valid kill proof.
+"""
+
+import argparse
+import json
+from pathlib import Path
+import subprocess
+import tempfile
+
+import check_arena_damage_stark as guard
+
+
+ROOT = Path(__file__).resolve().parent.parent
+RELATIONS = (
+    "integer_air", "checked_integer_air", "arena_aim_air",
+    "arena_geometry_air", "arena_hit_air",
+)
+
+
+def create_output(target, explicit):
+    """Give every run a new directory so prior measurements cannot be reused."""
+    if explicit is not None:
+        explicit = explicit.resolve()
+        explicit.mkdir(parents=True, exist_ok=False)
+        return explicit
+    parent = target / "arena-hit-stark-feasibility" / "runs"
+    parent.mkdir(parents=True, exist_ok=True)
+    return Path(tempfile.mkdtemp(prefix="layout-", dir=parent))
+
+
+def native_field(source):
+    """Extract the complete actual base/extension field with unique boundaries."""
+    start = "/// Canonical Goldilocks field element."
+    end = "/// Failure in protocol-neutral transparent-proof machinery."
+    if source.count(start) != 1 or source.count(end) != 1:
+        raise ValueError("native field extraction boundaries changed")
+    names = (
+        "GOLDILOCKS_MODULUS_V1", "GOLDILOCKS_EPSILON_V1",
+        "GOLDILOCKS_GENERATOR_V1", "GOLDILOCKS_FP4_DEGREE_V1",
+        "GOLDILOCKS_FP4_WIRE_BYTES_V1", "GOLDILOCKS_FP4_NONRESIDUE_V1",
+    )
+    constants = []
+    for name in names:
+        matches = [line for line in source.splitlines() if line.startswith(
+            ("const " + name + ":", "pub(crate) const " + name + ":"))]
+        if len(matches) != 1 or not matches[0].endswith(";"):
+            raise ValueError("native field constant changed: " + name)
+        constants.extend(matches)
+    return "use zeroize::Zeroize as _;\n" + "\n".join(constants) + "\n" + source[source.index(start):source.index(end)]
+
+
+def write_harness(output):
+    """Include current native sources and append only a private measurement entry."""
+    source_root = ROOT / "crates/iroha_core/src/execution_proofs"
+    field_path = ROOT / "crates/iroha_core/src/privacy_engines/transparent_stark.rs"
+    field = native_field(field_path.read_text())
+    (output / "native_field.rs").write_text(field)
+    modules = []
+    for name in RELATIONS:
+        path = source_root / (name + ".rs")
+        if name == "arena_hit_air":
+            # This copied source has identical equations; the appended accessor
+            # merely exposes the private compiled graph to the research binary.
+            text = path.read_text() + "\npub(super) fn research_shape(players:usize,walls:usize,attacker:usize)->(usize,usize){let graph=ArenaHitAirV1::compile(players,walls,attacker).unwrap();(graph.air.width(),graph.air.constraint_count())}\n"
+            copy = output / "arena_hit_air.rs"
+            copy.write_text(text)
+            path = copy
+        modules.append("#[path = " + json.dumps(str(path)) + "] mod " + name + ";")
+    stark = source_root / "stark/mod.rs"
+    modules.append("#[path = " + json.dumps(str(stark)) + "] mod stark;")
+    harness = r'''#![allow(dead_code)]
+mod privacy_engines { pub mod transparent_stark { include!("native_field.rs"); } }
+mod execution_proofs {
+''' + "\n".join(modules) + r'''
+use stark::{aggregate_stark::{AggregateProofLayoutV1, AggregateStarkParametersV1,
+    AggregateTraceGroupLayoutV1, maximum_encoded_proof_with_deep_bytes_v1},
+    proof_managed_note_stark::{NOTE_COPY_WIDTH_V1, NOTE_COPY_AUX_WIDTH_V1}};
+pub fn measure() -> Result<(), Box<dyn std::error::Error>> {
+    const TRACE_LOG: u8 = 13;
+    const TRACE_ROWS: u128 = 1 << TRACE_LOG;
+    const BLOWUP: u128 = 8;
+    const FIELD_BYTES: u128 = 8;
+    const CONSENSUS_CAP: usize = 4 * 1024 * 1024;
+    println!("players,walls,air_width,air_constraints,public_inputs,base_width,aux_width,lde_rows,mandatory_trace_opening_bytes,max_encoded_proof_bytes,consensus_cap_bytes,openings_exceed_cap,dense_base_lde_bytes,dense_aux_lde_bytes");
+    for (players, walls) in [(1,0),(2,0),(2,3),(2,4),(8,4),(12,4)] {
+        let (width, constraints) = arena_hit_air::research_shape(players, walls, 0);
+        let base_width = width + NOTE_COPY_WIDTH_V1;
+        let parameters = AggregateStarkParametersV1 {
+            proof_magic: *b"ARH1", proof_version: 1, security_lanes: 1,
+            query_count: 136, blowup_log2: 3, terminal_log2: 10,
+            terminal_degree_bound: 143, composition_degree_chunks: 4,
+            minimum_trace_log2: TRACE_LOG, maximum_trace_log2: TRACE_LOG,
+            maximum_trace_groups: 1, maximum_segment_instances: 1,
+            maximum_base_columns_per_instance: base_width,
+            maximum_aux_columns_per_instance: NOTE_COPY_AUX_WIDTH_V1,
+            maximum_proof_bytes: CONSENSUS_CAP,
+        };
+        let layout = AggregateProofLayoutV1::new(parameters,
+            vec![AggregateTraceGroupLayoutV1 {
+                native_trace_log2: TRACE_LOG, segment_instances: 1,
+                base_width, aux_width: NOTE_COPY_AUX_WIDTH_V1,
+            }])?;
+        let wire = maximum_encoded_proof_with_deep_bytes_v1(parameters, &layout)?;
+        // Canonical query encoding has distinct current/next full-width base
+        // and auxiliary field rows. This is a lower bound independent of any
+        // Merkle frontier, FRI, DEEP, transcript, or envelope overhead.
+        let mandatory_openings = (base_width + NOTE_COPY_AUX_WIDTH_V1) as u128
+            * 2 * parameters.query_count as u128 * FIELD_BYTES;
+        let base_bytes = base_width as u128 * TRACE_ROWS * BLOWUP * FIELD_BYTES;
+        let aux_bytes = NOTE_COPY_AUX_WIDTH_V1 as u128 * TRACE_ROWS * BLOWUP * FIELD_BYTES;
+        println!("{players},{walls},{width},{constraints},{},{base_width},{},{},{mandatory_openings},{wire},{CONSENSUS_CAP},{},{base_bytes},{aux_bytes}",
+            5 + 6 * players + 6 * walls, NOTE_COPY_AUX_WIDTH_V1,
+            layout.common_lde_size(), mandatory_openings > CONSENSUS_CAP as u128);
+    }
+    Ok(())
+}
+}
+fn main() -> Result<(), Box<dyn std::error::Error>> { execution_proofs::measure() }
+'''
+    (output / "harness.rs").write_text(harness)
+    provenance = [field_path, *(source_root / (name + ".rs") for name in RELATIONS),
+                  *sorted((source_root / "stark").glob("*.rs"))]
+    return {str(path.relative_to(ROOT)): guard.file_hash(path) for path in provenance}
+
+
+def main():
+    """Compile and run one source-sealed layout measurement."""
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--target-dir", type=Path, default=ROOT / "target")
+    parser.add_argument("--dependency-manifest", type=Path)
+    parser.add_argument("--output-dir", type=Path)
+    args = parser.parse_args()
+    target = args.target_dir.resolve()
+    deps = (target / "debug/deps").resolve()
+    output = create_output(target, args.output_dir)
+    print("Exclusive hit layout run:", output, flush=True)
+    before = after = None
+    error = None
+    try:
+        dependencies = guard.select_dependencies(deps, args.dependency_manifest)
+        before = guard.capture_seal(ROOT, dependencies)
+        guard.write_json(output / "seal-before.json", before)
+        sources = write_harness(output)
+        externs = [arg for name, item in dependencies.items()
+                   for arg in ("--extern", name + "=" + item["path"])]
+        command = ["rustc", "--edition=2024", "-C", "opt-level=2",
+                   str(output / "harness.rs"), "-L", "dependency=" + str(deps),
+                   "-o", str(output / "native-hit-layout")] + externs
+        subprocess.run(command, cwd=ROOT, check=True)
+        guard.require_same_seal(before, guard.capture_seal(ROOT, dependencies))
+        result = subprocess.run([str(output / "native-hit-layout")], cwd=ROOT,
+                                capture_output=True, text=True, check=True)
+        (output / "measurements.csv").write_text(result.stdout)
+        print(result.stdout, end="")
+        after = guard.capture_seal(ROOT, dependencies)
+        guard.write_json(output / "seal-after.json", after)
+        guard.require_same_seal(before, after)
+        if sources != {name: guard.file_hash(ROOT / name) for name in sources}:
+            raise ValueError("native relation or backend source changed")
+        guard.write_json(output / "source-provenance.json", {
+            "scope": "compiled AIR and native proof-layout bound only; no generated proof",
+            "sources_sha256": sources, "dependencies": dependencies,
+            "rustc_command": command,
+        })
+    except Exception as failure:
+        error = str(failure)
+    status = {"schema": "iroha.arena.hit_stark_feasibility.v1",
+              "status": "invalid" if error else "compiled_layout",
+              "proof_verified": False, "registered": False, "research_only": True}
+    if error:
+        status["error"] = error
+    status["artifacts_sha256"] = {path.name: guard.file_hash(path)
+                                   for path in sorted(output.iterdir())
+                                   if path.is_file() and path.name != "run-status.json"}
+    guard.write_json(output / "run-status.json", status)
