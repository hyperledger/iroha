+//! Non-shipping, isolated native equipment custody regression scenario.
+//! No caller state or private custody capability enters or leaves this fixture.
+use crate::{
+    kura::Kura,
+    query::store::LiveQueryStore,
+    smartcontracts::{
+        Execute,
+        isi::nft_custody::{prepare_nft_release_v1, prepare_nft_reservations_v1, reserve_nft_v1},
+    },
+    state::{State, StateReadOnly, World, WorldReadOnly},
+};
+use iroha_crypto::{Algorithm, Hash, KeyPair};
+use iroha_data_model::{
+    Registrable,
+    isi::nft_market::{BuyNftV1, CancelNftOfferV1, OfferNftV1},
+    nft_market::NftCustodyPurposeV1,
+    prelude::*,
+};
+use iroha_model_base::{domain::DomainId, metadata::Metadata};
+use iroha_primitives::numeric::Quantity;
+use mv::storage::StorageReadOnly;
+use norito::codec::Encode;
+use std::num::NonZeroU64;
+
+/// Exercise the actual private reservation and native marketplace/transfer guards.
+///
+/// Uses a disposable in-memory World and temporary Kura. It never qualifies a
+/// profile, accepts caller state, publishes a transaction, or returns a capability.
+///
+/// # Panics
+/// Panics if any assertion in this non-shipping regression scenario fails.
+pub fn assert_equipped_custody_guards_for_testing() {
+    let account = |seed| {
+        AccountId::new(
+            KeyPair::try_from_seed(vec![seed; 32], Algorithm::Ed25519)
+                .unwrap()
+                .public_key()
+                .clone(),
+        )
+    };
+    let owner = account(71);
+    let buyer = account(72);
+    let domain = DomainId::try_new("equipment", "universal").unwrap();
+    let asset_definition =
+        AssetDefinitionId::derive_from_components(domain.clone(), "xor".parse().unwrap());
+    let world = World::with_assets(
+        [Domain::new(domain).build(&owner)],
+        [&owner, &buyer].map(|id| Account::new(id.clone()).build(&owner)),
+        [AssetDefinition::numeric(
+            asset_definition.clone(),
+            "Equipment custody test",
+            AssetBalancePolicy::Global,
+            None,
+        )
+        .build(&owner)],
+        [],
+        [],
+    );
+    let state = State::new_for_testing(
+        world,
+        Kura::blank_kura_for_testing(),
+        LiveQueryStore::start_test(),
+    );
+    let mut block = state.block(BlockHeader::new(
+        NonZeroU64::new(1).unwrap(),
+        None,
+        None,
+        1000,
+        0,
+    ));
+    let mut st = block.transaction();
+    let reservation_id = Hash::new(b"isolated equipment reservation test");
+    let nft_id: NftId = "katana$equipment.universal".parse().unwrap();
+    Register::nft(Nft::new(nft_id.clone(), Metadata::default()))
+        .execute(&owner, &mut st)
+        .unwrap();
+    let metadata_hash = Hash::new(st.world.nft(&nft_id).unwrap().value().content.encode());
+    let old_offer = OfferNftV1::new(
+        Hash::new(b"equipment sale before admission"),
+        nft_id.clone(),
+        asset_definition.clone(),
+        Quantity::from(1_u32),
+        st.block_height() + 100,
+        None,
+    );
+    old_offer.clone().execute(&owner, &mut st).unwrap();
+    let sale = st
+        .world
+        .nft_sale_offers
+        .get(&old_offer.offer_id)
+        .unwrap()
+        .clone();
+    assert!(
+        prepare_nft_reservations_v1(
+            &st,
+            &owner,
+            reservation_id,
+            NftCustodyPurposeV1::GameResource,
+            vec![(nft_id.clone(), metadata_hash)],
+        )
+        .is_err(),
+        "a listed NFT cannot be equipped"
+    );
+    CancelNftOfferV1::new(old_offer.offer_id, sale.offer_hash)
+        .execute(&owner, &mut st)
+        .unwrap();
+    let held = reserve_nft_v1(
+        &mut st,
+        &owner,
+        reservation_id,
+        NftCustodyPurposeV1::GameResource,
+        &nft_id,
+    )
+    .unwrap();
+    let new_offer = OfferNftV1 {
+        offer_id: Hash::new(b"equipment sale during admission"),
+        ..old_offer
+    };
+    assert!(new_offer.clone().execute(&owner, &mut st).is_err());
+    assert!(
+        BuyNftV1::new(sale.offer).execute(&buyer, &mut st).is_err(),
+        "closed sale cannot deliver equipped custody"
+    );
+    assert!(
+        Transfer::nft(held.custody.clone(), nft_id.clone(), buyer.clone())
+            .execute(&owner, &mut st)
+            .is_err()
+    );
+    assert!(
+        SetKeyValue::nft(nft_id.clone(), "weapon".parse().unwrap(), "forged")
+            .execute(&owner, &mut st)
+            .is_err()
+    );
+    assert!(
+        Unregister::nft(nft_id.clone())
+            .execute(&owner, &mut st)
+            .is_err()
+    );
+    assert!(
+        prepare_nft_reservations_v1(
+            &st,
+            &owner,
+            Hash::new(b"second match"),
+            NftCustodyPurposeV1::GameResource,
+            vec![(nft_id.clone(), metadata_hash)],
+        )
+        .is_err()
+    );
+    for purpose in [NftCustodyPurposeV1::Sale, NftCustodyPurposeV1::GameWager] {
+        assert!(prepare_nft_release_v1(&st, reservation_id, purpose, &nft_id, &buyer).is_err());
+    }
+    assert_eq!(
+        st.world.nft(&nft_id).unwrap().value().owned_by,
+        held.custody
+    );
+    assert_eq!(
+        st.world.nft_custody_by_nft.get(&nft_id),
+        Some(&held.custody)
+    );
+    assert!(st.world.nft_sale_offers.get(&new_offer.offer_id).is_none());
+    // Exercise the same protected return capability used by terminal resource payouts.
+    prepare_nft_release_v1(
+        &st,
+        reservation_id,
+        NftCustodyPurposeV1::GameResource,
+        &nft_id,
+        &owner,
+    )
+    .unwrap()
+    .apply(&mut st);
+    assert_eq!(st.world.nft(&nft_id).unwrap().value().owned_by, owner);
+    new_offer.execute(&owner, &mut st).unwrap();
+}
