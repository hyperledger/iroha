+++ b/crates/iroha_core/src/execution_proofs/arena_kill_history_air.rs
@@ -0,0 +1,207 @@
+//! Unregistered bounded Arena research AIR for a two-shooter, 26-tick FFA kill.
+//!
+//! This is a deliberately closed 26-tick, three-player fixture, not a general
+//! execution relation and never a custody-authorizing profile. The inputs are
+//! fixed public columns supplied by the research statement; no kill log is an
+//! unconstrained witness. Geometry and signed input binding live in the caller.
+
+use super::{
+    checked_integer_air::{boolean_input_v1, bounded_input_v1},
+    integer_air::{IntegerAirV1, Value},
+};
+
+pub(super) const INPUT_COUNT: usize = 37;
+pub(super) const HEALTH_IN: usize = 0;
+pub(super) const HEALTH_OUT: usize = 1;
+pub(super) const CD0_IN: usize = 2;
+pub(super) const CD0_OUT: usize = 3;
+pub(super) const CD1_IN: usize = 4;
+pub(super) const CD1_OUT: usize = 5;
+pub(super) const AMMO0_IN: usize = 6;
+pub(super) const AMMO0_OUT: usize = 7;
+pub(super) const AMMO1_IN: usize = 8;
+pub(super) const AMMO1_OUT: usize = 9;
+pub(super) const FIRE0: usize = 10;
+pub(super) const FIRE1: usize = 11;
+pub(super) const SHOT0: usize = 12;
+pub(super) const SHOT1: usize = 13;
+pub(super) const DEALT0: usize = 14;
+pub(super) const DEALT1: usize = 15;
+pub(super) const ALIVE_IN: usize = 16;
+pub(super) const ALIVE_OUT: usize = 17;
+pub(super) const RESERVE_IN: usize = 18;
+pub(super) const RESERVE_OUT: usize = 19;
+pub(super) const EARN0_IN: usize = 20;
+pub(super) const EARN0_OUT: usize = 21;
+pub(super) const EARN1_IN: usize = 22;
+pub(super) const EARN1_OUT: usize = 23;
+pub(super) const PAID_IN: usize = 24;
+pub(super) const PAID_OUT: usize = 25;
+pub(super) const DEATHS_IN: usize = 26;
+pub(super) const DEATHS_OUT: usize = 27;
+pub(super) const KILLS1_IN: usize = 28;
+pub(super) const KILLS1_OUT: usize = 29;
+pub(super) const DEATH: usize = 30;
+pub(super) const CHAIN: usize = 31;
+pub(super) const RESPAWN_IN: usize = 32;
+pub(super) const RESPAWN_OUT: usize = 33;
+pub(super) const TERMINAL_IN: usize = 34;
+pub(super) const TERMINAL_OUT: usize = 35;
+pub(super) const FINAL_TICK: usize = 36;
+
+pub(super) struct ArenaKillTickAirV1 {
+    pub(super) air: IntegerAirV1,
+    pub(super) inputs: [Value; INPUT_COUNT],
+}
+
+impl ArenaKillTickAirV1 {
+    pub(super) fn compile() -> Self {
+        let mut air = IntegerAirV1::default();
+        let mut inputs = [Value::constant(0); INPUT_COUNT];
+        for (index, item) in inputs.iter_mut().enumerate() {
+            *item = if matches!(
+                index,
+                FIRE0
+                    | FIRE1
+                    | SHOT0
+                    | SHOT1
+                    | ALIVE_IN
+                    | ALIVE_OUT
+                    | DEATH
+                    | CHAIN
+                    | TERMINAL_IN
+                    | TERMINAL_OUT
+                    | FINAL_TICK
+            ) {
+                boolean_input_v1(&mut air).value()
+            } else {
+                let (low, high) = match index {
+                    HEALTH_IN | HEALTH_OUT => (0, 125),
+                    CD0_IN | CD0_OUT | CD1_IN | CD1_OUT => (0, 12),
+                    AMMO0_IN | AMMO0_OUT | AMMO1_IN | AMMO1_OUT => (0, 24),
+                    DEALT0 | DEALT1 => (0, 22),
+                    RESERVE_IN | RESERVE_OUT => (0, 1000),
+                    EARN0_IN | EARN0_OUT | EARN1_IN | EARN1_OUT => (0, 100),
+                    PAID_IN | PAID_OUT | DEATHS_IN | DEATHS_OUT | KILLS1_IN | KILLS1_OUT => (0, 10),
+                    RESPAWN_IN | RESPAWN_OUT => (0, 480),
+                    _ => unreachable!("closed tick AIR index"),
+                };
+                bounded_input_v1(&mut air, low, high).expect("closed bounded tick input")
+            };
+        }
+        for (cooldown_in, cooldown_out, ammo_in, ammo_out, fire, shot) in [
+            (CD0_IN, CD0_OUT, AMMO0_IN, AMMO0_OUT, FIRE0, SHOT0),
+            (CD1_IN, CD1_OUT, AMMO1_IN, AMMO1_OUT, FIRE1, SHOT1),
+        ] {
+            let decreased = air.sub_constant(inputs[cooldown_in], 1);
+            let ready_cooldown = air.maximum(decreased, Value::constant(0));
+            let ready = air.less(ready_cooldown, Value::constant(1));
+            let available = air.less(Value::constant(0), inputs[ammo_in]);
+            let ready = air.and(ready, available);
+            let shot_value = air.and(inputs[fire], ready);
+            air.equate(inputs[shot], shot_value);
+            let cooldown_after = air.select(shot_value, Value::constant(12), ready_cooldown);
+            air.equate(inputs[cooldown_out], cooldown_after);
+            let ammo_after = air.sub(inputs[ammo_in], shot_value);
+            air.equate(inputs[ammo_out], ammo_after);
+        }
+        let shot0_damage = air.mul_constant(inputs[SHOT0], 22);
+        let shot0_damage = air.mul(shot0_damage, inputs[ALIVE_IN]);
+        let dealt0 = air.minimum(inputs[HEALTH_IN], shot0_damage);
+        air.equate(inputs[DEALT0], dealt0);
+        let mid_health = air.sub(inputs[HEALTH_IN], dealt0);
+        let shot1_damage = air.mul_constant(inputs[SHOT1], 22);
+        let shot1_damage = air.mul(shot1_damage, inputs[ALIVE_IN]);
+        let dealt1 = air.minimum(mid_health, shot1_damage);
+        air.equate(inputs[DEALT1], dealt1);
+        let next_health = air.sub(mid_health, dealt1);
+        air.equate(inputs[HEALTH_OUT], next_health);
+        let had_health = air.less(Value::constant(0), inputs[HEALTH_IN]);
+        let no_health = air.less(next_health, Value::constant(1));
+        let died = air.and(inputs[ALIVE_IN], had_health);
+        let died = air.and(died, no_health);
+        air.equate(inputs[DEATH], died);
+        let next_alive = air.sub(inputs[ALIVE_IN], died);
+        air.equate(inputs[ALIVE_OUT], next_alive);
+        // The fatal tick establishes the victim's 480-tick respawn timer;
+        // the signed idle tick then consumes exactly one tick of it.
+        let decayed_input = air.sub_constant(inputs[RESPAWN_IN], 1);
+        let decayed = air.maximum(decayed_input, Value::constant(0));
+        let continuing = air.select(inputs[ALIVE_IN], Value::constant(0), decayed);
+        let respawn_out = air.select(died, Value::constant(480), continuing);
+        air.equate(inputs[RESPAWN_OUT], respawn_out);
+        air.equate(inputs[TERMINAL_IN], Value::constant(0));
+        air.equate(inputs[TERMINAL_OUT], inputs[FINAL_TICK]);
+        let final_has_no_chain = air.mul(inputs[FINAL_TICK], inputs[CHAIN]);
+        air.equate(final_has_no_chain, Value::constant(0));
+        // This fixed FFA trace has ordered shooter 0 damage, followed by
+        // shooter 1's lethal damage. Shooter 0 is the only damage assist.
+        let no_first_shot = air.not(inputs[SHOT0]);
+        let death_without_first_shot = air.mul(died, no_first_shot);
+        air.equate(death_without_first_shot, Value::constant(0));
+        let no_second_shot = air.not(inputs[SHOT1]);
+        let death_without_second_shot = air.mul(died, no_second_shot);
+        air.equate(death_without_second_shot, Value::constant(0));
+        let mid_positive = air.less(Value::constant(0), mid_health);
+        let no_second_damage = air.not(mid_positive);
+        let death_without_second_damage = air.mul(died, no_second_damage);
+        air.equate(death_without_second_damage, Value::constant(0));
+        // The admitted initial deposit is exactly 1000 atomic units per slot;
+        // the fixed tranche is derived algebraically, not read from a kill log.
+        let (tranche, remainder) = air.divmod_unsigned(Value::constant(1000), 10);
+        air.equate(remainder, Value::constant(0));
+        let transfer = air.mul(died, tranche);
+        let assist_numerator = air.mul_constant(transfer, 20);
+        let (assist_credit, assist_remainder) = air.divmod_unsigned(assist_numerator, 100);
+        air.equate(assist_remainder, Value::constant(0));
+        let killer_credit = air.sub(transfer, assist_credit);
+        let reserve_after = air.sub(inputs[RESERVE_IN], transfer);
+        air.equate(inputs[RESERVE_OUT], reserve_after);
+        let assist_after = air.add(inputs[EARN0_IN], assist_credit);
+        air.equate(inputs[EARN0_OUT], assist_after);
+        let killer_after = air.add(inputs[EARN1_IN], killer_credit);
+        air.equate(inputs[EARN1_OUT], killer_after);
+        for (before, after) in [
+            (PAID_IN, PAID_OUT),
+            (DEATHS_IN, DEATHS_OUT),
+            (KILLS1_IN, KILLS1_OUT),
+        ] {
+            let updated = air.add(inputs[before], died);
+            air.equate(inputs[after], updated);
+        }
+        // The first 25 tick stages are consecutive trace rows. A Boolean
+        // public chain selector enforces every mutable projected boundary in
+        // native AIR; the final tick and geometry stages have selector zero.
+        for (out, next_in) in [
+            (HEALTH_OUT, HEALTH_IN),
+            (CD0_OUT, CD0_IN),
+            (CD1_OUT, CD1_IN),
+            (AMMO0_OUT, AMMO0_IN),
+            (AMMO1_OUT, AMMO1_IN),
+            (ALIVE_OUT, ALIVE_IN),
+            (RESERVE_OUT, RESERVE_IN),
+            (EARN0_OUT, EARN0_IN),
+            (EARN1_OUT, EARN1_IN),
+            (PAID_OUT, PAID_IN),
+            (DEATHS_OUT, DEATHS_IN),
+            (KILLS1_OUT, KILLS1_IN),
+            (RESPAWN_OUT, RESPAWN_IN),
+            (TERMINAL_OUT, TERMINAL_IN),
+        ] {
+            air.gated_equate(
+                inputs[CHAIN],
+                inputs[out],
+                IntegerAirV1::next(inputs[next_in]),
+            );
+        }
+        let conserved_before = air.add(inputs[RESERVE_IN], inputs[EARN0_IN]);
+        let conserved_before = air.add(conserved_before, inputs[EARN1_IN]);
+        let conserved_after = air.add(inputs[RESERVE_OUT], inputs[EARN0_OUT]);
+        let conserved_after = air.add(conserved_after, inputs[EARN1_OUT]);
+        air.equate(conserved_before, conserved_after);
+        for (index, input) in inputs.iter().copied().enumerate() {
+            air.equate(input, Value::fixed(index, input.low, input.high));
+        }
+        Self { air, inputs }
+    }
+}
