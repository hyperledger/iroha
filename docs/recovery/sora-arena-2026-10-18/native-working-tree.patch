+++ b/crates/iroha_core/src/execution_proofs/arena_movement_research.rs
@@ -0,0 +1,537 @@
+//! Unregistered, unfunded two-player/two-tick Arena movement research proof.
+//!
+//! Both admitted gameplay keys sign the same commitment set, and each signed
+//! commitment opens to its exact canonical two-tick input payload. This is a
+//! peer-accepted research batch, **not** a consensus-selected `GameForcedBatchV1`:
+//! the compiled registry still rejects this profile and no native session can
+//! accept or settle it. The proof covers positions only, under the exact narrow
+//! collision-free input restrictions in `validate`.
+
+use super::{
+    arena_movement_air::{ArenaMovementAirV1, INPUT_COUNT},
+    integer_air::{Value, field},
+    registry::compiled_execution_profile_v1,
+    stark::{
+        aggregate_stark::{
+            AggregateProofLayoutV1, AggregateStarkDomainsV1, AggregateStarkParametersV1,
+            AggregateTraceGroupLayoutV1, maximum_encoded_proof_with_deep_bytes_v1,
+        },
+        proof_managed_note_stark::{
+            NOTE_COPY_AUX_WIDTH_V1, NOTE_COPY_FIXED_WIDTH_V1, NOTE_COPY_WIDTH_V1,
+            NoteCopyCellPolicyV1, NoteCopyChallengesV1, NoteCopyScheduleV1,
+            ProofManagedNoteStarkAdapterV1, ProofManagedNoteStarkErrorV1 as NativeError,
+            ProofManagedNoteStarkProtocolV1, prove_proof_managed_note_stark_v1,
+            verify_proof_managed_note_stark_v1,
+        },
+        transparent_stark::{
+            GoldilocksDigest384V1, GoldilocksFieldV1 as F, TransparentStarkDigestContextV1,
+            TransparentTranscriptV1, goldilocks_digest384_frame_v1,
+        },
+    },
+};
+use iroha_crypto::{Algorithm, Hash};
+use iroha_data_model::{
+    NetworkId,
+    game::{
+        GameAccessV1, GameAdmissionBodyV1, GameCommitmentSetV1, GameForcedBatchV1,
+        GameInputCommitmentV1, GameInputRevealV1, GameManifestV1, GamePayoutPolicyV1,
+        game_commitment_set_hash_v1, game_input_commitment_v1, game_input_message_hash_v1,
+        game_message_hash_v1,
+    },
+};
+use iroha_primitives::numeric::Quantity;
+use norito::codec::Encode;
+use sha2::{Digest, Sha256};
+
+const TRACE_LOG: u8 = 13;
+const TRACE_SIZE: usize = 1 << TRACE_LOG;
+const MAX_PROOF_BYTES: usize = 4 * 1024 * 1024;
+const CONTEXT: TransparentStarkDigestContextV1 =
+    TransparentStarkDigestContextV1::execution_v1(b"arena-movement-research-v1");
+const DESCRIPTOR: &[u8] = b"unregistered-arena-movement-research-v1:two-players:two-ticks:offline-zero-bond:forward-axis-cardinal-no-buttons:no-wall-collision:peer-signed-commit-reveal:not-ledger-selected:no-kill-no-payout:no-qualification";
+const RULES: &[u8] = b"arena-core:sora-arena-first-release-6:ffa:map0:samurai-class0:katana-weapon0:offline=true:base-bond=0:tick=60hz:spawn=(18000,0),(-18000,0):move-x=-127..127:move-y=0:buttons=0:pitch=0:yaw=0|16384|32768|49152:forward-q15-cardinal:velocity=trunc(move-x*80/127):x-then-y-safe-motion:collision-free-corridor:x=17840..18160|-18160..-17840:y=-160..160:z=0";
+const MAP_ZERO_WALLS: &[u8] = b"map0:walls=(-8000,-9000,-6500,6000,3800);(6500,-6000,8000,9000,3800);(-4000,7000,3500,8000,2300):radius=350:world-bounds=24000";
+const DOMAINS: AggregateStarkDomainsV1 = AggregateStarkDomainsV1 {
+    digest_context: CONTEXT,
+    base_leaf: b"arena-move-base-leaf-v1",
+    base_node: b"arena-move-base-node-v1",
+    aux_leaf: b"arena-move-aux-leaf-v1",
+    aux_node: b"arena-move-aux-node-v1",
+    composition_leaf: b"arena-move-composition-leaf-v1",
+    composition_node: b"arena-move-composition-node-v1",
+    fri_leaf: b"arena-move-fri-leaf-v1",
+    fri_node: b"arena-move-fri-node-v1",
+    layout_label: b"arena-move-layout-v1",
+    base_root_label: b"arena-move-base-root-v1",
+    aux_root_label: b"arena-move-aux-root-v1",
+    composition_root_label: b"arena-move-composition-root-v1",
+    fri_root_label: b"arena-move-fri-root-v1",
+    fri_beta_label: b"arena-move-fri-beta-v1",
+    query_seed: b"arena-move-query-seed-v1",
+};
+
+/// A deliberately unregistered ID; `OpenGameSessionV1` rejects this manifest.
+#[must_use]
+pub fn research_profile_id_v1() -> Hash {
+    Hash::new(DESCRIPTOR)
+}
+
+/// These exact manifest terms cannot authorize a live bond or NFT reservation.
+#[must_use]
+pub fn research_manifest_v1() -> GameManifestV1 {
+    GameManifestV1 {
+        version: 1,
+        application_id: Hash::new(b"sora-arena-movement-research-v1"),
+        profile_id: research_profile_id_v1(),
+        application_parameters: vec![0, 1], // map zero; offline=true
+        min_participants: 2,
+        max_participants: 2,
+        batch_ticks: 2,
+        max_ticks: 2,
+        max_input_bytes: 16,
+        max_participant_data_bytes: 3,
+        access: GameAccessV1::Public,
+        payout_policy: GamePayoutPolicyV1::NoPayout,
+    }
+}
+
+/// The fixed restricted rules, including the collision-free map-zero corridor.
+#[must_use]
+pub fn research_rules_hash_v1() -> Hash {
+    Hash::new(RULES)
+}
+
+/// Exact first Arena map wall layout used by the corridor lemma.
+#[must_use]
+pub fn research_map_hash_v1() -> Hash {
+    Hash::new(MAP_ZERO_WALLS)
+}
+
+/// Research-only admission-bound state commitment; no registry dispatch accepts it.
+pub fn research_genesis_root_v1(
+    network: &NetworkId,
+    session_id: Hash,
+    manifest: &GameManifestV1,
+    admission: &GameAdmissionBodyV1,
+) -> Result<Hash, String> {
+    validate_admission(manifest, admission)?;
+    Ok(game_message_hash_v1(
+        network,
+        "arena-movement-research-genesis",
+        &(
+            session_id,
+            manifest.clone(),
+            admission.clone(),
+            research_rules_hash_v1(),
+            research_map_hash_v1(),
+            [[18_000_i32, 0], [-18_000, 0]],
+        ),
+    ))
+}
+
+fn validate_admission(
+    manifest: &GameManifestV1,
+    admission: &GameAdmissionBodyV1,
+) -> Result<(), String> {
+    if *manifest != research_manifest_v1()
+        || compiled_execution_profile_v1(&manifest.profile_id).is_some()
+    {
+        return Err("research manifest is not the exact unregistered offline profile".into());
+    }
+    admission.validate()?;
+    if admission.participants.len() != 2
+        || !admission.wagers.is_empty()
+        || !admission.resources.is_empty()
+    {
+        return Err("research admission needs exactly two unfunded, unreserved players".into());
+    }
+    for participant in &admission.participants {
+        if participant.application_data != [0, 0, 0]
+            || participant.deposit != Quantity::zero()
+            || participant.input_key.algorithm() != Algorithm::Ed25519
+        {
+            return Err("research admission team/class/weapon/bond mismatch".into());
+        }
+    }
+    Ok(())
+}
+
+/// Public, versioned witness statement. `positions[tick][slot]` contains integer
+/// x/y in millimetres; the accepted input bytes determine all four transitions.
+#[derive(Debug, Clone, Encode)]
+pub struct ArenaMovementResearchStatementV1 {
+    /// Isolated test network; the digest domain also binds this identity.
+    pub network_id: NetworkId,
+    /// Research session identity signed by the admitted gameplay keys.
+    pub session_id: Hash,
+    /// Exact offline, unregistered two-player manifest.
+    pub manifest: GameManifestV1,
+    /// Immutable generic admission with two zero-bond Samurai.
+    pub admission: GameAdmissionBodyV1,
+    /// Domain-separated root of this exact admission and initial positions.
+    pub genesis_root: Hash,
+    /// Fixed restricted Arena movement rules.
+    pub rules_hash: Hash,
+    /// Exact collision layout of map zero.
+    pub map_hash: Hash,
+    /// One signed input commitment per permanent slot.
+    pub commitments: Vec<GameInputCommitmentV1>,
+    /// Both players' signatures on the one canonical commitment set.
+    pub commitment_set: GameCommitmentSetV1,
+    /// Opening salt and exact input bytes for each slot.
+    pub reveals: Vec<GameInputRevealV1>,
+    /// Canonical forced-batch-shaped peer-selected inputs; not ledger-selected.
+    pub batch: GameForcedBatchV1,
+    /// Public x/y positions at ticks zero, one, and two, by permanent slot.
+    pub positions: [[[i32; 2]; 2]; 3],
+}
+
+impl ArenaMovementResearchStatementV1 {
+    fn rows(&self) -> Result<[[i64; INPUT_COUNT]; 4], String> {
+        let mut rows = [[0_i64; INPUT_COUNT]; 4];
+        for tick in 0..2 {
+            for slot in 0..2 {
+                let payload = &self.batch.inputs[slot];
+                let input = &payload[tick * 8..tick * 8 + 8];
+                let buttons = u16::from_le_bytes([input[0], input[1]]);
+                let move_x = input[2] as i8;
+                let move_y = input[3] as i8;
+                let yaw = u16::from_le_bytes([input[4], input[5]]);
+                let pitch = i16::from_le_bytes([input[6], input[7]]);
+                if buttons != 0
+                    || move_x == i8::MIN
+                    || move_y != 0
+                    || pitch != 0
+                    || !matches!(yaw, 0 | 16_384 | 32_768 | 49_152)
+                {
+                    return Err("input is outside the proved movement-only slice".into());
+                }
+                let before = self.positions[tick][slot];
+                let after = self.positions[tick + 1][slot];
+                rows[tick * 2 + slot] = [
+                    i64::from(before[0]),
+                    i64::from(before[1]),
+                    i64::from(move_x),
+                    i64::from(yaw / 16_384),
+                    i64::from(after[0]),
+                    i64::from(after[1]),
+                ];
+            }
+        }
+        Ok(rows)
+    }
+
+    /// Fail closed on admission, peer signatures, commit/reveal history, the
+    /// exact offline map/rules, and every boundary used by the movement AIR.
+    pub fn validate(&self) -> Result<(), String> {
+        validate_admission(&self.manifest, &self.admission)?;
+        if self.rules_hash != research_rules_hash_v1() || self.map_hash != research_map_hash_v1() {
+            return Err("movement rules or map collision identity changed".into());
+        }
+        let genesis = research_genesis_root_v1(
+            &self.network_id,
+            self.session_id,
+            &self.manifest,
+            &self.admission,
+        )?;
+        if self.genesis_root != genesis {
+            return Err("admission-bound genesis root mismatch".into());
+        }
+        if self.positions[0] != [[18_000, 0], [-18_000, 0]] {
+            return Err("incorrect admitted initial positions".into());
+        }
+        // Each of two steps moves at most 80 mm. Even an adversarial position
+        // trace in this corridor cannot touch any map-zero wall or world bound.
+        for (tick, positions) in self.positions.iter().enumerate() {
+            let reach = (tick as i64) * 80;
+            for (slot, position) in positions.iter().enumerate() {
+                let spawn = if slot == 0 { 18_000_i64 } else { -18_000_i64 };
+                if (i64::from(position[0]) - spawn).abs() > reach
+                    || i64::from(position[1]).abs() > reach
+                {
+                    return Err("position exits the collision-free two-tick corridor".into());
+                }
+            }
+        }
+        if self.batch.epoch != 0
+            || self.batch.start_tick != 0
+            || self.batch.inputs.len() != 2
+            || self.batch.inputs.iter().any(|payload| payload.len() != 16)
+            || !self.batch.dnf_slots.is_empty()
+            || self.commitments.len() != 2
+            || self.reveals.len() != 2
+        {
+            return Err("noncanonical two-slot two-tick accepted batch".into());
+        }
+        self.rows()?;
+        let parent_root = game_message_hash_v1(
+            &self.network_id,
+            "arena-movement-research-empty-transcript",
+            &(self.session_id, genesis),
+        );
+        let set = &self.commitment_set;
+        if set.session_id != self.session_id
+            || set.epoch != 0
+            || set.start_tick != 0
+            || set.parent_transcript_root != parent_root
+            || set.commitments.len() != 2
+            || set.signatures.len() != 2
+        {
+            return Err("joint commitment set does not bind research genesis".into());
+        }
+        let set_hash = game_commitment_set_hash_v1(&self.network_id, set);
+        for slot in 0..2 {
+            let key = &self.admission.participants[slot].input_key;
+            let reveal = &self.reveals[slot];
+            let commitment = &self.commitments[slot];
+            let signed_set = &set.signatures[slot];
+            if reveal.session_id != self.session_id
+                || reveal.epoch != 0
+                || reveal.start_tick != 0
+                || usize::from(reveal.slot) != slot
+                || reveal.payload != self.batch.inputs[slot]
+                || commitment.session_id != self.session_id
+                || commitment.epoch != 0
+                || commitment.start_tick != 0
+                || usize::from(commitment.slot) != slot
+                || commitment.commitment != game_input_commitment_v1(&self.network_id, reveal)
+                || set.commitments[slot] != commitment.commitment
+                || usize::from(signed_set.slot) != slot
+                || commitment
+                    .signature
+                    .verify(
+                        key,
+                        game_input_message_hash_v1(&self.network_id, commitment).as_ref(),
+                    )
+                    .is_err()
+                || signed_set.signature.verify(key, set_hash.as_ref()).is_err()
+            {
+                return Err("invalid peer-signed commitment or opened input".into());
+            }
+        }
+        Ok(())
+    }
+}
+
+struct Adapter {
+    statement: ArenaMovementResearchStatementV1,
+    rows: [[i64; INPUT_COUNT]; 4],
+    compiled: ArenaMovementAirV1,
+}
+
+impl Adapter {
+    fn new(statement: ArenaMovementResearchStatementV1) -> Result<Self, String> {
+        statement.validate()?;
+        let rows = statement.rows()?;
+        let mut compiled = ArenaMovementAirV1::compile();
+        for (index, input) in compiled.inputs.iter().copied().enumerate() {
+            let super::integer_air::Source::Column(column) = input.source else {
+                return Err("movement input graph changed".into());
+            };
+            if column != index {
+                return Err("movement input graph reordered".into());
+            }
+            compiled
+                .air
+                .equate(input, Value::fixed(index, input.low, input.high));
+        }
+        Ok(Self {
+            statement,
+            rows,
+            compiled,
+        })
+    }
+
+    fn columns(&self) -> Vec<Vec<F>> {
+        let mut columns = vec![vec![F::ZERO; TRACE_SIZE]; NOTE_COPY_WIDTH_V1];
+        columns.extend((0..self.compiled.air.width()).map(|_| vec![F::ZERO; TRACE_SIZE]));
+        for tick_slot in 0..4 {
+            let row = self
+                .compiled
+                .air
+                .witness(&self.rows[tick_slot], &self.rows[tick_slot]);
+            for (index, value) in row.into_iter().enumerate() {
+                for trace_row in (tick_slot..TRACE_SIZE).step_by(4) {
+                    columns[NOTE_COPY_WIDTH_V1 + index][trace_row] = field(value);
+                }
+            }
+        }
+        columns
+    }
+}
+
+impl ProofManagedNoteStarkAdapterV1 for Adapter {
+    type ProfileChallenges = ();
+
+    fn protocol_v1(&self) -> ProofManagedNoteStarkProtocolV1 {
+        ProofManagedNoteStarkProtocolV1 {
+            parameters: AggregateStarkParametersV1 {
+                proof_magic: *b"ARM1",
+                proof_version: 1,
+                security_lanes: 1,
+                query_count: 136,
+                blowup_log2: 3,
+                terminal_log2: 10,
+                terminal_degree_bound: 143,
+                composition_degree_chunks: 4,
+                minimum_trace_log2: TRACE_LOG,
+                maximum_trace_log2: TRACE_LOG,
+                maximum_trace_groups: 1,
+                maximum_segment_instances: 1,
+                maximum_base_columns_per_instance: self.base_width_v1(),
+                maximum_aux_columns_per_instance: NOTE_COPY_AUX_WIDTH_V1,
+                maximum_proof_bytes: MAX_PROOF_BYTES,
+            },
+            domains: DOMAINS,
+            maximum_constraint_degree: 4,
+            profile_binding_label: b"arena-move-profile-binding-v1",
+            profile_descriptor: DESCRIPTOR,
+            relation_layout_domain: b"arena-move-relation-layout-v1",
+        }
+    }
+
+    fn public_input_digest_v1(&self) -> Result<GoldilocksDigest384V1, NativeError> {
+        let statement = self.statement.encode();
+        let mut source_hash = Sha256::new();
+        for source in [
+            include_bytes!("arena_movement_air.rs").as_slice(),
+            include_bytes!("integer_air.rs").as_slice(),
+            include_bytes!("arena_movement_research.rs").as_slice(),
+        ] {
+            source_hash.update((source.len() as u64).to_le_bytes());
+            source_hash.update(source);
+        }
+        goldilocks_digest384_frame_v1(
+            CONTEXT,
+            b"arena-move-public-statement-v1",
+            b"statement",
+            0,
+            0,
+            0,
+            &[&source_hash.finalize(), &statement],
+        )
+        .map_err(|_| NativeError::InvalidProfile)
+    }
+
+    fn trace_log2_v1(&self) -> u8 {
+        TRACE_LOG
+    }
+    fn base_width_v1(&self) -> usize {
+        self.compiled.air.width() + NOTE_COPY_WIDTH_V1
+    }
+    fn profile_aux_width_v1(&self) -> usize {
+        0
+    }
+    fn profile_fixed_width_v1(&self) -> usize {
+        INPUT_COUNT
+    }
+    fn profile_constraint_count_v1(&self) -> usize {
+        self.compiled.air.constraint_count()
+    }
+    fn copy_schedule_v1(&self) -> Result<NoteCopyScheduleV1, NativeError> {
+        Ok(NoteCopyScheduleV1 {
+            policies: vec![[NoteCopyCellPolicyV1::Inactive; NOTE_COPY_WIDTH_V1]; TRACE_SIZE],
+            sigma: (0..TRACE_SIZE)
+                .map(|row| std::array::from_fn(|col| (row * NOTE_COPY_WIDTH_V1 + col + 1) as u32))
+                .collect(),
+        })
+    }
+    fn profile_fixed_columns_v1(&self) -> Result<Vec<Vec<F>>, NativeError> {
+        Ok((0..INPUT_COUNT)
+            .map(|index| {
+                (0..TRACE_SIZE)
+                    .map(|row| field(self.rows[row % 4][index]))
+                    .collect()
+            })
+            .collect())
+    }
+    fn derive_profile_challenges_v1(
+        &self,
+        _: &mut TransparentTranscriptV1,
+        _: NoteCopyChallengesV1,
+    ) -> Result<(), NativeError> {
+        Ok(())
+    }
+    fn build_profile_aux_columns_v1(
+        &self,
+        _: &[Vec<F>],
+        _: &[Vec<F>],
+        _: &[Vec<F>],
+        _: NoteCopyChallengesV1,
+        _: &(),
+    ) -> Result<Vec<Vec<F>>, NativeError> {
+        Ok(vec![])
+    }
+    fn profile_constraint_residues_v1(
+        &self,
+        current: &[F],
+        next: &[F],
+        _: &[F],
+        _: &[F],
+        fixed: &[F],
+        _: NoteCopyChallengesV1,
+        _: &(),
+    ) -> Result<Vec<F>, NativeError> {
+        Ok(self.compiled.air.residues(
+            &current[NOTE_COPY_WIDTH_V1..],
+            &next[NOTE_COPY_WIDTH_V1..],
+            &fixed[NOTE_COPY_FIXED_WIDTH_V1..],
+        ))
+    }
+}
+
+fn preflight(adapter: &Adapter) -> Result<usize, String> {
+    let protocol = adapter.protocol_v1();
+    protocol.validate().map_err(|error| error.to_string())?;
+    let layout = AggregateProofLayoutV1::new(
+        protocol.parameters,
+        vec![AggregateTraceGroupLayoutV1 {
+            native_trace_log2: TRACE_LOG,
+            segment_instances: 1,
+            base_width: adapter.base_width_v1(),
+            aux_width: NOTE_COPY_AUX_WIDTH_V1,
+        }],
+    )
+    .map_err(|error| error.to_string())?;
+    let maximum = maximum_encoded_proof_with_deep_bytes_v1(protocol.parameters, &layout)
+        .map_err(|error| error.to_string())?;
+    if maximum > MAX_PROOF_BYTES {
+        return Err(format!(
+            "movement research proof maximum wire {maximum} exceeds {MAX_PROOF_BYTES} bytes"
+        ));
+    }
+    Ok(maximum)
+}
+
+/// Return width/constraint/max-wire geometry before allocating an actual proof.
+pub fn research_geometry_v1(
+    statement: ArenaMovementResearchStatementV1,
+) -> Result<(usize, usize, usize), String> {
+    let adapter = Adapter::new(statement)?;
+    let maximum = preflight(&adapter)?;
+    Ok((
+        adapter.compiled.air.width(),
+        adapter.profile_constraint_count_v1(),
+        maximum,
+    ))
+}
+
+/// Generate a research proof. This function is never called by custody code.
+pub fn prove_research_movement_v1(
+    statement: ArenaMovementResearchStatementV1,
+) -> Result<Vec<u8>, String> {
+    let adapter = Adapter::new(statement)?;
+    preflight(&adapter)?;
+    let columns = adapter.columns();
+    prove_proof_managed_note_stark_v1(&adapter, &columns).map_err(|error| error.to_string())
+}
+
+/// Independently verify the exact public admission, history and movement state.
+pub fn verify_research_movement_v1(
+    statement: ArenaMovementResearchStatementV1,
+    proof: &[u8],
+) -> Result<(), String> {
+    let adapter = Adapter::new(statement)?;
+    preflight(&adapter)?;
+    verify_proof_managed_note_stark_v1(&adapter, proof).map_err(|error| error.to_string())
+}
