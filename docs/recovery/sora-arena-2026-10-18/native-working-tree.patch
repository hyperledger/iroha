+        let mut full_roster = [[9000, 2000, 0, 1, 1, 0]; 12];
+        full_roster[0] = [0, 0, 0, 0, 1, 0];
+        full_roster[11] = [4000, 0, 0, 1, 1, 0];
+        check(12, 0, 0, &fixture(&full_roster, &[]), Some(12));
