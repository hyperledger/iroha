+        _: &[Vec<F>],
+        _: &[Vec<F>],
+        _: NoteCopyChallengesV1,
+        _: &(),
+    ) -> Result<Vec<Vec<F>>, NativeError> {
+        Ok(vec![])
+    }
+    fn profile_constraint_residues_v1(
+        &self,
+        current: &[F],
+        next: &[F],
+        _: &[F],
+        _: &[F],
+        fixed: &[F],
+        _: NoteCopyChallengesV1,
+        _: &(),
+    ) -> Result<Vec<F>, NativeError> {
+        let marker = fixed[NOTE_COPY_FIXED_WIDTH_V1 + DAMAGE_INPUT_COUNT];
+        let plane_gate = F::ONE.sub(marker);
+        let plane = self.plane.air.residues(
+            &current[NOTE_COPY_WIDTH_V1..NOTE_COPY_WIDTH_V1 + self.plane.air.width()],
+            &next[NOTE_COPY_WIDTH_V1..NOTE_COPY_WIDTH_V1 + self.plane.air.width()],
+            &fixed[NOTE_COPY_FIXED_WIDTH_V1..NOTE_COPY_FIXED_WIDTH_V1 + PLANE_VALUES],
+        );
+        let damage = self.damage.air.residues(
+            &current[NOTE_COPY_WIDTH_V1..NOTE_COPY_WIDTH_V1 + self.damage.air.width()],
+            &next[NOTE_COPY_WIDTH_V1..NOTE_COPY_WIDTH_V1 + self.damage.air.width()],
+            &fixed[NOTE_COPY_FIXED_WIDTH_V1..NOTE_COPY_FIXED_WIDTH_V1 + DAMAGE_INPUT_COUNT],
+        );
+        Ok(plane
+            .into_iter()
+            .map(|value| value.mul(plane_gate))
+            .chain(damage.into_iter().map(|value| value.mul(marker)))
+            .collect())
+    }
