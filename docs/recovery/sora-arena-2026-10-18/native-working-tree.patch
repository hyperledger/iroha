@@ -0,0 +1,226 @@
+//! Unregistered two-tick, three-player ranged-hit research fixture.
+
+use iroha_core::execution_proofs::{
+    arena_ranged_research::{
+        ArenaRangedResearchStatementV1, expected_states_v1, prove_research_ranged_hit_v1,
+        reference_plane_rows_v1, research_genesis_root_v1, research_geometry_v1,
+        research_manifest_v1, research_map_hash_v1, research_rules_hash_v1,
+        verify_research_ranged_hit_v1,
+    },
+    compiled_execution_profile_v1, initial_game_state_root_v1,
+};
+use iroha_crypto::{Algorithm, Hash, HashOf, KeyPair, Signature};
+use iroha_data_model::{
+    NetworkId,
+    account::AccountId,
+    block::BlockHeader,
+    game::{
+        GameAdmissionBodyV1, GameAdmissionParticipantV1, GameCommitmentSetV1, GameForcedBatchV1,
+        GameInputCommitmentV1, GameInputRevealV1, GameSlotSignatureV1, game_commitment_set_hash_v1,
+        game_input_commitment_v1, game_input_message_hash_v1, game_message_hash_v1,
+    },
+};
+use iroha_primitives::numeric::Quantity;
+
+fn input_keys() -> [KeyPair; 3] {
+    std::array::from_fn(|slot| {
+        KeyPair::try_from_seed(vec![slot as u8 + 81; 32], Algorithm::Ed25519).unwrap()
+    })
+}
+
+fn fixture() -> ArenaRangedResearchStatementV1 {
+    let network_id = NetworkId::from_genesis_hash(HashOf::<BlockHeader>::from_untyped_unchecked(
+        Hash::new(b"arena-ranged-research-isolated-network"),
+    ));
+    let session_id = Hash::new(b"arena-ranged-research-unfunded-session");
+    let keys = input_keys();
+    let manifest = research_manifest_v1();
+    let admission = GameAdmissionBodyV1 {
+        version: 1,
+        participants: (0..3)
+            .map(|slot| {
+                let wallet =
+                    KeyPair::try_from_seed(vec![slot as u8 + 1; 32], Algorithm::Ed25519).unwrap();
+                GameAdmissionParticipantV1 {
+                    account: AccountId::new(wallet.public_key().clone()),
+                    input_key: keys[slot].public_key().clone(),
+                    deposit: Quantity::zero(),
+                    application_data: vec![0, 0, u8::from(slot == 0)],
+                }
+            })
+            .collect(),
+        wagers: vec![],
+        resources: vec![],
+    };
+    let genesis_root =
+        research_genesis_root_v1(&network_id, session_id, &manifest, &admission).unwrap();
+    let shot = [1, 0, 0, 0, 0, 96, 0, 0];
+    let idle = [0_u8; 8];
+    let batch = GameForcedBatchV1 {
+        epoch: 0,
+        start_tick: 0,
+        inputs: vec![
+            [shot, idle].concat(),
+            [idle, idle].concat(),
+            [idle, idle].concat(),
+        ],
+        dnf_slots: vec![],
+    };
+    let reveals: Vec<_> = (0..3)
+        .map(|slot| GameInputRevealV1 {
+            session_id,
+            epoch: 0,
+            start_tick: 0,
+            slot: slot as u8,
+            payload: batch.inputs[slot].clone(),
+            salt: Hash::new([slot as u8, 19, 7, 4]),
+        })
+        .collect();
+    let commitments: Vec<_> = (0..3)
+        .map(|slot| {
+            let mut item = GameInputCommitmentV1 {
+                session_id,
+                epoch: 0,
+                start_tick: 0,
+                slot: slot as u8,
+                commitment: game_input_commitment_v1(&network_id, &reveals[slot]),
+                signature: Signature::new(keys[slot].private_key(), b"temporary"),
+            };
+            let digest = game_input_message_hash_v1(&network_id, &item);
+            item.signature = Signature::new(keys[slot].private_key(), digest.as_ref());
+            item
+        })
+        .collect();
+    let parent_transcript_root = game_message_hash_v1(
+        &network_id,
+        "arena-ranged-research-empty-transcript",
+        &(session_id, genesis_root),
+    );
+    let mut commitment_set = GameCommitmentSetV1 {
+        session_id,
+        epoch: 0,
+        start_tick: 0,
+        parent_transcript_root,
+        commitments: commitments.iter().map(|item| item.commitment).collect(),
+        signatures: vec![],
+    };
+    let digest = game_commitment_set_hash_v1(&network_id, &commitment_set);
+    commitment_set.signatures = (0..3)
+        .map(|slot| GameSlotSignatureV1 {
+            slot: slot as u8,
+            signature: Signature::new(keys[slot].private_key(), digest.as_ref()),
+        })
+        .collect();
+    ArenaRangedResearchStatementV1 {
+        network_id,
+        session_id,
+        manifest,
+        admission,
+        genesis_root,
+        rules_hash: research_rules_hash_v1(),
+        map_hash: research_map_hash_v1(),
+        commitments,
+        commitment_set,
+        reveals,
+        batch,
+        states: expected_states_v1(),
+        plane_rows: reference_plane_rows_v1(),
+        selected_target: 3,
+        damage_row: [
+            125, 100, 22, 0, 0, 0, 2, 32767, 0, 18_000, 0, 0, 18_000, 103, 100, 22, 0,
+        ],
+    }
+}
+
+#[test]
+fn exact_history_and_staged_selection_preflight() {
+    let valid = fixture();
+    valid.validate().unwrap();
+    assert!(compiled_execution_profile_v1(&valid.manifest.profile_id).is_none());
+    assert!(
+        initial_game_state_root_v1(&valid.network_id, &valid.manifest, &valid.admission).is_err()
+    );
+    let geometry = research_geometry_v1(valid.clone());
+    eprintln!("ranged_geometry={geometry:?}");
+    assert_eq!(geometry.unwrap(), (658, 1_414, 2_607_552));
+    let mut bad = valid.clone();
+    bad.admission.participants[0].deposit = Quantity::from(10_u32);
+    assert!(bad.validate().is_err());
+    let mut bad = valid.clone();
+    bad.admission.participants[0].application_data[2] = 12;
+    assert!(bad.validate().is_err());
+    let mut bad = valid.clone();
+    bad.batch.inputs[0][0] = 0;
+    assert!(bad.validate().is_err());
+    let mut bad = valid.clone();
+    bad.batch.inputs[0].truncate(8); // second tick cannot be omitted
+    assert!(bad.validate().is_err());
+    let mut bad = valid.clone();
+    bad.plane_rows.remove(0); // a wall slab cannot be omitted
+    assert!(bad.validate().is_err());
+    let mut bad = valid.clone();
+    bad.plane_rows[0][2] += 1; // altered wall bound
+    assert!(bad.validate().is_err());
+    let mut bad = valid.clone();
+    bad.selected_target = 2; // alternate target
+    assert!(bad.validate().is_err());
+    let mut bad = valid.clone();
+    bad.plane_rows[9][3] = 1 << 20; // forged right-wall occlusion
+    assert!(bad.validate().is_err());
+    let mut bad = valid.clone();
+    bad.states[2].health[2] += 1;
+    assert!(bad.validate().is_err());
+    let mut bad = valid.clone();
+    bad.damage_row[15] = 21;
+    assert!(bad.validate().is_err());
+    let mut bad = valid.clone();
+    bad.reveals[2].payload[0] ^= 1;
+    assert!(bad.validate().is_err());
+    let mut bad = valid;
+    bad.commitment_set.signatures.swap(0, 1);
+    assert!(bad.validate().is_err());
+}
+
+#[test]
+#[ignore = "native staged proof takes minutes; run explicitly after preflight"]
+fn prove_and_save_ranged_hit() {
+    let path = std::env::var("ARENA_RANGED_PROOF_PATH").expect("proof path");
+    let statement = fixture();
+    let started = std::time::Instant::now();
+    let proof = prove_research_ranged_hit_v1(statement.clone()).unwrap();
+    eprintln!(
+        "ranged_prove_ms={} ranged_proof_bytes={}",
+        started.elapsed().as_millis(),
+        proof.len()
+    );
+    std::fs::write(&path, &proof).unwrap();
+    verify_research_ranged_hit_v1(statement, &proof).unwrap();
+}
+
+#[test]
+#[ignore = "verify a proof file saved by another process"]
+fn independently_verify_saved_ranged_hit() {
+    let path = std::env::var("ARENA_RANGED_PROOF_PATH").expect("proof path");
+    let proof = std::fs::read(&path).unwrap();
+    let statement = fixture();
+    let started = std::time::Instant::now();
+    verify_research_ranged_hit_v1(statement.clone(), &proof).unwrap();
+    eprintln!("ranged_verify_ms={}", started.elapsed().as_millis());
+    let mut bad = statement.clone();
+    bad.selected_target = 2;
+    assert!(verify_research_ranged_hit_v1(bad, &proof).is_err());
+    let mut bad = statement.clone();
+    bad.plane_rows[0][3] += 1; // plausible but false fraction, same selected target
+    bad.validate().unwrap(); // this case reaches transcript-bound proof verification
+    assert!(verify_research_ranged_hit_v1(bad, &proof).is_err());
+    let mut bad = statement.clone();
+    bad.damage_row[13] += 1;
+    assert!(verify_research_ranged_hit_v1(bad, &proof).is_err());
+    let mut bad = statement.clone();
+    bad.batch.inputs[0][0] = 0;
+    assert!(verify_research_ranged_hit_v1(bad, &proof).is_err());
+    let mut damaged = proof.clone();
+    let index = damaged.len() / 2;
+    damaged[index] ^= 1;
+    assert!(verify_research_ranged_hit_v1(statement, &damaged).is_err());
+}
