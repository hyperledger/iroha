+//! Unregistered native proof of the generic ordered Arena ray-stop relation.
+//!
+//! The complete ray-relevant public snapshot, attacker and claimed result are
+//! bound into Fiat–Shamir and verifier-reconstructed fixed columns. Aim, signed
+//! slab arithmetic, eligibility and nearest selection are polynomial constraints.
+//! This is a conditional component proof: it establishes neither authenticated
+//! World state, legal attack initiation, damage, a kill, custody nor settlement.
+
+pub use super::arena_staged_hit_air::{
+    ArenaHitEntityV1, ArenaHitOutputV1, ArenaHitPlayerV1, ArenaHitSnapshotV1,
+};
+use super::{
+    arena_staged_hit_air::StagedArenaHitAirV1,
+    stark::{
+        aggregate_stark::{
+            AggregateProofLayoutV1, AggregateStarkDomainsV1, AggregateStarkParametersV1,
+            AggregateTraceGroupLayoutV1, maximum_encoded_proof_with_deep_bytes_v1,
+        },
+        proof_managed_note_stark::{
+            NOTE_COPY_AUX_WIDTH_V1, NOTE_COPY_FIXED_WIDTH_V1, NOTE_COPY_WIDTH_V1,
+            NoteCopyCellPolicyV1, NoteCopyChallengesV1, NoteCopyScheduleV1,
+            ProofManagedNoteStarkAdapterV1, ProofManagedNoteStarkErrorV1 as Error,
+            ProofManagedNoteStarkProtocolV1, prove_proof_managed_note_stark_v1,
+            verify_proof_managed_note_stark_v1,
+        },
+        transparent_stark::{
+            GoldilocksDigest384V1, GoldilocksFieldV1 as F, TransparentStarkDigestContextV1,
+            TransparentTranscriptV1, goldilocks_digest384_frame_v1,
+        },
+    },
+};
+use sha2::{Digest, Sha256};
+use std::{path::Path, time::Instant};
+
+const TRACE_LOG: u8 = 13;
+const TRACE_SIZE: usize = 1 << TRACE_LOG;
+const MAX_PROOF_BYTES: usize = 4 * 1024 * 1024;
+const CONTEXT: TransparentStarkDigestContextV1 =
+    TransparentStarkDigestContextV1::execution_v1(b"arena-staged-hit-research-v1");
+const DESCRIPTOR: &[u8] = b"unregistered-arena-staged-hit-research-v1:players=1..12:walls=0..64:entities=0..48:ordered-public-ray-snapshot:aim=bhaskara-q15:slabs=signed-trunc-q20:wall-entity-player-strict-nearest:fixed-stage-schedule:complete-scratch-carry:trace=8192:degree=4:queries=136:lde=8:fri-terminal=1024:fri-degree=143:composition-chunks=4:proof-cap=4194304:no-world:no-attack-legality:no-damage:no-custody:no-qualification";
+const DOMAINS: AggregateStarkDomainsV1 = AggregateStarkDomainsV1 {
+    digest_context: CONTEXT,
+    base_leaf: b"arena-staged-hit-base-leaf-v1",
+    base_node: b"arena-staged-hit-base-node-v1",
+    aux_leaf: b"arena-staged-hit-aux-leaf-v1",
+    aux_node: b"arena-staged-hit-aux-node-v1",
+    composition_leaf: b"arena-staged-hit-composition-leaf-v1",
+    composition_node: b"arena-staged-hit-composition-node-v1",
+    fri_leaf: b"arena-staged-hit-fri-leaf-v1",
+    fri_node: b"arena-staged-hit-fri-node-v1",
+    layout_label: b"arena-staged-hit-layout-v1",
+    base_root_label: b"arena-staged-hit-base-root-v1",
+    aux_root_label: b"arena-staged-hit-aux-root-v1",
+    composition_root_label: b"arena-staged-hit-composition-root-v1",
+    fri_root_label: b"arena-staged-hit-fri-root-v1",
+    fri_beta_label: b"arena-staged-hit-fri-beta-v1",
+    query_seed: b"arena-staged-hit-query-seed-v1",
+};
+
+/// Component layout and conservative native proof-wire bound, before trace allocation.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct ArenaStagedHitLayoutV1 {
+    /// Fixed native trace row count, including padding.
+    pub trace_rows: usize,
+    /// Scheduled arithmetic rows plus the output boundary.
+    pub minimum_rows: usize,
+    /// Committed base columns, including the shared eight byte-copy columns.
+    pub base_columns: usize,
+    /// Committed shared permutation columns.
+    pub aux_columns: usize,
+    /// Verifier-reconstructed columns, including shared copy preprocessing.
+    pub fixed_columns: usize,
+    /// Arena polynomial residues, excluding the shared permutation residues.
+    pub profile_constraints: usize,
+    /// Conservative full native proof wire bound, including DEEP openings.
+    pub maximum_wire_bytes: usize,
+    /// Whether the conservative bound fits the unchanged four-MiB cap.
+    pub fits_proof_cap: bool,
+}
+
+struct Adapter<'a> {
+    snapshot: &'a ArenaHitSnapshotV1,
+    attacker: usize,
+    expected: ArenaHitOutputV1,
+    compiled: StagedArenaHitAirV1,
+}
+
+impl<'a> Adapter<'a> {
+    fn new(
+        snapshot: &'a ArenaHitSnapshotV1,
+        attacker: usize,
+        expected: ArenaHitOutputV1,
+    ) -> Result<Self, String> {
+        let compiled = StagedArenaHitAirV1::compile(
+            snapshot.players.len(),
+            snapshot.walls.len(),
+            snapshot.entities.len(),
+            attacker,
+        )?;
+        // Validation and fixed-domain selection never invoke witness generation.
+        compiled.fixed_row(snapshot, expected, 0, TRACE_SIZE)?;
+        Ok(Self {
+            snapshot,
+            attacker,
+            expected,
+            compiled,
+        })
+    }
+
+    fn layout(&self) -> Result<ArenaStagedHitLayoutV1, String> {
+        let protocol = self.protocol_v1();
+        protocol.validate().map_err(|error| error.to_string())?;
+        let layout = AggregateProofLayoutV1::new(
+            protocol.parameters,
+            vec![AggregateTraceGroupLayoutV1 {
+                native_trace_log2: TRACE_LOG,
+                segment_instances: 1,
+                base_width: self.base_width_v1(),
+                aux_width: NOTE_COPY_AUX_WIDTH_V1,
+            }],
+        )
+        .map_err(|error| error.to_string())?;
+        let maximum_wire_bytes =
+            maximum_encoded_proof_with_deep_bytes_v1(protocol.parameters, &layout)
+                .map_err(|error| error.to_string())?;
+        Ok(ArenaStagedHitLayoutV1 {
+            trace_rows: TRACE_SIZE,
+            minimum_rows: self.compiled.minimum_rows(),
+            base_columns: self.base_width_v1(),
+            aux_columns: NOTE_COPY_AUX_WIDTH_V1,
+            fixed_columns: NOTE_COPY_FIXED_WIDTH_V1 + self.compiled.fixed_width(),
+            profile_constraints: self.compiled.constraint_count(),
+            maximum_wire_bytes,
+            fits_proof_cap: maximum_wire_bytes <= MAX_PROOF_BYTES,
+        })
+    }
+
+    fn columns(&self) -> Result<Vec<Vec<F>>, String> {
+        let (rows, derived) = self.compiled.witness(self.snapshot, TRACE_SIZE)?;
+        if derived != self.expected {
+            return Err("claimed ray result differs from generated witness".into());
+        }
+        let mut columns = vec![vec![F::ZERO; TRACE_SIZE]; self.base_width_v1()];
+        for (index, row) in rows.into_iter().enumerate() {
+            for (column, value) in columns[NOTE_COPY_WIDTH_V1..].iter_mut().zip(row) {
+                column[index] = value;
+            }
+        }
+        Ok(columns)
+    }
+}
