@@ -0,0 +1,86 @@
+//! Admission-bound genesis tests through the public compiled execution API.
+
+use iroha_core::execution_proofs::{
+    initial_game_state_root_v1, initial_race_state_v1, race_profile_id_v1, race_state_root_v1,
+};
+use iroha_crypto::{Algorithm, Hash, HashOf, KeyPair};
+use iroha_data_model::{
+    NetworkId,
+    account::AccountId,
+    block::BlockHeader,
+    execution_proofs::RaceTrackV1,
+    game::{
+        GameAccessV1, GameAdmissionBodyV1, GameAdmissionParticipantV1, GameManifestV1,
+        GamePayoutPolicyV1,
+    },
+};
+use iroha_primitives::numeric::Quantity;
+use norito::codec::Encode;
+
+fn admission() -> GameAdmissionBodyV1 {
+    GameAdmissionBodyV1 {
+        version: 1,
+        participants: (0..2)
+            .map(|slot| {
+                let wallet = KeyPair::try_from_seed(vec![slot + 1; 32], Algorithm::Ed25519)
+                    .expect("fixture wallet");
+                let input = KeyPair::try_from_seed(vec![slot + 65; 32], Algorithm::Ed25519)
+                    .expect("fixture input key");
+                GameAdmissionParticipantV1 {
+                    account: AccountId::new(wallet.public_key().clone()),
+                    input_key: input.public_key().clone(),
+                    deposit: Quantity::zero(),
+                    application_data: vec![slot],
+                }
+            })
+            .collect(),
+        wagers: Vec::new(),
+        resources: Vec::new(),
+    }
+}
+
+#[test]
+fn invalid_admission_cannot_compute_genesis_and_valid_race_root_is_unchanged() {
+    let network = NetworkId::from_genesis_hash(HashOf::<BlockHeader>::from_untyped_unchecked(
+        Hash::new(b"admission-bound-race-genesis-network"),
+    ));
+    let manifest = GameManifestV1 {
+        version: 1,
+        application_id: Hash::new(b"admission-bound-race-genesis"),
+        profile_id: race_profile_id_v1(),
+        application_parameters: RaceTrackV1::NeonTokyo.encode(),
+        min_participants: 2,
+        max_participants: 8,
+        batch_ticks: 6,
+        max_ticks: 5400,
+        max_input_bytes: 12,
+        max_participant_data_bytes: 1,
+        access: GameAccessV1::Public,
+        payout_policy: GamePayoutPolicyV1::NoPayout,
+    };
+    let admitted = admission();
+    let expected = race_state_root_v1(
+        &network,
+        &initial_race_state_v1(RaceTrackV1::NeonTokyo, 2).unwrap(),
+    );
+    assert_eq!(
+        initial_game_state_root_v1(&network, &manifest, &admitted).unwrap(),
+        expected,
+    );
+
+    let mut wrong_version = admitted.clone();
+    wrong_version.version = 2;
+    let mut wrong_skin = admitted.clone();
+    wrong_skin.participants[1].application_data = vec![6];
+    let mut repeated_input_key = admitted.clone();
+    repeated_input_key.participants[1].input_key =
+        repeated_input_key.participants[0].input_key.clone();
+    let mut missing_slot = admitted;
+    missing_slot.participants.pop();
+    for invalid in [wrong_version, wrong_skin, repeated_input_key, missing_slot] {
+        assert!(
+            initial_game_state_root_v1(&network, &manifest, &invalid).is_err(),
+            "invalid admission must not yield a genesis root"
+        );
+    }
+}
