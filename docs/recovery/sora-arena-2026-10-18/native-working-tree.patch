@@ -0,0 +1,100 @@
+#!/usr/bin/env python3
+"""Dependency-free filesystem/provenance guard tests; no mocked cryptographic proof.
+Run with Python3. Temporary files are guard inputs, not executable rlibs or STARKs.
+"""
+import importlib.util
+import json
+from pathlib import Path
+import tempfile
+import unittest
+
+SPEC = importlib.util.spec_from_file_location('arena_stark_guard', Path(__file__).with_name('check_arena_damage_stark.py'))
+GUARD = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(GUARD)
+
+
+class GuardTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.root = Path(self.temp.name).resolve()
+        self.seal = {'source': {'hash': 'source-v1'}, 'dependencies': {'hash': 'rlibs-v1'}, 'toolchain': {'hash': 'rustc-v1'}}
+
+    def tearDown(self):
+        self.temp.cleanup()
+
+    def test_exclusive_runs_never_reuse_prior_proof_or_requested_path(self):
+        first = GUARD.create_output(self.root, None, False)
+        proof = first / 'damage-transition.stark'
+        proof.write_bytes(b'previous evidence must remain unchanged')
+        second = GUARD.create_output(self.root, None, False)
+        build = GUARD.create_output(self.root, None, True)
+        self.assertEqual(len({first, second, build}), 3)
+        self.assertTrue(build.name.startswith('build-'))
+        self.assertTrue(first.name.startswith('prove-'))
+        with self.assertRaises(FileExistsError):
+            GUARD.create_output(self.root, first, False)
+        self.assertEqual(proof.read_bytes(), b'previous evidence must remain unchanged')
+        self.assertFalse((second / proof.name).exists())
+        self.assertFalse((build / proof.name).exists())
+
+    def test_ambiguous_rlibs_fail_and_explicit_pin_is_hash_checked(self):
+        deps = self.root / 'debug/deps'
+        deps.mkdir(parents=True)
+        pins = {}
+        for name in GUARD.REQUIRED_LIBRARIES:
+            chosen = deps / f'lib{name}-1111.rlib'
+            chosen.write_bytes((name + ':chosen').encode())
+            (deps / f'lib{name}-2222.rlib').write_bytes((name + ':other').encode())
+            pins[name] = {'path': str(chosen), 'sha256': GUARD.file_hash(chosen)}
+        with self.assertRaisesRegex(ValueError, 'candidate rlibs'):
+            GUARD.select_dependencies(deps, None)
+        manifest = self.root / 'pins.json'
+        manifest.write_text(json.dumps({'schema': 'iroha.arena.research_dependencies.v1', 'dependencies': pins}))
+        self.assertEqual(GUARD.select_dependencies(deps, manifest), pins)
+        Path(pins['fastpq_isi']['path']).write_bytes(b'changed after explicit pin')
+        with self.assertRaisesRegex(ValueError, 'hash differs'):
+            GUARD.select_dependencies(deps, manifest)
+
+    def test_missing_or_unknown_dependency_pins_fail(self):
+        deps = self.root / 'deps'
+        deps.mkdir()
+        manifest = self.root / 'pins.json'
+        manifest.write_text(json.dumps({'schema': 'iroha.arena.research_dependencies.v1', 'dependencies': {}}))
+        with self.assertRaisesRegex(ValueError, 'all seven'):
+            GUARD.select_dependencies(deps, manifest)
+
+    def test_every_seal_component_is_enforced(self):
+        for component in ('source', 'dependencies', 'toolchain'):
+            altered = dict(self.seal)
+            altered[component] = {'hash': 'changed'}
+            with self.subTest(component=component), self.assertRaisesRegex(ValueError, 'seal changed'):
+                GUARD.require_same_seal(self.seal, altered)
+        for before, after in [(None, None), (self.seal, None), ({}, {})]:
+            with self.assertRaisesRegex(ValueError, 'seals are required'):
+                GUARD.require_same_seal(before, after)
+
+    def test_mismatching_seal_invalidates_even_present_evidence(self):
+        output = GUARD.create_output(self.root, None, False)
+        (output / 'measurements.txt').write_text('synthetic guard-test metadata, not a proof')
+        after = dict(self.seal, toolchain={'hash': 'changed'})
+        status = GUARD.finalize_run(output, False, self.seal, after)
+        self.assertEqual(status['status'], 'invalid')
+        self.assertFalse(status['proof_verified'])
+        self.assertEqual(json.loads((output / 'run-status.json').read_text()), status)
+        with self.assertRaises(FileExistsError):
+            GUARD.finalize_run(output, False, self.seal, self.seal)
+
+    def test_build_only_is_explicitly_not_proof_and_compile_errors_fail_closed(self):
+        output = GUARD.create_output(self.root, None, True)
+        status = GUARD.finalize_run(output, True, self.seal, self.seal)
+        self.assertEqual(status['status'], 'build_complete')
+        self.assertEqual(status['kind'], 'build_only')
+        self.assertFalse(status['proof_verified'])
+        failed = GUARD.create_output(self.root, None, False)
+        status = GUARD.finalize_run(failed, False, self.seal, self.seal, 'compiler rejected linkage')
+        self.assertEqual(status['status'], 'invalid')
+        self.assertFalse(status['proof_verified'])
+
+
+if __name__ == '__main__':
+    unittest.main()
