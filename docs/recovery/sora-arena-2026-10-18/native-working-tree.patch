+//! Unregistered native STARK research for one bounded Arena box axis.
+//!
+//! Uses the unchanged native execution DEEP-ALI/FRI backend and security geometry.
+//! Both axis planes share one constrained ray and ordered box bounds. This
+//! still does not prove a three-dimensional hit, target selection, custody,
+//! complete state/history, a kill, or settlement. No registry calls exist here.
+
+use super::{
+    arena_geometry_air::{ArenaGeometryAxisAirV1, Q20},
+    integer_air::{Value, field},
+    stark::{
+        aggregate_stark::{
+            AggregateProofLayoutV1, AggregateStarkDomainsV1, AggregateStarkParametersV1,
+            AggregateTraceGroupLayoutV1, maximum_encoded_proof_with_deep_bytes_v1,
+        },
+        proof_managed_note_stark::{
+            NOTE_COPY_AUX_WIDTH_V1, NOTE_COPY_FIXED_WIDTH_V1, NOTE_COPY_WIDTH_V1,
+            NoteCopyCellPolicyV1, NoteCopyChallengesV1, NoteCopyScheduleV1,
+            ProofManagedNoteStarkAdapterV1, ProofManagedNoteStarkErrorV1 as Error,
+            ProofManagedNoteStarkProtocolV1, prove_proof_managed_note_stark_v1,
+            verify_proof_managed_note_stark_v1,
+        },
+        transparent_stark::{
+            GoldilocksDigest384V1, GoldilocksFieldV1 as F, TransparentStarkDigestContextV1,
+            TransparentTranscriptV1, goldilocks_digest384_frame_v1,
+        },
+    },
+};
+use sha2::{Digest, Sha256};
+use std::{path::Path, time::Instant};
+
+const TRACE_LOG: u8 = 13;
+const TRACE_SIZE: usize = 1 << TRACE_LOG;
+const INPUT_COUNT: usize = 4;
+const STATEMENT_COUNT: usize = 8;
+const AIR_WIDTH: usize = 1274;
+const AIR_CONSTRAINTS: usize = 1410;
+const MAX_PROOF_BYTES: usize = 4 * 1024 * 1024;
+const CONTEXT: TransparentStarkDigestContextV1 =
+    TransparentStarkDigestContextV1::execution_v1(b"arena-axis-research-v1");
+const DESCRIPTOR: &[u8] = b"unregistered-arena-axis-research-v1:one-box-axis:geometry-air=1274-columns/1410-constraints:public=8-signed-i64-le-fixed-columns:trace=8192-repeated-relation:base=1282:aux=118:fixed=51:profile-constraints=1418:degree=4:queries=136:lde=8:fri-terminal=1024:fri-degree=143:composition-chunks=4:grinding=20:proof-cap=4194304:no-qualification:no-settlement";
+const DOMAINS: AggregateStarkDomainsV1 = AggregateStarkDomainsV1 {
+    digest_context: CONTEXT,
+    base_leaf: b"arena-axis-research-base-leaf-v1",
+    base_node: b"arena-axis-research-base-node-v1",
+    aux_leaf: b"arena-axis-research-aux-leaf-v1",
+    aux_node: b"arena-axis-research-aux-node-v1",
+    composition_leaf: b"arena-axis-research-composition-leaf-v1",
+    composition_node: b"arena-axis-research-composition-node-v1",
+    fri_leaf: b"arena-axis-research-fri-leaf-v1",
+    fri_node: b"arena-axis-research-fri-node-v1",
+    layout_label: b"arena-axis-research-layout-v1",
+    base_root_label: b"arena-axis-research-base-root-v1",
+    aux_root_label: b"arena-axis-research-aux-root-v1",
+    composition_root_label: b"arena-axis-research-composition-root-v1",
+    fri_root_label: b"arena-axis-research-fri-root-v1",
+    fri_beta_label: b"arena-axis-research-fri-beta-v1",
+    query_seed: b"arena-axis-research-query-seed-v1",
+};
+
+struct Adapter {
+    statement: [i64; STATEMENT_COUNT],
+    compiled: ArenaGeometryAxisAirV1,
+}
+impl Adapter {
+    fn new(statement: [i64; STATEMENT_COUNT]) -> Result<Self, Error> {
+        let mut compiled = ArenaGeometryAxisAirV1::compile();
+        if compiled.air.width() != AIR_WIDTH || compiled.air.constraint_count() != AIR_CONSTRAINTS {
+            return Err(Error::InvalidProfile);
+        }
+        for (index, input) in compiled
+            .inputs
+            .iter()
+            .copied()
+            .chain([
+                compiled.outputs.hit,
+                compiled.outputs.fraction,
+                compiled.outputs.near,
+                compiled.outputs.far,
+            ])
+            .enumerate()
+        {
+            if !(input.low..=input.high).contains(&statement[index]) {
+                return Err(Error::InvalidTrace);
+            }
+            compiled
+                .air
+                .equate(input, Value::fixed(index, input.low, input.high));
+        }
+        Ok(Self {
+            statement,
+            compiled,
+        })
+    }
+    fn columns(&self) -> Vec<Vec<F>> {
+        let row = self
+            .compiled
+            .air
+            .witness(&self.statement[..INPUT_COUNT], &self.statement);
+        let mut columns = vec![vec![F::ZERO; TRACE_SIZE]; NOTE_COPY_WIDTH_V1];
+        columns.extend(row.into_iter().map(|v| vec![field(v); TRACE_SIZE]));
+        columns
+    }
+}
+impl ProofManagedNoteStarkAdapterV1 for Adapter {
+    type ProfileChallenges = ();
+    fn protocol_v1(&self) -> ProofManagedNoteStarkProtocolV1 {
+        ProofManagedNoteStarkProtocolV1 {
+            parameters: AggregateStarkParametersV1 {
+                proof_magic: *b"ARG1",
+                proof_version: 1,
+                security_lanes: 1,
+                query_count: 136,
+                blowup_log2: 3,
+                terminal_log2: 10,
+                terminal_degree_bound: 143,
+                composition_degree_chunks: 4,
+                minimum_trace_log2: TRACE_LOG,
+                maximum_trace_log2: TRACE_LOG,
+                maximum_trace_groups: 1,
+                maximum_segment_instances: 1,
+                maximum_base_columns_per_instance: AIR_WIDTH + NOTE_COPY_WIDTH_V1,
+                maximum_aux_columns_per_instance: NOTE_COPY_AUX_WIDTH_V1,
+                maximum_proof_bytes: MAX_PROOF_BYTES,
+            },
+            domains: DOMAINS,
+            maximum_constraint_degree: 4,
+            profile_binding_label: b"arena-axis-research-profile-binding-v1",
+            profile_descriptor: DESCRIPTOR,
+            relation_layout_domain: b"arena-axis-research-relation-layout-v1",
+        }
+    }
+    fn public_input_digest_v1(&self) -> Result<GoldilocksDigest384V1, Error> {
+        let values = self
+            .statement
+            .iter()
+            .flat_map(|v| v.to_le_bytes())
+            .collect::<Vec<_>>();
+        let mut source_hash = Sha256::new();
+        for source in [
+            include_bytes!("arena_geometry_air.rs").as_slice(),
+            include_bytes!("checked_integer_air.rs").as_slice(),
+            include_bytes!("integer_air.rs").as_slice(),
+            include_bytes!("arena_geometry_stark_research.rs").as_slice(),
+        ] {
+            source_hash.update((source.len() as u64).to_le_bytes());
+            source_hash.update(source);
+        }
+        goldilocks_digest384_frame_v1(
+            CONTEXT,
+            b"arena-axis-research-public-intersection-v1",
+            b"statement",
+            0,
+            0,
+            0,
+            &[&source_hash.finalize(), &values],
+        )
+        .map_err(|_| Error::InvalidProfile)
+    }
+    fn trace_log2_v1(&self) -> u8 {
+        TRACE_LOG
+    }
+    fn base_width_v1(&self) -> usize {
+        AIR_WIDTH + NOTE_COPY_WIDTH_V1
+    }
+    fn profile_aux_width_v1(&self) -> usize {
+        0
+    }
+    fn profile_fixed_width_v1(&self) -> usize {
+        STATEMENT_COUNT
+    }
+    fn profile_constraint_count_v1(&self) -> usize {
+        AIR_CONSTRAINTS + STATEMENT_COUNT
+    }
+    fn copy_schedule_v1(&self) -> Result<NoteCopyScheduleV1, Error> {
+        Ok(NoteCopyScheduleV1 {
+            policies: vec![[NoteCopyCellPolicyV1::Inactive; NOTE_COPY_WIDTH_V1]; TRACE_SIZE],
+            sigma: (0..TRACE_SIZE)
+                .map(|r| std::array::from_fn(|c| (r * NOTE_COPY_WIDTH_V1 + c + 1) as u32))
+                .collect(),
+        })
+    }
+    fn profile_fixed_columns_v1(&self) -> Result<Vec<Vec<F>>, Error> {
+        Ok(self
+            .statement
+            .iter()
+            .map(|&v| vec![field(v); TRACE_SIZE])
+            .collect())
+    }
+    fn derive_profile_challenges_v1(
+        &self,
+        _: &mut TransparentTranscriptV1,
+        _: NoteCopyChallengesV1,
+    ) -> Result<(), Error> {
+        Ok(())
+    }
+    fn build_profile_aux_columns_v1(
+        &self,
+        _: &[Vec<F>],
+        _: &[Vec<F>],
+        _: &[Vec<F>],
+        _: NoteCopyChallengesV1,
+        _: &(),
+    ) -> Result<Vec<Vec<F>>, Error> {
+        Ok(vec![])
+    }
+    fn profile_constraint_residues_v1(
+        &self,
+        current: &[F],
+        next: &[F],
+        _: &[F],
+        _: &[F],
+        fixed: &[F],
+        _: NoteCopyChallengesV1,
+        _: &(),
+    ) -> Result<Vec<F>, Error> {
+        Ok(self.compiled.air.residues(
+            &current[NOTE_COPY_WIDTH_V1..],
+            &next[NOTE_COPY_WIDTH_V1..],
+            &fixed[NOTE_COPY_FIXED_WIDTH_V1..],
+        ))
+    }
+}
+
+/// Bounded one-axis segment/AABB experiment. Both slab endpoints, shared ray,
+/// ordered box, parallel gate and output are constrained and verifier-fixed.
+pub(super) fn run(output: &Path) -> Result<(), Box<dyn std::error::Error>> {
+    std::fs::create_dir_all(output)?;
+    let statement = [0, 40, 10, 20, 1, Q20 / 4, Q20 / 4, Q20 / 2];
+    let adapter = Adapter::new(statement)?;
+    let protocol = adapter.protocol_v1();
+    protocol.validate()?;
+    let layout = AggregateProofLayoutV1::new(
+        protocol.parameters,
+        vec![AggregateTraceGroupLayoutV1 {
+            native_trace_log2: TRACE_LOG,
+            segment_instances: 1,
+            base_width: adapter.base_width_v1(),
+            aux_width: NOTE_COPY_AUX_WIDTH_V1,
+        }],
+    )?;
+    let maximum_wire = maximum_encoded_proof_with_deep_bytes_v1(protocol.parameters, &layout)?;
+    if maximum_wire > MAX_PROOF_BYTES {
+        return Err(Error::Resource.into());
+    }
+    println!("native_backend=execution_proofs/stark/proof_managed_note_stark.rs");
+    println!(
+        "trace_rows={TRACE_SIZE} base_columns={} aux_columns={} fixed_columns={} profile_constraints={} maximum_wire_bytes={maximum_wire}",
+        adapter.base_width_v1(),
+        NOTE_COPY_AUX_WIDTH_V1,
+        NOTE_COPY_FIXED_WIDTH_V1 + STATEMENT_COUNT,
+        adapter.profile_constraint_count_v1()
+    );
+    println!("stage=prove");
+    let columns = adapter.columns();
+    let started = Instant::now();
+    let proof = prove_proof_managed_note_stark_v1(&adapter, &columns)?;
+    let prove_ms = started.elapsed().as_millis();
+    drop(columns);
+    println!("prove_ms={prove_ms} proof_bytes={}", proof.len());
+    std::fs::write(output.join("axis-intersection.stark"), &proof)?;
+    std::fs::write(
+        output.join("public-statement.txt"),
+        format!("{statement:?}\n"),
+    )?;
+    println!("stage=verify");
+    let started = Instant::now();
+    verify_proof_managed_note_stark_v1(&adapter, &proof)?;
+    let verify_ms = started.elapsed().as_millis();
+    println!("verify_ms={verify_ms} valid_proof=accepted");
+    let mut rejected = 0;
+    for (label, index) in [
+        ("start", 0),
+        ("end", 1),
+        ("minimum", 2),
+        ("maximum", 3),
+        ("hit", 4),
+        ("fraction", 5),
+        ("near", 6),
+        ("far", 7),
+    ] {
+        let mut altered = statement;
+        altered[index] = if index == 4 { 0 } else { statement[index] + 1 };
+        let other = Adapter::new(altered)?;
+        let error = verify_proof_managed_note_stark_v1(&other, &proof)
+            .err()
+            .ok_or("altered public statement was accepted")?;
+        println!("altered_{label}=rejected error={error}");
+        rejected += 1;
+    }
+    let truncated = &proof[..proof.len() - 1];
+    let mut trailing = proof.clone();
+    trailing.push(0);
+    let mut tampered = proof.clone();
+    let position = tampered.len() / 3;
+    tampered[position] ^= 1;
+    for (label, bytes) in [
+        ("truncated", truncated),
+        ("trailing", trailing.as_slice()),
+        ("tampered", tampered.as_slice()),
+    ] {
+        let error = verify_proof_managed_note_stark_v1(&adapter, bytes)
+            .err()
+            .ok_or("malformed proof was accepted")?;
+        println!("{label}_proof=rejected error={error}");
+        rejected += 1;
+    }
+    let proof_sha256 = format!("{:x}", Sha256::digest(&proof));
+    let report = format!(
+        "research_only=true\nqualified=false\nrelation=single_fixed_public_one_axis_segment_aabb_intersection\nproof_bytes={}\nproof_sha256={proof_sha256}\nprove_ms={prove_ms}\nverify_ms={verify_ms}\nnegative_verifications={rejected}\n",
+        proof.len()
+    );
+    std::fs::write(output.join("measurements.txt"), &report)?;
+    print!("{report}");
+    Ok(())
+}
diff --git a/crates/iroha_core/src/execution_proofs/arena_history_translation_research.rs b/crates/iroha_core/src/execution_proofs/arena_history_translation_research.rs
new file mode 100644
index 0000000000000000000000000000000000000000..b5c95eb784055efac6f933239739bf1caae08a5a
--- /dev/null
+++ b/crates/iroha_core/src/execution_proofs/arena_history_translation_research.rs
@@ -0,0 +1,165 @@
+//! Pure, unregistered translation of signed Arena P2P controls into native batch shapes.
+//!
+//! The returned dispute root is conditional on caller-supplied checkpoint/anchors.
+//! Nothing here selects ledger history, proves Arena execution, or authorizes funds.
+
+use super::arena_kill_history_research::{
+    P2PCertifiedBatchV2, P2PContextV2, research_genesis_root_v1, research_manifest_v1,
+};
+use iroha_crypto::Hash;
+use iroha_data_model::{
+    NetworkId,
+    game::{
+        GameAdmissionBodyV1, GameCheckpointV1, GameForcedBatchV1, GameManifestV1,
+        GameTranscriptAnchorV1, GameTranscriptBatchV1, GameTranscriptV1, game_message_hash_v1,
+    },
+};
+
+const BATCHES: usize = 13;
+const SLOTS: usize = 3;
+const TICKS_PER_BATCH: usize = 2;
+
+/// Pure projection. `checkpoint` and `anchors` are not authenticated by this type.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ArenaNativeHistoryProjectionV1 {
+    /// Game P2P rolling root; SHA-256 and distinct from either native hash.
+    pub p2p_root: [u8; 32],
+    /// Native forced-batch shape with sequential native epochs `0..12`.
+    pub forced_batches: Vec<GameForcedBatchV1>,
+    /// Native Norito input-transcript hash over the exact translated controls.
+    pub transcript_root: Hash,
+    /// Native epoch following all thirteen forced batches.
+    pub epoch: u64,
+    /// Caller-supplied checkpoint, copied into the dispute-root components.
+    pub checkpoint: Option<GameCheckpointV1>,
+    /// Caller-supplied anchors, copied into the dispute-root components.
+    pub anchors: Vec<GameTranscriptAnchorV1>,
+    /// Conditional Norito dispute root over session, epoch, checkpoint, anchors and batches.
+    pub dispute_root: Hash,
+}
+
+/// Verify every original-slot P2P certificate/opening and derive native batch shapes.
+///
+/// P2P epoch zero is local to this fixed research history. The native batch epoch
+/// advances after each forced batch; the two numbers must never be aliased.
+pub fn translate_signed_arena_history_v1(
+    network: &NetworkId,
+    session_id: Hash,
+    manifest: &GameManifestV1,
+    admission: &GameAdmissionBodyV1,
+    history: &[P2PCertifiedBatchV2],
+    checkpoint: Option<&GameCheckpointV1>,
+    anchors: &[GameTranscriptAnchorV1],
+) -> Result<ArenaNativeHistoryProjectionV1, String> {
+    if *manifest != research_manifest_v1() || history.len() != BATCHES || !anchors.is_empty() {
+        return Err("translation requires the exact thirteen-batch research manifest".into());
+    }
+    let _research_genesis = research_genesis_root_v1(network, session_id, manifest, admission)?;
+    if checkpoint.is_some_and(|checkpoint| {
+        checkpoint.session_id != session_id
+            || checkpoint.tick != 0
+            || checkpoint.epoch != 0
+            || checkpoint.terminal
+    }) {
+        return Err("research translation requires a session-bound genesis checkpoint".into());
+    }
+    let context = P2PContextV2::from_admission(network, session_id, manifest, admission)?;
+    let mut p2p_root = context.genesis_root();
+    let mut forced_batches = Vec::with_capacity(BATCHES);
+    for (index, certified) in history.iter().enumerate() {
+        let set = &certified.set;
+        let start_tick = (index * TICKS_PER_BATCH) as u32;
+        if set.epoch != 0
+            || set.start_tick != start_tick
+            || set.parent != p2p_root
+            || set.commitments.len() != SLOTS
+            || certified.signatures.len() != SLOTS
+            || certified.reveals.len() != SLOTS
+        {
+            return Err("P2P history has a gap, fork, or incomplete original roster".into());
+        }
+        let digest = context.set_digest(set)?;
+        let mut inputs = Vec::with_capacity(SLOTS);
+        for slot in 0..SLOTS {
+            let signature = &certified.signatures[slot];
+            let reveal = &certified.reveals[slot];
+            if usize::from(signature.slot) != slot
+                || usize::from(reveal.slot) != slot
+                || signature
+                    .signature
+                    .verify(&admission.participants[slot].input_key, &digest)
+                    .is_err()
+                || context.input_commitment(set, reveal)? != set.commitments[slot]
+            {
+                return Err("P2P batch certificate or exact opening is invalid".into());
+            }
+            inputs.push(reveal.payload.to_vec());
+        }
+        forced_batches.push(GameForcedBatchV1 {
+            epoch: index as u64,
+            start_tick,
+            inputs,
+            dnf_slots: Vec::new(),
+        });
+        p2p_root = context.next_root(p2p_root, certified)?;
+    }
+    let native_transcript = GameTranscriptV1 {
+        batches: forced_batches
+            .iter()
+            .map(|batch| GameTranscriptBatchV1 {
+                start_tick: batch.start_tick,
+                inputs: batch.inputs.clone(),
+            })
+            .collect(),
+        dnf_events: Vec::new(),
+    };
+    let transcript_root = game_message_hash_v1(network, "input-transcript", &native_transcript);
+    let epoch = BATCHES as u64;
+    let checkpoint = checkpoint.copied();
+    let anchors = anchors.to_vec();
+    let dispute_root = game_message_hash_v1(
+        network,
+        "dispute-history",
+        &(
+            session_id,
+            epoch,
+            checkpoint,
+            anchors.clone(),
+            forced_batches.clone(),
+        ),
+    );
+    Ok(ArenaNativeHistoryProjectionV1 {
+        p2p_root,
+        forced_batches,
+        transcript_root,
+        epoch,
+        checkpoint,
+        anchors,
+        dispute_root,
+    })
+}
+
+/// Reject any claimed native projection or hash that differs from the signed controls.
+/// This compares caller values to a pure derivation, not to consensus-retained state.
+pub fn verify_claimed_arena_translation_v1(
+    network: &NetworkId,
+    session_id: Hash,
+    manifest: &GameManifestV1,
+    admission: &GameAdmissionBodyV1,
+    history: &[P2PCertifiedBatchV2],
+    claimed: &ArenaNativeHistoryProjectionV1,
+) -> Result<(), String> {
+    let derived = translate_signed_arena_history_v1(
+        network,
+        session_id,
+        manifest,
+        admission,
+        history,
+        claimed.checkpoint.as_ref(),
+        &claimed.anchors,
+    )?;
+    if derived != *claimed {
+        return Err("claimed native translation differs from signed Arena controls".into());
+    }
+    Ok(())
+}
diff --git a/crates/iroha_core/src/execution_proofs/arena_hit_air.rs b/crates/iroha_core/src/execution_proofs/arena_hit_air.rs
new file mode 100644
index 0000000000000000000000000000000000000000..9bcb8a2ae2604af3508d3d5c60855d560b9d6626
--- /dev/null
+++ b/crates/iroha_core/src/execution_proofs/arena_hit_air.rs
@@ -0,0 +1,525 @@
+//! Test-only composed aim, bounded geometry and nearest eligible hitscan selection.
+//! This relation proves a selected attack's target, not its legal initiation or
+//! complete match history. TODO: bind its full ordered roster/map/control snapshot
+//! into the parent execution relation before any profile or monetary qualification.
+
+use super::{
+    arena_aim_air::direction_v1,
+    arena_geometry_air::{COORDINATE_LIMIT, GeometryIntersectionV1, Q20, intersect_v1},
+    checked_integer_air::{
+        boolean_input_v1, bounded_input_v1, bounded_value_v1, constrain_boolean_v1, select_v1,
+    },
+    integer_air::{IntegerAirV1, Value},
+};
+
+const BODY_RADIUS_MM: i64 = 350;
+const BODY_HEIGHT_MM: i64 = 1700;
+const EYE_HEIGHT_MM: i64 = 1400;
+const MELEE_EXPANSION_MM: i64 = 180;
+const MAX_RANGE_MM: i64 = 70000;
+
+#[derive(Clone, Copy)]
+struct PlayerColumns {
+    position: [Value; 3],
+    team: Value,
+    alive: Value,
+    protection: Value,
+}
+
+fn choose(
+    air: &mut IntegerAirV1,
+    selectors: &mut Vec<Value>,
+    condition: Value,
+    yes: Value,
+    no: Value,
+) -> Value {
+    let condition = constrain_boolean_v1(air, condition);
+    selectors.push(condition.value());
+    select_v1(air, condition, yes, no).expect("bounded hit selector")
+}
+
+struct ArenaHitAirV1 {
+    air: IntegerAirV1,
+    hit: Value,
+    /// Zero means no target; otherwise the original roster slot plus one.
+    target: Value,
+    fraction: Value,
+    nearest: Value,
+    direction: [Value; 3],
+    from: [Value; 3],
+    to: [Value; 3],
+    eligible: Vec<Value>,
+    selectors: Vec<Value>,
+    intersections: Vec<GeometryIntersectionV1>,
+}
+
+impl ArenaHitAirV1 {
+    /// Graph dimensions and attacker slot are verifier-fixed, never witness claims.
+    /// Inputs: team-mode, melee, range-mm, yaw, pitch; six fields per original
+    /// player [x,y,z,team,alive,protection]; six per wall [min xyz,max xyz].
+    fn compile(
+        players_count: usize,
+        walls_count: usize,
+        attacker: usize,
+    ) -> Result<Self, &'static str> {
+        if !(1..=12).contains(&players_count) || walls_count > 32 || attacker >= players_count {
+            return Err("invalid verifier-fixed roster/wall/attacker dimensions");
+        }
+        let mut air = IntegerAirV1::default();
+        let team_mode = boolean_input_v1(&mut air).value();
+        let melee = boolean_input_v1(&mut air).value();
+        let range = bounded_input_v1(&mut air, 1, MAX_RANGE_MM).expect("weapon range domain");
+        let yaw = bounded_input_v1(&mut air, 0, 65535).expect("yaw domain");
+        let pitch = bounded_input_v1(&mut air, -16384, 16384).expect("pitch domain");
+        let mut players = Vec::with_capacity(players_count);
+        for _ in 0..players_count {
+            players.push(PlayerColumns {
+                position: std::array::from_fn(|_| {
+                    bounded_input_v1(&mut air, -COORDINATE_LIMIT, COORDINATE_LIMIT)
+                        .expect("player coordinate")
+                }),
+                team: bounded_input_v1(&mut air, 0, 1).expect("team"),
+                alive: boolean_input_v1(&mut air).value(),
+                protection: bounded_input_v1(&mut air, 0, 65535).expect("spawn protection"),
+            });
+        }
+        let walls = (0..walls_count)
+            .map(|_| {
+                let minimum = std::array::from_fn(|_| {
+                    bounded_input_v1(&mut air, -COORDINATE_LIMIT, COORDINATE_LIMIT)
+                        .expect("wall minimum")
+                });
+                let maximum = std::array::from_fn(|_| {
+                    bounded_input_v1(&mut air, -COORDINATE_LIMIT, COORDINATE_LIMIT)
+                        .expect("wall maximum")
+                });
+                (minimum, maximum)
+            })
+            .collect::<Vec<([Value; 3], [Value; 3])>>();
+        // This slice is entered for an already initiated attack by a living actor.
+        air.equate(players[attacker].alive, Value::constant(1));
+        let direction = direction_v1(&mut air, yaw, pitch);
+        let mut from = players[attacker].position;
+        from[2] = air.add_constant(from[2], EYE_HEIGHT_MM);
+        let to = std::array::from_fn(|axis| {
+            let scaled = air.mul(direction[axis], range);
+            let offset = air.divide(scaled, 32767);
+            air.add(from[axis], offset)
+        });
+        let mut nearest = Value::constant(Q20 + 1);
+        let mut target = Value::constant(0);
+        let mut selectors = Vec::new();
+        let mut intersections = Vec::with_capacity(walls_count + players_count);
+        for (minimum, maximum) in walls {
+            let intersection = intersect_v1(&mut air, from, to, minimum, maximum);
+            let closer = air.less(intersection.fraction, nearest);
+            let replace = air.and(intersection.hit, closer);
+            nearest = choose(
+                &mut air,
+                &mut selectors,
+                replace,
+                intersection.fraction,
+                nearest,
+            );
+            intersections.push(intersection);
+        }
+        let expansion = air.mul_constant(melee, MELEE_EXPANSION_MM);
+        let radius = air.add_constant(expansion, BODY_RADIUS_MM);
+        let non_team_mode = air.not(team_mode);
+        let mut eligible = Vec::with_capacity(players_count);
+        for (slot, player) in players.iter().enumerate() {
+            let difference = air.sub(players[attacker].team, player.team);
+            let absolute_difference = air.absolute(difference);
+            let different_team = air.less(Value::constant(0), absolute_difference);
+            let enemy_team = air.or(non_team_mode, different_team);
+            let enemy = air.and(enemy_team, Value::constant(i64::from(slot != attacker)));
+            let protected = air.less(Value::constant(0), player.protection);
+            let unprotected = air.not(protected);
+            let alive_enemy = air.and(player.alive, enemy);
+            let admissible = air.and(alive_enemy, unprotected);
+            let admissible = constrain_boolean_v1(&mut air, admissible).value();
+            eligible.push(admissible);
+            let minimum = [
+                air.sub(player.position[0], radius),
+                air.sub(player.position[1], radius),
+                player.position[2],
+            ];
+            let maximum = [
+                air.add(player.position[0], radius),
+                air.add(player.position[1], radius),
+                air.add_constant(player.position[2], BODY_HEIGHT_MM),
+            ];
+            let intersection = intersect_v1(&mut air, from, to, minimum, maximum);
+            let closer = air.less(intersection.fraction, nearest);
+            let intersected_enemy = air.and(admissible, intersection.hit);
+            let replace = air.and(intersected_enemy, closer);
+            nearest = choose(
+                &mut air,
+                &mut selectors,
+                replace,
+                intersection.fraction,
+                nearest,
+            );
+            target = choose(
+                &mut air,
+                &mut selectors,
+                replace,
+                Value::constant(slot as i64 + 1),
+                target,
+            );
+            intersections.push(intersection);
+        }
+        let hit = air.less(Value::constant(0), target);
+        let hit = constrain_boolean_v1(&mut air, hit).value();
+        let fraction = choose(&mut air, &mut selectors, hit, nearest, Value::constant(0));
+        let fraction = bounded_value_v1(&mut air, fraction, 0, Q20).expect("hit fraction");
+        let target = bounded_value_v1(&mut air, target, 0, players_count as i64)
+            .expect("original roster slot");
+        Ok(Self {
+            air,
+            hit,
+            target,
+            fraction,
+            nearest,
+            direction,
+            from,
+            to,
+            eligible,
+            selectors,
+            intersections,
+        })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::super::integer_air::{Source, field};
+    use super::*;
+    use crate::privacy_engines::transparent_stark::GoldilocksFieldV1 as F;
+
+    fn column(value: Value) -> usize {
+        let Source::Column(index) = value.source else {
+            panic!("witness column")
+        };
+        index
+    }
+    fn accepted(graph: &ArenaHitAirV1, row: &[F]) -> bool {
+        graph
+            .air
+            .residues(row, row, &[])
+            .iter()
+            .all(|v| *v == F::ZERO)
+    }
+    fn sine(angle: i64) -> i64 {
+        let (x, sign) = if angle > 32768 {
+            (angle - 32768, -1)
+        } else {
+            (angle, 1)
+        };
+        let p = x * (32768 - x);
+        sign * 16 * p * 32767 / (5 * 32768_i64.pow(2) - 4 * p)
+    }
+    /// Direct reference uses full signed divisions and early exits, without the
+    /// AIR's clipping, safe-numerator substitution, or polynomial graph helpers.
+    fn intersect(
+        from: [i64; 3],
+        to: [i64; 3],
+        minimum: [i64; 3],
+        maximum: [i64; 3],
+    ) -> Option<i64> {
+        let (mut near, mut far) = (0, Q20);
+        for axis in 0..3 {
+            let delta = to[axis] - from[axis];
+            if delta == 0 {
+                if from[axis] < minimum[axis] || from[axis] > maximum[axis] {
+                    return None;
+                }
+            } else {
+                let a = ((minimum[axis] - from[axis]) << 20) / delta;
+                let b = ((maximum[axis] - from[axis]) << 20) / delta;
+                near = near.max(a.min(b));
+                far = far.min(a.max(b));
+                if near > far {
+                    return None;
+                }
+            }
+        }
+        Some(near)
+    }
+    fn reference(input: &[i64], players: usize, walls: usize, attacker: usize) -> (i64, i64) {
+        let actor = &input[5 + attacker * 6..5 + (attacker + 1) * 6];
+        let from = [actor[0], actor[1], actor[2] + EYE_HEIGHT_MM];
+        let pitch = input[4].rem_euclid(65536);
+        let cp = sine((pitch + 16384) % 65536);
+        let direction = [
+            sine((input[3] + 16384) % 65536) * cp / 32767,
+            sine(input[3]) * cp / 32767,
+            sine(pitch),
+        ];
+        let to = std::array::from_fn(|i| from[i] + direction[i] * input[2] / 32767);
+        let (mut nearest, mut target) = (Q20 + 1, 0);
+        for wall in input[5 + players * 6..].chunks_exact(6).take(walls) {
+            if let Some(t) = intersect(
+                from,
+                to,
+                wall[..3].try_into().unwrap(),
+                wall[3..].try_into().unwrap(),
+            ) {
+                nearest = nearest.min(t);
+            }
+        }
+        for (slot, player) in input[5..5 + players * 6].chunks_exact(6).enumerate() {
+            if slot == attacker
+                || (input[0] != 0 && player[3] == actor[3])
+                || player[4] == 0
+                || player[5] > 0
+            {
+                continue;
+            }
+            let radius = BODY_RADIUS_MM + if input[1] != 0 { MELEE_EXPANSION_MM } else { 0 };
+            let minimum = [player[0] - radius, player[1] - radius, player[2]];
+            let maximum = [
+                player[0] + radius,
+                player[1] + radius,
+                player[2] + BODY_HEIGHT_MM,
+            ];
+            if let Some(t) = intersect(from, to, minimum, maximum) {
+                if t < nearest {
+                    nearest = t;
+                    target = slot as i64 + 1;
+                }
+            }
+        }
+        (target, if target == 0 { 0 } else { nearest })
+    }
+    fn fixture(players: &[[i64; 6]], walls: &[[i64; 6]]) -> Vec<i64> {
+        let mut data = vec![0, 0, 10000, 0, 0];
+        data.extend(players.iter().flatten());
+        data.extend(walls.iter().flatten());
+        data
+    }
+    fn check(
+        players: usize,
+        walls: usize,
+        attacker: usize,
+        input: &[i64],
+        expected_target: Option<i64>,
+    ) {
+        let graph = ArenaHitAirV1::compile(players, walls, attacker).unwrap();
+        let expected = reference(input, players, walls, attacker);
+        if let Some(target) = expected_target {
+            assert_eq!(expected.0, target, "reference fixture");
+        }
+        let row = graph.air.witness(input, &[]);
+        assert_eq!(
+            (row[column(graph.target)], row[column(graph.fraction)]),
+            expected
+        );
+        assert_eq!(row[column(graph.hit)], i64::from(expected.0 != 0));
+        assert!(accepted(
+            &graph,
+            &row.into_iter().map(field).collect::<Vec<_>>()
+        ));
+    }
+
+    #[test]
+    fn wall_priority_player_ties_endpoint_and_no_hit_match_kernel() {
+        let players = [
+            [0, 0, 0, 0, 1, 0],
+            [5000, 0, 0, 1, 1, 0],
+            [5000, 0, 0, 1, 1, 0],
+        ];
+        check(3, 0, 0, &fixture(&players, &[]), Some(2));
+        // Equal entry fractions: the wall wins, then a wall one millimetre farther
+        // permits the lower original player slot to win the player tie.
+        for (x, winner) in [(4650, 0), (4651, 2), (4649, 0), (0, 0)] {
+            check(
+                3,
+                1,
+                0,
+                &fixture(&players, &[[x, -100, 0, x + 1, 100, 1700]]),
+                Some(winner),
+            );
+        }
+        for walls in [
+            [
+                [8000, -100, 0, 8001, 100, 1700],
+                [4650, -100, 0, 4651, 100, 1700],
+            ],
+            [
+                [4650, -100, 0, 4651, 100, 1700],
+                [8000, -100, 0, 8001, 100, 1700],
+            ],
+        ] {
+            check(3, 2, 0, &fixture(&players, &walls), Some(0));
+        }
+        let endpoint = [[0, 0, 0, 0, 1, 0], [10350, 0, 0, 1, 1, 0]];
+        check(2, 0, 0, &fixture(&endpoint, &[]), Some(2));
+        check(
+            2,
+            1,
+            0,
+            &fixture(&endpoint, &[[10000, -1, 0, 10001, 1, 1700]]),
+            Some(0),
+        );
+        check(1, 0, 0, &fixture(&players[..1], &[]), Some(0));
+        let missed = [[0, 0, 0, 0, 1, 0], [5000, 2000, 0, 1, 1, 0]];
+        check(2, 0, 0, &fixture(&missed, &[]), Some(0));
+    }
+
+    #[test]
+    fn ineligible_bodies_do_not_occlude_and_melee_expands_only_player_xy() {
+        let base = [
+            [0, 0, 0, 0, 1, 0],
+            [2000, 0, 0, 1, 1, 0],
+            [5000, 0, 0, 1, 1, 0],
+        ];
+        for (field_index, bad_value) in [(4, 0), (5, 1), (5, 65535)] {
+            let mut players = base;
+            players[1][field_index] = bad_value;
+            check(3, 0, 0, &fixture(&players, &[]), Some(3));
+        }
+        let mut players = base;
+        players[1][3] = 0;
+        let mut input = fixture(&players, &[]);
+        input[0] = 1;
+        check(3, 0, 0, &input, Some(3));
+        input[0] = 0;
+        check(3, 0, 0, &input, Some(2));
+        let melee_players = [[0, 0, 0, 0, 1, 0], [1000, 450, 0, 1, 1, 0]];
+        let mut input = fixture(&melee_players, &[[200, 100, 0, 300, 200, 1700]]);
+        input[2] = 2300;
+        check(2, 1, 0, &input, Some(0));
+        input[1] = 1;
+        check(2, 1, 0, &input, Some(2));
