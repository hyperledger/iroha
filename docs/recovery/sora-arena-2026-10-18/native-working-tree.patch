--- /dev/null
+++ b/scripts/check_arena_damage_stark.py
@@ -0,0 +1,240 @@
+#!/usr/bin/env python3
+"""Prove/verify one public Arena damage relation with Iroha's actual native STARK.
+
+Compiles the untouched native execution backend plus the research adapter against
+already built, explicitly pinned workspace rlibs. Python3, Node.js, Git and the
+workspace Rust toolchain are required; no environment overrides are needed.
+Each invocation creates an exclusive run directory and checks the repository
+source-state owner, dependency hashes and compiler/standard-library hashes before
+and after compile/run. Any change marks the run invalid; build-only is not proof. Extracts the complete unchanged native Goldilocks
+base/extension-field source, not a replacement implementation. No cfg(test), core
+unit-fixture migration, profile registration, downloaded crypto or reduced security.
+A local experiment only: no hit legitimacy, game-history, custody or settlement proof.
+"""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import platform
+import re
+import shutil
+import tempfile
+import subprocess
+import sys
+
+
+REQUIRED_LIBRARIES = ('zeroize', 'thiserror', 'fastpq_isi', 'rayon', 'rand', 'sha2', 'iroha_data_model')
+
+
+def file_hash(path):
+    """Hash a stable regular input; detect writes or replacement during reading."""
+    before = path.stat()
+    if not path.is_file():
+        raise ValueError('input is not a regular file: ' + str(path))
+    digest = hashlib.sha256()
+    with path.open('rb') as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b''):
+            digest.update(block)
+    after = path.stat()
+    fields = ('st_dev', 'st_ino', 'st_size', 'st_mtime_ns', 'st_ctime_ns')
+    if any(getattr(before, field) != getattr(after, field) for field in fields):
+        raise ValueError('input changed while hashing: ' + str(path))
+    return digest.hexdigest()
+
+
+def write_json(path, value):
+    with path.open('x') as stream:
+        json.dump(value, stream, indent=2, sort_keys=True)
+        stream.write('\n')
+
+
+def create_output(target, explicit, build_only):
+    """Never reuse a run, including an earlier failed or build-only directory."""
+    if explicit is not None:
+        explicit = explicit.resolve()
+        explicit.mkdir(parents=True, exist_ok=False)
+        return explicit
+    parent = target / 'arena-damage-stark-research/runs'
+    parent.mkdir(parents=True, exist_ok=True)
+    return Path(tempfile.mkdtemp(prefix='build-' if build_only else 'prove-', dir=parent))
+
+
+def select_dependencies(deps, manifest_path):
+    deps = deps.resolve()
+    supplied = None
+    if manifest_path:
+        supplied = json.loads(manifest_path.read_text())
+        if set(supplied) != {'schema', 'dependencies'} or supplied['schema'] != 'iroha.arena.research_dependencies.v1':
+            raise ValueError('invalid dependency manifest schema')
+        supplied = supplied['dependencies']
+        if set(supplied) != set(REQUIRED_LIBRARIES):
+            raise ValueError('dependency manifest must pin all seven libraries')
+    selected = {}
+    for name in REQUIRED_LIBRARIES:
+        if supplied is not None:
+            entry = supplied[name]
+            if set(entry) != {'path', 'sha256'} or not re.fullmatch('[0-9a-f]{64}', entry['sha256']):
+                raise ValueError('invalid dependency pin: ' + name)
+            path = Path(entry['path'])
+            if not path.is_absolute():
+                path = manifest_path.resolve().parent / path
+            path = path.resolve(strict=True)
+            if path.parent != deps or not re.fullmatch('lib' + name + '-[A-Za-z0-9]+\.rlib', path.name):
+                raise ValueError('dependency must be an exact named rlib in selected target/debug/deps: ' + name)
+            if file_hash(path) != entry['sha256']:
+                raise ValueError('dependency hash differs from explicit pin: ' + name)
+        else:
+            candidates = sorted(deps.glob('lib' + name + '-*.rlib'))
+            if len(candidates) != 1:
+                raise ValueError(f'{name} has {len(candidates)} candidate rlibs; provide --dependency-manifest with exact paths and SHA256s')
+            path = candidates[0].resolve(strict=True)
+        selected[name] = {'path': str(path), 'sha256': file_hash(path)}
+    return selected
+
+
+def toolchain_state():
+    rustc = shutil.which('rustc')
+    if rustc is None:
+        raise ValueError('rustc is unavailable')
+    version = subprocess.check_output([rustc, '--version', '--verbose'], text=True)
+    host = next(line.removeprefix('host: ') for line in version.splitlines() if line.startswith('host: '))
+    sysroot = Path(subprocess.check_output([rustc, '--print', 'sysroot'], text=True).strip()).resolve()
+    files = [sysroot / 'bin/rustc']
+    files += list((sysroot / 'lib').glob('*rustc_driver*'))
+    files += [p for p in (sysroot / 'lib/rustlib' / host / 'lib').rglob('*') if p.is_file()]
+    return {'rustc_command': str(Path(rustc).resolve()), 'version_verbose': version, 'sysroot': str(sysroot),
+            'files_sha256': {str(p.relative_to(sysroot)): file_hash(p) for p in sorted(files)}}
+
+
+def capture_seal(root, dependencies):
+    """Use the repository's exact tracked/untracked Git source-state owner."""
+    reader = root / 'javascript/iroha_js/scripts/read-native-build-source-state.mjs'
+    source = json.loads(subprocess.check_output(['node', str(reader), '--', str(root)], text=True, cwd=root))
+    if set(source) != {'sourceGitRevision', 'sourceTreeClean', 'sourceTreeSha256'}:
+        raise ValueError('source-state owner returned an invalid schema')
+    observed = {name: {'path': entry['path'], 'sha256': file_hash(Path(entry['path']))} for name, entry in dependencies.items()}
+    if observed != dependencies:
+        raise ValueError('a pinned dependency changed')
+    return {'source': source, 'dependencies': observed, 'toolchain': toolchain_state()}
+
+
+def require_same_seal(before, after):
+    if not isinstance(before, dict) or not isinstance(after, dict) or set(before) != {'source', 'dependencies', 'toolchain'} or set(after) != set(before):
+        raise ValueError('complete before/after seals are required')
+    if before != after:
+        raise ValueError('source, pinned dependency or Rust toolchain seal changed; run is invalid')
+
+
+def finalize_run(output, build_only, before, after, error=None):
+    if error is None:
+        try:
+            require_same_seal(before, after)
+        except ValueError as failure:
+            error = str(failure)
+    status = {'schema': 'iroha.arena.damage_stark.run.v1', 'kind': 'build_only' if build_only else 'prove_verify',
+              'status': 'invalid' if error else ('build_complete' if build_only else 'proof_verified'),
+              'proof_verified': not build_only and error is None, 'research_only': True, 'registered': False}
+    if error:
+        status['error'] = error
+    status['artifacts_sha256'] = {p.name: file_hash(p) for p in sorted(output.iterdir()) if p.is_file() and p.name != 'run-status.json'}
+    write_json(output / 'run-status.json', status)
+    return status
+
+
+def main():
+    root = Path(__file__).resolve().parent.parent
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--target-dir', type=Path, default=root / 'target')
+    parser.add_argument('--dependency-manifest', type=Path, help='exact seven rlib paths and SHA256 pins; required when cache contains alternatives')
+    parser.add_argument('--output-dir', type=Path, help='new, nonexistent directory; defaults to a fresh exclusive run under target')
+    parser.add_argument('--build-only', action='store_true')
+    parser.add_argument('--threads', type=int, default=4)
+    args = parser.parse_args()
+    if not 1 <= args.threads <= 16:
+        parser.error('--threads must be 1..16')
+    target = args.target_dir.resolve()
+    deps = (target / 'debug/deps').resolve()
+    output = create_output(target, args.output_dir, args.build_only)
+    print('Exclusive research run:', output, flush=True)
+    dependencies = None
+    before = after = None
+    error = None
+    try:
+        dependencies = select_dependencies(deps, args.dependency_manifest)
+        before = capture_seal(root, dependencies)
+        write_json(output / 'seal-before.json', before)
+        execute(root, deps, output, args, dependencies, before)
+        after = capture_seal(root, dependencies)
+        write_json(output / 'seal-after.json', after)
+        require_same_seal(before, after)
+    except Exception as failure:
+        error = str(failure)
+        if dependencies is not None and after is None:
+            try:
+                after = capture_seal(root, dependencies)
+                write_json(output / 'seal-after.json', after)
+            except Exception as guard_failure:
+                error += '; final seal unavailable: ' + str(guard_failure)
+    status = finalize_run(output, args.build_only, before, after, error)
+    print('Research status:', status['status'], flush=True)
+    if status['status'] == 'invalid':
+        print(status['error'], file=sys.stderr)
+        sys.exit(1)
+
+
+def execute(root, deps, output, args, dependencies, before):
+    externs = [item for name, entry in dependencies.items() for item in ['--extern', name + '=' + entry['path']]]
+    field_path = root / 'crates/iroha_core/src/privacy_engines/transparent_stark.rs'
+    source = field_path.read_text()
+    start, end = '/// Canonical Goldilocks field element.', '/// Failure in protocol-neutral transparent-proof machinery.'
+    if source.count(start) != 1 or source.count(end) != 1:
+        parser.error('native field extraction boundaries changed')
+    names = ['GOLDILOCKS_MODULUS_V1', 'GOLDILOCKS_EPSILON_V1', 'GOLDILOCKS_GENERATOR_V1', 'GOLDILOCKS_FP4_DEGREE_V1', 'GOLDILOCKS_FP4_WIRE_BYTES_V1', 'GOLDILOCKS_FP4_NONRESIDUE_V1']
+    constants = []
+    for name in names:
+        matches = [line for line in source.splitlines() if line.startswith(('const ' + name + ':', 'pub(crate) const ' + name + ':'))]
+        if len(matches) != 1 or not matches[0].endswith(';'):
+            parser.error('native constant declaration changed: ' + name)
+        constants.extend(matches)
+    field = 'use zeroize::Zeroize as _;\n' + '\n'.join(constants) + '\n' + source[source.index(start):source.index(end)]
+    (output / 'native_field.rs').write_text(field)
+    paths = [root / 'crates/iroha_core/src/execution_proofs' / (name + '.rs') for name in ['integer_air', 'checked_integer_air', 'arena_damage_air', 'arena_damage_stark_research']]
+    lines = ['#![allow(dead_code)]', 'mod privacy_engines { pub mod transparent_stark { include!("native_field.rs"); } }', 'mod execution_proofs {']
+    for path in paths:
+        lines.append('#[path = ' + json.dumps(str(path)) + '] mod ' + path.stem + ';')
+    stark = root / 'crates/iroha_core/src/execution_proofs/stark/mod.rs'
+    lines.extend(['#[path = ' + json.dumps(str(stark)) + '] mod stark;',
+                  'pub fn run(path: &std::path::Path)->Result<(),Box<dyn std::error::Error>> { arena_damage_stark_research::run(path) }', '}',
+                  'fn main()->Result<(),Box<dyn std::error::Error>> { let output=std::env::args().nth(1).ok_or("missing output directory")?; execution_proofs::run(std::path::Path::new(&output)) }'])
+    harness = output / 'harness.rs'; harness.write_text('\n'.join(lines) + '\n')
+    binary = output / 'native-damage-stark'
+    provenance_paths = paths + [field_path] + list(stark.parent.glob('*.rs'))
+    provenance = {'research_only': True, 'registered': False, 'rustc': subprocess.check_output(['rustc', '--version'], text=True).strip(), 'dependencies': dependencies,
+                  'sources': {str(p.relative_to(root)): hashlib.sha256(p.read_bytes()).hexdigest() for p in provenance_paths},
+                  'field_extraction_sha256': hashlib.sha256(field.encode()).hexdigest(), 'threads': args.threads}
+    (output / 'source-provenance.json').write_text(json.dumps(provenance, indent=2) + '\n')
+    subprocess.run(['rustc', '--edition=2024', '-C', 'opt-level=3', '-C', 'debuginfo=0', str(harness), '-L', 'dependency=' + str(deps), '-o', str(binary)] + externs, check=True, cwd=root)
+    compiled_seal = capture_seal(root, dependencies)
+    write_json(output / 'seal-after-compile.json', compiled_seal)
+    require_same_seal(before, compiled_seal)
+    print('Compiled actual native STARK backend:', binary, flush=True)
+    if args.build_only:
+        return
+    command = [str(binary), str(output)]
+    if platform.system() == 'Darwin':
+        command = ['/usr/bin/time', '-l'] + command
+    env = dict(os.environ, RAYON_NUM_THREADS=str(args.threads))
+    with (output / 'run.log').open('w') as log:
+        process = subprocess.Popen(command, cwd=root, env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
+        for line in process.stdout:
+            print(line, end='', flush=True); log.write(line); log.flush()
+        code = process.wait()
+    if code:
+        raise RuntimeError('native experiment failed with exit code ' + str(code))
+    if not (output / 'measurements.txt').is_file() or not (output / 'damage-transition.stark').is_file():
+        raise RuntimeError('native experiment did not produce complete proof evidence')
+
+
+if __name__ == '__main__':
+    main()
