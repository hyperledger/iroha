+/// Research diagnostic: inspect raw per-stage AIR residues before a costly prove.
+/// This does not bypass native proof verification or authorize settlement.
+pub fn research_stage_residue_failures_v1(
+    statement: ArenaKillHistoryResearchStatementV2,
+) -> Result<Vec<(usize, usize)>, String> {
+    let adapter = Adapter::new(statement)?;
+    let mut failures = Vec::new();
+    for stage in 0..STAGES {
+        let values = adapter.stage_values(stage);
+        let residues = if stage < TICKS {
+            let current = adapter
+                .tick
+                .air
+                .witness(
+                    &values[..arena_kill_history_air::INPUT_COUNT],
+                    &values[..arena_kill_history_air::INPUT_COUNT],
+                )
+                .into_iter()
+                .map(field)
+                .collect::<Vec<_>>();
+            let next_values = adapter.stage_values((stage + 1).min(TICKS - 1));
+            let next = adapter
+                .tick
+                .air
+                .witness(
+                    &next_values[..arena_kill_history_air::INPUT_COUNT],
+                    &next_values[..arena_kill_history_air::INPUT_COUNT],
+                )
+                .into_iter()
+                .map(field)
+                .collect::<Vec<_>>();
+            adapter.tick.air.residues(
+                &current,
+                &next,
+                &values[..arena_kill_history_air::INPUT_COUNT]
+                    .iter()
+                    .copied()
+                    .map(field)
+                    .collect::<Vec<_>>(),
+            )
+        } else {
+            let current = adapter
+                .plane
+                .air
+                .witness(&values[..3], &values[..PLANE_VALUES])
+                .into_iter()
+                .map(field)
+                .collect::<Vec<_>>();
+            adapter.plane.air.residues(
+                &current,
+                &current,
+                &values[..PLANE_VALUES]
+                    .iter()
+                    .copied()
+                    .map(field)
+                    .collect::<Vec<_>>(),
+            )
+        };
+        failures.extend(
+            residues
+                .iter()
+                .enumerate()
+                .filter(|(_, residue)| **residue != F::ZERO)
+                .map(|(constraint, _)| (stage, constraint)),
+        );
+    }
+    Ok(failures)
+}
