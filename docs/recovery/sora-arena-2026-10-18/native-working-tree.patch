diff --git a/crates/connect_norito_bridge/src/arena_join_terms_inspection.rs b/crates/connect_norito_bridge/src/arena_join_terms_inspection.rs
new file mode 100644
index 0000000000000000000000000000000000000000..5f5b641bfda72b23f81d1ee507ce5db7a56d9647
--- /dev/null
+++ b/crates/connect_norito_bridge/src/arena_join_terms_inspection.rs
@@ -0,0 +1,243 @@
+//! Canonical, non-authorizing Arena join-term inspection for wallet presentation.
+
+use super::*;
+use iroha_data_model::isi::game::JoinGameSessionV1;
+
+const MAX_JOIN_TERMS_JSON_BYTES: usize = 128 * 1024;
+
+fn inspect_join_terms(bytes: &[u8]) -> BridgeResult<Vec<u8>> {
+    let (tx, _) = inspect_detached_transaction_scaffold(bytes)?;
+    let Executable::Instructions(instructions) = tx.instructions() else {
+        return Err(BridgeError::DetachedTransactionScaffold);
+    };
+    if instructions.len() != 1 {
+        return Err(BridgeError::DetachedTransactionScaffold);
+    }
+    let join = instructions
+        .iter()
+        .next()
+        .and_then(|instruction| instruction.as_any().downcast_ref::<JoinGameSessionV1>())
+        .ok_or(BridgeError::DetachedTransactionScaffold)?;
+    let network = tx
+        .network_id()
+        .ok_or(BridgeError::DetachedTransactionScaffold)?;
+    let creation_time_ms = u64::try_from(tx.creation_time().as_millis())
+        .map_err(|_| BridgeError::DetachedTransactionScaffold)?;
+    let time_to_live_ms = tx
+        .time_to_live()
+        .ok_or(BridgeError::DetachedTransactionScaffold)
+        .and_then(|ttl| {
+            u64::try_from(ttl.as_millis()).map_err(|_| BridgeError::DetachedTransactionScaffold)
+        })?;
+    if time_to_live_ms == 0 {
+        return Err(BridgeError::DetachedTransactionScaffold);
+    }
+    let payload_signing_hash = iroha_crypto::HashOf::new(tx.payload());
+    let json = JsonValue::Object(JsonMap::from_iter([
+        (
+            "schema".into(),
+            JsonValue::from("sora.arena.join_terms_inspection.v1"),
+        ),
+        ("authorization_ready".into(), JsonValue::from(false)),
+        (
+            "verification_scope".into(),
+            JsonValue::from("canonical_scaffold_only"),
+        ),
+        (
+            "scaffold_blake3_hex".into(),
+            JsonValue::from(hex::encode(blake3_hash(bytes).as_bytes())),
+        ),
+        (
+            "payload_signing_hash_hex".into(),
+            detached_transaction_hash_hex(payload_signing_hash.as_ref()),
+        ),
+        (
+            "network_id".into(),
+            norito::json::to_value(network)
+                .map_err(|_| BridgeError::DetachedTransactionScaffold)?,
+        ),
+        (
+            "authority".into(),
+            JsonValue::from(tx.authority().to_string()),
+        ),
+        ("creation_time_ms".into(), JsonValue::from(creation_time_ms)),
+        ("time_to_live_ms".into(), JsonValue::from(time_to_live_ms)),
+        (
+            "fee_payment".into(),
+            norito::json::to_value(tx.fee_payment_intent())
+                .map_err(|_| BridgeError::DetachedTransactionScaffold)?,
+        ),
+        (
+            "join".into(),
+            norito::json::to_value(join).map_err(|_| BridgeError::DetachedTransactionScaffold)?,
+        ),
+    ]));
+    let encoded =
+        norito::json::to_vec(&json).map_err(|_| BridgeError::DetachedTransactionScaffold)?;
+    if encoded.len() > MAX_JOIN_TERMS_JSON_BYTES {
+        return Err(BridgeError::DetachedTransactionScaffold);
+    }
+    Ok(encoded)
+}
+
+/// Decode a canonical Join scaffold into exact typed terms for research review.
+/// The result is never sufficient to authorize a bond or request a wallet signature.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn connect_norito_arena_join_terms_inspect_v1(
+    tx_ptr: *const c_uchar,
+    tx_len: c_ulong,
+    out_json_ptr: *mut *mut c_uchar,
+    out_json_len: *mut c_ulong,
+) -> c_int {
+    let result = (|| {
+        clear_bridge_output_or_null(out_json_ptr, out_json_len)?;
+        let tx_len =
+            usize::try_from(tx_len).map_err(|_| BridgeError::DetachedTransactionScaffold)?;
+        if tx_ptr.is_null() || tx_len == 0 || tx_len > DETACHED_TRANSACTION_SCAFFOLD_MAX_BYTES {
+            return Err(BridgeError::DetachedTransactionScaffold);
+        }
+        let bytes = unsafe { slice::from_raw_parts(tx_ptr, tx_len) };
+        let json = inspect_join_terms(bytes)?;
+        unsafe { write_bytes_bridge(out_json_ptr, out_json_len, &json) }
+    })();
+    bridge_result_to_code(result)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use iroha_data_model::isi::game::ClaimGamePayoutV1;
+
+    fn fixture_request(instruction: JsonValue) -> Vec<u8> {
+        let keypair = KeyPair::try_from_seed(vec![47; 32], Algorithm::Ed25519).unwrap();
+        let account = AccountId::new(keypair.public_key().clone());
+        let network = NetworkId::from_genesis_hash(iroha_crypto::HashOf::<
+            iroha_data_model::block::BlockHeader,
+        >::from_untyped_unchecked(Hash::new(
+            b"arena-join-review-test",
+        )));
+        let request = JsonValue::Object(JsonMap::from_iter([
+            (
+                "network_id".into(),
+                norito::json::to_value(&network).unwrap(),
+            ),
+            (
+                "authority".into(),
+                norito::json::to_value(&account).unwrap(),
+            ),
+            ("creation_time_ms".into(), JsonValue::from(1234_u64)),
+            ("time_to_live_ms".into(), JsonValue::from(60_000_u64)),
+            (
+                "fee_payment".into(),
+                norito::json::to_value(&FeePaymentIntent::authority(
+                    Vec::new(),
+                    NonZeroU64::new(9_000_000),
+                ))
+                .unwrap(),
+            ),
+            ("instruction".into(), instruction),
+        ]));
+        norito::json::to_vec(&request).unwrap()
+    }
+
+    fn instruction(name: &str, value: JsonValue) -> JsonValue {
+        JsonValue::Object(JsonMap::from_iter([
+            ("name".into(), JsonValue::from(name)),
+            ("value".into(), value),
+        ]))
+    }
+
+    #[test]
+    fn join_inspection_is_typed_and_permanently_non_authorizing() {
+        let keypair = KeyPair::try_from_seed(vec![47; 32], Algorithm::Ed25519).unwrap();
+        let asset = AssetDefinitionId::derive_from_components(
+            DomainId::try_new("wallet", "universal").unwrap(),
+            "xor".parse().unwrap(),
+        );
+        let join = JoinGameSessionV1 {
+            session_id: Hash::new(b"arena-session"),
+            input_key: keypair.public_key().clone(),
+            application_data: vec![1, 2, 3],
+            resources: Vec::new(),
+            invitation: None,
+            expected_manifest_hash: Hash::new(b"arena-manifest"),
+            expected_asset_definition: asset,
+            expected_stake: Quantity::from(50_u32),
+        };
+        let request = fixture_request(instruction(
+            "JoinGameSessionV1",
+            norito::json::to_value(&join).unwrap(),
+        ));
+        let (scaffold, existing_inspection) =
+            build_native_detached_transaction_scaffold(&request).unwrap();
+        let review: JsonValue =
+            norito::json::from_slice_value(&inspect_join_terms(&scaffold).unwrap()).unwrap();
+        let existing: JsonValue = norito::json::from_slice_value(&existing_inspection).unwrap();
+        assert_eq!(
+            review["schema"].as_str(),
+            Some("sora.arena.join_terms_inspection.v1")
+        );
+        assert_eq!(review["authorization_ready"], JsonValue::from(false));
+        assert_eq!(
+            review["verification_scope"].as_str(),
+            Some("canonical_scaffold_only")
+        );
+        assert_eq!(review["join"], norito::json::to_value(&join).unwrap());
+        assert_eq!(review["fee_payment"], existing["fee_payment"]);
+        assert_eq!(
+            review["payload_signing_hash_hex"],
+            existing["payload_signing_hash_hex"]
+        );
+        assert_eq!(
+            review["scaffold_blake3_hex"].as_str(),
+            Some(hex::encode(blake3_hash(&scaffold).as_bytes()).as_str())
+        );
+        assert_eq!(review["join"]["expected_stake"].as_str(), Some("50"));
+
+        let mut output = ptr::null_mut();
+        let mut length = 0;
+        let result = unsafe {
+            connect_norito_arena_join_terms_inspect_v1(
+                scaffold.as_ptr(),
+                scaffold.len() as c_ulong,
+                &mut output,
+                &mut length,
+            )
+        };
+        assert_eq!(result, 0);
+        let ffi_json = unsafe { slice::from_raw_parts(output, length as usize) }.to_vec();
+        connect_norito_free(output);
+        assert_eq!(ffi_json, inspect_join_terms(&scaffold).unwrap());
+    }
+
+    #[test]
+    fn non_join_and_noncanonical_scaffolds_are_rejected() {
+        let keypair = KeyPair::try_from_seed(vec![47; 32], Algorithm::Ed25519).unwrap();
+        let account = AccountId::new(keypair.public_key().clone());
+        let claim =
+            ClaimGamePayoutV1::new(Hash::new(b"arena-session"), 0, account, Quantity::one());
+        let request = fixture_request(instruction(
+            "ClaimGamePayoutV1",
+            norito::json::to_value(&claim).unwrap(),
+        ));
+        let (scaffold, _) = build_native_detached_transaction_scaffold(&request).unwrap();
+        assert!(inspect_join_terms(&scaffold).is_err());
+        let mut altered = scaffold;
+        altered.push(0);
+        assert!(inspect_join_terms(&altered).is_err());
+        assert!(inspect_join_terms(&[]).is_err());
+        let mut output = ptr::null_mut();
+        let mut length = 0;
+        let result = unsafe {
+            connect_norito_arena_join_terms_inspect_v1(
+                altered.as_ptr(),
+                altered.len() as c_ulong,
+                &mut output,
+                &mut length,
+            )
+        };
+        assert_ne!(result, 0);
+        assert!(output.is_null());
+        assert_eq!(length, 0);
+    }
+}
