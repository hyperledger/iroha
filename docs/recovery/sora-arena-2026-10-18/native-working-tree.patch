+            amount: Quantity::from(25_u32),
+        }],
+    };
+    let bytes = outcome.encode();
+    assert_eq!(
+        GameOutcomeV1::decode(&mut bytes.as_slice()).unwrap(),
+        outcome
+    );
+    assert_eq!(
+        norito::decode_from_bytes::<GameOutcomeV1>(&norito::to_bytes(&outcome).unwrap()).unwrap(),
+        outcome
+    );
+    let mut missing = norito::json::to_value(&outcome).unwrap();
+    missing.as_object_mut().unwrap().remove("allocations");
+    assert!(norito::json::from_value::<GameOutcomeV1>(missing).is_err());
+    let policy = GamePayoutPolicyV1::VerifiedAllocations;
+    assert_eq!(
+        GamePayoutPolicyV1::decode(&mut policy.encode().as_slice()).unwrap(),
+        policy
+    );
 }
 
