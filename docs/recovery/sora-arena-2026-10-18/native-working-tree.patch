@@ -0,0 +1,295 @@
+//! Unregistered, unfunded P2P-to-native batch translation research.
+
+use iroha_core::execution_proofs::{
+    arena_history_translation_research::{
+        translate_signed_arena_history_v1, verify_claimed_arena_translation_v1,
+    },
+    arena_kill_history_research::{
+        P2PCertifiedBatchV2, P2PContextV2, P2PRevealV2, P2PSetV2, canonical_input_v1,
+        research_genesis_root_v1, research_manifest_v1,
+    },
+    compiled_execution_profile_v1,
+};
+use iroha_crypto::{Algorithm, Hash, HashOf, KeyPair, Signature};
+use iroha_data_model::{
+    NetworkId,
+    account::AccountId,
+    block::BlockHeader,
+    game::{
+        GameAdmissionBodyV1, GameAdmissionParticipantV1, GameCheckpointV1, GameSlotSignatureV1,
+        GameTranscriptBatchV1, GameTranscriptV1, game_message_hash_v1,
+    },
+};
+use iroha_primitives::numeric::Quantity;
+use sha2::{Digest, Sha256};
+
+fn keys() -> [KeyPair; 3] {
+    std::array::from_fn(|slot| {
+        KeyPair::try_from_seed(vec![slot as u8 + 121; 32], Algorithm::Ed25519).unwrap()
+    })
+}
+
+fn fixture() -> (
+    NetworkId,
+    Hash,
+    iroha_data_model::game::GameManifestV1,
+    GameAdmissionBodyV1,
+    Vec<P2PCertifiedBatchV2>,
+    GameCheckpointV1,
+) {
+    let network = NetworkId::from_genesis_hash(HashOf::<BlockHeader>::from_untyped_unchecked(
+        Hash::new(b"arena-kill-history-research-isolated-network"),
+    ));
+    let session = Hash::new(b"arena-kill-history-research-unfunded-session");
+    let manifest = research_manifest_v1();
+    let signing_keys = keys();
+    let admission = GameAdmissionBodyV1 {
+        version: 1,
+        participants: (0..3)
+            .map(|slot| {
+                let wallet =
+                    KeyPair::try_from_seed(vec![slot as u8 + 41; 32], Algorithm::Ed25519).unwrap();
+                GameAdmissionParticipantV1 {
+                    account: AccountId::new(wallet.public_key().clone()),
+                    input_key: signing_keys[slot].public_key().clone(),
+                    deposit: Quantity::from(1000_u32),
+                    application_data: vec![0, 0, u8::from(slot < 2)],
+                }
+            })
+            .collect(),
+        wagers: vec![],
+        resources: vec![],
+    };
+    let context = P2PContextV2::from_admission(&network, session, &manifest, &admission).unwrap();
+    let mut root = context.genesis_root();
+    let mut history = Vec::new();
+    for index in 0..13 {
+        let start_tick = (index * 2) as u32;
+        let reveals = (0..3)
+            .map(|slot| P2PRevealV2 {
+                slot: slot as u8,
+                payload: canonical_input_v1(slot)[index * 16..index * 16 + 16]
+                    .try_into()
+                    .unwrap(),
+                salt: Sha256::digest([index as u8, slot as u8, 0x42]).into(),
+            })
+            .collect::<Vec<_>>();
+        let mut set = P2PSetV2 {
+            epoch: 0,
+            start_tick,
+            parent: root,
+            commitments: vec![[0; 32]; 3],
+        };
+        for slot in 0..3 {
+            set.commitments[slot] = context.input_commitment(&set, &reveals[slot]).unwrap();
+        }
+        let digest = context.set_digest(&set).unwrap();
+        let signatures = (0..3)
+            .map(|slot| GameSlotSignatureV1 {
+                slot: slot as u8,
+                signature: Signature::new(signing_keys[slot].private_key(), &digest),
+            })
+            .collect();
+        let batch = P2PCertifiedBatchV2 {
+            set,
+            signatures,
+            reveals,
+        };
+        root = context.next_root(root, &batch).unwrap();
+        history.push(batch);
+    }
+    let checkpoint = GameCheckpointV1 {
+        session_id: session,
+        epoch: 0,
+        tick: 0,
+        transcript_root: game_message_hash_v1(
+            &network,
+            "input-transcript",
+            &GameTranscriptV1 {
+                batches: vec![],
+                dnf_events: vec![],
+            },
+        ),
+        state_root: research_genesis_root_v1(&network, session, &manifest, &admission).unwrap(),
+        terminal: false,
+    };
+    (network, session, manifest, admission, history, checkpoint)
+}
+
+#[test]
+fn signed_batches_translate_to_sequential_native_epochs_and_distinct_roots() {
+    let (network, session, manifest, admission, history, checkpoint) = fixture();
+    assert!(compiled_execution_profile_v1(&manifest.profile_id).is_none());
+    let projected = translate_signed_arena_history_v1(
+        &network,
+        session,
+        &manifest,
+        &admission,
+        &history,
+        Some(&checkpoint),
+        &[],
+    )
+    .unwrap();
+    assert_eq!(projected.epoch, 13);
+    assert_eq!(projected.forced_batches.len(), 13);
+    for (index, batch) in projected.forced_batches.iter().enumerate() {
+        assert_eq!(batch.epoch, index as u64);
+        assert_eq!(batch.start_tick, (index * 2) as u32);
+        assert!(batch.dnf_slots.is_empty());
+        for slot in 0..3 {
+            assert_eq!(batch.inputs[slot], history[index].reveals[slot].payload);
+        }
+    }
+    let native_transcript = GameTranscriptV1 {
+        batches: projected
+            .forced_batches
+            .iter()
+            .map(|batch| GameTranscriptBatchV1 {
+                start_tick: batch.start_tick,
+                inputs: batch.inputs.clone(),
+            })
+            .collect(),
+        dnf_events: vec![],
+    };
+    assert_eq!(
+        projected.transcript_root,
+        game_message_hash_v1(&network, "input-transcript", &native_transcript)
+    );
+    assert_eq!(
+        projected.dispute_root,
+        game_message_hash_v1(
+            &network,
+            "dispute-history",
+            &(
+                session,
+                13_u64,
+                Some(checkpoint),
+                Vec::<iroha_data_model::game::GameTranscriptAnchorV1>::new(),
+                projected.forced_batches.clone(),
+            )
+        )
+    );
+    assert_ne!(
+        Hash::prehashed(projected.p2p_root),
+        projected.transcript_root
+    );
+    assert_ne!(projected.transcript_root, projected.dispute_root);
+    verify_claimed_arena_translation_v1(
+        &network, session, &manifest, &admission, &history, &projected,
+    )
+    .unwrap();
+}
+
+#[test]
+fn altered_epochs_frames_slots_and_hash_domains_are_rejected() {
+    let (network, session, manifest, admission, history, checkpoint) = fixture();
+    let valid = translate_signed_arena_history_v1(
+        &network,
+        session,
+        &manifest,
+        &admission,
+        &history,
+        Some(&checkpoint),
+        &[],
+    )
+    .unwrap();
+    let check = |claim| {
+        verify_claimed_arena_translation_v1(
+            &network, session, &manifest, &admission, &history, &claim,
+        )
+    };
+    let mut bad = valid.clone();
+    bad.forced_batches[5].epoch = 0;
+    assert!(check(bad).is_err());
+    let mut bad = valid.clone();
+    bad.forced_batches.swap(2, 3);
+    assert!(check(bad).is_err());
+    let mut bad = valid.clone();
+    bad.forced_batches.remove(8);
+    assert!(check(bad).is_err());
+    let mut bad = valid.clone();
+    bad.forced_batches[4].inputs[0].truncate(8);
+    assert!(check(bad).is_err());
+    let mut bad = valid.clone();
+    bad.forced_batches[0].inputs.swap(0, 1);
+    assert!(check(bad).is_err());
+    let mut bad = valid.clone();
+    bad.transcript_root = Hash::prehashed(valid.p2p_root);
+    assert!(check(bad).is_err());
+    let mut bad = valid.clone();
+    bad.dispute_root = valid.transcript_root;
+    assert!(check(bad).is_err());
+    let mut bad_history = history.clone();
+    bad_history.pop();
+    assert!(
+        translate_signed_arena_history_v1(
+            &network,
+            session,
+            &manifest,
+            &admission,
+            &bad_history,
+            Some(&checkpoint),
+            &[],
+        )
+        .is_err()
+    );
+    let mut bad_history = history.clone();
+    bad_history.swap(3, 4);
+    assert!(
+        translate_signed_arena_history_v1(
+            &network,
+            session,
+            &manifest,
+            &admission,
+            &bad_history,
+            Some(&checkpoint),
+            &[],
+        )
+        .is_err()
+    );
+    let mut bad_history = history.clone();
+    bad_history[0].reveals[0].slot = 1;
+    assert!(
+        translate_signed_arena_history_v1(
+            &network,
+            session,
+            &manifest,
+            &admission,
+            &bad_history,
+            Some(&checkpoint),
+            &[],
+        )
+        .is_err()
+    );
+    let mut bad_history = history.clone();
+    bad_history[0].set.epoch = 1;
+    assert!(
+        translate_signed_arena_history_v1(
+            &network,
+            session,
+            &manifest,
+            &admission,
+            &bad_history,
+            Some(&checkpoint),
+            &[],
+        )
+        .is_err()
+    );
+    // Checkpoint bytes are caller-supplied, so a different one changes only
+    // the conditional dispute root. Neither checkpoint has ledger provenance.
+    let mut other_checkpoint = checkpoint;
+    other_checkpoint.state_root = Hash::new(b"different-unselected-checkpoint");
+    let other = translate_signed_arena_history_v1(
+        &network,
+        session,
+        &manifest,
+        &admission,
+        &history,
+        Some(&other_checkpoint),
+        &[],
+    )
+    .unwrap();
+    assert_eq!(other.p2p_root, valid.p2p_root);
+    assert_eq!(other.transcript_root, valid.transcript_root);
+    assert_ne!(other.dispute_root, valid.dispute_root);
+}
