@@ -0,0 +1,157 @@
+//! Unregistered ArenaV1 candidate source identity, separate from the frozen RaceV1 bundle.
+//!
+//! This is a source-inventory experiment, not an execution relation or a compiled
+//! profile. In particular, the external game-kernel digest is supplied by a
+//! caller and has not been authenticated against an immutable build artifact.
+
+use iroha_crypto::Hash;
+
+const DOMAIN_V1: &[u8] = b"iroha:unregistered-arena-v1-source-candidate:v1\0";
+const EXTERNAL_ARENA_CORE_PATH_V1: &str = "sora-arena/crates/arena-core/src/lib.rs";
+
+// TODO: Extend this inventory to every outcome-affecting source, generated
+// artifact, compiler/toolchain identity and verifier parameter before an
+// ArenaV1 descriptor can be compiled. This candidate is intentionally absent
+// from the execution-profile registry.
+const CANDIDATE_SOURCES_V1: &[(&str, &[u8])] = &[
+    (
+        "crates/iroha_core/src/execution_proofs/arena_geometry_air.rs",
+        include_bytes!("arena_geometry_air.rs"),
+    ),
+    (
+        "crates/iroha_core/src/execution_proofs/arena_kill_history_air.rs",
+        include_bytes!("arena_kill_history_air.rs"),
+    ),
+    (
+        "crates/iroha_core/src/execution_proofs/arena_kill_history_research.rs",
+        include_bytes!("arena_kill_history_research.rs"),
+    ),
+    (
+        "crates/iroha_core/src/execution_proofs/arena_profile_identity_research.rs",
+        include_bytes!("arena_profile_identity_research.rs"),
+    ),
+    (
+        "crates/iroha_core/src/execution_proofs/checked_integer_air.rs",
+        include_bytes!("checked_integer_air.rs"),
+    ),
+    (
+        "crates/iroha_core/src/execution_proofs/integer_air.rs",
+        include_bytes!("integer_air.rs"),
+    ),
+    (
+        "crates/iroha_data_model/src/execution_proofs.rs",
+        include_bytes!("../../../iroha_data_model/src/execution_proofs.rs"),
+    ),
+    (
+        "crates/iroha_data_model/src/game.rs",
+        include_bytes!("../../../iroha_data_model/src/game.rs"),
+    ),
+];
+
+fn frame(bytes: &mut Vec<u8>, value: &[u8]) -> Result<(), &'static str> {
+    let length = u64::try_from(value.len()).map_err(|_| "Arena source field is too large")?;
+    bytes.extend_from_slice(&length.to_le_bytes());
+    bytes.extend_from_slice(value);
+    Ok(())
+}
+
+fn candidate_source_root_for_v1(
+    external_arena_core_sha256: &[u8; 32],
+    sources: &[(&str, &[u8])],
+) -> Result<Hash, &'static str> {
+    if *external_arena_core_sha256 == [0; 32] {
+        return Err("external arena-core source digest is missing");
+    }
+    if sources.is_empty() {
+        return Err("Arena source inventory is empty");
+    }
+    let mut framed = Vec::new();
+    frame(&mut framed, DOMAIN_V1)?;
+    frame(&mut framed, EXTERNAL_ARENA_CORE_PATH_V1.as_bytes())?;
+    frame(&mut framed, external_arena_core_sha256)?;
+    let source_count = u64::try_from(sources.len()).map_err(|_| "Arena source count overflow")?;
+    framed.extend_from_slice(&source_count.to_le_bytes());
+    let mut previous_path = "";
+    for (path, source) in sources {
+        if path.is_empty() || *path <= previous_path || source.is_empty() {
+            return Err("Arena source inventory is empty, duplicated or out of order");
+        }
+        frame(&mut framed, path.as_bytes())?;
+        frame(&mut framed, source)?;
+        previous_path = path;
+    }
+    Ok(Hash::new(&framed))
+}
+
+/// Hash the currently incomplete, unregistered Arena source candidate with an
+/// explicit digest of the external `arena-core` source file. The caller must
+/// independently check that digest; this function does not attest the file or
+/// produce a native execution-profile descriptor.
+pub fn arena_v1_candidate_source_root_v1(
+    external_arena_core_sha256: &[u8; 32],
+) -> Result<Hash, &'static str> {
+    candidate_source_root_for_v1(external_arena_core_sha256, CANDIDATE_SOURCES_V1)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::execution_proofs::{
+        arena_kill_history_research::research_profile_id_v1, compiled_execution_profile_v1,
+        race_profile_id_v1,
+    };
+
+    #[test]
+    fn source_candidate_is_distinct_and_unregistered() {
+        let root = arena_v1_candidate_source_root_v1(&[0x42; 32]).unwrap();
+        assert_ne!(root, race_profile_id_v1());
+        assert_ne!(root, research_profile_id_v1());
+        assert!(compiled_execution_profile_v1(&root).is_none());
+        assert_eq!(
+            arena_v1_candidate_source_root_v1(&[0; 32]),
+            Err("external arena-core source digest is missing")
+        );
+    }
+
+    #[test]
+    fn source_candidate_binds_external_digest_path_content_and_order() {
+        let sources = [
+            ("a.rs", b"first".as_slice()),
+            ("b.rs", b"second".as_slice()),
+        ];
+        let baseline = candidate_source_root_for_v1(&[1; 32], &sources).unwrap();
+        assert_eq!(
+            candidate_source_root_for_v1(&[1; 32], &sources).unwrap(),
+            baseline
+        );
+        assert_ne!(
+            candidate_source_root_for_v1(&[2; 32], &sources).unwrap(),
+            baseline
+        );
+        assert_ne!(
+            candidate_source_root_for_v1(
+                &[1; 32],
+                &[
+                    ("a.rs", b"changed".as_slice()),
+                    ("b.rs", b"second".as_slice()),
+                ],
+            )
+            .unwrap(),
+            baseline
+        );
+        assert_ne!(
+            candidate_source_root_for_v1(
+                &[1; 32],
+                &[
+                    ("a-renamed.rs", b"first".as_slice()),
+                    ("b.rs", b"second".as_slice()),
+                ],
+            )
+            .unwrap(),
+            baseline
+        );
+        assert!(candidate_source_root_for_v1(&[1; 32], &sources[..0]).is_err());
+        assert!(candidate_source_root_for_v1(&[1; 32], &sources[..1].repeat(2)).is_err());
+        assert!(candidate_source_root_for_v1(&[1; 32], &[sources[1], sources[0]]).is_err());
+    }
+}
