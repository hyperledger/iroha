+/// The 30 proved signed slab endpoints, one proved damage transition, and
+/// verifier-derived target/state are bound into one exact public statement.
+#[derive(Debug, Clone, Encode)]
+pub struct ArenaRangedResearchStatementV1 {
+    /// Isolated research network identity.
+    pub network_id: NetworkId,
+    /// Domain-separated immutable session identity.
+    pub session_id: Hash,
+    /// Exact unregistered two-tick manifest.
+    pub manifest: GameManifestV1,
+    /// Three immutable admitted accounts, gameplay keys and zero deposits.
+    pub admission: GameAdmissionBodyV1,
+    /// Admission-bound tick-zero state root.
+    pub genesis_root: Hash,
+    /// Fixed restricted research rules hash.
+    pub rules_hash: Hash,
+    /// Exact map-zero wall layout hash.
+    pub map_hash: Hash,
+    /// Each peer's signed commit to its complete two-tick payload.
+    pub commitments: Vec<GameInputCommitmentV1>,
+    /// The jointly signed canonical commitment set.
+    pub commitment_set: GameCommitmentSetV1,
+    /// Salted openings in original slot order.
+    pub reveals: Vec<GameInputRevealV1>,
+    /// Two ticks of exact canonical controls for all three slots.
+    pub batch: GameForcedBatchV1,
+    /// Three ordered tick-boundary state projections.
+    pub states: [RangedResearchStateV1; 3],
+    /// Five boxes × three axes × two slab endpoints, in that order.
+    pub plane_rows: Vec<[i64; PLANE_VALUES]>,
+    /// Claimed target slot plus one; zero is no target.
+    pub selected_target: u8,
+    /// Public damage/parry AIR input/output row.
+    pub damage_row: [i64; DAMAGE_INPUT_COUNT],
+}
+
+fn expected_plane_inputs(index: usize) -> [i64; 3] {
+    let box_index = index / 6;
+    let axis = (index % 6) / 2;
+    let bound = if index % 2 == 0 {
+        BOXES[box_index].0[axis]
+    } else {
+        BOXES[box_index].1[axis]
+    };
+    [FROM[axis], TO[axis], bound]
+}
+
+fn box_fraction(rows: &[[i64; PLANE_VALUES]], box_index: usize) -> Result<Option<i64>, String> {
+    let mut near = 0_i64;
+    let mut far = Q20;
+    for axis in 0..3 {
+        let lower = rows[box_index * 6 + axis * 2];
+        let upper = rows[box_index * 6 + axis * 2 + 1];
+        if lower[4] != upper[4] {
+            return Err("slab endpoints disagree on ray-axis parallelism".into());
+        }
+        if lower[4] == 0 {
+            if FROM[axis] < BOXES[box_index].0[axis] || FROM[axis] > BOXES[box_index].1[axis] {
+                return Ok(None);
+            }
+        } else {
+            near = near.max(lower[3].min(upper[3]));
+            far = far.min(lower[3].max(upper[3]));
+        }
+    }
+    Ok((near <= far).then_some(near))
+}
+
+fn select_target(rows: &[[i64; PLANE_VALUES]]) -> Result<u8, String> {
+    let mut nearest = Q20 + 1;
+    for wall in 0..3 {
+        if let Some(fraction) = box_fraction(rows, wall)? {
+            nearest = nearest.min(fraction);
+        }
+    }
+    let mut selected = 0_u8;
+    // Self is skipped. The remaining living, unprotected FFA participants are
+    // considered in ascending original slot order, with strict-less ties.
+    for (box_index, slot) in [(3, 1_u8), (4, 2_u8)] {
+        if let Some(fraction) = box_fraction(rows, box_index)? {
+            if fraction < nearest {
+                nearest = fraction;
+                selected = slot + 1;
+            }
+        }
+    }
+    Ok(selected)
+}
+
+impl ArenaRangedResearchStatementV1 {
+    /// Validate exact admission, signatures/history, both ticks, public scene,
+    /// wall-first nearest selection and the complete proved damage-row binding.
+    pub fn validate(&self) -> Result<(), String> {
+        validate_admission(&self.manifest, &self.admission)?;
+        if self.rules_hash != research_rules_hash_v1() || self.map_hash != research_map_hash_v1() {
+            return Err("ranged rules or map identity changed".into());
+        }
+        let genesis = research_genesis_root_v1(
+            &self.network_id,
+            self.session_id,
+            &self.manifest,
+            &self.admission,
+        )?;
+        if self.genesis_root != genesis || self.states != expected_states_v1() {
+            return Err("ranged genesis or two-tick state projection differs".into());
+        }
+        if self.batch.epoch != 0
+            || self.batch.start_tick != 0
+            || self.batch.inputs.len() != 3
+            || self.batch.inputs[0] != [SHOT, IDLE].concat()
+            || self.batch.inputs[1] != [IDLE, IDLE].concat()
+            || self.batch.inputs[2] != [IDLE, IDLE].concat()
+            || !self.batch.dnf_slots.is_empty()
+            || self.reveals.len() != 3
+            || self.commitments.len() != 3
+        {
+            return Err("ranged research batch is not the canonical two-tick input".into());
+        }
+        let parent = game_message_hash_v1(
+            &self.network_id,
+            "arena-ranged-research-empty-transcript",
+            &(self.session_id, genesis),
+        );
+        let set = &self.commitment_set;
+        if set.session_id != self.session_id
+            || set.epoch != 0
+            || set.start_tick != 0
+            || set.parent_transcript_root != parent
+            || set.commitments.len() != 3
+            || set.signatures.len() != 3
+        {
+            return Err("ranged commitment set is not rooted in genesis".into());
+        }
+        let set_hash = game_commitment_set_hash_v1(&self.network_id, set);
+        for slot in 0..3 {
+            let key = &self.admission.participants[slot].input_key;
+            let reveal = &self.reveals[slot];
+            let commitment = &self.commitments[slot];
+            let signed_set = &set.signatures[slot];
+            if reveal.session_id != self.session_id
+                || reveal.epoch != 0
+                || reveal.start_tick != 0
+                || usize::from(reveal.slot) != slot
+                || reveal.payload != self.batch.inputs[slot]
+                || commitment.session_id != self.session_id
+                || commitment.epoch != 0
+                || commitment.start_tick != 0
+                || usize::from(commitment.slot) != slot
+                || commitment.commitment != game_input_commitment_v1(&self.network_id, reveal)
+                || set.commitments[slot] != commitment.commitment
+                || usize::from(signed_set.slot) != slot
+                || commitment
+                    .signature
+                    .verify(
+                        key,
+                        game_input_message_hash_v1(&self.network_id, commitment).as_ref(),
+                    )
+                    .is_err()
+                || signed_set.signature.verify(key, set_hash.as_ref()).is_err()
+            {
+                return Err("ranged input commitment, reveal or signature invalid".into());
+            }
+        }
+        if self.plane_rows.len() != PLANE_COUNT {
+            return Err("omitted or extra wall/body slab".into());
+        }
+        for (index, row) in self.plane_rows.iter().enumerate() {
+            if row[..3] != expected_plane_inputs(index)
+                || !(-1..=Q20 + 1).contains(&row[3])
+                || !matches!(row[4], 0 | 1)
+            {
+                return Err("altered slab source or claimed fraction domain".into());
+            }
+        }
+        let selected = select_target(&self.plane_rows)?;
+        if selected != 3 || self.selected_target != selected {
+            return Err("claimed ranged target differs from ordered proved slabs".into());
+        }
+        let expected_damage = [
+            125, 100, 22, 0, 0, 0, 2, 32767, 0, 18_000, 0, 0, 18_000, 103, 100, 22, 0,
+        ];
+        if self.damage_row != expected_damage
+            || self.damage_row[13] != i64::from(self.states[1].health[2])
+            || self.states[2].health[2] != self.states[1].health[2]
+        {
+            return Err("damage row is not bound to selected victim and outgoing state".into());
+        }
+        Ok(())
+    }
+}
