@@ -0,0 +1,306 @@
+//! Native instruction and query integration for immutable, genesis-trusted NFT catalogs.
+use std::num::NonZeroU64;
+
+use iroha_core::{
+    gas::meter_instruction,
+    kura::Kura,
+    query::store::LiveQueryStore,
+    smartcontracts::{Execute, ValidSingularQuery},
+    state::{State, StateReadOnly, World, WorldReadOnly},
+};
+use iroha_crypto::{Algorithm, Hash, KeyPair};
+use iroha_data_model::{
+    Registrable,
+    account::{Account, AccountId},
+    block::BlockHeader,
+    domain::Domain,
+    game_equipment::*,
+    game_resources::GameResourceReturnPolicyV1,
+    isi::{Register, Transfer, game_equipment::*},
+    nft::Nft,
+    query::game::{FindGameEquipmentCatalogById, FindGameEquipmentPublisherById},
+};
+use iroha_model_base::{domain::DomainId, metadata::Metadata};
+use mv::storage::StorageReadOnly;
+use norito::codec::Encode;
+
+fn account(seed: u8) -> AccountId {
+    AccountId::new(
+        KeyPair::try_from_seed(vec![seed; 32], Algorithm::Ed25519)
+            .expect("deterministic account key")
+            .public_key()
+            .clone(),
+    )
+}
+
+fn fixture() -> (State, GameEquipmentCatalogV1, AccountId) {
+    let publisher = account(71);
+    let buyer = account(72);
+    let collection = DomainId::try_new("equipment", "universal").unwrap();
+    let world = World::with_assets(
+        [Domain::new(collection.clone()).build(&publisher)],
+        [&publisher, &buyer].map(|id| Account::new(id.clone()).build(&publisher)),
+        [],
+        [],
+        [],
+    );
+    let state = State::new_for_testing(
+        world,
+        Kura::blank_kura_for_testing(),
+        LiveQueryStore::start_test(),
+    );
+    let catalog = GameEquipmentCatalogV1 {
+        version: 1,
+        network_id: *state.view().network_id(),
+        publisher,
+        application_seed: Hash::new(b"native catalog integration application"),
+        collection,
+        profile_id: Hash::new(b"unregistered native catalog integration profile"),
+        role_id: Hash::new(b"native catalog integration role"),
+        policy: GameResourceReturnPolicyV1::ReturnToOriginalOwnerAtTerminal,
+        members: vec![GameEquipmentCatalogMemberV1 {
+            nft_id: "katana$equipment.universal".parse().unwrap(),
+            metadata_hash: Hash::new(Metadata::default().encode()),
+        }],
+    };
+    (state, catalog, buyer)
+}
+
+fn header(height: u64) -> BlockHeader {
+    BlockHeader::new(
+        NonZeroU64::new(height).unwrap(),
+        None,
+        None,
+        height * 1000,
+        0,
+    )
+}
+
+#[test]
+fn native_publication_needs_genesis_trust_and_authenticated_publisher_and_is_immutable() {
+    let (state, catalog, buyer) = fixture();
+    let publisher = catalog.publisher.clone();
+    let terms = catalog.publisher_terms();
+    let mut block = state.block(header(1));
+    let mut st = block.transaction();
+    Register::nft(Nft::new(
+        catalog.members[0].nft_id.clone(),
+        Metadata::default(),
+    ))
+    .execute(&publisher, &mut st)
+    .unwrap();
+
+    assert!(
+        PublishGameEquipmentCatalogV1::new(catalog.clone())
+            .execute(&publisher, &mut st)
+            .is_err()
+    );
+    assert!(
+        st.world
+            .game_equipment_catalogs()
+            .get(&catalog.id())
+            .is_none()
+    );
+    RegisterGameEquipmentPublisherV1::new(terms.clone())
+        .execute(&publisher, &mut st)
+        .unwrap();
+    assert_eq!(
+        FindGameEquipmentPublisherById::new(terms.id())
+            .execute(&st)
+            .unwrap(),
+        terms
+    );
+    assert!(
+        RegisterGameEquipmentPublisherV1::new(terms.clone())
+            .execute(&publisher, &mut st)
+            .is_err()
+    );
+    assert!(
+        PublishGameEquipmentCatalogV1::new(catalog.clone())
+            .execute(&buyer, &mut st)
+            .is_err()
+    );
+    PublishGameEquipmentCatalogV1::new(catalog.clone())
+        .execute(&publisher, &mut st)
+        .unwrap();
+    let expected = GameEquipmentCatalogRecordV1 {
+        catalog: catalog.clone(),
+        published_at_height: 1,
+    };
+    assert_eq!(
+        FindGameEquipmentCatalogById::new(catalog.id())
+            .execute(&st)
+            .unwrap(),
+        expected
+    );
+    assert!(
+        PublishGameEquipmentCatalogV1::new(catalog.clone())
+            .execute(&publisher, &mut st)
+            .is_err()
+    );
+
+    // Sale/transfer changes possession, never the retained publisher's exact approval.
+    Transfer::nft(
+        publisher.clone(),
+        catalog.members[0].nft_id.clone(),
+        buyer.clone(),
+    )
+    .execute(&publisher, &mut st)
+    .unwrap();
+    assert_eq!(
+        FindGameEquipmentCatalogById::new(catalog.id())
+            .execute(&st)
+            .unwrap(),
+        expected
+    );
+    assert!(
+        FindGameEquipmentCatalogById::new(Hash::new(b"absent catalog"))
+            .execute(&st)
+            .is_err()
+    );
+}
+
+#[test]
+fn publisher_registration_rejects_non_genesis_and_transaction_drop_keeps_trust_absent() {
+    let (state, catalog, _) = fixture();
+    let publisher = catalog.publisher.clone();
+    let terms = catalog.publisher_terms();
+    {
+        let mut block = state.block(header(2));
+        let mut st = block.transaction();
+        let error = RegisterGameEquipmentPublisherV1::new(terms.clone())
+            .execute(&publisher, &mut st)
+            .unwrap_err();
+        assert!(error.to_string().contains("signed genesis"), "{error}");
+        assert!(
+            FindGameEquipmentPublisherById::new(terms.id())
+                .execute(&st)
+                .is_err()
+        );
+    }
+    {
+        let mut block = state.block(header(1));
+        let mut st = block.transaction();
+        RegisterGameEquipmentPublisherV1::new(terms.clone())
+            .execute(&publisher, &mut st)
+            .unwrap();
+        assert!(
+            FindGameEquipmentPublisherById::new(terms.id())
+                .execute(&st)
+                .is_ok()
+        );
+        // A rejected surrounding transaction must roll back newly installed trust.
+    }
+    assert!(
+        FindGameEquipmentPublisherById::new(terms.id())
+            .execute(&state.view())
+            .is_err()
+    );
+}
+
+#[test]
+fn publication_meter_charges_membership_and_descriptor_growth_without_reading_state() {
+    let (_, catalog, _) = fixture();
+    let one = meter_instruction(&PublishGameEquipmentCatalogV1::new(catalog.clone()).into());
+    let mut two = catalog.clone();
+    two.members.push(GameEquipmentCatalogMemberV1 {
+        nft_id: "wakizashi$equipment.universal".parse().unwrap(),
+        metadata_hash: Hash::new(b"a second exact metadata commitment"),
+    });
+    two.validate().unwrap();
+    let larger = meter_instruction(&PublishGameEquipmentCatalogV1::new(two).into());
+    assert!(larger > one && one > 32_768);
+    assert!(
+        meter_instruction(&RegisterGameEquipmentPublisherV1::new(catalog.publisher_terms()).into())
+            > 32_000
+    );
+}
+
+#[cfg(feature = "iroha-core-tests")]
+#[test]
+fn snapshot_decoder_rejects_omitted_authoritative_game_and_custody_maps() {
+    use iroha_core::state::validate_world_snapshot_json_for_testing;
+    let world = World::default();
+    let encoded = norito::json::to_json(&world).unwrap();
+    validate_world_snapshot_json_for_testing(&encoded).unwrap();
+    for field in [
+        "execution_proof_profiles",
+        "execution_proof_verifications",
+        "game_sessions",
+        "game_equipment_publishers",
+        "game_equipment_catalogs",
+        "nft_sale_offers",
+        "nft_custody_records",
+    ] {
+        // Re-serializing a generic JSON object sorts its keys, so remove the
+        // member from the canonical World serialization without reordering
+        // any of the surviving fields.
+        let key = format!("\"{field}\"");
+        let positions: Vec<_> = encoded.match_indices(&key).collect();
+        assert_eq!(positions.len(), 1, "canonical snapshot lacks a unique {field}");
+        let mut start = positions[0].0;
+        let mut value_start = start + key.len();
+        let bytes = encoded.as_bytes();
+        while bytes[value_start].is_ascii_whitespace() {
+            value_start += 1;
+        }
+        assert_eq!(bytes[value_start], b':');
+        value_start += 1;
+        while bytes[value_start].is_ascii_whitespace() {
+            value_start += 1;
+        }
+        // Snapshot storage maps use a specialized canonical encoding that a
+        // generic JSON Value cannot reproduce. Find the matching JSON value
+        // delimiter directly, respecting quoted strings and escapes.
+        assert!(matches!(bytes[value_start], b'{' | b'['));
+        let mut closers = Vec::new();
+        let mut quoted = false;
+        let mut escaped = false;
+        let mut end = None;
+        for (offset, &byte) in bytes[value_start..].iter().enumerate() {
+            if quoted {
+                if escaped {
+                    escaped = false;
+                } else if byte == b'\\' {
+                    escaped = true;
+                } else if byte == b'"' {
+                    quoted = false;
+                }
+                continue;
+            }
+            match byte {
+                b'"' => quoted = true,
+                b'{' => closers.push(b'}'),
+                b'[' => closers.push(b']'),
+                b'}' | b']' => {
+                    assert_eq!(closers.pop(), Some(byte));
+                    if closers.is_empty() {
+                        end = Some(value_start + offset + 1);
+                        break;
+                    }
+                }
+                _ => {}
+            }
+        }
+        let mut end = end.expect("canonical snapshot field has a complete JSON value");
+        if bytes.get(end) == Some(&b',') {
+            end += 1;
+        } else {
+            assert_eq!(bytes.get(start - 1), Some(&b','));
+            start -= 1;
+        }
+        let missing = format!("{}{}", &encoded[..start], &encoded[end..]);
+        let parsed: norito::json::Value = norito::json::from_str(&missing).unwrap();
+        assert!(parsed.as_object().unwrap().get(field).is_none());
+        let error = validate_world_snapshot_json_for_testing(&missing).unwrap_err();
+        assert!(
+            error.contains("snapshot world fields are not in canonical schema order"),
+            "missing {field}: {error}"
+        );
+    }
+}
+
+#[test]
+fn equipped_native_custody_excludes_sale_transfer_and_double_equip() {
+    iroha_core::smartcontracts::isi::game_equipment::test_support::assert_equipped_custody_guards_for_testing();
+}
