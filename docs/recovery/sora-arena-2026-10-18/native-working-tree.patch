+/// Validate a wallet-approved deposit against the immutable funding policy.
+pub(crate) fn admitted_deposit(session: &GameSessionRecordV1, deposit: &Quantity) -> bool {
+    deposit.scale() <= session.payout_scale
+        && match session.manifest.payout_policy {
+            GamePayoutPolicyV1::NoPayout => deposit.is_zero() && session.stake.is_zero(),
+            GamePayoutPolicyV1::EqualWinnersOrRefund => deposit == &session.stake,
+            GamePayoutPolicyV1::VerifiedAllocations => deposit >= &session.stake,
+        }
+}
+
+fn original_pool(session: &GameSessionRecordV1) -> Result<Quantity, Error> {
+    session
+        .participants
+        .iter()
+        .try_fold(Quantity::zero(), |sum, participant| {
+            if !admitted_deposit(session, &participant.deposit) {
+                return Err(invalid(
+                    "retained deposit differs from the immutable funding policy",
+                ));
+            }
+            sum.checked_add(&participant.deposit)
+                .map_err(|_| invalid("game deposit pool overflow"))
+        })
+}
