+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import { encodeGameValueV1, decodeGameValueV1 } from "../src/game.js";
+
+const fixture = JSON.parse(fs.readFileSync(new URL("fixtures/game-v1-codec.json", import.meta.url), "utf8"));
+const encode = value => encodeGameValueV1("GameOutcomeV1", value);
+
+test("exact allocation outcomes carry indivisible amounts independently from winner slots", () => {
+  const outcome = { terminal_tick: 120, winner_slots: [2], allocations: [
+    { slot: 0, amount: "0.0000000000000000000000000001" },
+    { slot: 1, amount: "1234567890123456789012345678.5" },
+  ], result: [] };
+  const bytes = encode(outcome);
+  assert.deepEqual(decodeGameValueV1("GameOutcomeV1", bytes), outcome);
+  assert.notDeepEqual(encode({ ...outcome, allocations: [{slot: 0, amount: "1"}] }), bytes);
+  assert.notDeepEqual(encode({ ...outcome, allocations: [...outcome.allocations].reverse() }), bytes);
+  const omitted = { ...outcome }; delete omitted.allocations;
+  assert.throws(() => encode(omitted));
+  assert.throws(() => encode({ ...outcome, allocations: [{slot: 0, amount: "01"}] }));
+  assert.throws(() => encode({ ...outcome, allocations: [{slot: 0, amount: "1", trusted_kills: 1}] }));
+  assert.throws(() => encode({ ...outcome, allocations: Array.from({length: 33}, (_,slot) => ({slot, amount:"1"})) }));
+});
+
+test("the initial-release manifest has one explicit verified allocation policy", () => {
+  const manifest = { ...fixture.vectors.find(row => row.name === "GameManifestV1").value, access: {kind: "public", public_key: null}, payout_policy: {kind: "verified_allocations", value: null} };
+  const bytes = encodeGameValueV1("GameManifestV1", manifest);
+  assert.deepEqual(decodeGameValueV1("GameManifestV1", bytes), manifest);
+  for (const kind of ["slashed_kills", "VerifiedAllocations", "operator_decides"]) {
+    assert.throws(() => encodeGameValueV1("GameManifestV1", {...manifest, payout_policy:{kind, value: null}}));
+  }
+});
+
+for (const row of fixture.vectors.filter(row => row.name === "GameOutcomeV1")) {
+  test(`Rust-origin outcome wire matches allocation codec: ${row.case ?? row.value.terminal_tick}`, () => {
+    const bytes = encode(row.value);
+    assert.equal(Buffer.from(bytes).toString("hex").toUpperCase(), row.encoded_hex);
+    assert.deepEqual(decodeGameValueV1("GameOutcomeV1", bytes), row.value);
+  });
+}
