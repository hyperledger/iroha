+fn preflight(adapter: &Adapter) -> Result<(usize, usize), String> {
+    let protocol = adapter.protocol_v1();
+    protocol.validate().map_err(|error| error.to_string())?;
+    let layout = AggregateProofLayoutV1::new(
+        protocol.parameters,
+        vec![AggregateTraceGroupLayoutV1 {
+            native_trace_log2: TRACE_LOG,
+            segment_instances: 1,
+            base_width: adapter.base_width_v1(),
+            aux_width: NOTE_COPY_AUX_WIDTH_V1,
+        }],
+    )
+    .map_err(|error| error.to_string())?;
+    let maximum = maximum_encoded_proof_with_deep_bytes_v1(protocol.parameters, &layout)
+        .map_err(|error| error.to_string())?;
+    let envelope_maximum = encoded_envelope_size_v2(&adapter.statement, maximum);
+    if envelope_maximum > MAX_PROOF_BYTES {
+        return Err(format!(
+            "staged kill whole-envelope maximum {envelope_maximum} (STARK {maximum}) exceeds {MAX_PROOF_BYTES} bytes"
+        ));
+    }
+    Ok((maximum, envelope_maximum))
+}
