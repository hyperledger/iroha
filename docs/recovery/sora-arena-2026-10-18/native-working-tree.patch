+fn authority_generation_migration_binds_complete_authorization() {
+    use iroha_data_model::isi::kagemusha_v1::InstalledBeaconEpochBindingV1;
+
+    let context = context();
+    let genesis = context.kagemusha_mint_finality_authorization;
+    let retained = retained_authorization(genesis);
+    let next = retained_authorization(retained);
+    retained.validate_successor(&genesis).unwrap();
+    next.validate_successor(&retained).unwrap();
+    next.validate_against_authority(&context.kagemusha_mint_finality_authority)
+        .unwrap();
+    assert_eq!(next.authority_generation, 0);
+    assert_eq!(next.authority_id, genesis.authority_id);
+    assert_ne!(next.authorization_id().unwrap(), next.authority_id);
+    assert_ne!(
+        next.authorization_id().unwrap(),
+        retained.authorization_id().unwrap()
+    );
+
+    let encoded = next.encode();
+    assert_eq!(
