+fn encoded_envelope_size_v2(
+    statement: &ArenaKillHistoryResearchStatementV2,
+    stark_len: usize,
+) -> usize {
+    let dispute_root = game_message_hash_v1(
+        &statement.network_id,
+        "dispute-history",
+        &(
+            statement.session_id,
+            0_u64,
+            None::<GameCheckpointV1>,
+            Vec::<GameTranscriptAnchorV1>::new(),
+            statement.native_batches.clone(),
+        ),
+    );
+    let envelope = ExecutionProofEnvelopeV1 {
+        version: 1,
+        profile_id: statement.manifest.profile_id,
+        statement: ExecutionPublicInputsV1 {
+            network_id: statement.network_id.clone(),
+            session_id: statement.session_id,
+            manifest_hash: statement.manifest_hash,
+            roster_hash: statement.roster_hash,
+            transcript_root: statement.native_transcript_root,
+            dispute_root,
+            outcome_hash: statement.outcome_hash,
+        },
+        proof_bytes: ResearchPayloadV2 {
+            statement: statement.clone(),
+            stark_bytes: vec![0; stark_len],
+        }
+        .encode(),
+    };
+    envelope.encode().len()
+}
