+++ b/crates/iroha_core/tests/arena_kill_two_tick_history.rs
@@ -0,0 +1,372 @@
+//! Independent audit of the game's 2-tick P2P evidence framing against the
+//! existing, source-sealed 25-tick kill AIR fixture. No custody or funding.
+
+use iroha_core::execution_proofs::arena_kill_research::{
+    canonical_input_v1, expected_states_v1, reference_tick_rows_v1, research_manifest_v1,
+};
+use iroha_crypto::{Algorithm, Hash, KeyPair, Signature};
+use norito::codec::Encode;
+use sha2::{Digest, Sha256};
+
+const PLAYERS: usize = 3;
+const BATCH_TICKS: usize = 2;
+const BATCHES: usize = 13;
+const FRAME_BYTES: usize = 8;
+type Digest32 = [u8; 32];
+type Frame = [u8; FRAME_BYTES];
+
+fn sha256(bytes: &[u8]) -> Digest32 {
+    Sha256::digest(bytes).into()
+}
+
+fn keys() -> [KeyPair; PLAYERS] {
+    std::array::from_fn(|slot| {
+        KeyPair::try_from_seed(vec![slot as u8 + 121; 32], Algorithm::Ed25519).unwrap()
+    })
+}
+
+#[derive(Clone)]
+struct Context {
+    network: Digest32,
+    session: Digest32,
+    manifest: Digest32,
+    roster: [Digest32; PLAYERS],
+}
+
+impl Context {
+    fn new(keys: &[KeyPair; PLAYERS]) -> Self {
+        // The source-sealed kill profile itself describes a 25-tick batch. This
+        // separate, unregistered research manifest describes the P2P shape.
+        let mut manifest = research_manifest_v1();
+        manifest.batch_ticks = BATCH_TICKS as u16;
+        manifest.max_ticks = (BATCHES * BATCH_TICKS) as u32;
+        manifest.max_input_bytes = (BATCH_TICKS * FRAME_BYTES) as u16;
+        Self {
+            network: *Hash::new(b"arena-kill-research-isolated-network").as_ref(),
+            session: *Hash::new(b"arena-kill-research-bonded-unfunded-session").as_ref(),
+            manifest: sha256(&manifest.encode()),
+            roster: std::array::from_fn(|slot| {
+                keys[slot].public_key().to_bytes().1.try_into().unwrap()
+            }),
+        }
+    }
+
+    // Byte-for-byte form of arena-core::protocol::Context::domain.
+    fn domain(&self, tag: &[u8]) -> Vec<u8> {
+        let mut out = b"sora-arena:p2p-evidence:v1\0".to_vec();
+        out.extend((tag.len() as u32).to_le_bytes());
+        out.extend(tag);
+        out.extend(self.network);
+        out.extend(self.session);
+        out.extend(self.manifest);
+        out.extend((PLAYERS as u32).to_le_bytes());
+        for key in &self.roster {
+            out.extend(key);
+        }
+        out
+    }
+
+    fn genesis_root(&self) -> Digest32 {
+        sha256(&self.domain(b"genesis"))
+    }
+}
+
+#[derive(Clone)]
+struct Reveal {
+    slot: usize,
+    inputs: [Frame; BATCH_TICKS],
+    salt: Digest32,
+}
+
+#[derive(Clone)]
+struct Set {
+    epoch: u64,
+    start_tick: u32,
+    parent: Digest32,
+    commitments: [Digest32; PLAYERS],
+}
+
+impl Set {
+    // Byte-for-byte form of arena-core::protocol::CommitmentSet::digest.
+    fn digest(&self, context: &Context) -> Digest32 {
+        let mut bytes = context.domain(b"complete-commitment-set");
+        bytes.extend(self.epoch.to_le_bytes());
+        bytes.extend(self.start_tick.to_le_bytes());
+        bytes.extend(self.parent);
+        for commitment in self.commitments {
+            bytes.extend(commitment);
+        }
+        sha256(&bytes)
+    }
+}
+
+#[derive(Clone)]
+struct CertifiedBatch {
+    set: Set,
+    signatures: [Signature; PLAYERS],
+    reveals: [Reveal; PLAYERS],
+}
+
+fn input_commitment(context: &Context, set: &Set, reveal: &Reveal) -> Digest32 {
+    // Byte-for-byte form of arena-core::protocol::input_commitment for two
+    // eight-byte canonical controls, including the previous transcript root.
+    let mut bytes = context.domain(b"inputs");
+    bytes.extend(set.epoch.to_le_bytes());
+    bytes.extend(set.start_tick.to_le_bytes());
+    bytes.extend(set.parent);
+    bytes.extend((reveal.slot as u32).to_le_bytes());
+    bytes.extend((BATCH_TICKS as u32).to_le_bytes());
+    for input in reveal.inputs {
+        bytes.extend(input);
+    }
+    bytes.extend(reveal.salt);
+    sha256(&bytes)
+}
+
+fn next_root(context: &Context, old_root: Digest32, batch: &CertifiedBatch) -> Digest32 {
+    // Byte-for-byte form of arena-core::protocol::EvidenceLog::reveal.
+    let mut bytes = context.domain(b"transcript-batch");
+    bytes.extend(old_root);
+    bytes.extend(batch.set.digest(context));
+    for reveal in &batch.reveals {
+        for input in reveal.inputs {
+            bytes.extend(input);
+        }
+    }
+    sha256(&bytes)
+}
+
+fn frame(slot: usize, tick: usize, suppress_lethal_fire: bool) -> Frame {
+    if tick < 25 {
+        let canonical = canonical_input_v1(slot);
+        let mut result: Frame = canonical[tick * FRAME_BYTES..(tick + 1) * FRAME_BYTES]
+            .try_into()
+            .unwrap();
+        if suppress_lethal_fire && tick == 24 {
+            result[0] = 0;
+        }
+        result
+    } else {
+        // The 26th frame is required by the game's fixed two-tick batch size.
+        // It is deliberately idle; the existing research AIR ends at tick 25.
+        let yaw: u16 = match slot {
+            0 => 24_576,
+            1 => 8_192,
+            _ => 0,
+        };
+        let [lo, hi] = yaw.to_le_bytes();
+        [0, 0, 0, 0, lo, hi, 0, 0]
+    }
+}
+
+fn history(
+    context: &Context,
+    keys: &[KeyPair; PLAYERS],
+    suppress_lethal_fire: bool,
+) -> Vec<CertifiedBatch> {
+    let mut root = context.genesis_root();
+    (0..BATCHES)
+        .map(|batch_index| {
+            let start_tick = (batch_index * BATCH_TICKS) as u32;
+            let reveals = std::array::from_fn(|slot| Reveal {
+                slot,
+                inputs: [
+                    frame(slot, start_tick as usize, suppress_lethal_fire),
+                    frame(slot, start_tick as usize + 1, suppress_lethal_fire),
+                ],
+                salt: sha256(&[batch_index as u8, slot as u8, 0x42]),
+            });
+            let mut set = Set {
+                epoch: 0,
+                start_tick,
+                parent: root,
+                commitments: [[0; 32]; PLAYERS],
+            };
+            set.commitments =
+                std::array::from_fn(|slot| input_commitment(context, &set, &reveals[slot]));
+            let digest = set.digest(context);
+            let signatures =
+                std::array::from_fn(|slot| Signature::new(keys[slot].private_key(), &digest));
+            let batch = CertifiedBatch {
+                set,
+                signatures,
+                reveals,
+            };
+            root = next_root(context, root, &batch);
+            batch
+        })
+        .collect()
+}
+
+fn validate_frame(frame: Frame) -> Result<(), &'static str> {
+    let buttons = u16::from_le_bytes([frame[0], frame[1]]);
+    let pitch = i16::from_le_bytes([frame[6], frame[7]]);
+    if buttons & !63 != 0 || !(-16_384..=16_384).contains(&pitch) {
+        return Err("invalid canonical control");
+    }
+    Ok(())
+}
+
+fn audit(
+    context: &Context,
+    keys: &[KeyPair; PLAYERS],
+    batches: &[CertifiedBatch],
+) -> Result<(Digest32, [Vec<Frame>; PLAYERS]), &'static str> {
+    if batches.len() != BATCHES {
+        return Err("wrong batch count");
+    }
+    let mut root = context.genesis_root();
+    let mut by_slot: [Vec<Frame>; PLAYERS] = std::array::from_fn(|_| Vec::with_capacity(26));
+    for (index, batch) in batches.iter().enumerate() {
+        if batch.set.epoch != 0
+            || batch.set.start_tick != (index * BATCH_TICKS) as u32
+            || batch.set.parent != root
+        {
+            return Err("gap, replay, generation or parent root mismatch");
+        }
+        let digest = batch.set.digest(context);
+        for slot in 0..PLAYERS {
+            let reveal = &batch.reveals[slot];
+            if reveal.slot != slot || context.roster[slot] != keys[slot].public_key().to_bytes().1 {
+                return Err("wrong permanent slot or key");
+            }
+            if batch.signatures[slot]
+                .verify(keys[slot].public_key(), &digest)
+                .is_err()
+            {
+                return Err("invalid joint certificate");
+            }
+            if batch.set.commitments[slot] != input_commitment(context, &batch.set, reveal) {
+                return Err("reveal does not open committed controls");
+            }
+            for input in reveal.inputs {
+                validate_frame(input)?;
+                by_slot[slot].push(input);
+            }
+        }
+        root = next_root(context, root, batch);
+    }
+    Ok((root, by_slot))
+}
+
+fn controls_match_kill_air(controls: &[Vec<Frame>; PLAYERS]) -> bool {
+    let rows = reference_tick_rows_v1();
+    (0..PLAYERS).all(|slot| {
+        controls[slot].len() == 26
+            && controls[slot][..25].concat() == canonical_input_v1(slot)
+            && controls[slot][25] == frame(slot, 25, false)
+    }) && (0..25).all(|tick| {
+        rows[tick][10] == i64::from(controls[0][tick][0] & 1)
+            && rows[tick][11] == i64::from(controls[1][tick][0] & 1)
+    })
+}
+
+fn assert_matches_kill_air(controls: &[Vec<Frame>; PLAYERS]) {
+    let rows = reference_tick_rows_v1();
+    let states = expected_states_v1();
+    assert_eq!(rows.len(), 25);
+    assert_eq!(states.len(), 26);
+    assert!(controls_match_kill_air(controls));
+    for slot in 0..PLAYERS {
+        assert_eq!(controls[slot].len(), 26);
+        assert_eq!(controls[slot][..25].concat(), canonical_input_v1(slot));
+        assert_eq!(
+            controls[slot][25],
+            frame(slot, 25, false),
+            "padding tick must be the exact idle control"
+        );
+    }
+    const LINKED: [(usize, usize); 12] = [
+        (1, 0),   // victim HP
+        (3, 2),   // shooter 0 cooldown
+        (5, 4),   // shooter 1 cooldown
+        (7, 6),   // shooter 0 magazine
+        (9, 8),   // shooter 1 magazine
+        (17, 16), // victim alive
+        (19, 18), // victim reserve
+        (21, 20), // assist earnings
+        (23, 22), // killer earnings
+        (25, 24), // victim paid deaths
+        (27, 26), // victim deaths
+        (29, 28), // shooter 1 kills
+    ];
+    for tick in 0..25 {
+        let row = &rows[tick];
+        assert_eq!(row[10], i64::from(controls[0][tick][0] & 1));
+        assert_eq!(row[11], i64::from(controls[1][tick][0] & 1));
+        assert_eq!(row[0], i64::from(states[tick].health[2]));
+        assert_eq!(row[1], i64::from(states[tick + 1].health[2]));
+        assert_eq!(row[18], states[tick].reserve[2] as i64);
+        assert_eq!(row[19], states[tick + 1].reserve[2] as i64);
+        assert_eq!(row[30], i64::from(tick == 24));
+        if tick + 1 < 25 {
+            assert_eq!(row[31], 1);
+            for (out, next_in) in LINKED {
+                assert_eq!(row[out], rows[tick + 1][next_in], "tick {tick} link");
+            }
+        } else {
+            assert_eq!(row[31], 0);
+        }
+    }
+    for start in (2..25).step_by(2) {
+        assert_eq!(rows[start - 1][1], rows[start][0]);
+        assert_eq!(rows[start - 1][19], rows[start][18]);
+    }
+    assert_eq!(states[25].health[2], 0);
+    assert_eq!(states[25].reserve, [1000, 1000, 900]);
+    assert_eq!(states[25].earnings, [20, 80, 0]);
+    assert_eq!(states[25].paid_deaths, [0, 0, 1]);
+}
+
+#[test]
+fn thirteen_signed_two_tick_batches_chain_to_the_proved_kill_inputs() {
+    let keys = keys();
+    let context = Context::new(&keys);
+    let batches = history(&context, &keys, false);
+    let (root, controls) = audit(&context, &keys, &batches).unwrap();
+    assert_matches_kill_air(&controls);
+    assert_ne!(root, context.genesis_root());
+    eprintln!("two_tick_batches=13 executed_ticks=25 padded_ticks=1 transcript_root={root:02x?}");
+}
+
+#[test]
+fn tampered_or_reordered_two_tick_evidence_fails() {
+    let keys = keys();
+    let context = Context::new(&keys);
+    let valid = history(&context, &keys, false);
+    assert!(audit(&context, &keys, &valid[..12]).is_err());
+
+    let mut reordered = valid.clone();
+    reordered.swap(1, 2);
+    assert!(audit(&context, &keys, &reordered).is_err());
+
+    let mut wrong_parent = valid.clone();
+    wrong_parent[1].set.parent = [9; 32];
+    assert!(audit(&context, &keys, &wrong_parent).is_err());
+
+    let mut stale_tick = valid.clone();
+    stale_tick[1].set.start_tick = 0;
+    assert!(audit(&context, &keys, &stale_tick).is_err());
+
+    let mut forged_signature = valid.clone();
+    forged_signature[0].signatures[1] = forged_signature[0].signatures[0].clone();
+    assert!(audit(&context, &keys, &forged_signature).is_err());
+
+    let mut changed_reveal = valid.clone();
+    changed_reveal[12].reveals[1].inputs[0][0] = 0;
+    assert!(audit(&context, &keys, &changed_reveal).is_err());
+
+    let mut wrong_slot = valid.clone();
+    wrong_slot[7].reveals[0].slot = 1;
+    assert!(audit(&context, &keys, &wrong_slot).is_err());
+
+    let mut other_network = context.clone();
+    other_network.network[0] ^= 1;
+    assert!(audit(&other_network, &keys, &valid).is_err());
+
+    let mut no_lethal_fire = history(&context, &keys, true);
+    let (_, controls) = audit(&context, &keys, &no_lethal_fire).unwrap();
+    assert!(!controls_match_kill_air(&controls));
+    no_lethal_fire[12].reveals[0].inputs[0][0] = 1;
+    assert!(audit(&context, &keys, &no_lethal_fire).is_err());
+}
