@@ -0,0 +1,361 @@
+//! Unregistered, unfunded thirteen-batch P2P history and 26-tick kill proof research.
+
+use iroha_core::execution_proofs::{
+    arena_kill_history_research::{
+        ArenaKillHistoryResearchStatementV2, P2PCertifiedBatchV2, P2PContextV2, P2PRevealV2,
+        P2PSetV2, canonical_input_v1, expected_outcome_v2, expected_states_v1,
+        prove_research_kill_v1, reference_plane_rows_v1, reference_tick_rows_v1,
+        research_equipment_hash_v1, research_genesis_root_v1, research_geometry_v1,
+        research_manifest_v1, research_map_hash_v1, research_rules_hash_v1,
+        research_stage_residue_failures_v1, verify_research_kill_v1,
+    },
+    compiled_execution_profile_v1, initial_game_state_root_v1,
+};
+use iroha_crypto::{Algorithm, Hash, HashOf, KeyPair, Signature};
+use iroha_data_model::{
+    NetworkId,
+    account::AccountId,
+    block::BlockHeader,
+    game::{
+        GameAdmissionBodyV1, GameAdmissionParticipantV1, GameForcedBatchV1, GameSlotSignatureV1,
+        GameTranscriptBatchV1, GameTranscriptV1, game_message_hash_v1, game_roster_hash_v1,
+    },
+};
+use iroha_primitives::numeric::Quantity;
+use sha2::{Digest, Sha256};
+
+fn input_keys() -> [KeyPair; 3] {
+    std::array::from_fn(|slot| {
+        KeyPair::try_from_seed(vec![slot as u8 + 121; 32], Algorithm::Ed25519).unwrap()
+    })
+}
+
+fn fixture() -> ArenaKillHistoryResearchStatementV2 {
+    let network_id = NetworkId::from_genesis_hash(HashOf::<BlockHeader>::from_untyped_unchecked(
+        Hash::new(b"arena-kill-history-research-isolated-network"),
+    ));
+    let session_id = Hash::new(b"arena-kill-history-research-unfunded-session");
+    let keys = input_keys();
+    let manifest = research_manifest_v1();
+    let admission = GameAdmissionBodyV1 {
+        version: 1,
+        participants: (0..3)
+            .map(|slot| {
+                let wallet =
+                    KeyPair::try_from_seed(vec![slot as u8 + 41; 32], Algorithm::Ed25519).unwrap();
+                GameAdmissionParticipantV1 {
+                    account: AccountId::new(wallet.public_key().clone()),
+                    input_key: keys[slot].public_key().clone(),
+                    deposit: Quantity::from(1000_u32),
+                    application_data: vec![0, 0, u8::from(slot < 2)],
+                }
+            })
+            .collect(),
+        wagers: vec![],
+        resources: vec![],
+    };
+    let genesis_root =
+        research_genesis_root_v1(&network_id, session_id, &manifest, &admission).unwrap();
+    let p2p = P2PContextV2::from_admission(&network_id, session_id, &manifest, &admission).unwrap();
+    let mut root = p2p.genesis_root();
+    let mut history = Vec::new();
+    let mut native_batches = Vec::new();
+    for index in 0..13 {
+        let start_tick = (index * 2) as u32;
+        let reveals = (0..3)
+            .map(|slot| P2PRevealV2 {
+                slot: slot as u8,
+                payload: canonical_input_v1(slot)[index * 16..index * 16 + 16]
+                    .try_into()
+                    .unwrap(),
+                salt: Sha256::digest([index as u8, slot as u8, 0x42]).into(),
+            })
+            .collect::<Vec<_>>();
+        let mut set = P2PSetV2 {
+            epoch: 0,
+            start_tick,
+            parent: root,
+            commitments: vec![[0; 32]; 3],
+        };
+        for slot in 0..3 {
+            set.commitments[slot] = p2p.input_commitment(&set, &reveals[slot]).unwrap();
+        }
+        let digest = p2p.set_digest(&set).unwrap();
+        let signatures = (0..3)
+            .map(|slot| GameSlotSignatureV1 {
+                slot: slot as u8,
+                signature: Signature::new(keys[slot].private_key(), &digest),
+            })
+            .collect();
+        let batch = P2PCertifiedBatchV2 {
+            set,
+            signatures,
+            reveals,
+        };
+        root = p2p.next_root(root, &batch).unwrap();
+        native_batches.push(GameForcedBatchV1 {
+            epoch: 0,
+            start_tick,
+            inputs: batch
+                .reveals
+                .iter()
+                .map(|reveal| reveal.payload.to_vec())
+                .collect(),
+            dnf_slots: vec![],
+        });
+        history.push(batch);
+    }
+    let transcript = GameTranscriptV1 {
+        batches: native_batches
+            .iter()
+            .map(|batch| GameTranscriptBatchV1 {
+                start_tick: batch.start_tick,
+                inputs: batch.inputs.clone(),
+            })
+            .collect(),
+        dnf_events: vec![],
+    };
+    let native_transcript_root = game_message_hash_v1(&network_id, "input-transcript", &transcript);
+    let outcome = expected_outcome_v2();
+    let outcome_hash = game_message_hash_v1(&network_id, "session-outcome", &outcome);
+    ArenaKillHistoryResearchStatementV2 {
+        network_id: network_id.clone(),
+        session_id,
+        manifest: manifest.clone(),
+        admission: admission.clone(),
+        genesis_root,
+        rules_hash: research_rules_hash_v1(),
+        map_hash: research_map_hash_v1(),
+        equipment_hash: research_equipment_hash_v1(),
+        manifest_hash: game_message_hash_v1(&network_id, "session-manifest", &manifest),
+        roster_hash: game_roster_hash_v1(&network_id, &session_id, &admission),
+        history,
+        p2p_root: root,
+        native_batches,
+        native_transcript_root,
+        outcome,
+        outcome_hash,
+        states: expected_states_v1(),
+        plane_rows: reference_plane_rows_v1(),
+        selected_targets: [3; 2],
+        tick_rows: reference_tick_rows_v1(),
+    }
+}
+
+// Re-sign a changed legal input through every later P2P parent and both transcript domains.
+// This distinguishes fixed-scene rejection from an invalid signature or stale root.
+fn reseal_history(statement: &mut ArenaKillHistoryResearchStatementV2) {
+    let context = P2PContextV2::from_admission(
+        &statement.network_id,
+        statement.session_id,
+        &statement.manifest,
+        &statement.admission,
+    )
+    .unwrap();
+    let keys = input_keys();
+    let mut root = context.genesis_root();
+    for (index, batch) in statement.history.iter_mut().enumerate() {
+        batch.set.parent = root;
+        for slot in 0..3 {
+            batch.set.commitments[slot] = context
+                .input_commitment(&batch.set, &batch.reveals[slot])
+                .unwrap();
+        }
+        let digest = context.set_digest(&batch.set).unwrap();
+        batch.signatures = (0..3)
+            .map(|slot| GameSlotSignatureV1 {
+                slot: slot as u8,
+                signature: Signature::new(keys[slot].private_key(), &digest),
+            })
+            .collect();
+        statement.native_batches[index].inputs = batch
+            .reveals
+            .iter()
+            .map(|reveal| reveal.payload.to_vec())
+            .collect();
+        root = context.next_root(root, batch).unwrap();
+    }
+    statement.p2p_root = root;
+    let transcript = GameTranscriptV1 {
+        batches: statement
+            .native_batches
+            .iter()
+            .map(|batch| GameTranscriptBatchV1 {
+                start_tick: batch.start_tick,
+                inputs: batch.inputs.clone(),
+            })
+            .collect(),
+        dnf_events: vec![],
+    };
+    statement.native_transcript_root =
+        game_message_hash_v1(&statement.network_id, "input-transcript", &transcript);
+}
+
+#[test]
+fn complete_thirteen_batch_history_and_twenty_six_transition_preflight() {
+    let valid = fixture();
+    valid.validate().unwrap();
+    assert!(compiled_execution_profile_v1(&valid.manifest.profile_id).is_none());
+    assert!(
+        initial_game_state_root_v1(&valid.network_id, &valid.manifest, &valid.admission).is_err()
+    );
+    assert_eq!(valid.history.len(), 13);
+    assert_eq!(valid.tick_rows.len(), 26);
+    assert_eq!(valid.states.len(), 27);
+    assert_eq!(valid.states[25].respawn_ticks[2], 480);
+    assert!(!valid.states[25].terminal);
+    assert_eq!(valid.states[26].respawn_ticks[2], 479);
+    assert!(valid.states[26].terminal);
+    let geometry = research_geometry_v1(valid.clone());
+    eprintln!("history_kill_geometry={geometry:?}");
+    assert!(geometry.is_ok());
+    let failures = research_stage_residue_failures_v1(valid.clone()).unwrap();
+    eprintln!("history_kill_stage_residue_failures={failures:?}");
+    assert!(failures.is_empty());
+
+    let mut bad = valid.clone();
+    bad.history.pop();
+    assert!(bad.validate().is_err());
+    let mut bad = valid.clone();
+    bad.history.swap(1, 2);
+    assert!(bad.validate().is_err());
+    let mut bad = valid.clone();
+    bad.history[1].set.parent[0] ^= 1;
+    assert!(bad.validate().is_err());
+    let mut bad = valid.clone();
+    bad.history[4].set.start_tick = 6;
+    assert!(bad.validate().is_err());
+    let mut bad = valid.clone();
+    bad.history[0].signatures.swap(0, 1);
+    assert!(bad.validate().is_err());
+    let mut bad = valid.clone();
+    bad.history[12].reveals[0].payload[8] ^= 1; // final committed idle frame
+    assert!(bad.validate().is_err());
+    let mut bad = valid.clone();
+    bad.history[2].reveals[0].payload[2] = 0x80; // encoded move_x=-128
+    let p2p = P2PContextV2::from_admission(
+        &bad.network_id,
+        bad.session_id,
+        &bad.manifest,
+        &bad.admission,
+    )
+    .unwrap();
+    assert!(
+        p2p.input_commitment(&bad.history[2].set, &bad.history[2].reveals[0])
+            .is_err()
+    );
+    assert!(bad.validate().is_err());
+    let mut bad = valid.clone();
+    bad.history[2].reveals[0].payload[3] = 0x80; // encoded move_y=-128
+    assert!(
+        p2p.input_commitment(&bad.history[2].set, &bad.history[2].reveals[0])
+            .is_err()
+    );
+    assert!(bad.validate().is_err());
+    let mut bad = valid.clone();
+    bad.history[12].reveals[0].payload[10] = 127; // legal second-frame move_x
+    reseal_history(&mut bad);
+    assert!(bad.validate().is_err()); // fixed zero-movement scene, not signature failure
+    let mut bad = valid.clone();
+    bad.history[12].reveals[0].payload[8] = 1; // legal final-frame FIRE
+    reseal_history(&mut bad);
+    assert!(bad.validate().is_err()); // fixed final idle transition
+    let mut bad = valid.clone();
+    bad.history[0].reveals[0].salt[0] ^= 1;
+    assert!(bad.validate().is_err());
+    let mut bad = valid.clone();
+    bad.p2p_root[0] ^= 1;
+    assert!(bad.validate().is_err());
+    let mut bad = valid.clone();
+    bad.native_transcript_root = Hash::new(b"forged-native-root");
+    assert!(bad.validate().is_err());
+    let mut bad = valid.clone();
+    bad.native_batches[0].inputs[0][0] ^= 1;
+    assert!(bad.validate().is_err());
+    let mut bad = valid.clone();
+    bad.admission.participants[2].deposit = Quantity::from(1010_u32);
+    assert!(bad.validate().is_err());
+    let mut bad = valid.clone();
+    bad.admission.participants[0].application_data[2] = 12;
+    assert!(bad.validate().is_err());
+    let mut bad = valid.clone();
+    bad.map_hash = Hash::new(b"forged-map");
+    assert!(bad.validate().is_err());
+    let mut bad = valid.clone();
+    bad.rules_hash = Hash::new(b"forged-rules");
+    assert!(bad.validate().is_err());
+    let mut bad = valid.clone();
+    bad.equipment_hash = Hash::new(b"forged-equipment");
+    assert!(bad.validate().is_err());
+    let mut bad = valid.clone();
+    bad.states[26].respawn_ticks[2] = 478;
+    assert!(bad.validate().is_err());
+    let mut bad = valid.clone();
+    bad.states[26].terminal = false;
+    assert!(bad.validate().is_err());
+    let mut bad = valid.clone();
+    bad.tick_rows[25][33] = 478;
+    assert!(bad.validate().is_err());
+    let mut bad = valid.clone();
+    bad.outcome.allocations[1].amount = Quantity::from(1079_u32);
+    assert!(bad.validate().is_err());
+    let mut bad = valid.clone();
+    bad.selected_targets[0] = 2;
+    assert!(bad.validate().is_err());
+}
+
+#[test]
+fn verifier_rejects_oversized_caller_proof_before_stark_decoding() {
+    let statement = fixture();
+    assert_eq!(
+        verify_research_kill_v1(statement.clone(), &vec![0; 4 * 1024 * 1024 + 1]),
+        Err("research kill proof exceeds its byte limit".into())
+    );
+    // A payload can fit the raw STARK cap while its native envelope does not.
+    assert_eq!(
+        verify_research_kill_v1(statement.clone(), &vec![0; 4 * 1024 * 1024]),
+        Err("research kill proof exceeds its whole-envelope byte limit".into())
+    );
+    assert!(verify_research_kill_v1(statement, &[0]).is_err());
+}
+
+#[test]
+#[ignore = "native proof takes minutes; run after full-envelope preflight"]
+fn prove_and_save_history_kill() {
+    let path = std::env::var("ARENA_HISTORY_KILL_PROOF_PATH").expect("proof path");
+    let statement = fixture();
+    let started = std::time::Instant::now();
+    let proof = prove_research_kill_v1(statement.clone()).unwrap();
+    eprintln!(
+        "history_kill_prove_ms={} history_kill_stark_bytes={}",
+        started.elapsed().as_millis(),
+        proof.len()
+    );
+    std::fs::write(&path, &proof).unwrap();
+    verify_research_kill_v1(statement, &proof).unwrap();
+}
+
+#[test]
+#[ignore = "verify the proof saved by a separate prover process"]
+fn independently_verify_saved_history_kill() {
+    let path = std::env::var("ARENA_HISTORY_KILL_PROOF_PATH").expect("proof path");
+    let proof = std::fs::read(path).unwrap();
+    let statement = fixture();
+    let started = std::time::Instant::now();
+    verify_research_kill_v1(statement.clone(), &proof).unwrap();
+    eprintln!("history_kill_verify_ms={}", started.elapsed().as_millis());
+    let mut bad = statement.clone();
+    bad.plane_rows[0][3] += 1; // host-valid false wall fraction changes proof binding
+    bad.validate().unwrap();
+    assert!(verify_research_kill_v1(bad, &proof).is_err());
+    let mut bad = statement.clone();
+    bad.native_batches[12].inputs[0][0] ^= 1;
+    assert!(verify_research_kill_v1(bad, &proof).is_err());
+    let mut bad = statement.clone();
+    bad.states[26].respawn_ticks[2] = 478;
+    assert!(verify_research_kill_v1(bad, &proof).is_err());
+    let mut damaged = proof.clone();
+    let damaged_index = damaged.len() / 2;
+    damaged[damaged_index] ^= 1;
+    assert!(verify_research_kill_v1(statement, &damaged).is_err());
+}
