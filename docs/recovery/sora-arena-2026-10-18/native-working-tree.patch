+/// Reject a restored record whose retained forced history cannot arise from the
+/// native batch transition. This checks record consistency, not independent
+/// consensus inclusion or signatures already consumed by prior transitions.
+pub fn validate_retained_game_history_v1(session: &GameSessionRecordV1) -> Result<(), String> {
+    let batch_ticks = u32::from(session.manifest.batch_ticks);
+    let roster_len = session.participants.len();
+    if batch_ticks == 0
+        || session.manifest.max_ticks == 0
+        || session.manifest.max_ticks % batch_ticks != 0
+        || roster_len > GAME_MAX_PARTICIPANTS_V1
+        || session.manifest.max_input_bytes == 0
+        || session.next_tick > session.manifest.max_ticks
+        || session.forced_batches.len() > (session.manifest.max_ticks / batch_ticks) as usize
+        || session.epoch != session.forced_batches.len() as u64
+    {
+        return Err("retained game batch limits, epoch or next tick are inconsistent".into());
+    }
+    if session.checkpoint.as_ref().is_some_and(|signed| {
+        let checkpoint = &signed.checkpoint;
+        checkpoint.session_id != session.session_id
+            || checkpoint.epoch > session.epoch
+            || checkpoint.tick > session.next_tick
+            || checkpoint.tick > session.manifest.max_ticks
+            || (!checkpoint.terminal && checkpoint.tick % batch_ticks != 0)
+    }) {
+        return Err("retained game checkpoint is outside its session history".into());
+    }
+    if session.transcript_anchors.len() > roster_len
+        || session
+            .transcript_anchors
+            .windows(2)
+            .any(|pair| pair[0].tick >= pair[1].tick)
+        || session.transcript_anchors.iter().any(|anchor| {
+            anchor.tick > session.next_tick
+                || anchor.tick > session.manifest.max_ticks
+                || anchor.tick % batch_ticks != 0
+        })
+    {
+        return Err("retained game transcript anchors are out of order or bounds".into());
+    }
+    let mut matched_dnfs = vec![false; roster_len];
+    let mut previous_end = 0_u32;
+    for (index, batch) in session.forced_batches.iter().enumerate() {
+        let Some(end_tick) = batch.start_tick.checked_add(batch_ticks) else {
+            return Err("retained game batch tick overflow".into());
+        };
+        if batch.epoch != index as u64
+            || batch.start_tick < previous_end
+            || batch.start_tick % batch_ticks != 0
+            || end_tick > session.next_tick
+            || end_tick > session.manifest.max_ticks
+            || batch.inputs.len() != roster_len
+            || batch
+                .inputs
+                .iter()
+                .any(|input| input.len() > usize::from(session.manifest.max_input_bytes))
+        {
+            return Err("retained game forced batch has invalid epoch, tick or inputs".into());
+        }
+        let expected_dnfs = session
+            .participants
+            .iter()
+            .enumerate()
+            .filter_map(|(slot, participant)| {
+                (participant.dnf_at_tick == Some(batch.start_tick)).then_some(slot as u8)
+            })
+            .collect::<Vec<_>>();
+        if batch.dnf_slots != expected_dnfs {
+            return Err("retained game DNF batch differs from participant removal markers".into());
+        }
+        for (slot, (participant, input)) in
+            session.participants.iter().zip(&batch.inputs).enumerate()
+        {
+            if participant
+                .dnf_at_tick
+                .is_some_and(|tick| tick <= batch.start_tick)
+                && !input.is_empty()
+            {
+                return Err("retained game removed slot supplied forced input".into());
+            }
+            if expected_dnfs.contains(&(slot as u8)) {
+                matched_dnfs[slot] = true;
+            }
+        }
+        previous_end = end_tick;
+    }
+    if (!session.forced_batches.is_empty() && session.checkpoint.is_none())
+        || session.next_tick
+            != session
+                .checkpoint
+                .as_ref()
+                .map_or(0, |signed| signed.checkpoint.tick)
+                .max(previous_end)
+    {
+        return Err("retained game next tick lacks a checkpoint or completed batch".into());
+    }
+    if session
+        .participants
+        .iter()
+        .enumerate()
+        .any(|(slot, participant)| participant.dnf_at_tick.is_some() && !matched_dnfs[slot])
+    {
+        return Err("retained game participant removal lacks a forced batch".into());
+    }
+    if session.dispute_root != game_dispute_root_v1(session) {
+        return Err("retained game dispute root differs from exact stored history".into());
+    }
+    Ok(())
+}
