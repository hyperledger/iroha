@@ -0,0 +1,1243 @@
+//! Unregistered, unfunded staged proof of one execution-derived bonded FPS death.
+//!
+//! The fixed 26-tick three-player FFA scene uses two Arc carbines against one
+//! full-health samurai. Native AIR proves both shooters' wall/body slabs and
+//! all projected health, cooldown, ammo, death and exact bond/award transitions.
+//! Host code verifies thirteen signed two-tick P2P batches and nearest-body
+//! reduction over proved slabs. This is not a general Arena relation, a complete
+//! `World` proof, a ledger-selected history, or a settlement authorization.
+
+use super::{
+    arena_geometry_air::{COORDINATE_LIMIT, Q20, plane_v1},
+    arena_kill_history_air::{self, ArenaKillTickAirV1},
+    checked_integer_air::bounded_input_v1,
+    integer_air::{IntegerAirV1, Source, Value, field},
+    registry::compiled_execution_profile_v1,
+    stark::{
+        aggregate_stark::{
+            AggregateProofLayoutV1, AggregateStarkDomainsV1, AggregateStarkParametersV1,
+            AggregateTraceGroupLayoutV1, maximum_encoded_proof_with_deep_bytes_v1,
+        },
+        proof_managed_note_stark::{
+            NOTE_COPY_AUX_WIDTH_V1, NOTE_COPY_FIXED_WIDTH_V1, NOTE_COPY_WIDTH_V1,
+            NoteCopyCellPolicyV1, NoteCopyChallengesV1, NoteCopyScheduleV1,
+            ProofManagedNoteStarkAdapterV1, ProofManagedNoteStarkErrorV1 as NativeError,
+            ProofManagedNoteStarkProtocolV1, prove_proof_managed_note_stark_v1,
+            verify_proof_managed_note_stark_v1,
+        },
+        transparent_stark::{
+            GoldilocksDigest384V1, GoldilocksFieldV1 as F, TransparentStarkDigestContextV1,
+            TransparentTranscriptV1, goldilocks_digest384_frame_v1,
+        },
+    },
+};
+use iroha_crypto::{Algorithm, Hash};
+use iroha_data_model::{
+    NetworkId,
+    execution_proofs::{ExecutionProofEnvelopeV1, ExecutionPublicInputsV1},
+    game::{
+        GameAccessV1, GameAdmissionBodyV1, GameCheckpointV1, GameForcedBatchV1, GameManifestV1,
+        GameOutcomeV1, GamePayoutAllocationV1, GamePayoutPolicyV1, GameSlotSignatureV1,
+        GameTranscriptAnchorV1, GameTranscriptBatchV1, GameTranscriptV1, game_message_hash_v1,
+        game_roster_hash_v1,
+    },
+};
+use iroha_primitives::numeric::Quantity;
+use norito::codec::Encode;
+use sha2::{Digest, Sha256};
+
+const TRACE_LOG: u8 = 13;
+const TRACE_SIZE: usize = 1 << TRACE_LOG;
+const MAX_PROOF_BYTES: usize = 4 * 1024 * 1024;
+const TICKS: usize = 26;
+const SHOOTERS: usize = 2;
+const BOXES_PER_SHOOTER: usize = 5; // three walls, two eligible bodies
+const PLANE_VALUES: usize = 5;
+const PLANE_COUNT: usize = SHOOTERS * BOXES_PER_SHOOTER * 3 * 2;
+const ACTIVE_STAGES: usize = TICKS + PLANE_COUNT;
+// The trace wraps from row 8191 to row 0. A power-of-two stage period ensures
+// no chained tick row can land at that wrap; padding repeats a valid plane row.
+const STAGES: usize = 128;
+const _: () = assert!(STAGES >= ACTIVE_STAGES && TRACE_SIZE.is_multiple_of(STAGES));
+const FIXED_VALUES: usize = arena_kill_history_air::INPUT_COUNT + 1;
+const CONTEXT: TransparentStarkDigestContextV1 =
+    TransparentStarkDigestContextV1::execution_v1(b"arena-kill-history-research-v2");
+const DESCRIPTOR: &[u8] = b"unregistered-arena-kill-history-research-v2:rules=arena-first-release-6:three-player-ffa:map0:thirteen-signed-two-tick-batches:sixty-proved-slabs:twentysix-proved-tick-transitions:1000-bonds:one-execution-derived-death:80-killer/20-assist:no-ledger-selection:no-settlement:no-qualification";
+// Manually fixed research specification; NOT a cryptographic commitment to all
+// arena-core source. The scene is independently executed in arena-core tests.
+const RULES: &[u8] = b"arena-core:sora-arena-first-release-6:mode=FFA:map0:offline=false:base-bond=1000:players=(team0,class0,weapon1,bond1000)x2,(team0,class0,weapon0,bond1000):spawn=(18000,0),(-18000,0),(0,18000):health=125:stamina=100:arc-carbine=hitscan/damage22/range45000/cooldown12/magazine24:slots0/1-fire-at-ticks0,12,24:yaw=24576,8192:all-other-inputs-idle:shots-ordered-slot0-then-slot1:target-slot2:FFA-assist-five-second-window:tranche=100:80-killer/20-assist:death-at-tick25:terminal-at-tick26";
+const MAP_ZERO_WALLS: &[u8] = b"map0:walls=(-8000,-9000,-6500,6000,3800);(6500,-6000,8000,9000,3800);(-4000,7000,3500,8000,2300):radius=350:world-bounds=24000";
+const EQUIPMENT: &[u8] = b"arena-core:catalog:class0-samurai-health125-stamina100-move80:weapon0-katana-melee:weapon1-arc-carbine-hitscan-damage22-range45000-cooldown12-magazine24:no-nft-resource:base-bond1000";
+const FROM: [[i64; 3]; SHOOTERS] = [[18_000, 0, 1_400], [-18_000, 0, 1_400]];
+const TO: [[i64; 3]; SHOOTERS] = [[-13_763, 31_763, 1_400], [13_763, 31_763, 1_400]];
+const WALLS: [([i64; 3], [i64; 3]); 3] = [
+    ([-8_000, -9_000, 0], [-6_500, 6_000, 3_800]),
+    ([6_500, -6_000, 0], [8_000, 9_000, 3_800]),
+    ([-4_000, 7_000, 0], [3_500, 8_000, 2_300]),
+];
+const BODIES: [([i64; 3], [i64; 3]); 3] = [
+    ([17_650, -350, 0], [18_350, 350, 1_700]),
+    ([-18_350, -350, 0], [-17_650, 350, 1_700]),
+    ([-350, 17_650, 0], [350, 18_350, 1_700]),
+];
+const DOMAINS: AggregateStarkDomainsV1 = AggregateStarkDomainsV1 {
+    digest_context: CONTEXT,
+    base_leaf: b"arena-kill-base-leaf-v1",
+    base_node: b"arena-kill-base-node-v1",
+    aux_leaf: b"arena-kill-aux-leaf-v1",
+    aux_node: b"arena-kill-aux-node-v1",
+    composition_leaf: b"arena-kill-composition-leaf-v1",
+    composition_node: b"arena-kill-composition-node-v1",
+    fri_leaf: b"arena-kill-fri-leaf-v1",
+    fri_node: b"arena-kill-fri-node-v1",
+    layout_label: b"arena-kill-layout-v1",
+    base_root_label: b"arena-kill-base-root-v1",
+    aux_root_label: b"arena-kill-aux-root-v1",
+    composition_root_label: b"arena-kill-composition-root-v1",
+    fri_root_label: b"arena-kill-fri-root-v1",
+    fri_beta_label: b"arena-kill-fri-beta-v1",
+    query_seed: b"arena-kill-query-seed-v1",
+};
+
+/// Fixed research ID, absent from `COMPILED_ADAPTERS_V1`.
+#[must_use]
+pub fn research_profile_id_v1() -> Hash {
+    Hash::new(DESCRIPTOR)
+}
+
+/// Exact three-entrant, 26-tick, bonded research manifest.
+#[must_use]
+pub fn research_manifest_v1() -> GameManifestV1 {
+    GameManifestV1 {
+        version: 1,
+        application_id: Hash::new(b"sora-arena-kill-history-research-v2"),
+        profile_id: research_profile_id_v1(),
+        application_parameters: vec![0, 1],
+        min_participants: 3,
+        max_participants: 3,
+        batch_ticks: 2,
+        max_ticks: TICKS as u32,
+        max_input_bytes: 16,
+        max_participant_data_bytes: 3,
+        access: GameAccessV1::Public,
+        payout_policy: GamePayoutPolicyV1::VerifiedAllocations,
+    }
+}
+
+/// Hash of the restricted scene rules above.
+#[must_use]
+pub fn research_rules_hash_v1() -> Hash {
+    Hash::new(RULES)
+}
+
+/// Exact map-zero wall layout hash.
+#[must_use]
+pub fn research_map_hash_v1() -> Hash {
+    Hash::new(MAP_ZERO_WALLS)
+}
+
+/// Exact restricted equipment table for this unregistered scene.
+#[must_use]
+pub fn research_equipment_hash_v1() -> Hash {
+    Hash::new(EQUIPMENT)
+}
+
+/// The economic and combat state projected at a complete tick boundary.
+/// Unlisted `World` fields are not proved by this research relation.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Encode)]
+pub struct KillResearchStateV1 {
+    /// Complete simulation tick.
+    pub tick: u32,
+    /// Spawn positions in millimetres, fixed by the admitted scene.
+    pub positions: [[i32; 3]; 3],
+    /// Health of all three players.
+    pub health: [i32; 3],
+    /// Stamina of all three players.
+    pub stamina: [i32; 3],
+    /// Magazine rounds.
+    pub ammo: [u16; 3],
+    /// Ranged attack cooldown.
+    pub cooldown: [u16; 3],
+    /// Facing yaw.
+    pub yaw: [u16; 3],
+    /// Alive status.
+    pub alive: [bool; 3],
+    /// Session terminal at the 26-tick limit.
+    pub terminal: bool,
+    /// Victim respawn timer is constrained across lethal and final idle ticks.
+    pub respawn_ticks: [u32; 3],
+    /// Remaining original deposits, never including earnings.
+    pub reserve: [u64; 3],
+    /// Separately earned rewards.
+    pub earnings: [u64; 3],
+    /// Paid deaths per permanent slot.
+    pub paid_deaths: [u32; 3],
+    /// Total deaths per permanent slot.
+    pub deaths: [u32; 3],
+    /// Kills per permanent slot.
+    pub kills: [u32; 3],
+}
+
+/// Complete fixed research projection, independently checked against arena-core.
+#[must_use]
+pub fn expected_states_v1() -> Vec<KillResearchStateV1> {
+    (0..=TICKS)
+        .map(|tick| {
+            let volleys = if tick == 0 {
+                0
+            } else {
+                ((tick - 1) / 12 + 1).min(3)
+            };
+            let dead = tick >= 25;
+            KillResearchStateV1 {
+                tick: tick as u32,
+                positions: [[18_000, 0, 0], [-18_000, 0, 0], [0, 18_000, 0]],
+                health: [
+                    125,
+                    125,
+                    match volleys {
+                        0 => 125,
+                        1 => 81,
+                        2 => 37,
+                        _ => 0,
+                    },
+                ],
+                stamina: [100; 3],
+                ammo: [24 - volleys as u16, 24 - volleys as u16, 0],
+                cooldown: {
+                    let cd = if tick == 0 {
+                        0
+                    } else {
+                        (12 - ((tick - 1) % 12)) as u16
+                    };
+                    [cd, cd, 0]
+                },
+                yaw: if tick == 0 {
+                    [0; 3]
+                } else {
+                    [24_576, 8_192, 0]
+                },
+                alive: [true, true, !dead],
+                terminal: tick == TICKS,
+                respawn_ticks: [
+                    0,
+                    0,
+                    if tick == 25 {
+                        480
+                    } else if tick == 26 {
+                        479
+                    } else {
+                        0
+                    },
+                ],
+                reserve: [1000, 1000, if dead { 900 } else { 1000 }],
+                earnings: [if dead { 20 } else { 0 }, if dead { 80 } else { 0 }, 0],
+                paid_deaths: [0, 0, u32::from(dead)],
+                deaths: [0, 0, u32::from(dead)],
+                kills: [0, u32::from(dead), 0],
+            }
+        })
+        .collect()
+}
