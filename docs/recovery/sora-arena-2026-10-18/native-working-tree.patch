+
+    #[test]
+    fn forged_targets_occlusion_rays_eligibility_and_selectors_fail_recomputed_constraints() {
+        let graph = ArenaHitAirV1::compile(3, 1, 0).unwrap();
+        let input = fixture(
+            &[
+                [0, 0, 0, 0, 1, 0],
+                [5000, 0, 0, 1, 1, 0],
+                [5000, 0, 0, 1, 1, 0],
+            ],
+            &[[4650, -10, 0, 4700, 10, 1700]],
+        );
+        let fields = input.iter().copied().map(field).collect::<Vec<_>>();
+        let honest = graph.air.field_assignment(&fields, &[]);
+        assert!(accepted(&graph, &honest));
+        let mut outputs = vec![graph.hit, graph.target, graph.fraction, graph.nearest];
+        outputs.extend(graph.direction);
+        outputs.extend(graph.from);
+        outputs.extend(graph.to);
+        outputs.extend(&graph.eligible);
+        for intersection in &graph.intersections {
+            outputs.extend([intersection.hit, intersection.fraction]);
+        }
+        for value in outputs {
+            // Input position columns legitimately vary: parent custody binds them,
+            // so test only their derived from-z and endpoint/direction columns here.
+            if graph.from[..2]
+                .iter()
+                .any(|input| column(*input) == column(value))
+            {
+                continue;
+            }
+            let index = column(value);
+            let forged = graph
+                .air
+                .field_assignment(&fields, &[(index, honest[index].add(F::ONE))]);
+            assert!(!accepted(&graph, &forged), "forged derived column {index}");
+        }
+        for selector in graph
+            .selectors
+            .iter()
+            .chain(graph.intersections.iter().flat_map(|x| x.selectors.iter()))
+        {
+            let row = graph
+                .air
+                .field_assignment(&fields, &[(column(*selector), field(2).inv().unwrap())]);
+            assert!(!accepted(&graph, &row));
+        }
+    }
+
+    #[test]
+    fn input_domains_dead_shooter_and_fixed_dimensions_are_enforced() {
+        for dimensions in [(0, 0, 0), (13, 0, 0), (2, 33, 0), (2, 0, 2)] {
+            assert!(ArenaHitAirV1::compile(dimensions.0, dimensions.1, dimensions.2).is_err());
+        }
+        let graph = ArenaHitAirV1::compile(2, 1, 0).unwrap();
+        let input = fixture(
+            &[[0, 0, 0, 0, 1, 0], [5000, 0, 0, 1, 1, 0]],
+            &[[6000, -10, 0, 6001, 10, 1700]],
+        );
+        for (index, bad) in [
+            (0, 2),
+            (1, 2),
+            (2, 0),
+            (2, MAX_RANGE_MM + 1),
+            (3, 65536),
+            (4, 16385),
+            (5, COORDINATE_LIMIT + 1),
+            (8, 2),
+            (9, 0),
+            (10, -1),
+            (16, 65536),
+            (17, 6002),
+        ] {
+            let mut fields = input.iter().copied().map(field).collect::<Vec<_>>();
+            fields[index] = field(bad);
+            let row = graph.air.field_assignment(&fields, &[]);
+            assert!(!accepted(&graph, &row), "invalid input {index}");
+        }
+        for index in [0, 1, 9, 15] {
+            let mut fields = input.iter().copied().map(field).collect::<Vec<_>>();
+            fields[index] = field(2).inv().unwrap();
+            let row = graph.air.field_assignment(&fields, &[]);
+            assert!(!accepted(&graph, &row));
+        }
+    }
