+//! Focused restoration-history consistency checks for the registered RaceV1 profile.
+
+use iroha_core::{
+    execution_proofs::{
+        initial_game_state_root_v1, race_profile_id_v1, validate_game_input_v1,
+        validate_game_manifest_v1,
+    },
+    smartcontracts::isi::game::{
+        game_custody_account_v1, game_dispute_root_v1, validate_retained_game_history_v1,
+    },
+};
+use iroha_crypto::{Algorithm, Hash, HashOf, KeyPair};
+use iroha_data_model::{
+    NetworkId,
+    account::AccountId,
+    asset::AssetDefinitionId,
+    block::BlockHeader,
+    execution_proofs::RaceTrackV1,
+    game::{
+        GameAccessV1, GameAdmissionBodyV1, GameCheckpointV1, GameForcedBatchV1, GameManifestV1,
+        GameParticipantV1, GamePayoutPolicyV1, GamePhaseV1, GameSessionRecordV1, GameTranscriptV1,
+        SignedGameCheckpointV1, game_message_hash_v1, game_roster_hash_v1,
+    },
+};
+use iroha_model_base::domain::DomainId;
+use iroha_primitives::numeric::Quantity;
+use norito::codec::Encode;
+
+fn key(seed: u8) -> KeyPair {
+    KeyPair::try_from_seed(vec![seed; 32], Algorithm::Ed25519).unwrap()
+}
+
+fn fixture() -> GameSessionRecordV1 {
+    let network = NetworkId::from_genesis_hash(HashOf::<BlockHeader>::from_untyped_unchecked(
+        Hash::new(b"registered-race-history-restore-network"),
+    ));
+    let session_id = Hash::new(b"registered-race-history-restore-session");
+    let manifest = GameManifestV1 {
+        version: 1,
+        application_id: Hash::new(b"registered-race-history-restore"),
+        profile_id: race_profile_id_v1(),
+        application_parameters: RaceTrackV1::NeonTokyo.encode(),
+        min_participants: 2,
+        max_participants: 2,
+        batch_ticks: 6,
+        max_ticks: 5400,
+        max_input_bytes: 12,
+        max_participant_data_bytes: 1,
+        access: GameAccessV1::Public,
+        payout_policy: GamePayoutPolicyV1::NoPayout,
+    };
+    validate_game_manifest_v1(&manifest).unwrap();
+    let participants = (0..2)
+        .map(|slot| GameParticipantV1 {
+            account: AccountId::new(key(slot + 1).public_key().clone()),
+            input_key: key(slot + 65).public_key().clone(),
+            application_data: vec![slot],
+            deposit: Quantity::zero(),
+            dnf_at_tick: None,
+        })
+        .collect::<Vec<_>>();
+    let asset_definition = AssetDefinitionId::derive_from_components(
+        DomainId::try_new("race-restore", "universal").unwrap(),
+        "testxor".parse().unwrap(),
+    );
+    let custody = game_custody_account_v1(&network, &session_id, &asset_definition);
+    let mut session = GameSessionRecordV1 {
+        version: 1,
+        network_id: network.clone(),
+        session_id,
+        manifest_hash: game_message_hash_v1(&network, "session-manifest", &manifest),
+        profile_id: manifest.profile_id,
+        manifest,
+        asset_definition,
+        stake: Quantity::zero(),
+        payout_scale: 0,
+        custody,
+        liability: Quantity::zero(),
+        payout_claims: vec![],
+        item_stakes: vec![],
+        resources: vec![],
+        participants,
+        roster_hash: Hash::new(b"assigned below"),
+        phase: GamePhaseV1::ForcedCommit,
+        revision: 1,
+        epoch: 2,
+        deadline_height: 100,
+        checkpoint: None,
+        pending_certificate: None,
+        next_tick: 12,
+        input_commitments: vec![None; 2],
+        input_reveals: vec![None; 2],
+        transcript_anchors: vec![],
+        forced_batches: vec![
+            GameForcedBatchV1 {
+                epoch: 0,
+                start_tick: 0,
+                inputs: vec![vec![0; 12]; 2],
+                dnf_slots: vec![],
+            },
+            GameForcedBatchV1 {
+                epoch: 1,
+                start_tick: 6,
+                inputs: vec![vec![0; 12]; 2],
+                dnf_slots: vec![],
+            },
+        ],
+        dispute_root: Hash::new(b"assigned below"),
+        verification_id: None,
+        terminal_at_height: None,
+        result: None,
+    };
+    for batch in &session.forced_batches {
+        for input in &batch.inputs {
+            validate_game_input_v1(&session.manifest, input).unwrap();
+        }
+    }
+    let admission = GameAdmissionBodyV1::from_session(&session);
+    admission.validate().unwrap();
+    session.roster_hash = game_roster_hash_v1(&network, &session_id, &admission);
+    let checkpoint = GameCheckpointV1 {
+        session_id,
+        epoch: 0,
+        tick: 0,
+        transcript_root: game_message_hash_v1(
+            &network,
+            "input-transcript",
+            &GameTranscriptV1 {
+                batches: vec![],
+                dnf_events: vec![],
+            },
+        ),
+        state_root: initial_game_state_root_v1(&network, &session.manifest, &admission).unwrap(),
+        terminal: false,
+    };
+    session.checkpoint = Some(SignedGameCheckpointV1 {
+        checkpoint,
+        signatures: vec![],
+    });
+    session.dispute_root = game_dispute_root_v1(&session);
+    session
+}
+
+#[test]
+fn valid_registered_race_history_and_native_dnf_restore_shape() {
+    let valid = fixture();
+    validate_retained_game_history_v1(&valid).unwrap();
+    let mut dnf = valid;
+    dnf.participants[1].dnf_at_tick = Some(6);
+    dnf.forced_batches[1].inputs[1].clear();
+    dnf.forced_batches[1].dnf_slots = vec![1];
+    dnf.phase = GamePhaseV1::AwaitingProof;
+    dnf.dispute_root = game_dispute_root_v1(&dnf);
+    validate_retained_game_history_v1(&dnf).unwrap();
+}
+
+#[test]
+fn malformed_history_fails_even_when_dispute_root_is_recomputed() {
+    let valid = fixture();
+    let check = |mut changed: GameSessionRecordV1| {
+        changed.dispute_root = game_dispute_root_v1(&changed);
+        assert!(validate_retained_game_history_v1(&changed).is_err());
+    };
+    let mut bad = valid.clone();
+    bad.epoch = 3;
+    check(bad);
+    let mut bad = valid.clone();
+    bad.forced_batches[1].epoch = 0;
+    check(bad);
+    let mut bad = valid.clone();
+    bad.forced_batches.swap(0, 1);
+    check(bad);
+    let mut bad = valid.clone();
+    bad.forced_batches[1].start_tick = 5;
+    check(bad);
+    let mut bad = valid.clone();
+    bad.forced_batches[1].start_tick = 0;
+    check(bad);
+    let mut bad = valid.clone();
+    bad.forced_batches[1].inputs.pop();
+    check(bad);
+    let mut bad = valid.clone();
+    bad.forced_batches[1].inputs[0].push(0);
+    check(bad);
+    let mut bad = valid.clone();
+    bad.next_tick = 6;
+    check(bad);
+    let mut bad = valid.clone();
+    bad.next_tick = 18;
+    check(bad);
+    let mut bad = valid.clone();
+    bad.checkpoint = None;
+    check(bad);
+    let mut bad = valid.clone();
+    bad.participants[1].dnf_at_tick = Some(6);
+    check(bad);
+    let mut bad = valid.clone();
+    bad.forced_batches[1].dnf_slots = vec![1];
+    check(bad);
+    let mut bad = valid.clone();
+    bad.participants[1].dnf_at_tick = Some(6);
+    bad.forced_batches[1].dnf_slots = vec![1];
+    check(bad); // removed slot still supplied controls
+    let mut bad = valid.clone();
+    bad.checkpoint.as_mut().unwrap().checkpoint.tick = 18;
+    check(bad);
+    let mut bad = valid.clone();
+    bad.dispute_root = Hash::new(b"stale-dispute-root");
+    assert!(validate_retained_game_history_v1(&bad).is_err());
+}
