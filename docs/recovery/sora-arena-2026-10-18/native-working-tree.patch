+//! Unregistered two-tick Arena movement-to-kill STARK research.
+//!
+//! A deliberately fixed checkpoint places an Arc-carbine shooter at (0,0), a
+//! 22-health target at (2000,0), and a blocking cat at (1000,350). The blocker
+//! can sidestep on the first signed tick. Native AIR derives the exact cardinal
+//! movement quotient, closed-body y intersection, hit target, damage, death,
+//! reserve loss and credit. The fixed x/z ordering and map-wall clearance are
+//! scene premises, not general collision AIR. The checkpoint is not selected
+//! from a ledger, so this proof never authorizes a payout.
+
+use super::{
+    arena_kill_history_research::{P2PCertifiedBatchV2, P2PContextV2},
+    checked_integer_air::bounded_input_v1,
+    integer_air::{IntegerAirV1, Value, field},
+    registry::compiled_execution_profile_v1,
+    stark::{
+        aggregate_stark::{
+            AggregateProofLayoutV1, AggregateStarkDomainsV1, AggregateStarkParametersV1,
+            AggregateTraceGroupLayoutV1, maximum_encoded_proof_with_deep_bytes_v1,
+        },
+        proof_managed_note_stark::{
+            NOTE_COPY_AUX_WIDTH_V1, NOTE_COPY_FIXED_WIDTH_V1, NOTE_COPY_WIDTH_V1,
+            NoteCopyCellPolicyV1, NoteCopyChallengesV1, NoteCopyScheduleV1,
+            ProofManagedNoteStarkAdapterV1, ProofManagedNoteStarkErrorV1 as NativeError,
+            ProofManagedNoteStarkProtocolV1, prove_proof_managed_note_stark_v1,
+            verify_proof_managed_note_stark_v1,
+        },
+        transparent_stark::{
+            GoldilocksDigest384V1, GoldilocksFieldV1 as F, TransparentStarkDigestContextV1,
+            TransparentTranscriptV1, goldilocks_digest384_frame_v1,
+        },
+    },
+};
+use iroha_crypto::{Hash, HashOf};
+use iroha_data_model::{
+    NetworkId,
+    block::BlockHeader,
+    game::{
+        GameAccessV1, GameAdmissionBodyV1, GameForcedBatchV1, GameManifestV1, GameOutcomeV1,
+        GamePayoutAllocationV1, GamePayoutPolicyV1, GameTranscriptBatchV1, GameTranscriptV1,
+        game_message_hash_v1,
+    },
+};
+use iroha_primitives::numeric::Quantity;
+use norito::codec::Encode;
+use sha2::{Digest, Sha256};
+
+const TRACE_LOG: u8 = 13;
+const TRACE_SIZE: usize = 1 << TRACE_LOG;
+const MAX_PROOF_BYTES: usize = 4 * 1024 * 1024;
+const INPUT_COUNT: usize = 8;
+const MOVE: usize = 0;
+const MOVED_Y: usize = 1;
+const TARGET: usize = 2;
+const HEALTH1: usize = 3;
+const HEALTH2: usize = 4;
+const RESERVE1: usize = 5;
+const EARN0: usize = 6;
+const RESPAWN1: usize = 7;
+const RULES: &[u8] = b"arena-moved-kill-research-v1:two-tick-signed-prefix:three-samurai-ffa:map0:fixed-checkpoint:x=0,2000,1000:y=0,0,350:z=0:hp=125,22,125:unprotected:carbine22-range45000:slot2-cardinal-y-sidestep0..127:shot-slot0-yaw0-tick0:tick1-idle:ordered-body-x:wall-clear-before-target:death-tranche100:no-ledger-checkpoint:no-settlement";
+const DESCRIPTOR: &[u8] = b"unregistered-arena-moved-kill-research-v1:one-closed-scene:two-signed-ticks:movement-hit-damage-reserve-credit-air:no-general-geometry:no-ledger-selection:no-settlement";
+const CONTEXT: TransparentStarkDigestContextV1 =
+    TransparentStarkDigestContextV1::execution_v1(b"arena-moved-kill-research-v1");
+const DOMAINS: AggregateStarkDomainsV1 = AggregateStarkDomainsV1 {
+    digest_context: CONTEXT,
+    base_leaf: b"arena-moved-kill-base-leaf-v1",
+    base_node: b"arena-moved-kill-base-node-v1",
+    aux_leaf: b"arena-moved-kill-aux-leaf-v1",
+    aux_node: b"arena-moved-kill-aux-node-v1",
+    composition_leaf: b"arena-moved-kill-composition-leaf-v1",
+    composition_node: b"arena-moved-kill-composition-node-v1",
+    fri_leaf: b"arena-moved-kill-fri-leaf-v1",
+    fri_node: b"arena-moved-kill-fri-node-v1",
+    layout_label: b"arena-moved-kill-layout-v1",
+    base_root_label: b"arena-moved-kill-base-root-v1",
+    aux_root_label: b"arena-moved-kill-aux-root-v1",
+    composition_root_label: b"arena-moved-kill-composition-root-v1",
+    fri_root_label: b"arena-moved-kill-fri-root-v1",
+    fri_beta_label: b"arena-moved-kill-fri-beta-v1",
+    query_seed: b"arena-moved-kill-query-seed-v1",
+};
+
+/// Exact unregistered research profile identity.
+#[must_use]
+pub fn research_profile_id_v1() -> Hash {
+    Hash::new(DESCRIPTOR)
+}
+
+/// Immutable two-tick, three-participant research manifest.
+#[must_use]
+pub fn research_manifest_v1() -> GameManifestV1 {
+    GameManifestV1 {
+        version: 1,
+        application_id: Hash::new(b"sora-arena-moved-kill-research-v1"),
+        profile_id: research_profile_id_v1(),
+        application_parameters: vec![0, 1],
+        min_participants: 3,
+        max_participants: 3,
+        batch_ticks: 2,
+        max_ticks: 2,
+        max_input_bytes: 16,
+        max_participant_data_bytes: 3,
+        access: GameAccessV1::Public,
+        payout_policy: GamePayoutPolicyV1::VerifiedAllocations,
+    }
+}
+
+/// Hash of this manually restricted scene; it is not the full game kernel.
+#[must_use]
+pub fn research_rules_hash_v1() -> Hash {
+    Hash::new(RULES)
+}
+
+/// Public, signed, research-only continuation and claimed outputs.
+#[derive(Debug, Clone, Encode)]
+pub struct ArenaMovedKillStatementV1 {
+    /// Isolated network identity.
+    pub network_id: NetworkId,
+    /// Research session identity.
+    pub session_id: Hash,
+    /// Unregistered manifest.
+    pub manifest: GameManifestV1,
+    /// Three immutable accounts, input keys and 1,000-unit deposits.
+    pub admission: GameAdmissionBodyV1,
+    /// Manual restricted rules identity.
+    pub rules_hash: Hash,
+    /// Opaque research checkpoint commitment; not authenticated by consensus.
+    pub checkpoint_root: Hash,
+    /// One jointly signed two-tick P2P commitment and reveal set.
+    pub signed_batch: P2PCertifiedBatchV2,
+    /// Caller-projected native batch; this is not ledger selected.
+    pub native_batch: GameForcedBatchV1,
+    /// Game P2P rolling root after the signed batch.
+    pub p2p_root: [u8; 32],
+    /// Native input-transcript root over the same controls.
+    pub transcript_root: Hash,
+    /// Claimed blocker position after its first movement.
+    pub moved_y: i64,
+    /// Claimed selected victim slot, either one or two.
+    pub target: i64,
+    /// Claimed slot-one health after the shot and idle tick.
+    pub health1: i64,
+    /// Claimed slot-two health after the shot and idle tick.
+    pub health2: i64,
+    /// Claimed slot-one original-bond reserve.
+    pub reserve1: i64,
+    /// Claimed slot-zero earned credit, separate from its original bond.
+    pub earn0: i64,
+    /// Claimed slot-one respawn timer after the idle tick.
+    pub respawn1: i64,
+    /// Terminal allocation vector derived from the proved reserve and credit.
+    pub outcome: GameOutcomeV1,
+}
+
+impl ArenaMovedKillStatementV1 {
+    fn move_axis(&self) -> Result<i64, String> {
+        if self.network_id
+            != NetworkId::from_genesis_hash(HashOf::<BlockHeader>::from_untyped_unchecked(
+                Hash::new(b"arena-moved-kill-isolated-research-network"),
+            ))
+            || self.session_id != Hash::new(b"arena-moved-kill-unfunded-research-session")
+            || self.manifest != research_manifest_v1()
+            || self.rules_hash != research_rules_hash_v1()
+            || compiled_execution_profile_v1(&self.manifest.profile_id).is_some()
+            || self.checkpoint_root
+                != Hash::new(b"arena-moved-kill-research-unselected-checkpoint-v1")
+        {
+            return Err("research manifest, rules or fixed checkpoint changed".into());
+        }
+        self.admission.validate().map_err(|e| e.to_string())?;
+        if self.admission.participants.len() != 3
+            || !self.admission.wagers.is_empty()
+            || !self.admission.resources.is_empty()
+            || self
+                .admission
+                .participants
+                .iter()
+                .enumerate()
+                .any(|(slot, p)| {
+                    p.deposit != Quantity::from(1000_u32)
+                        || p.application_data.as_slice() != [0, 0, u8::from(slot == 0)].as_slice()
+                })
+        {
+            return Err("research admission differs from exact three-slot checkpoint".into());
+        }
+        let context = P2PContextV2::from_admission(
+            &self.network_id,
+            self.session_id,
+            &self.manifest,
+            &self.admission,
+        )?;
+        let set = &self.signed_batch.set;
+        if set.epoch != 0
+            || set.start_tick != 0
+            || set.parent != context.genesis_root()
+            || set.commitments.len() != 3
+            || self.signed_batch.signatures.len() != 3
+            || self.signed_batch.reveals.len() != 3
+        {
+            return Err("research batch is incomplete or has the wrong parent".into());
+        }
+        let digest = context.set_digest(set)?;
+        for slot in 0..3 {
+            let signature = &self.signed_batch.signatures[slot];
+            let reveal = &self.signed_batch.reveals[slot];
+            if usize::from(signature.slot) != slot
+                || usize::from(reveal.slot) != slot
+                || signature
+                    .signature
+                    .verify(&self.admission.participants[slot].input_key, &digest)
+                    .is_err()
+                || context.input_commitment(set, reveal)? != set.commitments[slot]
+            {
+                return Err("signed control or salted reveal is invalid".into());
+            }
+        }
+        if self.p2p_root != context.next_root(set.parent, &self.signed_batch)?
+            || self.native_batch.epoch != 0
+            || self.native_batch.start_tick != 0
+            || !self.native_batch.dnf_slots.is_empty()
+            || self.native_batch.inputs
+                != self
+                    .signed_batch
+                    .reveals
+                    .iter()
+                    .map(|r| r.payload.to_vec())
+                    .collect::<Vec<_>>()
+        {
+            return Err("P2P and native research batches differ".into());
+        }
+        let transcript = GameTranscriptV1 {
+            batches: vec![GameTranscriptBatchV1 {
+                start_tick: 0,
+                inputs: self.native_batch.inputs.clone(),
+            }],
+            dnf_events: Vec::new(),
+        };
+        if self.transcript_root
+            != game_message_hash_v1(&self.network_id, "input-transcript", &transcript)
+        {
+            return Err("native transcript hash differs from signed controls".into());
+        }
+        // TODO(ArenaV1): Replace this fixed scene and manually chosen checkpoint
+        // with a ledger-selected full-state relation before profile registration.
+        // These fixed controls are the declared closed scene. Only the
+        // blocker's first cardinal forward amount varies and is AIR-proved.
+        let shooter = &self.signed_batch.reveals[0].payload;
+        let victim = &self.signed_batch.reveals[1].payload;
+        let blocker = &self.signed_batch.reveals[2].payload;
+        if shooter[..8] != [1, 0, 0, 0, 0, 0, 0, 0]
+            || shooter[8..] != [0; 8]
+            || *victim != [0; 16]
+            || blocker[0..2] != [0; 2]
+            || blocker[3] != 0
+            || blocker[4..8] != [0, 64, 0, 0]
+            || blocker[8..] != [0, 0, 0, 0, 0, 64, 0, 0]
+            || (blocker[2] as i8) < 0
+        {
+            return Err("signed controls leave the restricted two-tick scene".into());
+        }
+        Ok(i64::from(blocker[2]))
+    }
+
+    /// Check signatures, exact native projection, fixed scene and outcome shape.
+    /// Arithmetic claims are independently constrained by the native AIR.
+    pub fn validate(&self) -> Result<(), String> {
+        let _ = self.move_axis()?;
+        if !(0..=100).contains(&self.earn0) || !(900..=1000).contains(&self.reserve1) {
+            return Err("claimed reserve or credit is outside the research domain".into());
+        }
+        if self.outcome.terminal_tick != 2
+            || !self.outcome.winner_slots.is_empty()
+            || !self.outcome.result.is_empty()
+            || self.outcome.allocations
+                != vec![
+                    GamePayoutAllocationV1 {
+                        slot: 0,
+                        amount: Quantity::from(1000_u32 + self.earn0 as u32),
+                    },
+                    GamePayoutAllocationV1 {
+                        slot: 1,
+                        amount: Quantity::from(self.reserve1 as u32),
+                    },
+                    GamePayoutAllocationV1 {
+                        slot: 2,
+                        amount: Quantity::from(1000_u32),
+                    },
+                ]
+        {
+            return Err("outcome differs from claimed terminal reserve and credit".into());
+        }
+        Ok(())
+    }
+
+    fn row(&self) -> Result<[i64; INPUT_COUNT], String> {
+        Ok([
+            self.move_axis()?,
+            self.moved_y,
+            self.target,
+            self.health1,
+            self.health2,
+            self.reserve1,
+            self.earn0,
+            self.respawn1,
+        ])
+    }
+}
+
+struct MovedKillAirV1 {
+    air: IntegerAirV1,
+    inputs: [Value; INPUT_COUNT],
+}
+
+impl MovedKillAirV1 {
+    fn compile() -> Self {
+        let mut air = IntegerAirV1::default();
+        let bounds = [
+            (0, 127),
+            (350, 430),
+            (1, 2),
+            (0, 22),
+            (103, 125),
+            (900, 1000),
+            (0, 100),
+            (0, 479),
+        ];
+        let inputs = std::array::from_fn(|index| {
+            let (low, high) = bounds[index];
+            bounded_input_v1(&mut air, low, high).expect("closed moved-kill input")
+        });
+        // The exact cardinal +Y Samurai step is trunc(move_x * 80 / 127).
+        // Both signed ticks are included: the second has zero movement.
+        let speed = air.mul_constant(inputs[MOVE], 80);
+        let step = air.divide(speed, 127);
+        let next_y = air.add_constant(step, 350);
+        air.equate(inputs[MOVED_Y], next_y);
+        // The ray travels along +X at y=0. The blocker body spans y-350..y+350;
+        // exact inclusive AABB contact at y=350 blocks slot one. Fixed x/z
+        // ordering and absence of an earlier map wall are scene premises.
+        let clear = air.less(Value::constant(350), inputs[MOVED_Y]);
+        let selected = air.sub(Value::constant(2), clear);
+        air.equate(inputs[TARGET], selected);
+        let damage1 = air.mul_constant(clear, 22);
+        let blocked = air.not(clear);
+        let damage2 = air.mul_constant(blocked, 22);
+        let health1 = air.sub(Value::constant(22), damage1);
+        let health2 = air.sub(Value::constant(125), damage2);
+        air.equate(inputs[HEALTH1], health1);
+        air.equate(inputs[HEALTH2], health2);
+        // One full-health blocker survives; the 22-health slot-one target dies
+        // exactly when clear. An idle second tick decrements its respawn 480→479.
+        let reward = air.mul_constant(clear, 100);
+        let reserve = air.sub(Value::constant(1000), reward);
+        air.equate(inputs[RESERVE1], reserve);
+        air.equate(inputs[EARN0], reward);
+        let respawn = air.mul_constant(clear, 479);
+        air.equate(inputs[RESPAWN1], respawn);
+        let conserved = air.add(inputs[RESERVE1], inputs[EARN0]);
+        air.equate(conserved, Value::constant(1000));
+        for (index, input) in inputs.iter().copied().enumerate() {
+            air.equate(input, Value::fixed(index, input.low, input.high));
+        }
+        Self { air, inputs }
+    }
+}
+
+struct Adapter {
+    statement: ArenaMovedKillStatementV1,
+    graph: MovedKillAirV1,
+}
+
+impl Adapter {
+    fn new(statement: ArenaMovedKillStatementV1) -> Result<Self, String> {
+        statement.validate()?;
+        let graph = MovedKillAirV1::compile();
+        let row = statement.row()?;
+        if graph
+            .inputs
+            .iter()
+            .zip(row)
+            .any(|(v, n)| !(v.low..=v.high).contains(&n))
+        {
+            return Err("moved-kill public claim exceeds its integer domain".into());
+        }
+        Ok(Self { statement, graph })
+    }
+
+    fn columns(&self) -> Vec<Vec<F>> {
+        let row = self.graph.air.witness(
+            &self.statement.row().expect("validated row"),
+            &self.statement.row().expect("validated row"),
+        );
+        let mut columns = vec![vec![F::ZERO; TRACE_SIZE]; NOTE_COPY_WIDTH_V1];
+        columns.extend(row.into_iter().map(|value| vec![field(value); TRACE_SIZE]));
+        columns
+    }
+}
+
+impl ProofManagedNoteStarkAdapterV1 for Adapter {
+    type ProfileChallenges = ();
+
+    fn protocol_v1(&self) -> ProofManagedNoteStarkProtocolV1 {
+        ProofManagedNoteStarkProtocolV1 {
+            parameters: AggregateStarkParametersV1 {
+                proof_magic: *b"AMK1",
+                proof_version: 1,
+                security_lanes: 1,
+                query_count: 136,
+                blowup_log2: 3,
+                terminal_log2: 10,
+                terminal_degree_bound: 143,
+                composition_degree_chunks: 4,
+                minimum_trace_log2: TRACE_LOG,
+                maximum_trace_log2: TRACE_LOG,
+                maximum_trace_groups: 1,
+                maximum_segment_instances: 1,
+                maximum_base_columns_per_instance: self.base_width_v1(),
+                maximum_aux_columns_per_instance: NOTE_COPY_AUX_WIDTH_V1,
+                maximum_proof_bytes: MAX_PROOF_BYTES,
+            },
+            domains: DOMAINS,
+            maximum_constraint_degree: 4,
+            profile_binding_label: b"arena-moved-kill-profile-binding-v1",
+            profile_descriptor: DESCRIPTOR,
+            relation_layout_domain: b"arena-moved-kill-relation-layout-v1",
+        }
+    }
+
+    fn public_input_digest_v1(&self) -> Result<GoldilocksDigest384V1, NativeError> {
+        let statement = self.statement.encode();
+        let mut sources = Sha256::new();
+        for source in [
+            include_bytes!("arena_moved_kill_research.rs").as_slice(),
+            include_bytes!("arena_kill_history_research.rs").as_slice(),
+            include_bytes!("checked_integer_air.rs").as_slice(),
+            include_bytes!("integer_air.rs").as_slice(),
+        ] {
+            sources.update((source.len() as u64).to_le_bytes());
+            sources.update(source);
+        }
+        goldilocks_digest384_frame_v1(
+            CONTEXT,
+            b"arena-moved-kill-statement-v1",
+            b"statement",
+            0,
+            0,
+            0,
+            &[&sources.finalize(), &statement],
+        )
+        .map_err(|_| NativeError::InvalidProfile)
+    }
+
+    fn trace_log2_v1(&self) -> u8 {
+        TRACE_LOG
+    }
+    fn base_width_v1(&self) -> usize {
+        self.graph.air.width() + NOTE_COPY_WIDTH_V1
+    }
+    fn profile_aux_width_v1(&self) -> usize {
+        0
+    }
+    fn profile_fixed_width_v1(&self) -> usize {
+        INPUT_COUNT
+    }
+    fn profile_constraint_count_v1(&self) -> usize {
+        self.graph.air.constraint_count()
+    }
+
+    fn copy_schedule_v1(&self) -> Result<NoteCopyScheduleV1, NativeError> {
+        Ok(NoteCopyScheduleV1 {
+            policies: vec![[NoteCopyCellPolicyV1::Inactive; NOTE_COPY_WIDTH_V1]; TRACE_SIZE],
+            sigma: (0..TRACE_SIZE)
+                .map(|row| std::array::from_fn(|col| (row * NOTE_COPY_WIDTH_V1 + col + 1) as u32))
+                .collect(),
+        })
+    }
+    fn profile_fixed_columns_v1(&self) -> Result<Vec<Vec<F>>, NativeError> {
+        Ok(self
+            .statement
+            .row()
+            .map_err(|_| NativeError::InvalidTrace)?
+            .into_iter()
+            .map(|value| vec![field(value); TRACE_SIZE])
+            .collect())
+    }
+    fn derive_profile_challenges_v1(
+        &self,
+        _: &mut TransparentTranscriptV1,
+        _: NoteCopyChallengesV1,
+    ) -> Result<(), NativeError> {
+        Ok(())
+    }
+    fn build_profile_aux_columns_v1(
+        &self,
+        _: &[Vec<F>],
+        _: &[Vec<F>],
+        _: &[Vec<F>],
+        _: NoteCopyChallengesV1,
+        _: &(),
+    ) -> Result<Vec<Vec<F>>, NativeError> {
+        Ok(Vec::new())
+    }
+    fn profile_constraint_residues_v1(
+        &self,
+        current: &[F],
+        next: &[F],
+        _: &[F],
+        _: &[F],
+        fixed: &[F],
+        _: NoteCopyChallengesV1,
+        _: &(),
+    ) -> Result<Vec<F>, NativeError> {
+        Ok(self.graph.air.residues(
+            &current[NOTE_COPY_WIDTH_V1..],
+            &next[NOTE_COPY_WIDTH_V1..],
+            &fixed[NOTE_COPY_FIXED_WIDTH_V1..],
+        ))
+    }
+}
+
+/// Compile the exact bounded relation and its conservative native wire maximum.
+pub fn research_geometry_v1(
+    statement: ArenaMovedKillStatementV1,
+) -> Result<(usize, usize, usize), String> {
+    let adapter = Adapter::new(statement)?;
+    let protocol = adapter.protocol_v1();
+    protocol.validate().map_err(|e| e.to_string())?;
+    let layout = AggregateProofLayoutV1::new(
+        protocol.parameters,
+        vec![AggregateTraceGroupLayoutV1 {
+            native_trace_log2: TRACE_LOG,
+            segment_instances: 1,
+            base_width: adapter.base_width_v1(),
+            aux_width: NOTE_COPY_AUX_WIDTH_V1,
+        }],
+    )
+    .map_err(|e| e.to_string())?;
+    let maximum = maximum_encoded_proof_with_deep_bytes_v1(protocol.parameters, &layout)
+        .map_err(|e| e.to_string())?;
+    if maximum > MAX_PROOF_BYTES {
+        return Err("moved-kill native proof exceeds the enforced wire cap".into());
+    }
+    Ok((
+        adapter.graph.air.width(),
+        adapter.graph.air.constraint_count(),
+        maximum,
+    ))
+}
+
+/// Return failing native AIR equation indexes for the claimed public transition.
+/// This diagnostic is a preflight, never a substitute for a STARK verifier.
+pub fn research_air_residue_failures_v1(
+    statement: ArenaMovedKillStatementV1,
+) -> Result<Vec<usize>, String> {
+    let adapter = Adapter::new(statement)?;
+    let row = adapter.statement.row()?;
+    let witness = adapter
+        .graph
+        .air
+        .witness(&row, &row)
+        .into_iter()
+        .map(field)
+        .collect::<Vec<_>>();
+    Ok(adapter
+        .graph
+        .air
+        .residues(&witness, &witness, &row.map(field))
+        .into_iter()
+        .enumerate()
+        .filter_map(|(index, residue)| (residue != F::ZERO).then_some(index))
+        .collect())
+}
+
+/// Generate an unregistered native proof of this restricted signed scene.
+pub fn prove_research_moved_kill_v1(
+    statement: ArenaMovedKillStatementV1,
+) -> Result<Vec<u8>, String> {
+    if !research_air_residue_failures_v1(statement.clone())?.is_empty() {
+        return Err("moved-kill claimed transition violates the AIR".into());
+    }
+    research_geometry_v1(statement.clone())?;
+    let adapter = Adapter::new(statement)?;
+    prove_proof_managed_note_stark_v1(&adapter, &adapter.columns()).map_err(|e| e.to_string())
+}
+
+/// Verify the signed scene and native arithmetic proof without touching custody.
+pub fn verify_research_moved_kill_v1(
+    statement: ArenaMovedKillStatementV1,
+    proof: &[u8],
+) -> Result<(), String> {
+    if proof.len() > MAX_PROOF_BYTES {
+        return Err("moved-kill proof exceeds the wire cap".into());
+    }
+    let adapter = Adapter::new(statement)?;
+    verify_proof_managed_note_stark_v1(&adapter, proof).map_err(|e| e.to_string())
+}
