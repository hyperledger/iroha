+impl ProofManagedNoteStarkAdapterV1 for Adapter<'_> {
+    type ProfileChallenges = ();
+    fn protocol_v1(&self) -> ProofManagedNoteStarkProtocolV1 {
+        ProofManagedNoteStarkProtocolV1 {
+            parameters: AggregateStarkParametersV1 {
+                proof_magic: *b"ASH1",
+                proof_version: 1,
+                security_lanes: 1,
+                query_count: 136,
+                blowup_log2: 3,
+                terminal_log2: 10,
+                terminal_degree_bound: 143,
+                composition_degree_chunks: 4,
+                minimum_trace_log2: TRACE_LOG,
+                maximum_trace_log2: TRACE_LOG,
+                maximum_trace_groups: 1,
+                maximum_segment_instances: 1,
+                maximum_base_columns_per_instance: self.base_width_v1(),
+                maximum_aux_columns_per_instance: NOTE_COPY_AUX_WIDTH_V1,
+                maximum_proof_bytes: MAX_PROOF_BYTES,
+            },
+            domains: DOMAINS,
+            maximum_constraint_degree: 4,
+            profile_binding_label: b"arena-staged-hit-profile-binding-v1",
+            profile_descriptor: DESCRIPTOR,
+            relation_layout_domain: b"arena-staged-hit-relation-layout-v1",
+        }
+    }
+    fn public_input_digest_v1(&self) -> Result<GoldilocksDigest384V1, Error> {
+        let mut values = Vec::new();
+        // Explicit lengths prevent ambiguous splits of the ordered candidate vectors.
+        for value in [
+            self.attacker,
+            self.snapshot.players.len(),
+            self.snapshot.walls.len(),
+            self.snapshot.entities.len(),
+        ] {
+            values.extend_from_slice(&(value as u64).to_le_bytes());
+        }
+        for value in self.snapshot.values() {
+            values.extend_from_slice(&value.to_le_bytes());
+        }
+        for value in [
+            i64::from(self.expected.kind),
+            i64::from(self.expected.identity),
+            self.expected.fraction_q20,
+        ] {
+            values.extend_from_slice(&value.to_le_bytes());
+        }
+        goldilocks_digest384_frame_v1(
+            CONTEXT,
+            b"arena-staged-hit-public-statement-v1",
+            b"statement",
+            0,
+            0,
+            0,
+            &[&staged_hit_source_digest_v1(), &values],
+        )
+        .map_err(|_| Error::InvalidProfile)
+    }
+    fn trace_log2_v1(&self) -> u8 {
+        TRACE_LOG
+    }
+    fn base_width_v1(&self) -> usize {
+        NOTE_COPY_WIDTH_V1 + self.compiled.width()
+    }
+    fn profile_aux_width_v1(&self) -> usize {
+        0
+    }
+    fn profile_fixed_width_v1(&self) -> usize {
+        self.compiled.fixed_width()
+    }
+    fn profile_constraint_count_v1(&self) -> usize {
+        self.compiled.constraint_count()
+    }
+    fn copy_schedule_v1(&self) -> Result<NoteCopyScheduleV1, Error> {
+        Ok(NoteCopyScheduleV1 {
+            policies: vec![[NoteCopyCellPolicyV1::Inactive; NOTE_COPY_WIDTH_V1]; TRACE_SIZE],
+            sigma: (0..TRACE_SIZE)
+                .map(|row| {
+                    std::array::from_fn(|column| (row * NOTE_COPY_WIDTH_V1 + column + 1) as u32)
+                })
+                .collect(),
+        })
+    }
+    fn profile_fixed_columns_v1(&self) -> Result<Vec<Vec<F>>, Error> {
+        let mut columns = vec![Vec::with_capacity(TRACE_SIZE); self.compiled.fixed_width()];
+        for row in 0..TRACE_SIZE {
+            let values = self
+                .compiled
+                .fixed_row(self.snapshot, self.expected, row, TRACE_SIZE)
+                .map_err(|_| Error::InvalidTrace)?;
+            for (column, value) in columns.iter_mut().zip(values) {
+                column.push(value);
+            }
+        }
+        Ok(columns)
+    }
+    fn derive_profile_challenges_v1(
+        &self,
+        _: &mut TransparentTranscriptV1,
+        _: NoteCopyChallengesV1,
+    ) -> Result<(), Error> {
+        Ok(())
+    }
+    fn build_profile_aux_columns_v1(
+        &self,
+        _: &[Vec<F>],
+        _: &[Vec<F>],
+        _: &[Vec<F>],
+        _: NoteCopyChallengesV1,
+        _: &(),
+    ) -> Result<Vec<Vec<F>>, Error> {
+        Ok(vec![])
+    }
+    fn profile_constraint_residues_v1(
+        &self,
+        current: &[F],
+        next: &[F],
+        _: &[F],
+        _: &[F],
+        fixed: &[F],
+        _: NoteCopyChallengesV1,
+        _: &(),
+    ) -> Result<Vec<F>, Error> {
+        self.compiled
+            .residues(
+                &current[NOTE_COPY_WIDTH_V1..],
+                &next[NOTE_COPY_WIDTH_V1..],
+                &fixed[NOTE_COPY_FIXED_WIDTH_V1..],
+            )
+            .map_err(|_| Error::InvalidTrace)
+    }
+}
