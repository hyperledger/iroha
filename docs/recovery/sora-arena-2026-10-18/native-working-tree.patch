+                let forged = graph
+                    .air
+                    .field_assignment(&inputs, &[(column(*selector), field(2).inv().unwrap())]);
+                assert!(!valid(&graph, &forged), "fractional selector");
+            }
+        }
+    }
+
+    #[test]
+    fn coordinate_ranges_and_box_order_reject_even_with_recomputed_field_auxiliaries() {
+        let graph = ArenaGeometryAirV1::compile();
+        let input = [0, 40, 10, 20, 0, 0, -2, 2, 0, 0, -2, 2].map(field);
+        for index in 0..12 {
+            for bad in [
+                field(-COORDINATE_LIMIT - 1),
+                field(COORDINATE_LIMIT + 1),
+                field(2).inv().unwrap(),
+            ] {
+                let mut forged = input;
+                forged[index] = bad;
+                let row = graph.air.field_assignment(&forged, &[]);
+                assert!(!valid(&graph, &row), "range {index}");
+            }
+        }
+        for axis in 0..3 {
+            let mut reversed = input;
+            reversed.swap(axis * 4 + 2, axis * 4 + 3);
+            let row = graph.air.field_assignment(&reversed, &[]);
+            assert!(!valid(&graph, &row), "reversed box {axis}");
+        }
+    }
