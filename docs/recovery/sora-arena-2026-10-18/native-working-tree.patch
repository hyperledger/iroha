+/// Admit the complete native JSON shape, including every optional field, without silently
+/// discarding unknown keys or accepting an alternate spelling of a monetary term.
+fn exact_detached_json<T: norito::json::JsonDeserialize + norito::json::JsonSerialize>(
+    value: &JsonValue,
+) -> BridgeResult<T> {
+    let decoded: T = norito::json::from_value(value.clone())
+        .map_err(|_| BridgeError::DetachedTransactionScaffold)?;
+    let canonical =
+        norito::json::to_value(&decoded).map_err(|_| BridgeError::DetachedTransactionScaffold)?;
+    if canonical != *value {
+        return Err(BridgeError::DetachedTransactionScaffold);
+    }
+    Ok(decoded)
+}
+fn native_wallet_instruction_from_json(value: &JsonValue) -> BridgeResult<InstructionBox> {
+    let object = value
+        .as_object()
+        .ok_or(BridgeError::DetachedTransactionScaffold)?;
+    if object.len() != 2 {
+        return Err(BridgeError::DetachedTransactionScaffold);
+    }
+    let name = object
+        .get("name")
+        .and_then(JsonValue::as_str)
+        .ok_or(BridgeError::DetachedTransactionScaffold)?;
+    let terms = object
+        .get("value")
+        .ok_or(BridgeError::DetachedTransactionScaffold)?;
+    macro_rules! decode_native {
+        ($($name:literal => $ty:path),+ $(,)?) => {
+            match name {
+                $($name => Ok(exact_detached_json::<$ty>(terms)?.into()),)+
+                _ => Err(BridgeError::DetachedTransactionScaffold),
+            }
+        };
+    }
+    decode_native! {
+        "OpenGameSessionV1" => iroha_data_model::isi::game::OpenGameSessionV1,
+        "JoinGameSessionV1" => iroha_data_model::isi::game::JoinGameSessionV1,
+        "ClaimGamePayoutV1" => iroha_data_model::isi::game::ClaimGamePayoutV1,
+        "StakeGameItemV1" => iroha_data_model::isi::game::StakeGameItemV1,
+        "OfferNftV1" => iroha_data_model::isi::nft_market::OfferNftV1,
+        "BuyNftV1" => iroha_data_model::isi::nft_market::BuyNftV1,
+        "CancelNftOfferV1" => iroha_data_model::isi::nft_market::CancelNftOfferV1,
+    }
+}
+fn build_native_detached_transaction_scaffold(bytes: &[u8]) -> BridgeResult<(Vec<u8>, Vec<u8>)> {
+    if bytes.is_empty() || bytes.len() > DETACHED_TRANSACTION_JSON_MAX_BYTES {
+        return Err(BridgeError::DetachedTransactionScaffold);
+    }
+    let value = norito::json::from_slice_value(bytes)
+        .map_err(|_| BridgeError::DetachedTransactionScaffold)?;
+    let object = value
+        .as_object()
+        .ok_or(BridgeError::DetachedTransactionScaffold)?;
+    if object.len() != 6 {
+        return Err(BridgeError::DetachedTransactionScaffold);
+    }
+    let field = |name| {
+        object
+            .get(name)
+            .ok_or(BridgeError::DetachedTransactionScaffold)
+    };
+    let network_id: NetworkId = exact_detached_json(field("network_id")?)?;
+    let authority: AccountId = exact_detached_json(field("authority")?)?;
+    let fee_payment: FeePaymentIntent = exact_detached_json(field("fee_payment")?)?;
+    let creation_time_ms = field("creation_time_ms")?
+        .as_u64()
+        .ok_or(BridgeError::DetachedTransactionScaffold)?;
+    let ttl_ms = field("time_to_live_ms")?
+        .as_u64()
+        .filter(|ttl| *ttl > 0)
+        .ok_or(BridgeError::DetachedTransactionScaffold)?;
+    let instruction = native_wallet_instruction_from_json(field("instruction")?)?;
+    let mut builder = TransactionBuilder::new(network_id, authority.clone(), fee_payment)
+        .with_instructions([instruction]);
+    builder.set_creation_time(Duration::from_millis(creation_time_ms));
+    builder.set_ttl(Duration::from_millis(ttl_ms));
+    let payload = builder
+        .into_payload()
+        .map_err(|_| BridgeError::DetachedTransactionScaffold)?;
+    // This ephemeral unrelated key supplies only a structurally valid placeholder.
+    // Its signature does not authorize the transaction and is replaced by the wallet.
+    let placeholder = KeyPair::try_random_with_algorithm(Algorithm::Ed25519)
+        .map_err(|_| BridgeError::DetachedTransactionScaffold)?;
+    if authority.try_signatory() == Some(placeholder.public_key()) {
+        return Err(BridgeError::DetachedTransactionScaffold);
+    }
+    let placeholder_signature = Signature::try_new(
+        placeholder.private_key(),
+        iroha_crypto::HashOf::new(&payload).as_ref(),
+    )
+    .map_err(|_| BridgeError::DetachedTransactionScaffold)?;
+    let transaction = TransactionBuilder::from_payload(payload)
+        .map_err(|_| BridgeError::DetachedTransactionScaffold)?
+        .build_with_signature(placeholder_signature);
+    let scaffold = transaction.encode_versioned();
+    let (_, inspection) = inspect_detached_transaction_scaffold(&scaffold)?;
+    Ok((scaffold, inspection))
+}
