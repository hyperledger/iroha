@@ -0,0 +1,161 @@
+//! Arena aiming arithmetic. No profile, custody or input authentication.
+//! Every direction component is derived from bounded yaw and pitch rather than
+//! accepting a peer's claimed ray. The parent relation must bind canonical controls.
+use super::{
+    checked_integer_air::{bounded_input_v1, bounded_value_v1, divmod_unsigned_v1},
+    integer_air::{IntegerAirV1, Value},
+};
+
+/// Exact Q15 Bhaskara function used by the separate Rust combat reference.
+pub(super) fn sine_v1(air: &mut IntegerAirV1, angle: Value) -> Value {
+    let angle = bounded_value_v1(air, angle, 0, 65535).expect("angle range");
+    let negative = air.less(Value::constant(32768), angle);
+    let second_half = air.sub_constant(angle, 32768);
+    let x = air.select(negative, second_half, angle);
+    let x = bounded_value_v1(air, x, 0, 32768).expect("half turn");
+    let complement = air.sub(Value::constant(32768), x);
+    let product = air.mul(x, complement);
+    // Maximum of x*(32768-x) occurs at x=16384. Emit the actual bound,
+    // rather than relying on the compiler's interval annotation.
+    let product = bounded_value_v1(air, product, 0, 268435456).expect("quadratic bound");
+    let numerator = air.mul_constant(product, 16 * 32767);
+    let four_product = air.mul_constant(product, 4);
+    let denominator = air.sub(Value::constant(5 * 32768_i64 * 32768), four_product);
+    let (absolute, _) = divmod_unsigned_v1(air, numerator, denominator).expect("safe trig ratio");
+    let absolute = bounded_value_v1(air, absolute, 0, 32767).expect("sine amplitude");
+    let negated = air.mul_constant(absolute, -1);
+    air.select(negative, negated, absolute)
+}
+
+pub(super) fn quarter_turn_v1(air: &mut IntegerAirV1, angle: Value) -> Value {
+    let sum = air.add_constant(angle, 16384);
+    let overflow = air.less(Value::constant(65535), sum);
+    let wrapped = air.sub_constant(sum, 65536);
+    let result = air.select(overflow, wrapped, sum);
+    bounded_value_v1(air, result, 0, 65535).expect("wrapped angle")
+}
+
+struct ArenaAimAirV1 {
+    air: IntegerAirV1,
+    outputs: [Value; 3],
+}
+
+/// Append exact bounded yaw/pitch direction equations to an existing same-row graph.
+/// The caller must bind these controls to its authenticated input stream.
+pub(super) fn direction_v1(air: &mut IntegerAirV1, yaw: Value, pitch: Value) -> [Value; 3] {
+    let yaw = bounded_value_v1(air, yaw, 0, 65535).expect("yaw");
+    let pitch = bounded_value_v1(air, pitch, -16384, 16384).expect("pitch");
+    let pitch_negative = air.less(pitch, Value::constant(0));
+    let pitch_unsigned = air.add_constant(pitch, 65536);
+    let pitch_angle = air.select(pitch_negative, pitch_unsigned, pitch);
+    let pitch_angle = bounded_value_v1(air, pitch_angle, 0, 65535).expect("pitch angle");
+    let yaw_cos_angle = quarter_turn_v1(air, yaw);
+    let pitch_cos_angle = quarter_turn_v1(air, pitch_angle);
+    let yaw_sin = sine_v1(air, yaw);
+    let yaw_cos = sine_v1(air, yaw_cos_angle);
+    let pitch_sin = sine_v1(air, pitch_angle);
+    let pitch_cos = sine_v1(air, pitch_cos_angle);
+    let dx = air.mul(yaw_cos, pitch_cos);
+    let dy = air.mul(yaw_sin, pitch_cos);
+    let dx = air.divide(dx, 32767);
+    let dy = air.divide(dy, 32767);
+    [dx, dy, pitch_sin]
+}
+
+impl ArenaAimAirV1 {
+    fn compile() -> Self {
+        let mut air = IntegerAirV1::default();
+        let yaw = bounded_input_v1(&mut air, 0, 65535).expect("yaw");
+        let pitch = bounded_input_v1(&mut air, -16384, 16384).expect("pitch");
+        let outputs = direction_v1(&mut air, yaw, pitch);
+        Self { air, outputs }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::super::integer_air::{Source, field};
+    use super::*;
+    use crate::privacy_engines::transparent_stark::GoldilocksFieldV1 as F;
+
+    /// Independent direct formula; no arithmetic-graph witness operations.
+    fn reference_sine(angle: u16) -> i64 {
+        let half = u32::from(angle) > 32768;
+        let x = i64::from(angle) - if half { 32768 } else { 0 };
+        let product = x * (32768 - x);
+        let value = 16 * product * 32767 / (5 * 32768_i64.pow(2) - 4 * product);
+        if half { -value } else { value }
+    }
+
+    #[test]
+    fn aim_equations_match_reference_quadrants_wrap_and_pitch() {
+        let graph = ArenaAimAirV1::compile();
+        for yaw in [
+            0_u16, 1, 8191, 8192, 16384, 32767, 32768, 32769, 49152, 65535,
+        ] {
+            for pitch in [-16384_i16, -8192, -1, 0, 1, 8192, 16384] {
+                let row = graph.air.witness(&[i64::from(yaw), i64::from(pitch)], &[]);
+                let cp = reference_sine((pitch as u16).wrapping_add(16384));
+                let expected = [
+                    reference_sine(yaw.wrapping_add(16384)) * cp / 32767,
+                    reference_sine(yaw) * cp / 32767,
+                    reference_sine(pitch as u16),
+                ];
+                for (output, expected) in graph.outputs.iter().zip(expected) {
+                    let Source::Column(column) = output.source else {
+                        panic!("column")
+                    };
+                    assert_eq!(row[column], expected, "yaw={yaw}, pitch={pitch}");
+                }
+                let row = row.into_iter().map(field).collect::<Vec<_>>();
+                assert!(
+                    graph
+                        .air
+                        .residues(&row, &row, &[])
+                        .iter()
+                        .all(|v| *v == F::ZERO)
+                );
+            }
+        }
+    }
+
+    #[test]
+    fn false_direction_and_noncanonical_controls_are_rejected() {
+        let graph = ArenaAimAirV1::compile();
+        let row = graph
+            .air
+            .witness(&[12345, -6789], &[])
+            .into_iter()
+            .map(field)
+            .collect::<Vec<_>>();
+        for output in graph.outputs {
+            let Source::Column(column) = output.source else {
+                panic!("column")
+            };
+            let mut forged = row.clone();
+            forged[column] = forged[column].add(F::ONE);
+            assert!(
+                graph
+                    .air
+                    .residues(&forged, &forged, &[])
+                    .iter()
+                    .any(|v| *v != F::ZERO)
+            );
+        }
+        for input in [[65536, 0], [-1, 0], [0, 16385], [0, -16385]] {
+            let row = graph
+                .air
+                .witness(&input, &[])
+                .into_iter()
+                .map(field)
+                .collect::<Vec<_>>();
+            assert!(
+                graph
+                    .air
+                    .residues(&row, &row, &[])
+                    .iter()
+                    .any(|v| *v != F::ZERO)
+            );
+        }
+    }
+}
diff --git a/crates/iroha_core/src/execution_proofs/arena_capacity_research.rs b/crates/iroha_core/src/execution_proofs/arena_capacity_research.rs
new file mode 100644
index 0000000000000000000000000000000000000000..301d876a39debfc608c25ffa099fde5b9e074cf9
--- /dev/null
+++ b/crates/iroha_core/src/execution_proofs/arena_capacity_research.rs
@@ -0,0 +1,127 @@
+//! Unregistered Arena capacity experiment. Structural input coverage is not an execution proof.
+//!
+//! These checks intentionally have no path into `OpenGameSessionV1` or the compiled
+//! execution registry. In particular, accepting this shape never permits stake,
+//! equipment reservation, a kill award, or settlement. They bound one complete,
+//! uninterrupted 60 Hz research match while the Arena execution relation and
+//! appendable consensus transcript are still under development.
+
+use iroha_crypto::Hash;
+use iroha_data_model::game::{GameAccessV1, GameForcedBatchV1, GameManifestV1, GamePayoutPolicyV1};
+use thiserror::Error;
+
+/// The six-versus-six match lasts ten minutes at 60 simulation ticks per second.
+pub const ARENA_RESEARCH_MAX_TICKS_V1: u32 = 36_000;
+/// Each commitment contains two complete eight-byte controls per slot.
+pub const ARENA_RESEARCH_BATCH_TICKS_V1: u16 = 2;
+/// The requested six-versus-six roster, including permanent eliminated slots.
+pub const ARENA_RESEARCH_MAX_SLOTS_V1: u8 = 12;
+/// Sixteen opaque bytes per two-tick participant batch.
+pub const ARENA_RESEARCH_INPUT_BYTES_V1: u16 = 16;
+/// Exactly 18,000 complete batches at the full ten-minute target.
+pub const ARENA_RESEARCH_MAX_BATCHES_V1: usize = 18_000;
+/// Preserve the existing generic bound on raw retained input bytes.
+pub const ARENA_RESEARCH_MAX_RAW_INPUT_BYTES_V1: usize = 4 * 1024 * 1024;
+
+/// This identifier is deliberately absent from the compiled execution registry.
+/// A manifest using it cannot open a native session or authorize funds.
+#[must_use]
+pub fn arena_capacity_research_id_v1() -> Hash {
+    Hash::new(b"unregistered-arena-capacity-research-v1:60hz:2ticks:12slots:16bytes:36000ticks:no-proof:no-funds")
+}
+
+/// Checked upper bounds for one manifest, not an execution-proof qualification.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct ArenaResearchCapacityV1 {
+    /// Exact number of two-tick batches declared by the manifest.
+    pub batches: usize,
+    /// Maximum raw input bytes over all original permanent slots and batches.
+    pub raw_input_bytes: usize,
+}
+
+/// Fail closed on unsupported research shapes before allocating a transcript.
+#[derive(Clone, Copy, Debug, Eq, Error, PartialEq)]
+pub enum ArenaResearchCapacityErrorV1 {
+    /// The manifest does not describe the one bounded, unregistered experiment.
+    #[error("unsupported or oversized unregistered Arena research manifest")]
+    Manifest,
+    /// The supplied uninterrupted history is incomplete, reordered, or malformed.
+    #[error("incomplete or malformed uninterrupted Arena research history")]
+    History,
+}
+
+/// Bound an *unfunded research* manifest before constructing any forced history.
+///
+/// This is intentionally stricter than the intended product: the current
+/// experiment covers one complete, uninterrupted public match only. Disconnect
+/// and DNF evidence require the still-missing compiled Arena relation.
+pub fn validate_arena_capacity_research_manifest_v1(
+    manifest: &GameManifestV1,
+) -> Result<ArenaResearchCapacityV1, ArenaResearchCapacityErrorV1> {
+    if manifest.version != 1
+        || manifest.profile_id != arena_capacity_research_id_v1()
+        || manifest.min_participants < 2
+        || manifest.max_participants > ARENA_RESEARCH_MAX_SLOTS_V1
+        || manifest.min_participants > manifest.max_participants
+        || manifest.batch_ticks != ARENA_RESEARCH_BATCH_TICKS_V1
+        || manifest.max_ticks == 0
+        || manifest.max_ticks > ARENA_RESEARCH_MAX_TICKS_V1
+        || !manifest
+            .max_ticks
+            .is_multiple_of(u32::from(ARENA_RESEARCH_BATCH_TICKS_V1))
+        || manifest.max_input_bytes != ARENA_RESEARCH_INPUT_BYTES_V1
+        || manifest.max_participant_data_bytes > 4_096
+        || manifest.application_parameters.len() > 65_536
+        || manifest.access != GameAccessV1::Public
+        || manifest.payout_policy != GamePayoutPolicyV1::NoPayout
+    {
+        return Err(ArenaResearchCapacityErrorV1::Manifest);
+    }
+    let batches = usize::try_from(manifest.max_ticks / u32::from(manifest.batch_ticks))
+        .map_err(|_| ArenaResearchCapacityErrorV1::Manifest)?;
+    let raw_input_bytes = batches
+        .checked_mul(usize::from(manifest.max_participants))
+        .and_then(|value| value.checked_mul(usize::from(manifest.max_input_bytes)))
+        .ok_or(ArenaResearchCapacityErrorV1::Manifest)?;
+    if batches > ARENA_RESEARCH_MAX_BATCHES_V1
+        || raw_input_bytes > ARENA_RESEARCH_MAX_RAW_INPUT_BYTES_V1
+    {
+        return Err(ArenaResearchCapacityErrorV1::Manifest);
+    }
+    Ok(ArenaResearchCapacityV1 {
+        batches,
+        raw_input_bytes,
+    })
+}
+
+/// Check every supplied batch, epoch, tick and permanent slot of one *complete*
+/// uninterrupted research history. This does not authenticate those inputs or
+/// constrain combat; a hash or shape check cannot prove a kill.
+pub fn validate_full_arena_capacity_research_history_v1(
+    manifest: &GameManifestV1,
+    batches: &[GameForcedBatchV1],
+) -> Result<ArenaResearchCapacityV1, ArenaResearchCapacityErrorV1> {
+    let capacity = validate_arena_capacity_research_manifest_v1(manifest)?;
+    if batches.len() != capacity.batches {
+        return Err(ArenaResearchCapacityErrorV1::History);
+    }
+    for (index, batch) in batches.iter().enumerate() {
+        let epoch = u64::try_from(index).map_err(|_| ArenaResearchCapacityErrorV1::History)?;
+        let start_tick = u32::try_from(index)
+            .ok()
+            .and_then(|value| value.checked_mul(u32::from(manifest.batch_ticks)))
+            .ok_or(ArenaResearchCapacityErrorV1::History)?;
+        if batch.epoch != epoch
+            || batch.start_tick != start_tick
+            || batch.inputs.len() != usize::from(manifest.max_participants)
+            || !batch.dnf_slots.is_empty()
+            || batch
+                .inputs
+                .iter()
+                .any(|input| input.len() != usize::from(manifest.max_input_bytes))
+        {
+            return Err(ArenaResearchCapacityErrorV1::History);
+        }
+    }
+    Ok(capacity)
+}
diff --git a/crates/iroha_core/src/execution_proofs/arena_damage_air.rs b/crates/iroha_core/src/execution_proofs/arena_damage_air.rs
new file mode 100644
index 0000000000000000000000000000000000000000..a5f4cdb030ff857712070c23d977ef841f8fc6e0
--- /dev/null
+++ b/crates/iroha_core/src/execution_proofs/arena_damage_air.rs
@@ -0,0 +1,296 @@
+//! Research AIR for one Arena damage application, with no registered proof profile.
+//!
+//! This constrains the damage/parry loop in `arena-core::simulation::World::step`.
+//! The caller still must prove that this damage application exists, the attacker and
+//! victim selection/order, weapon damage, canonical yaw-derived direction, positions,
+//! prior state, and all later death/allocation transitions. A passing residue check
+//! here is not a FPS proof and never authorizes custody. See `ARENA_DAMAGE_AIR.md`.
+
+use super::{
+    checked_integer_air::{
+        CheckedBooleanV1, CheckedIntegerAirErrorV1, boolean_input_v1, bounded_input_v1,
+        constrain_boolean_v1, select_v1,
+    },
+    integer_air::{IntegerAirV1, Value},
+};
+
+const HEALTH: usize = 0;
+const STAMINA: usize = 1;
+const DAMAGE: usize = 2;
+const GUARDING: usize = 3;
+const GUARD_TICKS: usize = 4;
+const ATTACKER: usize = 5;
+const VICTIM: usize = 6;
+const FACING_X: usize = 7;
+const FACING_Y: usize = 8;
+const ATTACKER_X: usize = 9;
+const ATTACKER_Y: usize = 10;
+const VICTIM_X: usize = 11;
+const VICTIM_Y: usize = 12;
+const NEXT_HEALTH: usize = 13;
+const NEXT_STAMINA: usize = 14;
+const DEALT: usize = 15;
+const LETHAL: usize = 16;
+pub(super) const INPUT_COUNT: usize = 17;
+
+/// Fixed closed research relation; there is no caller-selected equation or profile ID.
+pub(super) struct ArenaDamageAirV1 {
+    pub(super) air: IntegerAirV1,
+    pub(super) inputs: [Value; INPUT_COUNT],
+    facing_dot: Value,
+    parried: Value,
+    halved: Value,
+}
+
+fn boolean_and(air: &mut IntegerAirV1, a: Value, b: Value) -> CheckedBooleanV1 {
+    let value = air.and(a, b);
+    constrain_boolean_v1(air, value)
+}
+
+impl ArenaDamageAirV1 {
+    pub(super) fn compile() -> Result<Self, CheckedIntegerAirErrorV1> {
+        let mut air = IntegerAirV1::default();
+        let bounds = [
+            (0, 150),
+            (0, 100),
+            (0, 85),
+            (0, 1),
+            (0, 65535),
+            (0, 11),
+            (0, 11),
+            (-32767, 32767),
+            (-32767, 32767),
+            (-24000, 24000),
+            (-24000, 24000),
+            (-24000, 24000),
+            (-24000, 24000),
+            (0, 150),
+            (0, 100),
+            (0, 85),
+            (0, 1),
+        ];
+        let mut inputs = [Value::constant(0); INPUT_COUNT];
+        for (index, (low, high)) in bounds.into_iter().enumerate() {
+            inputs[index] = if index == GUARDING || index == LETHAL {
+                boolean_input_v1(&mut air).value()
+            } else {
+                bounded_input_v1(&mut air, low, high)?
+            };
+        }
+        let dx = air.sub(inputs[ATTACKER_X], inputs[VICTIM_X]);
+        let dy = air.sub(inputs[ATTACKER_Y], inputs[VICTIM_Y]);
+        let facing_dx = air.mul(inputs[FACING_X], dx);
+        let facing_dy = air.mul(inputs[FACING_Y], dy);
+        let facing_dot = air.add(facing_dx, facing_dy);
+        let facing = air.less(Value::constant(0), facing_dot);
+        let alive = air.less(Value::constant(0), inputs[HEALTH]);
+        let before = air.less(inputs[ATTACKER], inputs[VICTIM]);
+        let after = air.less(inputs[VICTIM], inputs[ATTACKER]);
+        let different = air.or(before, after);
+        let guard = boolean_and(&mut air, inputs[GUARDING], different);
+        let guard = boolean_and(&mut air, guard.value(), facing);
+        let guard = boolean_and(&mut air, guard.value(), alive);
+        let early = air.less(inputs[GUARD_TICKS], Value::constant(9));
+        let below_twenty = air.less(inputs[STAMINA], Value::constant(20));
+        let enough_for_parry = air.not(below_twenty);
+        let parry = boolean_and(&mut air, guard.value(), early);
+        let parry = boolean_and(&mut air, parry.value(), enough_for_parry);
+        let no_parry = air.not(parry.value());
+        let below_ten = air.less(inputs[STAMINA], Value::constant(10));
+        let enough_for_half = air.not(below_ten);
+        let half = boolean_and(&mut air, guard.value(), no_parry);
+        let half = boolean_and(&mut air, half.value(), enough_for_half);
+        let rounded_damage = air.add_constant(inputs[DAMAGE], 1);
+        let half_damage = air.divide(rounded_damage, 2);
+        let ordinary_damage = select_v1(&mut air, half, half_damage, inputs[DAMAGE])?;
+        let effective_damage = select_v1(&mut air, parry, Value::constant(0), ordinary_damage)?;
+        let dealt = air.minimum(effective_damage, inputs[HEALTH]);
+        air.equate(inputs[DEALT], dealt);
+        let next_health = air.sub(inputs[HEALTH], dealt);
+        air.equate(inputs[NEXT_HEALTH], next_health);
+        let half_cost = select_v1(&mut air, half, Value::constant(10), Value::constant(0))?;
+        let stamina_cost = select_v1(&mut air, parry, Value::constant(20), half_cost)?;
+        let next_stamina = air.sub(inputs[STAMINA], stamina_cost);
+        air.equate(inputs[NEXT_STAMINA], next_stamina);
+        let zero_health = air.less(inputs[NEXT_HEALTH], Value::constant(1));
+        let lethal = boolean_and(&mut air, alive, zero_health);
+        air.equate(inputs[LETHAL], lethal.value());
+        Ok(Self {
+            air,
+            inputs,
+            facing_dot,
+            parried: parry.value(),
+            halved: half.value(),
+        })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::{
+        execution_proofs::integer_air::{Source, field},
+        privacy_engines::transparent_stark::GoldilocksFieldV1 as F,
+    };
+
+    fn column(value: Value) -> usize {
+        let Source::Column(index) = value.source else {
+            panic!("expected witness column")
+        };
+        index
+    }
+    fn accepts(air: &ArenaDamageAirV1, inputs: &[i64; INPUT_COUNT]) -> bool {
+        let row = air
+            .air
+            .witness(inputs, &[])
+            .into_iter()
+            .map(field)
+            .collect::<Vec<_>>();
+        air.air
+            .residues(&row, &row, &[])
+            .iter()
+            .all(|residue| *residue == F::ZERO)
+    }
+    fn input(health: i64, stamina: i64, damage: i64, guard_ticks: i64) -> [i64; INPUT_COUNT] {
+        [
+            health,
+            stamina,
+            damage,
+            1,
+            guard_ticks,
+            0,
+            1,
+            32767,
+            0,
+            1000,
+            0,
+            0,
+            0,
+            health,
+            stamina,
+            0,
+            0,
+        ]
+    }
+    fn outcome(
+        mut row: [i64; INPUT_COUNT],
+        health: i64,
+        stamina: i64,
+        dealt: i64,
+        lethal: i64,
+    ) -> [i64; INPUT_COUNT] {
+        row[NEXT_HEALTH] = health;
+        row[NEXT_STAMINA] = stamina;
+        row[DEALT] = dealt;
+        row[LETHAL] = lethal;
+        row
+    }
+
+    #[test]
+    fn damage_parry_thresholds_and_overkill_follow_reference_rules() {
+        let air = ArenaDamageAirV1::compile().unwrap();
+        let mut cases = vec![
+            outcome(input(50, 20, 85, 8), 50, 0, 0, 0),
+            outcome(input(50, 20, 85, 9), 7, 10, 43, 0),
+            outcome(input(50, 19, 85, 8), 7, 9, 43, 0),
+            outcome(input(50, 10, 84, 8), 8, 0, 42, 0),
+            outcome(input(50, 9, 85, 8), 0, 9, 50, 1),
+            outcome(input(1, 10, 1, 65535), 0, 0, 1, 1),
+            outcome(input(0, 20, 85, 0), 0, 20, 0, 0),
+            // The reference consumes defensive stamina for a zero-damage event too.
+            outcome(input(50, 20, 0, 0), 50, 0, 0, 0),
+        ];
+        for (index, value) in [
+            (GUARDING, 0),
+            (ATTACKER, 1),
+            (FACING_X, -32767),
+            (FACING_X, 0),
+        ] {
+            let mut row = outcome(input(50, 100, 85, 1), 0, 100, 50, 1);
+            row[index] = value;
+            cases.push(row);
+        }
+        // Dot-product y component matters independently; positive x alone does not authorize parry.
+        let mut row = outcome(input(50, 100, 85, 1), 0, 100, 50, 1);
+        row[FACING_Y] = -32767;
+        row[ATTACKER_Y] = 1001;
+        cases.push(row);
+        for row in cases {
+            assert!(accepts(&air, &row), "reference boundary {row:?}");
+        }
+    }
+
+    #[test]
+    fn forged_lethal_stamina_damage_and_facing_witnesses_are_rejected() {
+        let air = ArenaDamageAirV1::compile().unwrap();
+        let legal = outcome(input(50, 20, 85, 8), 50, 0, 0, 0);
+        assert!(accepts(&air, &legal));
+        for (index, forged) in [
+            (LETHAL, 1),
+            (NEXT_HEALTH, 0),
+            (NEXT_STAMINA, 20),
+            (DEALT, 50),
+            (FACING_X, -32767),
+            (ATTACKER, 1),
+            (GUARDING, 0),
+            (GUARD_TICKS, 9),
+            (STAMINA, 19),
+        ] {
+            let mut bad = legal;
+            bad[index] = forged;
+            assert!(!accepts(&air, &bad), "forged input/claim {index}={forged}");
+        }
+        let witness = air
+            .air
+            .witness(&legal, &[])
+            .into_iter()
+            .map(field)
+            .collect::<Vec<_>>();
+        for value in [
+            air.inputs[LETHAL],
+            air.inputs[NEXT_STAMINA],
+            air.inputs[DEALT],
+            air.facing_dot,
+            air.parried,
+            air.halved,
+        ] {
+            let mut forged = witness.clone();
+            forged[column(value)] = forged[column(value)].add(F::ONE);
+            assert!(
+                air.air
+                    .residues(&forged, &forged, &[])
+                    .iter()
+                    .any(|r| *r != F::ZERO),
+                "changed polynomial witness column {}",
+                column(value)
+            );
+        }
+    }
+
+    #[test]
+    fn range_and_boolean_equations_reject_outside_domain_assignments() {
+        let air = ArenaDamageAirV1::compile().unwrap();
+        let legal = outcome(input(50, 20, 85, 8), 50, 0, 0, 0);
+        for (index, invalid) in [
+            (HEALTH, 151),
+            (HEALTH, -1),
+            (STAMINA, 101),
+            (DAMAGE, 86),
+            (GUARDING, 2),
+            (LETHAL, 2),
+            (GUARD_TICKS, 65536),
+            (ATTACKER, 12),
+            (FACING_X, 32768),
+            (FACING_X, -32768),
+            (ATTACKER_X, 24001),
+            (VICTIM_Y, -24001),
+        ] {
+            let mut bad = legal;
+            bad[index] = invalid;
+            assert!(
+                !accepts(&air, &bad),
+                "out-of-domain input {index}={invalid}"
+            );
+        }
+    }
+}
diff --git a/crates/iroha_core/src/execution_proofs/arena_damage_stark_research.rs b/crates/iroha_core/src/execution_proofs/arena_damage_stark_research.rs
new file mode 100644
index 0000000000000000000000000000000000000000..650f16d1231867c1f22cce47d2944f10d45567e2
--- /dev/null
+++ b/crates/iroha_core/src/execution_proofs/arena_damage_stark_research.rs
@@ -0,0 +1,298 @@
+//! Unregistered research adapter for one fixed public Arena damage/parry transition.
+//!
+//! Uses the unchanged native execution DEEP-ALI/FRI backend and security geometry.
+//! Does not prove target selection, attack initiation, complete state/history,
+//! bonds, native game admission, or settlement. No registry calls exist here.
+
+use super::{
+    arena_damage_air::{ArenaDamageAirV1, INPUT_COUNT},
+    integer_air::{Value, field},
+    stark::{
+        aggregate_stark::{
+            AggregateProofLayoutV1, AggregateStarkDomainsV1, AggregateStarkParametersV1,
+            AggregateTraceGroupLayoutV1, maximum_encoded_proof_with_deep_bytes_v1,
+        },
+        proof_managed_note_stark::{
+            NOTE_COPY_AUX_WIDTH_V1, NOTE_COPY_FIXED_WIDTH_V1, NOTE_COPY_WIDTH_V1,
+            NoteCopyCellPolicyV1, NoteCopyChallengesV1, NoteCopyScheduleV1,
+            ProofManagedNoteStarkAdapterV1, ProofManagedNoteStarkErrorV1 as Error,
+            ProofManagedNoteStarkProtocolV1, prove_proof_managed_note_stark_v1,
+            verify_proof_managed_note_stark_v1,
+        },
+        transparent_stark::{
+            GoldilocksDigest384V1, GoldilocksFieldV1 as F, TransparentStarkDigestContextV1,
+            TransparentTranscriptV1, goldilocks_digest384_frame_v1,
+        },
+    },
+};
+use sha2::{Digest, Sha256};
+use std::{path::Path, time::Instant};
+
+const TRACE_LOG: u8 = 13;
+const TRACE_SIZE: usize = 1 << TRACE_LOG;
+const AIR_WIDTH: usize = 575;
+const AIR_CONSTRAINTS: usize = 663;
+const MAX_PROOF_BYTES: usize = 4 * 1024 * 1024;
+const CONTEXT: TransparentStarkDigestContextV1 =
+    TransparentStarkDigestContextV1::execution_v1(b"arena-damage-research-v1");
+const DESCRIPTOR: &[u8] = b"unregistered-arena-damage-research-v1:single-public-transition:damage-air=575-columns/663-constraints:public=17-signed-i64-le-fixed-columns:trace=8192-repeated-relation:base=583:aux=118:fixed=60:profile-constraints=680:degree=4:queries=136:lde=8:fri-terminal=1024:fri-degree=143:composition-chunks=4:grinding=20:proof-cap=4194304:no-qualification:no-settlement";
+const DOMAINS: AggregateStarkDomainsV1 = AggregateStarkDomainsV1 {
+    digest_context: CONTEXT,
+    base_leaf: b"arena-research-base-leaf-v1",
+    base_node: b"arena-research-base-node-v1",
+    aux_leaf: b"arena-research-aux-leaf-v1",
+    aux_node: b"arena-research-aux-node-v1",
+    composition_leaf: b"arena-research-composition-leaf-v1",
+    composition_node: b"arena-research-composition-node-v1",
+    fri_leaf: b"arena-research-fri-leaf-v1",
+    fri_node: b"arena-research-fri-node-v1",
+    layout_label: b"arena-research-layout-v1",
+    base_root_label: b"arena-research-base-root-v1",
+    aux_root_label: b"arena-research-aux-root-v1",
+    composition_root_label: b"arena-research-composition-root-v1",
+    fri_root_label: b"arena-research-fri-root-v1",
+    fri_beta_label: b"arena-research-fri-beta-v1",
