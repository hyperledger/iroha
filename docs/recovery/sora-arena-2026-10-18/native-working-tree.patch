+
+    for mutation in 0..10 {
+        let mut invalid = next;
+        match mutation {
+            0 => invalid.network_id = network_id(0x72),
+            1 => invalid.epoch += 1,
+            2 => invalid.first_height += 1,
+            3 => invalid.last_height = invalid.first_height - 1,
+            4 => invalid.previous_authorization_id = genesis.authorization_id().unwrap(),
+            5 => invalid.authority_generation += 1,
