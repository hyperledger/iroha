+/// Exact game's P2P context, built only from the one public statement.
+pub struct P2PContextV2 {
+    prefix: Vec<u8>,
+}
+
+impl P2PContextV2 {
+    /// Derive the game protocol's SHA-256 domain framing from native identities.
+    pub fn from_admission(
+        network: &NetworkId,
+        session: Hash,
+        manifest: &GameManifestV1,
+        admission: &GameAdmissionBodyV1,
+    ) -> Result<Self, String> {
+        if admission.participants.len() != 3 {
+            return Err("P2P context requires exact admitted roster".into());
+        }
+        let mut prefix = Vec::new();
+        prefix.extend_from_slice(b"sora-arena:p2p-evidence:v1\0");
+        prefix.extend_from_slice(network.as_bytes());
+        prefix.extend_from_slice(session.as_ref());
+        prefix.extend_from_slice(&Sha256::digest(manifest.encode()));
+        prefix.extend_from_slice(&(admission.participants.len() as u32).to_le_bytes());
+        for participant in &admission.participants {
+            let (algorithm, bytes) = participant.input_key.to_bytes();
+            if algorithm != Algorithm::Ed25519 || bytes.len() != 32 {
+                return Err("P2P context input key must be canonical Ed25519".into());
+            }
+            prefix.extend_from_slice(&bytes);
+        }
+        Ok(Self { prefix })
+    }
+
+    fn domain(&self, tag: &[u8]) -> Vec<u8> {
+        let mut out = Vec::with_capacity(self.prefix.len() + tag.len() + 4);
+        out.extend_from_slice(b"sora-arena:p2p-evidence:v1\0");
+        out.extend_from_slice(&(tag.len() as u32).to_le_bytes());
+        out.extend_from_slice(tag);
+        // The prefix starts with the fixed protocol label; context fields follow it.
+        out.extend_from_slice(&self.prefix[b"sora-arena:p2p-evidence:v1\0".len()..]);
+        out
+    }
+
+    /// The game's empty evidence-log root.
+    #[must_use]
+    pub fn genesis_root(&self) -> [u8; 32] {
+        Sha256::digest(self.domain(b"genesis")).into()
+    }
+
+    /// Exact signed complete-commitment-set digest.
+    pub fn set_digest(&self, set: &P2PSetV2) -> Result<[u8; 32], String> {
+        if set.commitments.len() != 3 {
+            return Err("P2P set lacks all original commitments".into());
+        }
+        let mut bytes = self.domain(b"complete-commitment-set");
+        bytes.extend_from_slice(&set.epoch.to_le_bytes());
+        bytes.extend_from_slice(&set.start_tick.to_le_bytes());
+        bytes.extend_from_slice(&set.parent);
+        for commitment in &set.commitments {
+            bytes.extend_from_slice(commitment);
+        }
+        Ok(Sha256::digest(bytes).into())
+    }
+
+    /// Exact game-protocol salted commitment to two controls from one slot.
+    pub fn input_commitment(
+        &self,
+        set: &P2PSetV2,
+        reveal: &P2PRevealV2,
+    ) -> Result<[u8; 32], String> {
+        if reveal.slot >= 3 {
+            return Err("P2P reveal slot outside roster".into());
+        }
+        let mut bytes = self.domain(b"inputs");
+        bytes.extend_from_slice(&set.epoch.to_le_bytes());
+        bytes.extend_from_slice(&set.start_tick.to_le_bytes());
+        bytes.extend_from_slice(&set.parent);
+        bytes.extend_from_slice(&u32::from(reveal.slot).to_le_bytes());
+        bytes.extend_from_slice(&2_u32.to_le_bytes());
+        for frame in reveal.payload.chunks_exact(8) {
+            validate_frame_v2(frame)?;
+            bytes.extend_from_slice(frame);
+        }
+        bytes.extend_from_slice(&reveal.salt);
+        Ok(Sha256::digest(bytes).into())
+    }
+
+    /// Extend the P2P root with one authenticated two-tick batch.
+    pub fn next_root(
+        &self,
+        prior: [u8; 32],
+        batch: &P2PCertifiedBatchV2,
+    ) -> Result<[u8; 32], String> {
+        let mut bytes = self.domain(b"transcript-batch");
+        bytes.extend_from_slice(&prior);
+        bytes.extend_from_slice(&self.set_digest(&batch.set)?);
+        for reveal in &batch.reveals {
+            bytes.extend_from_slice(&reveal.payload);
+        }
+        Ok(Sha256::digest(bytes).into())
+    }
+}
+
+fn validate_frame_v2(bytes: &[u8]) -> Result<(), String> {
+    if bytes.len() != 8 {
+        return Err("P2P control must encode exactly eight bytes".into());
+    }
+    let buttons = u16::from_le_bytes([bytes[0], bytes[1]]);
+    let pitch = i16::from_le_bytes([bytes[6], bytes[7]]);
+    if buttons & !63 != 0
+        || bytes[2] as i8 == i8::MIN
+        || bytes[3] as i8 == i8::MIN
+        || !(-16_384..=16_384).contains(&pitch)
+    {
+        return Err("P2P control violates canonical Arena input bounds".into());
+    }
+    Ok(())
+}
+
+fn native_transcript_root_v2(network: &NetworkId, batches: &[GameForcedBatchV1]) -> Hash {
+    let transcript = GameTranscriptV1 {
+        batches: batches
+            .iter()
+            .map(|batch| GameTranscriptBatchV1 {
+                start_tick: batch.start_tick,
+                inputs: batch.inputs.clone(),
+            })
+            .collect(),
+        dnf_events: vec![],
+    };
+    game_message_hash_v1(network, "input-transcript", &transcript)
+}
+
+fn validate_history_v2(
+    statement: &ArenaKillHistoryResearchStatementV2,
+) -> Result<[Vec<u8>; 3], String> {
+    if statement.history.len() != 13 || statement.native_batches.len() != 13 {
+        return Err("P2P history must contain thirteen complete batches".into());
+    }
+    let context = P2PContextV2::from_admission(
+        &statement.network_id,
+        statement.session_id,
+        &statement.manifest,
+        &statement.admission,
+    )?;
+    let mut root = context.genesis_root();
+    let mut controls: [Vec<u8>; 3] = std::array::from_fn(|_| Vec::with_capacity(TICKS * 8));
+    for (index, batch) in statement.history.iter().enumerate() {
+        let set = &batch.set;
+        let start_tick = (index * 2) as u32;
+        if set.epoch != 0
+            || set.start_tick != start_tick
+            || set.parent != root
+            || set.commitments.len() != 3
+            || batch.signatures.len() != 3
+            || batch.reveals.len() != 3
+        {
+            return Err("P2P batch has gap, replay or incomplete roster".into());
+        }
+        let digest = context.set_digest(set)?;
+        let mut inputs = Vec::with_capacity(3);
+        for slot in 0..3 {
+            let signature = &batch.signatures[slot];
+            let reveal = &batch.reveals[slot];
+            if usize::from(signature.slot) != slot
+                || usize::from(reveal.slot) != slot
+                || signature
+                    .signature
+                    .verify(&statement.admission.participants[slot].input_key, &digest)
+                    .is_err()
+                || context.input_commitment(set, reveal)? != set.commitments[slot]
+            {
+                return Err("P2P batch certificate or opening invalid".into());
+            }
+            controls[slot].extend_from_slice(&reveal.payload);
+            inputs.push(reveal.payload.to_vec());
+        }
+        let native = &statement.native_batches[index];
+        if native.epoch != 0
+            || native.start_tick != start_tick
+            || native.inputs != inputs
+            || !native.dnf_slots.is_empty()
+        {
+            return Err("native-shaped batch differs from signed P2P controls".into());
+        }
+        root = context.next_root(root, batch)?;
+    }
+    if statement.p2p_root != root
+        || statement.native_transcript_root
+            != native_transcript_root_v2(&statement.network_id, &statement.native_batches)
+    {
+        return Err("P2P or native transcript root differs from complete history".into());
+    }
+    for (slot, bytes) in controls.iter().enumerate() {
+        if *bytes != canonical_input_v1(slot) {
+            return Err("signed controls differ from fixed 26-tick research scene".into());
+        }
+    }
+    Ok(controls)
+}
+
+fn body_slot(shooter: usize, box_index: usize) -> Option<usize> {
+    match (shooter, box_index) {
+        (0, 3) => Some(1),
+        (0, 4) => Some(2),
+        (1, 3) => Some(0),
+        (1, 4) => Some(2),
+        _ => None,
+    }
+}
+fn box_bounds(shooter: usize, box_index: usize) -> ([i64; 3], [i64; 3]) {
+    if box_index < 3 {
+        WALLS[box_index]
+    } else {
+        BODIES[body_slot(shooter, box_index).expect("eligible body")]
+    }
+}
+fn expected_plane_inputs(index: usize) -> [i64; 3] {
+    let shooter = index / 30;
+    let local = index % 30;
+    let box_index = local / 6;
+    let axis = (local % 6) / 2;
+    let bounds = box_bounds(shooter, box_index);
+    let bound = if local % 2 == 0 {
+        bounds.0[axis]
+    } else {
+        bounds.1[axis]
+    };
+    [FROM[shooter][axis], TO[shooter][axis], bound]
+}
+fn box_fraction(
+    rows: &[[i64; PLANE_VALUES]],
+    shooter: usize,
+    box_index: usize,
+) -> Result<Option<i64>, String> {
+    let mut near = 0_i64;
+    let mut far = Q20;
+    for axis in 0..3 {
+        let lower = rows[shooter * 30 + box_index * 6 + axis * 2];
+        let upper = rows[shooter * 30 + box_index * 6 + axis * 2 + 1];
+        if lower[4] != upper[4] {
+            return Err("slab endpoints disagree on ray-axis parallelism".into());
+        }
+        if lower[4] == 0 {
+            let bounds = box_bounds(shooter, box_index);
+            if FROM[shooter][axis] < bounds.0[axis] || FROM[shooter][axis] > bounds.1[axis] {
+                return Ok(None);
+            }
+        } else {
+            near = near.max(lower[3].min(upper[3]));
+            far = far.min(lower[3].max(upper[3]));
+        }
+    }
+    Ok((near <= far).then_some(near))
+}
+fn select_target(rows: &[[i64; PLANE_VALUES]], shooter: usize) -> Result<u8, String> {
+    let mut nearest = Q20 + 1;
+    for wall in 0..3 {
+        if let Some(fraction) = box_fraction(rows, shooter, wall)? {
+            nearest = nearest.min(fraction);
+        }
+    }
+    let mut selected = 0;
+    for box_index in 3..5 {
+        if let Some(fraction) = box_fraction(rows, shooter, box_index)? {
+            if fraction < nearest {
+                nearest = fraction;
+                selected = body_slot(shooter, box_index).expect("eligible body") as u8 + 1;
+            }
+        }
+    }
+    Ok(selected)
+}
+
+/// Fixture constructor; native AIR rather than this formula verifies fractions.
+#[must_use]
+pub fn reference_plane_rows_v1() -> Vec<[i64; PLANE_VALUES]> {
+    (0..PLANE_COUNT)
+        .map(|index| {
+            let [start, end, bound] = expected_plane_inputs(index);
+            let delta = end - start;
+            let denominator = if delta == 0 { 1 } else { delta.abs() };
+            let mut numerator = (bound - start) * Q20;
+            if delta < 0 {
+                numerator = -numerator;
+            }
+            let fraction = (numerator / denominator).clamp(-1, Q20 + 1);
+            [start, end, bound, fraction, i64::from(delta != 0)]
+        })
+        .collect()
+}
+
+fn tick_row(
+    before: &KillResearchStateV1,
+    after: &KillResearchStateV1,
+    tick: usize,
+) -> [i64; arena_kill_history_air::INPUT_COUNT] {
+    use arena_kill_history_air::*;
+    let mut row = [0_i64; INPUT_COUNT];
+    row[HEALTH_IN] = i64::from(before.health[2]);
+    row[HEALTH_OUT] = i64::from(after.health[2]);
+    row[CD0_IN] = i64::from(before.cooldown[0]);
+    row[CD0_OUT] = i64::from(after.cooldown[0]);
+    row[CD1_IN] = i64::from(before.cooldown[1]);
+    row[CD1_OUT] = i64::from(after.cooldown[1]);
+    row[AMMO0_IN] = i64::from(before.ammo[0]);
+    row[AMMO0_OUT] = i64::from(after.ammo[0]);
+    row[AMMO1_IN] = i64::from(before.ammo[1]);
+    row[AMMO1_OUT] = i64::from(after.ammo[1]);
+    let fired = i64::from(matches!(tick, 0 | 12 | 24));
+    row[FIRE0] = fired;
+    row[FIRE1] = fired;
+    row[SHOT0] = fired;
+    row[SHOT1] = fired;
+    row[DEALT0] = if fired == 1 { 22 } else { 0 };
+    row[DEALT1] = if tick == 24 {
+        15
+    } else if fired == 1 {
+        22
+    } else {
+        0
+    };
+    row[ALIVE_IN] = i64::from(before.alive[2]);
+    row[ALIVE_OUT] = i64::from(after.alive[2]);
+    row[RESERVE_IN] = before.reserve[2] as i64;
+    row[RESERVE_OUT] = after.reserve[2] as i64;
+    row[EARN0_IN] = before.earnings[0] as i64;
+    row[EARN0_OUT] = after.earnings[0] as i64;
+    row[EARN1_IN] = before.earnings[1] as i64;
+    row[EARN1_OUT] = after.earnings[1] as i64;
+    row[PAID_IN] = i64::from(before.paid_deaths[2]);
+    row[PAID_OUT] = i64::from(after.paid_deaths[2]);
+    row[DEATHS_IN] = i64::from(before.deaths[2]);
+    row[DEATHS_OUT] = i64::from(after.deaths[2]);
+    row[KILLS1_IN] = i64::from(before.kills[1]);
+    row[KILLS1_OUT] = i64::from(after.kills[1]);
+    row[DEATH] = i64::from(tick == 24);
+    row[CHAIN] = i64::from(tick + 1 < TICKS);
+    row[RESPAWN_IN] = i64::from(before.respawn_ticks[2]);
+    row[RESPAWN_OUT] = i64::from(after.respawn_ticks[2]);
+    row[TERMINAL_IN] = i64::from(before.terminal);
+    row[TERMINAL_OUT] = i64::from(after.terminal);
+    row[FINAL_TICK] = i64::from(tick + 1 == TICKS);
+    row
+}
