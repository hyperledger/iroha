+/// Produce the fixed research proof without calling custody code.
+pub fn prove_research_kill_v1(
+    statement: ArenaKillHistoryResearchStatementV2,
+) -> Result<Vec<u8>, String> {
+    let adapter = Adapter::new(statement)?;
+    preflight(&adapter)?;
+    let proof = prove_proof_managed_note_stark_v1(&adapter, &adapter.columns())
+        .map_err(|error| error.to_string())?;
+    let envelope_size = encoded_envelope_size_v2(&adapter.statement, proof.len());
+    if envelope_size > MAX_PROOF_BYTES {
+        return Err(format!(
+            "actual research envelope {envelope_size} exceeds {MAX_PROOF_BYTES}"
+        ));
+    }
+    Ok(proof)
+}
+
+/// Independently verify the exact peer-signed bounded scene and native proof.
+pub fn verify_research_kill_v1(
+    statement: ArenaKillHistoryResearchStatementV2,
+    proof: &[u8],
+) -> Result<(), String> {
+    // Reject oversized caller bytes before constructing the adapter or handing
+    // data to the STARK decoder. The conservative preflight bound describes a
+    // valid proof, not the size of a hostile proof supplied to this function.
+    if proof.len() > MAX_PROOF_BYTES {
+        return Err("research kill proof exceeds its byte limit".into());
+    }
+    let adapter = Adapter::new(statement)?;
+    preflight(&adapter)?;
+    if encoded_envelope_size_v2(&adapter.statement, proof.len()) > MAX_PROOF_BYTES {
+        return Err("research kill proof exceeds its whole-envelope byte limit".into());
+    }
+    verify_proof_managed_note_stark_v1(&adapter, proof).map_err(|error| error.to_string())
+}
