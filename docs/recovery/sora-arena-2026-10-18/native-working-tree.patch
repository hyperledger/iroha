+
+fn control_bytes(slot: usize, tick: usize) -> [u8; 8] {
+    let fire = slot < 2 && matches!(tick, 0 | 12 | 24);
+    let yaw: u16 = match slot {
+        0 => 24_576,
+        1 => 8_192,
+        _ => 0,
+    };
+    let [yaw0, yaw1] = yaw.to_le_bytes();
+    [u8::from(fire), 0, 0, 0, yaw0, yaw1, 0, 0]
+}
+
+/// Exact 25-tick control payload for a permanent slot.
+#[must_use]
+pub fn canonical_input_v1(slot: usize) -> Vec<u8> {
+    (0..TICKS)
+        .flat_map(|tick| control_bytes(slot, tick))
+        .collect()
+}
+
+fn body_slot(shooter: usize, box_index: usize) -> Option<usize> {
+    match (shooter, box_index) {
+        (0, 3) => Some(1),
+        (0, 4) => Some(2),
+        (1, 3) => Some(0),
+        (1, 4) => Some(2),
+        _ => None,
+    }
+}
+fn box_bounds(shooter: usize, box_index: usize) -> ([i64; 3], [i64; 3]) {
+    if box_index < 3 {
+        WALLS[box_index]
+    } else {
+        BODIES[body_slot(shooter, box_index).expect("eligible body")]
+    }
+}
+fn expected_plane_inputs(index: usize) -> [i64; 3] {
+    let shooter = index / 30;
+    let local = index % 30;
+    let box_index = local / 6;
+    let axis = (local % 6) / 2;
+    let bounds = box_bounds(shooter, box_index);
+    let bound = if local % 2 == 0 {
+        bounds.0[axis]
+    } else {
+        bounds.1[axis]
+    };
+    [FROM[shooter][axis], TO[shooter][axis], bound]
+}
+fn box_fraction(
+    rows: &[[i64; PLANE_VALUES]],
+    shooter: usize,
+    box_index: usize,
+) -> Result<Option<i64>, String> {
+    let mut near = 0_i64;
+    let mut far = Q20;
+    for axis in 0..3 {
+        let lower = rows[shooter * 30 + box_index * 6 + axis * 2];
+        let upper = rows[shooter * 30 + box_index * 6 + axis * 2 + 1];
+        if lower[4] != upper[4] {
+            return Err("slab endpoints disagree on ray-axis parallelism".into());
+        }
+        if lower[4] == 0 {
+            let bounds = box_bounds(shooter, box_index);
+            if FROM[shooter][axis] < bounds.0[axis] || FROM[shooter][axis] > bounds.1[axis] {
+                return Ok(None);
+            }
+        } else {
+            near = near.max(lower[3].min(upper[3]));
+            far = far.min(lower[3].max(upper[3]));
+        }
+    }
+    Ok((near <= far).then_some(near))
+}
+fn select_target(rows: &[[i64; PLANE_VALUES]], shooter: usize) -> Result<u8, String> {
+    let mut nearest = Q20 + 1;
+    for wall in 0..3 {
+        if let Some(fraction) = box_fraction(rows, shooter, wall)? {
+            nearest = nearest.min(fraction);
+        }
+    }
+    let mut selected = 0;
+    for box_index in 3..5 {
+        if let Some(fraction) = box_fraction(rows, shooter, box_index)? {
+            if fraction < nearest {
+                nearest = fraction;
+                selected = body_slot(shooter, box_index).expect("eligible body") as u8 + 1;
+            }
+        }
+    }
+    Ok(selected)
+}
+
+/// Fixture constructor; native AIR rather than this formula verifies fractions.
+#[must_use]
+pub fn reference_plane_rows_v1() -> Vec<[i64; PLANE_VALUES]> {
+    (0..PLANE_COUNT)
+        .map(|index| {
+            let [start, end, bound] = expected_plane_inputs(index);
+            let delta = end - start;
+            let denominator = if delta == 0 { 1 } else { delta.abs() };
+            let mut numerator = (bound - start) * Q20;
+            if delta < 0 {
+                numerator = -numerator;
+            }
+            let fraction = (numerator / denominator).clamp(-1, Q20 + 1);
+            [start, end, bound, fraction, i64::from(delta != 0)]
+        })
+        .collect()
+}
+
+fn tick_row(
+    before: &KillResearchStateV1,
+    after: &KillResearchStateV1,
+    tick: usize,
+) -> [i64; arena_kill_air::INPUT_COUNT] {
+    use arena_kill_air::*;
+    let mut row = [0_i64; INPUT_COUNT];
+    row[HEALTH_IN] = i64::from(before.health[2]);
+    row[HEALTH_OUT] = i64::from(after.health[2]);
+    row[CD0_IN] = i64::from(before.cooldown[0]);
+    row[CD0_OUT] = i64::from(after.cooldown[0]);
+    row[CD1_IN] = i64::from(before.cooldown[1]);
+    row[CD1_OUT] = i64::from(after.cooldown[1]);
+    row[AMMO0_IN] = i64::from(before.ammo[0]);
+    row[AMMO0_OUT] = i64::from(after.ammo[0]);
+    row[AMMO1_IN] = i64::from(before.ammo[1]);
+    row[AMMO1_OUT] = i64::from(after.ammo[1]);
+    let fired = i64::from(matches!(tick, 0 | 12 | 24));
+    row[FIRE0] = fired;
+    row[FIRE1] = fired;
+    row[SHOT0] = fired;
+    row[SHOT1] = fired;
+    row[DEALT0] = if fired == 1 { 22 } else { 0 };
+    row[DEALT1] = if tick == 24 {
+        15
+    } else if fired == 1 {
+        22
+    } else {
+        0
+    };
+    row[ALIVE_IN] = i64::from(before.alive[2]);
+    row[ALIVE_OUT] = i64::from(after.alive[2]);
+    row[RESERVE_IN] = before.reserve[2] as i64;
+    row[RESERVE_OUT] = after.reserve[2] as i64;
+    row[EARN0_IN] = before.earnings[0] as i64;
+    row[EARN0_OUT] = after.earnings[0] as i64;
+    row[EARN1_IN] = before.earnings[1] as i64;
+    row[EARN1_OUT] = after.earnings[1] as i64;
+    row[PAID_IN] = i64::from(before.paid_deaths[2]);
+    row[PAID_OUT] = i64::from(after.paid_deaths[2]);
+    row[DEATHS_IN] = i64::from(before.deaths[2]);
+    row[DEATHS_OUT] = i64::from(after.deaths[2]);
+    row[KILLS1_IN] = i64::from(before.kills[1]);
+    row[KILLS1_OUT] = i64::from(after.kills[1]);
+    row[DEATH] = i64::from(tick == 24);
+    row[CHAIN] = i64::from(tick + 1 < TICKS);
+    row
+}
+
+/// Exact public AIR rows derived from every pair of state boundaries.
+#[must_use]
+pub fn reference_tick_rows_v1() -> Vec<[i64; arena_kill_air::INPUT_COUNT]> {
+    let states = expected_states_v1();
+    (0..TICKS)
+        .map(|tick| tick_row(&states[tick], &states[tick + 1], tick))
+        .collect()
+}
+
+impl ArenaKillResearchStatementV1 {
+    /// Check exact admission, signatures/history, public scene and AIR row binding.
+    pub fn validate(&self) -> Result<(), String> {
+        validate_admission(&self.manifest, &self.admission)?;
+        if self.rules_hash != research_rules_hash_v1() || self.map_hash != research_map_hash_v1() {
+            return Err("kill rules or map identity changed".into());
+        }
+        let genesis = research_genesis_root_v1(
+            &self.network_id,
+            self.session_id,
+            &self.manifest,
+            &self.admission,
+        )?;
+        if self.genesis_root != genesis || self.states != expected_states_v1() {
+            return Err("kill genesis or 25-tick state projection differs".into());
+        }
+        if self.batch.epoch != 0
+            || self.batch.start_tick != 0
+            || self.batch.inputs.len() != 3
+            || !self.batch.dnf_slots.is_empty()
+            || self.reveals.len() != 3
+            || self.commitments.len() != 3
+        {
+            return Err("kill research batch shape invalid".into());
+        }
+        let parent = game_message_hash_v1(
+            &self.network_id,
+            "arena-kill-research-empty-transcript",
+            &(self.session_id, genesis),
+        );
+        let set = &self.commitment_set;
+        if set.session_id != self.session_id
+            || set.epoch != 0
+            || set.start_tick != 0
+            || set.parent_transcript_root != parent
+            || set.commitments.len() != 3
+            || set.signatures.len() != 3
+        {
+            return Err("kill commitment set is not rooted in genesis".into());
+        }
+        let set_hash = game_commitment_set_hash_v1(&self.network_id, set);
+        for slot in 0..3 {
+            if self.batch.inputs[slot] != canonical_input_v1(slot) {
+                return Err("kill control payload differs from canonical 25 ticks".into());
+            }
+            let key = &self.admission.participants[slot].input_key;
+            let reveal = &self.reveals[slot];
+            let commitment = &self.commitments[slot];
+            let signed_set = &set.signatures[slot];
+            if reveal.session_id != self.session_id
+                || reveal.epoch != 0
+                || reveal.start_tick != 0
+                || usize::from(reveal.slot) != slot
+                || reveal.payload != self.batch.inputs[slot]
+                || commitment.session_id != self.session_id
+                || commitment.epoch != 0
+                || commitment.start_tick != 0
+                || usize::from(commitment.slot) != slot
+                || commitment.commitment != game_input_commitment_v1(&self.network_id, reveal)
+                || set.commitments[slot] != commitment.commitment
+                || usize::from(signed_set.slot) != slot
+                || commitment
+                    .signature
+                    .verify(
+                        key,
+                        game_input_message_hash_v1(&self.network_id, commitment).as_ref(),
+                    )
+                    .is_err()
+                || signed_set.signature.verify(key, set_hash.as_ref()).is_err()
+            {
+                return Err("kill commitment, reveal or peer signature invalid".into());
+            }
+        }
+        if self.plane_rows.len() != PLANE_COUNT {
+            return Err("omitted or extra wall/body slab".into());
+        }
+        for (index, row) in self.plane_rows.iter().enumerate() {
+            if row[..3] != expected_plane_inputs(index)
+                || !(-1..=Q20 + 1).contains(&row[3])
+                || !matches!(row[4], 0 | 1)
+            {
+                return Err("altered slab source or claimed fraction domain".into());
+            }
+        }
+        for shooter in 0..SHOOTERS {
+            let selected = select_target(&self.plane_rows, shooter)?;
+            if selected != 3 || self.selected_targets[shooter] != selected {
+                return Err("selected kill target differs from ordered proved slabs".into());
+            }
+        }
+        if self.tick_rows.len() != TICKS {
+            return Err("omitted or extra combat transition".into());
+        }
+        for (tick, row) in self.tick_rows.iter().enumerate() {
+            if *row != tick_row(&self.states[tick], &self.states[tick + 1], tick) {
+                return Err("tick AIR row is not bound to complete projected boundaries".into());
+            }
+        }
+        let final_state = &self.states[TICKS];
+        if final_state.reserve.iter().sum::<u64>() + final_state.earnings.iter().sum::<u64>()
+            != 3000
+        {
+            return Err("terminal deposit and award sum is not conserved".into());
+        }
+        Ok(())
+    }
+}
+
+struct PlaneAir {
+    air: IntegerAirV1,
+    inputs: [Value; 3],
+    outputs: [Value; 2],
+}
+impl PlaneAir {
+    fn compile() -> Self {
+        let mut air = IntegerAirV1::default();
+        let inputs = std::array::from_fn(|_| {
+            bounded_input_v1(&mut air, -COORDINATE_LIMIT, COORDINATE_LIMIT)
+                .expect("bounded plane coordinate")
+        });
+        let plane = plane_v1(&mut air, inputs[0], inputs[1], inputs[2]);
+        let outputs = [plane.fraction, plane.nonzero];
+        for (index, value) in inputs.iter().copied().chain(outputs).enumerate() {
+            air.equate(value, Value::fixed(index, value.low, value.high));
+        }
+        Self {
+            air,
+            inputs,
+            outputs,
+        }
+    }
+}
+
+struct Adapter {
+    statement: ArenaKillResearchStatementV1,
+    plane: PlaneAir,
+    tick: ArenaKillTickAirV1,
+}
+impl Adapter {
+    fn new(statement: ArenaKillResearchStatementV1) -> Result<Self, String> {
+        statement.validate()?;
+        let plane = PlaneAir::compile();
+        let tick = ArenaKillTickAirV1::compile();
+        for (index, value) in tick.inputs.iter().copied().enumerate() {
+            let Source::Column(_) = value.source else {
+                return Err(format!("kill tick input {index} is not a witness column"));
+            };
+        }
+        for (index, value) in plane
+            .inputs
+            .iter()
+            .copied()
+            .chain(plane.outputs)
+            .enumerate()
+        {
+            let Source::Column(_) = value.source else {
+                return Err(format!("kill plane column {index} changed"));
+            };
+        }
+        Ok(Self {
+            statement,
+            plane,
+            tick,
+        })
+    }
+    fn air_width(&self) -> usize {
+        self.plane.air.width().max(self.tick.air.width())
+    }
+    fn stage_values(&self, stage: usize) -> [i64; FIXED_VALUES] {
+        let mut values = [0_i64; FIXED_VALUES];
+        if stage < TICKS {
+            values[..arena_kill_air::INPUT_COUNT].copy_from_slice(&self.statement.tick_rows[stage]);
+            values[arena_kill_air::INPUT_COUNT] = 1;
+        } else {
+            values[..PLANE_VALUES].copy_from_slice(&self.statement.plane_rows[stage - TICKS]);
+        }
+        values
+    }
+    fn columns(&self) -> Vec<Vec<F>> {
+        let mut columns = vec![vec![F::ZERO; TRACE_SIZE]; NOTE_COPY_WIDTH_V1 + self.air_width()];
+        for stage in 0..STAGES {
+            let values = self.stage_values(stage);
+            let witness = if stage < TICKS {
+                self.tick.air.witness(
+                    &values[..arena_kill_air::INPUT_COUNT],
+                    &values[..arena_kill_air::INPUT_COUNT],
+                )
+            } else {
+                self.plane
+                    .air
+                    .witness(&values[..3], &values[..PLANE_VALUES])
+            };
+            for (column, value) in witness.into_iter().enumerate() {
+                for row in (stage..TRACE_SIZE).step_by(STAGES) {
+                    columns[NOTE_COPY_WIDTH_V1 + column][row] = field(value);
+                }
+            }
+        }
+        columns
+    }
+}
