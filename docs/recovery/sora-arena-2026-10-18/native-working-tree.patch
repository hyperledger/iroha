+//! Unregistered bounded bonded Arena kill and exact FFA award research fixture.
+
+use iroha_core::execution_proofs::{
+    arena_kill_research::{
+        ArenaKillResearchStatementV1, canonical_input_v1, expected_states_v1,
+        prove_research_kill_v1, reference_plane_rows_v1, reference_tick_rows_v1,
+        research_genesis_root_v1, research_geometry_v1, research_manifest_v1, research_map_hash_v1,
+        research_rules_hash_v1, verify_research_kill_v1,
+    },
+    compiled_execution_profile_v1, initial_game_state_root_v1,
+};
+use iroha_crypto::{Algorithm, Hash, HashOf, KeyPair, Signature};
+use iroha_data_model::{
+    NetworkId,
+    account::AccountId,
+    block::BlockHeader,
+    game::{
+        GameAdmissionBodyV1, GameAdmissionParticipantV1, GameCommitmentSetV1, GameForcedBatchV1,
+        GameInputCommitmentV1, GameInputRevealV1, GameSlotSignatureV1, game_commitment_set_hash_v1,
+        game_input_commitment_v1, game_input_message_hash_v1, game_message_hash_v1,
+    },
+};
+use iroha_primitives::numeric::Quantity;
+
+fn input_keys() -> [KeyPair; 3] {
+    std::array::from_fn(|slot| {
+        KeyPair::try_from_seed(vec![slot as u8 + 121; 32], Algorithm::Ed25519).unwrap()
+    })
+}
+fn fixture() -> ArenaKillResearchStatementV1 {
+    let network_id = NetworkId::from_genesis_hash(HashOf::<BlockHeader>::from_untyped_unchecked(
+        Hash::new(b"arena-kill-research-isolated-network"),
+    ));
+    let session_id = Hash::new(b"arena-kill-research-bonded-unfunded-session");
+    let keys = input_keys();
+    let manifest = research_manifest_v1();
+    let admission = GameAdmissionBodyV1 {
+        version: 1,
+        participants: (0..3)
+            .map(|slot| {
+                let wallet =
+                    KeyPair::try_from_seed(vec![slot as u8 + 41; 32], Algorithm::Ed25519).unwrap();
+                GameAdmissionParticipantV1 {
+                    account: AccountId::new(wallet.public_key().clone()),
+                    input_key: keys[slot].public_key().clone(),
+                    deposit: Quantity::from(1000_u32),
+                    application_data: vec![0, 0, u8::from(slot < 2)],
+                }
+            })
+            .collect(),
+        wagers: vec![],
+        resources: vec![],
+    };
+    let genesis_root =
+        research_genesis_root_v1(&network_id, session_id, &manifest, &admission).unwrap();
+    let batch = GameForcedBatchV1 {
+        epoch: 0,
+        start_tick: 0,
+        inputs: (0..3).map(canonical_input_v1).collect(),
+        dnf_slots: vec![],
+    };
+    let reveals: Vec<_> = (0..3)
+        .map(|slot| GameInputRevealV1 {
+            session_id,
+            epoch: 0,
+            start_tick: 0,
+            slot: slot as u8,
+            payload: batch.inputs[slot].clone(),
+            salt: Hash::new([slot as u8, 31, 9, 4]),
+        })
+        .collect();
+    let commitments: Vec<_> = (0..3)
+        .map(|slot| {
+            let mut item = GameInputCommitmentV1 {
+                session_id,
+                epoch: 0,
+                start_tick: 0,
+                slot: slot as u8,
+                commitment: game_input_commitment_v1(&network_id, &reveals[slot]),
+                signature: Signature::new(keys[slot].private_key(), b"temporary"),
+            };
+            let digest = game_input_message_hash_v1(&network_id, &item);
+            item.signature = Signature::new(keys[slot].private_key(), digest.as_ref());
+            item
+        })
+        .collect();
+    let parent_transcript_root = game_message_hash_v1(
+        &network_id,
+        "arena-kill-research-empty-transcript",
+        &(session_id, genesis_root),
+    );
+    let mut commitment_set = GameCommitmentSetV1 {
+        session_id,
+        epoch: 0,
+        start_tick: 0,
+        parent_transcript_root,
+        commitments: commitments.iter().map(|item| item.commitment).collect(),
+        signatures: vec![],
+    };
+    let digest = game_commitment_set_hash_v1(&network_id, &commitment_set);
+    commitment_set.signatures = (0..3)
+        .map(|slot| GameSlotSignatureV1 {
+            slot: slot as u8,
+            signature: Signature::new(keys[slot].private_key(), digest.as_ref()),
+        })
+        .collect();
+    ArenaKillResearchStatementV1 {
+        network_id,
+        session_id,
+        manifest,
+        admission,
+        genesis_root,
+        rules_hash: research_rules_hash_v1(),
+        map_hash: research_map_hash_v1(),
+        commitments,
+        commitment_set,
+        reveals,
+        batch,
+        states: expected_states_v1(),
+        plane_rows: reference_plane_rows_v1(),
+        selected_targets: [3; 2],
+        tick_rows: reference_tick_rows_v1(),
+    }
+}
+
+#[test]
+fn exact_bonded_peer_history_and_kill_preflight() {
+    let valid = fixture();
+    valid.validate().unwrap();
+    assert!(compiled_execution_profile_v1(&valid.manifest.profile_id).is_none());
+    assert!(
+        initial_game_state_root_v1(&valid.network_id, &valid.manifest, &valid.admission).is_err()
+    );
+    let (width, constraints, cap) = research_geometry_v1(valid.clone()).unwrap();
+    eprintln!("kill_geometry=({width},{constraints},{cap})");
+    assert!(width > 0 && constraints > 0 && cap < 4 * 1024 * 1024);
+    let final_state = valid.states.last().unwrap();
+    assert_eq!(final_state.health, [125, 125, 0]);
+    assert_eq!(final_state.reserve, [1000, 1000, 900]);
+    assert_eq!(final_state.earnings, [20, 80, 0]);
+    assert_eq!(final_state.paid_deaths, [0, 0, 1]);
+    assert_eq!(final_state.kills, [0, 1, 0]);
+    assert_eq!(final_state.deaths, [0, 0, 1]);
+    assert!(final_state.terminal);
+    for (name, mut bad) in [
+        ("wrong bond", valid.clone()),
+        ("wrong input", valid.clone()),
+        ("wrong target", valid.clone()),
+        ("forged health", valid.clone()),
+        ("forged death", valid.clone()),
+        ("forged reserve", valid.clone()),
+        ("forged killer award", valid.clone()),
+        ("forged assist award", valid.clone()),
+        ("forged signed reveal", valid.clone()),
+    ] {
+        match name {
+            "wrong bond" => bad.admission.participants[2].deposit = Quantity::from(1010_u32),
+            "wrong input" => bad.batch.inputs[0][0] = 0,
+            "wrong target" => bad.selected_targets[1] = 1,
+            "forged health" => bad.states[25].health[2] = 1,
+            "forged death" => bad.states[25].alive[2] = true,
+            "forged reserve" => bad.states[25].reserve[2] = 1000,
+            "forged killer award" => bad.states[25].earnings[1] = 90,
+            "forged assist award" => bad.states[25].earnings[0] = 30,
+            "forged signed reveal" => bad.reveals[1].payload[0] ^= 1,
+            _ => unreachable!(),
+        }
+        assert!(bad.validate().is_err(), "accepted {name}");
+    }
+}
+
+#[test]
+#[ignore = "native kill proof takes minutes; run explicitly after preflight"]
+fn prove_and_save_kill() {
+    let path = std::env::var("ARENA_KILL_PROOF_PATH").expect("proof path");
+    let statement = fixture();
+    let started = std::time::Instant::now();
+    let proof = prove_research_kill_v1(statement.clone()).unwrap();
+    eprintln!(
+        "kill_prove_ms={} kill_proof_bytes={}",
+        started.elapsed().as_millis(),
+        proof.len()
+    );
+    std::fs::write(&path, &proof).unwrap();
+    verify_research_kill_v1(statement, &proof).unwrap();
+}
+
+#[test]
+#[ignore = "verify a proof file saved by another process"]
+fn independently_verify_saved_kill() {
+    let path = std::env::var("ARENA_KILL_PROOF_PATH").expect("proof path");
+    let proof = std::fs::read(&path).unwrap();
+    let statement = fixture();
+    let started = std::time::Instant::now();
+    verify_research_kill_v1(statement.clone(), &proof).unwrap();
+    eprintln!("kill_verify_ms={}", started.elapsed().as_millis());
+    let mut bad = statement.clone();
+    bad.selected_targets[0] = 2;
+    assert!(verify_research_kill_v1(bad, &proof).is_err());
+    let mut bad = statement.clone();
+    bad.plane_rows[0][3] += 1; // plausible but false fraction; preflight accepts, proof rejects
+    bad.validate().unwrap();
+    assert!(verify_research_kill_v1(bad, &proof).is_err());
+    let mut bad = statement.clone();
+    bad.states[25].reserve[2] = 1000;
+    assert!(verify_research_kill_v1(bad, &proof).is_err());
+    let mut damaged = proof.clone();
+    let index = damaged.len() / 2;
+    damaged[index] ^= 1;
+    assert!(verify_research_kill_v1(statement, &damaged).is_err());
+}
