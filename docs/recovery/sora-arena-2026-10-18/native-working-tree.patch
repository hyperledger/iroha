+++ b/crates/iroha_core/src/execution_proofs/arena_movement_air.rs
@@ -0,0 +1,48 @@
+//! Unregistered research AIR for one restricted, collision-free Arena movement step.
+//!
+//! Only a Samurai's forward axis, cardinal yaw, no buttons and zero pitch are
+//! admitted. The exact input bytes and the collision-free spawn corridor are
+//! checked by the surrounding research statement before this arithmetic proof.
+
+use super::integer_air::{IntegerAirV1, Value};
+
+pub(super) const INPUT_COUNT: usize = 6;
+pub(super) const OLD_X: usize = 0;
+pub(super) const OLD_Y: usize = 1;
+pub(super) const MOVE_X: usize = 2;
+pub(super) const HEADING: usize = 3;
+pub(super) const NEXT_X: usize = 4;
+pub(super) const NEXT_Y: usize = 5;
+
+pub(super) struct ArenaMovementAirV1 {
+    pub(super) air: IntegerAirV1,
+    pub(super) inputs: [Value; INPUT_COUNT],
+}
+
+impl ArenaMovementAirV1 {
+    pub(super) fn compile() -> Self {
+        let mut air = IntegerAirV1::default();
+        let inputs = [
+            air.input(-20_000, 20_000),
+            air.input(-200, 200),
+            air.input(-127, 127),
+            air.input(0, 3),
+            air.input(-20_000, 20_000),
+            air.input(-200, 200),
+        ];
+        // Exact cardinal vectors from arena-core::math::direction(yaw, 0).
+        let directions = air.lookup_columns(inputs[HEADING], &[&[1, 0, -1, 0], &[0, 1, 0, -1]]);
+        // With move_y=0 and |move_x|<=127, the kernel's L1 norm is exactly 127.
+        // Multiplying Q15 forward by 80/(32767*127) cancels the Q15 factor.
+        // IntegerAirV1::divide constrains Rust-style truncation toward zero.
+        let speed_numerator = air.mul_constant(inputs[MOVE_X], 80);
+        let step = air.divide(speed_numerator, 127);
+        let dx = air.mul(step, directions[0]);
+        let dy = air.mul(step, directions[1]);
+        let x = air.add(inputs[OLD_X], dx);
+        let y = air.add(inputs[OLD_Y], dy);
+        air.equate(inputs[NEXT_X], x);
+        air.equate(inputs[NEXT_Y], y);
+        Self { air, inputs }
+    }
+}
diff --git a/crates/iroha_core/src/execution_proofs/arena_movement_research.rs b/crates/iroha_core/src/execution_proofs/arena_movement_research.rs
