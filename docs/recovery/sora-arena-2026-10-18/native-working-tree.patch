+//! Adversarial tests of the actual native catalog policy with explicit ledger projections.
+use super::*;
+use iroha_crypto::{Algorithm, HashOf, KeyPair};
+use iroha_data_model::{
+    Registrable,
+    block::BlockHeader,
+    game::{GameAccessV1, GamePayoutPolicyV1},
+    game_resources::GameResourceReturnPolicyV1,
+};
+use iroha_model_base::metadata::Metadata;
+use iroha_primitives::json::Json;
+use std::collections::{BTreeMap, BTreeSet};
+
+#[derive(Clone, Default)]
+struct Ledger {
+    publishers: BTreeMap<Hash, GameEquipmentPublisherV1>,
+    catalogs: BTreeMap<Hash, GameEquipmentCatalogRecordV1>,
+    domains: BTreeMap<DomainId, Domain>,
+    nfts: BTreeMap<NftId, NftData>,
+    reservations: BTreeMap<NftId, AccountId>,
+    custody: BTreeMap<AccountId, NftCustodyRecordV1>,
+    accounts: BTreeSet<AccountId>,
+}
+impl GameEquipmentLedgerV1 for Ledger {
+    fn publisher(&self, id: &Hash) -> Option<&GameEquipmentPublisherV1> {
+        self.publishers.get(id)
+    }
+    fn catalog(&self, id: &Hash) -> Option<&GameEquipmentCatalogRecordV1> {
+        self.catalogs.get(id)
+    }
+    fn domain(&self, id: &DomainId) -> Option<&Domain> {
+        self.domains.get(id)
+    }
+    fn nft(&self, id: &NftId) -> Option<&NftData> {
+        self.nfts.get(id)
+    }
+    fn reservation(&self, id: &NftId) -> Option<&AccountId> {
+        self.reservations.get(id)
+    }
+    fn custody(&self, id: &AccountId) -> Option<&NftCustodyRecordV1> {
+        self.custody.get(id)
+    }
+    fn account_exists(&self, id: &AccountId) -> bool {
+        self.accounts.contains(id)
+    }
+}
+fn account(seed: u8) -> AccountId {
+    AccountId::new(
+        KeyPair::try_from_seed(vec![seed; 32], Algorithm::Ed25519)
+            .unwrap()
+            .public_key()
+            .clone(),
+    )
+}
+fn fixture() -> (Ledger, GameEquipmentCatalogV1, GameManifestV1) {
+    let owner = account(71);
+    let collection = DomainId::parse_fully_qualified("equipment.universal").unwrap();
+    let network = NetworkId::from_genesis_hash(HashOf::<BlockHeader>::from_untyped_unchecked(
+        Hash::new(b"catalog network"),
+    ));
+    let content = Metadata::default();
+    let nft: NftId = "a$equipment.universal".parse().unwrap();
+    let catalog = GameEquipmentCatalogV1 {
+        version: 1,
+        network_id: network,
+        publisher: owner.clone(),
+        application_seed: Hash::new(b"application"),
+        collection: collection.clone(),
+        profile_id: Hash::new(b"compiled relation"),
+        role_id: Hash::new(b"equipment role"),
+        policy: GameResourceReturnPolicyV1::ReturnToOriginalOwnerAtTerminal,
+        members: vec![GameEquipmentCatalogMemberV1 {
+            nft_id: nft.clone(),
+            metadata_hash: Hash::new(content.encode()),
+        }],
+    };
+    let terms = catalog.publisher_terms();
+    let ledger = Ledger {
+        publishers: [(terms.id(), terms)].into(),
+        domains: [(collection.clone(), Domain::new(collection).build(&owner))].into(),
+        nfts: [(
+            nft,
+            NftData {
+                content,
+                owned_by: owner.clone(),
+            },
+        )]
+        .into(),
+        accounts: [owner, account(72)].into(),
+        ..Ledger::default()
+    };
+    let manifest = GameManifestV1 {
+        version: 1,
+        application_id: game_equipment_application_id_v1(
+            &network,
+            &catalog.publisher,
+            &catalog.application_seed,
+        ),
+        profile_id: catalog.profile_id,
+        application_parameters: vec![],
+        min_participants: 2,
+        max_participants: 8,
+        batch_ticks: 6,
+        max_ticks: 60,
+        max_input_bytes: 8,
+        max_participant_data_bytes: 64,
+        access: GameAccessV1::Public,
+        payout_policy: GamePayoutPolicyV1::NoPayout,
+    };
+    (ledger, catalog, manifest)
+}
+fn publish(
+    ledger: &Ledger,
+    catalog: &GameEquipmentCatalogV1,
+) -> Result<(Hash, GameEquipmentCatalogRecordV1), String> {
+    prepare_game_equipment_catalog_v1(
+        ledger,
+        &catalog.network_id,
+        &catalog.publisher,
+        10,
+        catalog.clone(),
+    )
+}
+
+#[test]
+fn publication_requires_genesis_trust_not_ownership_or_self_declared_metadata() {
+    let (ledger, catalog, _) = fixture();
+    publish(&ledger, &catalog).unwrap();
+    let mut untrusted = ledger.clone();
+    untrusted.publishers.clear();
+    assert!(publish(&untrusted, &catalog).is_err());
+    let mut substituted = ledger.clone();
+    substituted.publishers.values_mut().next().unwrap().role_id = Hash::new(b"other role");
+    assert!(publish(&substituted, &catalog).is_err());
+    let mut owner_claim = catalog.clone();
+    owner_claim.publisher = account(72);
+    assert!(publish(&ledger, &owner_claim).is_err());
+    assert!(ledger.catalogs.is_empty());
+}
+
+#[test]
+fn publication_rejects_wrong_owner_metadata_reservation_network_height_and_replay() {
+    let (ledger, catalog, _) = fixture();
+    for mutation in 0..5 {
+        let mut invalid = ledger.clone();
+        match mutation {
+            0 => invalid.domains.values_mut().next().unwrap().owned_by = account(72),
+            1 => invalid.nfts.values_mut().next().unwrap().owned_by = account(72),
+            2 => {
+                invalid
+                    .nfts
+                    .values_mut()
+                    .next()
+                    .unwrap()
+                    .content
+                    .insert("altered".parse().unwrap(), Json::from(true));
+            }
+            3 => {
+                invalid
+                    .reservations
+                    .insert(catalog.members[0].nft_id.clone(), account(72));
+            }
+            _ => {
+                invalid.accounts.remove(&catalog.publisher);
+            }
+        }
+        assert!(publish(&invalid, &catalog).is_err(), "mutation {mutation}");
+        assert!(invalid.catalogs.is_empty());
+    }
+    assert!(
+        prepare_game_equipment_catalog_v1(
+            &ledger,
+            &catalog.network_id,
+            &account(72),
+            10,
+            catalog.clone()
+        )
+        .is_err()
+    );
+    assert!(
+        prepare_game_equipment_catalog_v1(
+            &ledger,
+            &catalog.network_id,
+            &catalog.publisher,
+            0,
+            catalog.clone()
+        )
+        .is_err()
+    );
+    let wrong_network = NetworkId::from_genesis_hash(
+        HashOf::<BlockHeader>::from_untyped_unchecked(Hash::new(b"another network")),
+    );
+    assert!(
+        prepare_game_equipment_catalog_v1(
+            &ledger,
+            &wrong_network,
+            &catalog.publisher,
+            10,
+            catalog.clone()
+        )
+        .is_err()
+    );
+    let mut used = ledger;
+    let (id, record) = publish(&used, &catalog).unwrap();
+    used.catalogs.insert(id, record);
+    assert!(publish(&used, &catalog).is_err());
+}
+
+#[test]
+fn application_binding_rejects_catalog_substitution_and_does_not_follow_new_collection_owner() {
+    let (mut ledger, catalog, manifest) = fixture();
+    let (id, record) = publish(&ledger, &catalog).unwrap();
+    ledger.catalogs.insert(id, record);
+    let bind = |ledger: &Ledger, manifest: &GameManifestV1, height, role: &Hash| {
+        validate_game_equipment_binding_v1(ledger, &catalog.network_id, height, manifest, &id, role)
+            .map(|_| ())
+    };
+    bind(&ledger, &manifest, 10, &catalog.role_id).unwrap();
+    assert!(bind(&ledger, &manifest, 9, &catalog.role_id).is_err());
+    assert!(bind(&ledger, &manifest, 10, &Hash::new(b"other role")).is_err());
+    let mut wrong = manifest.clone();
+    wrong.profile_id = Hash::new(b"other relation");
+    assert!(bind(&ledger, &wrong, 10, &catalog.role_id).is_err());
+    wrong = manifest.clone();
+    wrong.application_id = game_equipment_application_id_v1(
+        &catalog.network_id,
+        &account(72),
+        &catalog.application_seed,
+    );
+    assert!(bind(&ledger, &wrong, 10, &catalog.role_id).is_err());
+    ledger.domains.values_mut().next().unwrap().owned_by = account(72);
+    ledger.nfts.clear(); // Historical catalog approval survives legitimate later lifecycle changes.
+    bind(&ledger, &manifest, 20, &catalog.role_id).unwrap();
+    let mut corrupt = ledger.clone();
+    corrupt.catalogs.get_mut(&id).unwrap().catalog.members[0].metadata_hash = Hash::new(b"forged");
+    assert!(bind(&corrupt, &manifest, 20, &catalog.role_id).is_err());
+    ledger.publishers.clear();
+    assert!(bind(&ledger, &manifest, 20, &catalog.role_id).is_err());
+}
+
+#[test]
+fn publication_caps_individual_and_aggregate_metadata_work() {
+    let (mut ledger, mut catalog, _) = fixture();
+    let mut content = Metadata::default();
+    content.insert(
+        "large".parse().unwrap(),
+        Json::from(
+            "x".repeat(GAME_EQUIPMENT_NFT_METADATA_MAX_BYTES_V1)
+                .as_str(),
+        ),
+    );
+    let oversized = NftData {
+        content,
+        owned_by: catalog.publisher.clone(),
+    };
+    assert!(equipment_metadata_hash_v1(&oversized).is_err());
+    let mut content = Metadata::default();
+    content.insert(
+        "large".parse().unwrap(),
+        Json::from("x".repeat(60_000).as_str()),
+    );
+    let nft = NftData {
+        content,
+        owned_by: catalog.publisher.clone(),
+    };
+    let metadata_hash = equipment_metadata_hash_v1(&nft).unwrap().0;
+    catalog.members.clear();
+    ledger.nfts.clear();
+    for i in 0..18 {
+        let id: NftId = format!("kit{i:02}$equipment.universal").parse().unwrap();
+        ledger.nfts.insert(id.clone(), nft.clone());
