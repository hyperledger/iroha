+#[test]
+fn catalog_membership_and_identity_do_not_normalize_or_accept_substitutions() {
+    let (_, catalog, _) = fixture();
+    let member = &catalog.members[0];
+    catalog
+        .member(&member.nft_id, member.metadata_hash)
+        .unwrap();
+    assert!(
+        catalog
+            .member(
+                &"b$equipment.universal".parse().unwrap(),
+                member.metadata_hash
+            )
+            .is_err()
+    );
+    assert!(
+        catalog
+            .member(&member.nft_id, Hash::new(b"other metadata"))
+            .is_err()
+    );
+    let mut duplicate = catalog.clone();
+    duplicate.members.push(member.clone());
+    assert!(duplicate.validate().is_err());
+    let mut wrong_collection = catalog.clone();
+    wrong_collection.members[0].nft_id = "a$other.universal".parse().unwrap();
+    assert!(wrong_collection.validate().is_err());
+    let mut changed = catalog.clone();
+    changed.members[0].metadata_hash = Hash::new(b"changed approved metadata");
+    assert_ne!(changed.id(), catalog.id());
+    assert_eq!(
+        changed.publisher_terms().id(),
+        catalog.publisher_terms().id()
+    );
+    changed = catalog.clone();
+    changed.role_id = Hash::new(b"other role");
+    assert_ne!(
+        changed.publisher_terms().id(),
+        catalog.publisher_terms().id()
+    );
+}
