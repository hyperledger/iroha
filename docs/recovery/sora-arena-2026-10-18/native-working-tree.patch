+//! Unregistered, unfunded staged proof of one genesis-derived Arena ranged hit.
+//!
+//! The native AIR proves each ordered wall/body slab fraction and the selected
+//! victim's damage transition in one masked STARK. The verifier performs the
+//! small deterministic nearest-target reduction over those proved public slab
+//! values, including wall-first and strict-less tie behavior. Admission and a
+//! complete canonical two-tick peer-signed batch bind the fixed research state.
+//! This is not a ledger-selected batch or a qualified match execution profile.
+
+use super::{
+    arena_damage_air::{ArenaDamageAirV1, INPUT_COUNT as DAMAGE_INPUT_COUNT},
+    arena_geometry_air::{COORDINATE_LIMIT, Q20, plane_v1},
+    checked_integer_air::bounded_input_v1,
+    integer_air::{IntegerAirV1, Source, Value, field},
+    registry::compiled_execution_profile_v1,
+    stark::{
+        aggregate_stark::{
+            AggregateProofLayoutV1, AggregateStarkDomainsV1, AggregateStarkParametersV1,
+            AggregateTraceGroupLayoutV1, maximum_encoded_proof_with_deep_bytes_v1,
+        },
+        proof_managed_note_stark::{
+            NOTE_COPY_AUX_WIDTH_V1, NOTE_COPY_FIXED_WIDTH_V1, NOTE_COPY_WIDTH_V1,
+            NoteCopyCellPolicyV1, NoteCopyChallengesV1, NoteCopyScheduleV1,
+            ProofManagedNoteStarkAdapterV1, ProofManagedNoteStarkErrorV1 as NativeError,
+            ProofManagedNoteStarkProtocolV1, prove_proof_managed_note_stark_v1,
+            verify_proof_managed_note_stark_v1,
+        },
+        transparent_stark::{
+            GoldilocksDigest384V1, GoldilocksFieldV1 as F, TransparentStarkDigestContextV1,
+            TransparentTranscriptV1, goldilocks_digest384_frame_v1,
+        },
+    },
+};
+use iroha_crypto::{Algorithm, Hash};
+use iroha_data_model::{
+    NetworkId,
+    game::{
+        GameAccessV1, GameAdmissionBodyV1, GameCommitmentSetV1, GameForcedBatchV1,
+        GameInputCommitmentV1, GameInputRevealV1, GameManifestV1, GamePayoutPolicyV1,
+        game_commitment_set_hash_v1, game_input_commitment_v1, game_input_message_hash_v1,
+        game_message_hash_v1,
+    },
+};
+use iroha_primitives::numeric::Quantity;
+use norito::codec::Encode;
+use sha2::{Digest, Sha256};
+
+const TRACE_LOG: u8 = 13;
+const TRACE_SIZE: usize = 1 << TRACE_LOG;
+const MAX_PROOF_BYTES: usize = 4 * 1024 * 1024;
+const PLANE_VALUES: usize = 5;
+const FIXED_VALUES: usize = DAMAGE_INPUT_COUNT + 1;
+const BOX_COUNT: usize = 5; // three walls, two eligible bodies
+const PLANE_COUNT: usize = BOX_COUNT * 3 * 2;
+const STAGES: usize = PLANE_COUNT + 1;
+const CONTEXT: TransparentStarkDigestContextV1 =
+    TransparentStarkDigestContextV1::execution_v1(b"arena-ranged-hit-research-v1");
+const DESCRIPTOR: &[u8] = b"unregistered-arena-ranged-hit-research-v1:rules=arena-first-release-6:three-player-genesis:map0:two-tick-canonical-peer-batch:one-samurai-arc-carbine-shot:thirty-slab-planes:damage-stage:verifier-nearest-target-reduction:no-XOR:no-qualification";
+// Manually fixed research specification, NOT a cryptographic hash of all arena-core source.
+// The integration fixture separately checks parity with the current reference kernel.
+const RULES: &[u8] = b"arena-core:sora-arena-first-release-6:mode=FFA:map0:offline=true:base-bond=0:players=(team0,class0,weapon1),(team0,class0,weapon0),(team0,class0,weapon0):spawn=(18000,0),(-18000,0),(0,18000):health=125:stamina=100:arc-carbine=hitscan/damage22/range45000/cooldown12/magazine24/charge0:tick0-slot0=FIRE/yaw24576:tick1-all-idle:ray=(18000,0,1400)->(-13763,31763,1400):walls-first:players-ascending:strict-less-nearest:body-radius350/height1700:unprotected:damage22:tick2-terminal";
+const MAP_ZERO_WALLS: &[u8] = b"map0:walls=(-8000,-9000,-6500,6000,3800);(6500,-6000,8000,9000,3800);(-4000,7000,3500,8000,2300):radius=350:world-bounds=24000";
+const FROM: [i64; 3] = [18_000, 0, 1_400];
+const TO: [i64; 3] = [-13_763, 31_763, 1_400];
+const BOXES: [([i64; 3], [i64; 3]); BOX_COUNT] = [
+    ([-8_000, -9_000, 0], [-6_500, 6_000, 3_800]),
+    ([6_500, -6_000, 0], [8_000, 9_000, 3_800]),
+    ([-4_000, 7_000, 0], [3_500, 8_000, 2_300]),
+    ([-18_350, -350, 0], [-17_650, 350, 1_700]),
+    ([-350, 17_650, 0], [350, 18_350, 1_700]),
+];
+const SHOT: [u8; 8] = [1, 0, 0, 0, 0, 96, 0, 0];
+const IDLE: [u8; 8] = [0; 8];
+const DOMAINS: AggregateStarkDomainsV1 = AggregateStarkDomainsV1 {
+    digest_context: CONTEXT,
+    base_leaf: b"arena-ranged-base-leaf-v1",
+    base_node: b"arena-ranged-base-node-v1",
+    aux_leaf: b"arena-ranged-aux-leaf-v1",
+    aux_node: b"arena-ranged-aux-node-v1",
+    composition_leaf: b"arena-ranged-composition-leaf-v1",
+    composition_node: b"arena-ranged-composition-node-v1",
+    fri_leaf: b"arena-ranged-fri-leaf-v1",
+    fri_node: b"arena-ranged-fri-node-v1",
+    layout_label: b"arena-ranged-layout-v1",
+    base_root_label: b"arena-ranged-base-root-v1",
+    aux_root_label: b"arena-ranged-aux-root-v1",
+    composition_root_label: b"arena-ranged-composition-root-v1",
+    fri_root_label: b"arena-ranged-fri-root-v1",
+    fri_beta_label: b"arena-ranged-fri-beta-v1",
+    query_seed: b"arena-ranged-query-seed-v1",
+};
+
+/// Fixed research ID; absent from `COMPILED_ADAPTERS_V1`.
+#[must_use]
+pub fn research_profile_id_v1() -> Hash {
+    Hash::new(DESCRIPTOR)
+}
+
+/// Exact zero-bond two-tick peer research manifest.
+#[must_use]
+pub fn research_manifest_v1() -> GameManifestV1 {
+    GameManifestV1 {
+        version: 1,
+        application_id: Hash::new(b"sora-arena-ranged-hit-research-v1"),
+        profile_id: research_profile_id_v1(),
+        application_parameters: vec![0, 1],
+        min_participants: 3,
+        max_participants: 3,
+        batch_ticks: 2,
+        max_ticks: 2,
+        max_input_bytes: 16,
+        max_participant_data_bytes: 3,
+        access: GameAccessV1::Public,
+        payout_policy: GamePayoutPolicyV1::NoPayout,
+    }
+}
+
+/// Hash of the explicit restricted research rules above, not all game source.
+#[must_use]
+pub fn research_rules_hash_v1() -> Hash {
+    Hash::new(RULES)
+}
+
+/// Exact map-zero wall layout used in the research scene.
+#[must_use]
+pub fn research_map_hash_v1() -> Hash {
+    Hash::new(MAP_ZERO_WALLS)
+}
+
+/// Public state projection at a complete tick boundary. Fields outside this
+/// projection remain unproved and cannot be used for custody settlement.
+#[derive(Debug, Clone, PartialEq, Eq, Encode)]
+pub struct RangedResearchStateV1 {
+    /// Complete 60 Hz tick count.
+    pub tick: u32,
+    /// Each player's x/y/z millimetre position in permanent slot order.
+    pub positions: [[i32; 3]; 3],
+    /// Integer health by permanent slot.
+    pub health: [i32; 3],
+    /// Integer stamina by permanent slot.
+    pub stamina: [i32; 3],
+    /// Remaining ammo by permanent slot.
+    pub ammo: [u16; 3],
+    /// Attack cooldown by permanent slot.
+    pub attack_cooldown: [u16; 3],
+    /// Current facing yaw by permanent slot.
+    pub yaw: [u16; 3],
+    /// Alive flags by permanent slot.
+    pub alive: [bool; 3],
+    /// Whether the two-tick offline research session is terminal.
+    pub terminal: bool,
+    /// Canonical tick/attacker/victim/damage history rows retained at this boundary.
+    pub damage_history: Vec<[u32; 4]>,
+    /// No fungible account is funded in this research fixture.
+    pub account_reserves: [u64; 3],
+}
+
+/// Exact reference-kernel projection for the fixed canonical inputs.
+#[must_use]
+pub fn expected_states_v1() -> [RangedResearchStateV1; 3] {
+    let positions = [[18_000, 0, 0], [-18_000, 0, 0], [0, 18_000, 0]];
+    let base = RangedResearchStateV1 {
+        tick: 0,
+        positions,
+        health: [125; 3],
+        stamina: [100; 3],
+        ammo: [24, 0, 0],
+        attack_cooldown: [0; 3],
+        yaw: [0; 3],
+        alive: [true; 3],
+        terminal: false,
+        damage_history: vec![],
+        account_reserves: [0; 3],
+    };
+    let mut shot = base.clone();
+    shot.tick = 1;
+    shot.health[2] = 103;
+    shot.ammo[0] = 23;
+    shot.attack_cooldown[0] = 12;
+    shot.yaw[0] = 24_576;
+    shot.damage_history.push([0, 0, 2, 22]);
+    let mut terminal = shot.clone();
+    terminal.tick = 2;
+    terminal.attack_cooldown[0] = 11;
+    terminal.yaw[0] = 0;
+    terminal.terminal = true;
+    [base, shot, terminal]
