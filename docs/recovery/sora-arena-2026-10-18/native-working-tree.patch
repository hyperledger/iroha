+    use iroha_model_base::peer::PeerId;
+
+    fn fixture() -> (NetworkId, Vec<ValidatorPower>) {
+        let network = NetworkId::from_genesis_hash(HashOf::<BlockHeader>::from_untyped_unchecked(
+            Hash::new(b"authority-generation-helper-test"),
+        ));
+        let mut roster = (1_u8..=4)
+            .map(|seed| ValidatorPower {
+                validator: PeerId::new(
+                    KeyPair::from_seed(vec![seed; 32], Algorithm::BlsNormal)
+                        .public_key()
+                        .clone(),
+                ),
+                power: 1,
+            })
+            .collect::<Vec<_>>();
+        roster.sort_by(|left, right| left.validator.cmp(&right.validator));
+        (network, roster)
+    }
+
+    #[test]
+    fn fixture_genesis_template_binds_exact_generation_and_keys() {
+        let (network, roster) = fixture();
+        let parameters = mint_finality_genesis_parameters(&roster);
+        parameters.validate().unwrap();
+        assert_eq!(parameters.authority_generation.generation, 0);
+        assert_eq!(
+            parameters
+                .authority_generation
+                .bind_network_id(network)
+                .unwrap(),
+            mint_finality_authority(network, 0, &roster),
+        );
+        assert_ne!(
+            mint_finality_template(0, &roster).validators,
+            mint_finality_template(1, &roster).validators,
+            "key derivation must bind the immutable generation",
+        );
+    }
+
+    #[test]
+    fn fixture_genesis_context_binds_complete_authorization() {
+        let (network, roster) = fixture();
+        let (authorization, authority) = mint_finality_context_fields(network, 0, 0, 1, 8, &roster);
+        authorization
+            .validate_against_authority(&authority)
+            .unwrap();
+        assert_eq!(authorization.network_id, network);
+        assert_eq!(
+            authorization.authority_id,
+            authority.authority_id().unwrap()
+        );
+        assert_eq!(
+            (
+                authorization.epoch,
+                authorization.first_height,
+                authorization.last_height
+            ),
+            (0, 1, 8)
+        );
+        assert_eq!(authorization.beacon, BeaconEpochBindingV1::Bootstrap);
+        assert_eq!(authorization.previous_authorization_id, [0; 32]);
+        assert_eq!(authorization.transition_id, [0; 32]);
+        assert_eq!(
+            authorization.decision,
+            KagemushaMintFinalityEpochDecisionV1::Genesis
+        );
+        let mut wrong_authority = authority;
+        wrong_authority.generation = 1;
+        assert!(
+            authorization
+                .validate_against_authority(&wrong_authority)
+                .is_err()
+        );
+    }
+
+    #[test]
+    fn fixture_successors_bind_predecessor_and_preserve_retained_generation() {
+        let (network, roster) = fixture();
+        let (genesis, authority) = mint_finality_context_fields(network, 0, 0, 1, 8, &roster);
+        let retained = mint_finality_successor_authorization(
+            &genesis,
+            &authority,
+            16,
+            KagemushaMintFinalityEpochDecisionV1::Retain,
+        );
+        assert_eq!(retained.authority_generation, 0);
+        assert_eq!(retained.authority_id, genesis.authority_id);
+        assert_eq!(
+            retained.previous_authorization_id,
+            genesis.authorization_id().unwrap()
+        );
+        assert_eq!(
+            (retained.epoch, retained.first_height, retained.last_height),
+            (1, 9, 16)
+        );
+        let cancelled = mint_finality_successor_authorization(
+            &retained,
+            &authority,
+            24,
+            KagemushaMintFinalityEpochDecisionV1::RetainAndCancel,
+        );
+        assert_eq!(cancelled.beacon, retained.beacon);
+        let next_authority = mint_finality_authority(network, 1, &roster);
+        let activated = mint_finality_successor_authorization(
+            &cancelled,
+            &next_authority,
+            32,
+            KagemushaMintFinalityEpochDecisionV1::Activate,
+        );
+        activated
+            .validate_against_authority(&next_authority)
+            .unwrap();
+        assert_eq!(activated.authority_generation, 1);
+        let mut wrong_predecessor = activated;
+        wrong_predecessor.previous_authorization_id = genesis.authorization_id().unwrap();
+        assert!(wrong_predecessor.validate_successor(&cancelled).is_err());
+    }
+}
