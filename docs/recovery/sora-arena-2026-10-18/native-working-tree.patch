+    let adapter = Adapter::new(statement)?;
+    let (maximum, envelope_maximum) = preflight(&adapter)?;
+    Ok((
+        adapter.air_width(),
+        adapter.profile_constraint_count_v1(),
+        maximum,
+        envelope_maximum,
+    ))
+}
