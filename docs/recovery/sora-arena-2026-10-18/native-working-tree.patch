+fn validate_admission(
+    manifest: &GameManifestV1,
+    admission: &GameAdmissionBodyV1,
+) -> Result<(), String> {
+    if *manifest != research_manifest_v1()
+        || compiled_execution_profile_v1(&manifest.profile_id).is_some()
+    {
+        return Err("ranged research profile must be exact and unregistered".into());
+    }
+    admission.validate()?;
+    if admission.participants.len() != 3
+        || !admission.wagers.is_empty()
+        || !admission.resources.is_empty()
+    {
+        return Err("ranged research needs exactly three unfunded participants".into());
+    }
+    for (slot, participant) in admission.participants.iter().enumerate() {
+        let weapon = if slot == 0 { 1 } else { 0 };
+        if participant.application_data != [0, 0, weapon]
+            || participant.deposit != Quantity::zero()
+            || participant.input_key.algorithm() != Algorithm::Ed25519
+        {
+            return Err("ranged research team/class/weapon/bond mismatch".into());
+        }
+    }
+    Ok(())
+}
