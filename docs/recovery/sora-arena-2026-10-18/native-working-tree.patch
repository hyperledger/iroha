+#!/usr/bin/env python3
+"""Run isolated native Arena damage AIR equations; this does not qualify a STARK.
+
+Prerequisites: the workspace Rust toolchain and previously built thiserror/zeroize
+rlibs in target/debug/deps. No Python packages or environment variables are needed.
+--target-dir may select an existing Cargo target. Outputs are confined to its
+arena-air-research subdirectory; no source or configuration file is changed.
+
+Includes the actual compiler/helper/relation sources and extracts the exact native
+Goldilocks base-field implementation. No replacement field or constraint is used.
+The full iroha_core test suite and integrated cryptographic verification remain
+separate requirements, even if this focused source harness passes.
+"""
+import argparse
+import hashlib
+from pathlib import Path
+import subprocess
+
+
+def main():
+    root = Path(__file__).resolve().parent.parent
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--target-dir", type=Path, default=root / "target",
+                        help="existing Cargo target containing debug/deps rlibs")
+    args = parser.parse_args()
+    target = args.target_dir.resolve()
+    deps = target / "debug/deps"
+    externs = []
+    for name in ["zeroize", "thiserror"]:
+        candidates = sorted(deps.glob("lib" + name + "-*.rlib"), key=lambda path: path.stat().st_mtime)
+        if not candidates:
+            parser.error("build workspace dependencies first; missing " + name + " in " + str(deps))
+        externs.extend(["--extern", name + "=" + str(candidates[-1])])
+    source_path = root / "crates/iroha_core/src/privacy_engines/transparent_stark.rs"
+    source = source_path.read_text()
+    start_mark = "/// Canonical Goldilocks field element."
+    end_mark = "/// Quartic extension of Goldilocks"
+    if source.count(start_mark) != 1 or source.count(end_mark) != 1:
+        parser.error("native field source boundaries changed; review the source harness")
+    start = source.index(start_mark)
+    end = source.index(end_mark, start)
+    constants = [line for line in source.splitlines() if
+                 line.startswith("pub(crate) const GOLDILOCKS_MODULUS_V1:") or
+                 line.startswith("const GOLDILOCKS_EPSILON_V1:")]
+    if len(constants) != 2:
+        parser.error("native field constant declarations changed")
+    field = "use zeroize::Zeroize as _;\n" + "\n".join(constants) + "\n" + source[start:end]
+    output = target / "arena-air-research"
+    output.mkdir(parents=True, exist_ok=True)
+    (output / "native_goldilocks.rs").write_text(field)
+    modules = []
+    provenance = ["field_extraction " + hashlib.sha256(field.encode()).hexdigest()]
+    for name in ["integer_air", "checked_integer_air", "arena_damage_air", "arena_aim_air", "arena_geometry_air", "arena_hit_air"]:
+        path = root / "crates/iroha_core/src/execution_proofs" / (name + ".rs")
+        modules.append('#[path = "' + str(path).replace("\\", "\\\\").replace('"', '\\"') + '"] mod ' + name + ";")
+        provenance.append(name + " " + hashlib.sha256(path.read_bytes()).hexdigest())
+    harness = ('#![allow(dead_code)]\nmod privacy_engines { pub mod transparent_stark { '
+               'include!("native_goldilocks.rs"); } }\nmod execution_proofs {\n' +
+               "\n".join(modules) + "\n}\n")
+    harness_path = output / "harness.rs"
+    harness_path.write_text(harness)
+    binary = output / "harness"
+    subprocess.run(["rustc", "--edition=2024", "--test", str(harness_path),
+                    "-L", "dependency=" + str(deps), "-o", str(binary)] + externs, check=True, cwd=root)
+    result = subprocess.run([str(binary), "--nocapture"], check=True, text=True, capture_output=True, cwd=root)
+    report = ("Isolated native AIR equation tests only; no profile qualification.\n" +
+              "\n".join(provenance) + "\n" + result.stdout + result.stderr)
+    (output / "results.log").write_text(report)
+    print(report)
+
+
+if __name__ == "__main__":
+    main()
