+        let (q, r) = divmod_unsigned_v1(&mut air, numerator, denominator).unwrap();
+        let Source::Column(qc) = q.source else {
+            panic!("quotient column")
+        };
+        let Source::Column(rc) = r.source else {
+            panic!("remainder column")
+        };
+        for n in [0, 1, 31, 999, 1000] {
+            for d in 1..=31 {
+                let values = air.witness(&[n, d], &[]);
+                assert_eq!((values[qc], values[rc]), (n / d, n % d));
+                let row = values.into_iter().map(field).collect::<Vec<_>>();
+                assert!(air.residues(&row, &row, &[]).iter().all(|x| *x == F::ZERO));
+                for column in [qc, rc] {
+                    let mut forged = row.clone();
+                    forged[column] = forged[column].add(F::ONE);
+                    assert!(
+                        air.residues(&forged, &forged, &[])
+                            .iter()
+                            .any(|x| *x != F::ZERO)
+                    );
+                }
+            }
+        }
+        for input in [[-1, 2], [1001, 2], [100, 0], [100, 32], [100, -1]] {
+            let row = air
+                .witness(&input, &[])
+                .into_iter()
+                .map(field)
+                .collect::<Vec<_>>();
+            assert!(air.residues(&row, &row, &[]).iter().any(|x| *x != F::ZERO));
+        }
+    }
+
+    #[test]
+    fn variable_division_rejects_consistent_false_euclidean_and_field_assignments() {
+        let mut air = IntegerAirV1::default();
+        let n = air.input(0, 1000);
+        let d = air.input(1, 31);
+        let (q, r) = divmod_unsigned_v1(&mut air, n, d).unwrap();
+        let Source::Column(qc) = q.source else {
+            panic!("column")
+        };
+        let Source::Column(rc) = r.source else {
+            panic!("column")
+        };
+        let inputs = [field(100), field(7)];
+        let honest = field_assignment_with_overrides(&air, &inputs, &[]);
+        assert!(
+            air.residues(&honest, &honest, &[])
+                .iter()
+                .all(|v| *v == F::ZERO)
+        );
+        for (quotient, remainder) in [
+            (field(13), field(9)),
+            (field(15), field(-5)),
+            (field(100).mul(field(7).inv().unwrap()), F::ZERO),
+        ] {
+            // Each forgery preserves n=q*d+r, and every downstream auxiliary is
+            // recomputed. Only the Euclidean interval/integrality rules reject it.
+            assert_eq!(quotient.mul(inputs[1]).add(remainder), inputs[0]);
+            let forged =
+                field_assignment_with_overrides(&air, &inputs, &[(qc, quotient), (rc, remainder)]);
+            assert!(
+                air.residues(&forged, &forged, &[])
+                    .iter()
+                    .any(|v| *v != F::ZERO)
+            );
+        }
+    }
+
+    #[test]
+    fn variable_division_rejects_unsafe_graph_before_mutation() {
+        let mut air = IntegerAirV1::default();
+        for (n, d) in [
+            (Value::constant(-1), Value::constant(2)),
+            (Value::constant(1), Value::constant(0)),
+            (
+                Value {
+                    low: 0,
+                    high: 1_i64 << 44,
+                    ..Value::constant(0)
+                },
+                Value {
+                    low: 1,
+                    high: 1_i64 << 30,
+                    ..Value::constant(1)
+                },
+            ),
+        ] {
+            assert!(divmod_unsigned_v1(&mut air, n, d).is_err());
+            assert_eq!(air.width(), 0);
+        }
+    }
+
+    #[test]
+    fn bounded_quotient_admits_correlated_slabs_and_enforces_the_exact_cap() {
+        let mut air = IntegerAirV1::default();
+        let n = air.input(0, 1_i64 << 41);
+        let d = air.input(1, 1_i64 << 21);
+        let before = air.width();
+        assert!(divmod_unsigned_v1(&mut air, n, d).is_err());
+        assert_eq!(air.width(), before);
+        let (q, r) = divmod_unsigned_bounded_v1(&mut air, n, d, 1 << 20).unwrap();
+        let (Source::Column(qc), Source::Column(rc)) = (q.source, r.source) else {
+            panic!("quotient/remainder columns")
+        };
+        for (numerator, divisor) in [(0, 1), (1, 2), (1 << 20, 1), ((1_i64 << 41) - 1, 1 << 21)] {
+            let row = air.field_assignment(&[field(numerator), field(divisor)], &[]);
+            assert_eq!(row[qc], field(numerator / divisor));
+            assert_eq!(row[rc], field(numerator % divisor));
+            assert!(air.residues(&row, &row, &[]).iter().all(|v| *v == F::ZERO));
+        }
+        let inputs = [field((1 << 20) + 1), field(1)];
+        let excessive = air.field_assignment(&inputs, &[]);
+        assert!(
+            air.residues(&excessive, &excessive, &[])
+                .iter()
+                .any(|v| *v != F::ZERO)
+        );
+        // This forged pair preserves n=q*d+r but shifts the excess into r.
+        let forged = air.field_assignment(&inputs, &[(qc, field(1 << 20)), (rc, F::ONE)]);
+        assert!(
+            air.residues(&forged, &forged, &[])
+                .iter()
+                .any(|v| *v != F::ZERO)
+        );
+    }
+
+    #[test]
+    fn bounded_quotient_zero_and_largest_safe_operand_have_actual_range_equations() {
+        let mut air = IntegerAirV1::default();
+        let n = air.input(0, (1_i64 << 47) - 1);
+        let d = air.input(1, 7);
+        divmod_unsigned_bounded_v1(&mut air, n, d, 0).unwrap();
+        for (numerator, divisor, accepted) in
+            [(0, 1, true), (6, 7, true), (7, 7, false), (1, 1, false)]
+        {
+            let row = air.field_assignment(&[field(numerator), field(divisor)], &[]);
+            assert_eq!(
+                air.residues(&row, &row, &[]).iter().all(|v| *v == F::ZERO),
+                accepted
+            );
+        }
+    }
+
+    #[test]
+    fn bounded_quotient_rejects_unsafe_parameters_without_graph_mutation() {
+        let value = |low, high| Value {
+            low,
+            high,
+            ..Value::constant(0)
+        };
+        for (n, d, cap) in [
+            (value(0, 10), value(1, 2), -1),
+            (value(0, 10), value(1, 2), 1_i64 << 47),
+            (value(0, 1_i64 << 47), value(1, 2), 1),
+            (value(0, 10), value(1, 1_i64 << 47), 1),
+            (value(0, (1_i64 << 48) - 1), value(1, 1), 0),
+            (value(0, 1_i64 << 44), value(1, 1_i64 << 30), 1_i64 << 20),
+            (value(0, 10), value(0, 2), 1),
+        ] {
+            let mut air = IntegerAirV1::default();
+            assert!(divmod_unsigned_bounded_v1(&mut air, n, d, cap).is_err());
+            assert_eq!(air.width(), 0);
+            assert_eq!(air.constraint_count(), 0);
+        }
     }
 
