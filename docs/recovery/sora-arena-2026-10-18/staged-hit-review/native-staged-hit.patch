+            [0, 1, -COORDINATE_LIMIT, COORDINATE_LIMIT],
+            [
+                COORDINATE_LIMIT,
+                COORDINATE_LIMIT - 1,
+                -COORDINATE_LIMIT,
+                -COORDINATE_LIMIT,
+            ],
