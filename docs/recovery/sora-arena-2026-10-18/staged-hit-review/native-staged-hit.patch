+/// Component layout and conservative native proof-wire bound, before trace allocation.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct ArenaStagedHitLayoutV1 {
+    /// Fixed native trace row count, including padding.
+    pub trace_rows: usize,
+    /// Scheduled arithmetic rows plus the output boundary.
+    pub minimum_rows: usize,
+    /// Committed base columns, including the shared eight byte-copy columns.
+    pub base_columns: usize,
+    /// Committed shared permutation columns.
+    pub aux_columns: usize,
+    /// Verifier-reconstructed columns, including shared copy preprocessing.
+    pub fixed_columns: usize,
+    /// Arena polynomial residues, excluding the shared permutation residues.
+    pub profile_constraints: usize,
+    /// Conservative full native proof wire bound, including DEEP openings.
+    pub maximum_wire_bytes: usize,
+    /// Whether the conservative bound fits the unchanged four-MiB cap.
+    pub fits_proof_cap: bool,
+}
+
+struct Adapter<'a> {
+    snapshot: &'a ArenaHitSnapshotV1,
+    attacker: usize,
+    expected: ArenaHitOutputV1,
+    compiled: StagedArenaHitAirV1,
+}
+
+impl<'a> Adapter<'a> {
+    fn new(
+        snapshot: &'a ArenaHitSnapshotV1,
+        attacker: usize,
+        expected: ArenaHitOutputV1,
+    ) -> Result<Self, String> {
+        let compiled = StagedArenaHitAirV1::compile(
+            snapshot.players.len(),
+            snapshot.walls.len(),
+            snapshot.entities.len(),
+            attacker,
+        )?;
+        // Validation and fixed-domain selection never invoke witness generation.
+        compiled.fixed_row(snapshot, expected, 0, TRACE_SIZE)?;
+        Ok(Self {
+            snapshot,
+            attacker,
+            expected,
+            compiled,
+        })
+    }
+
+    fn layout(&self) -> Result<ArenaStagedHitLayoutV1, String> {
+        let protocol = self.protocol_v1();
+        protocol.validate().map_err(|error| error.to_string())?;
+        let layout = AggregateProofLayoutV1::new(
+            protocol.parameters,
+            vec![AggregateTraceGroupLayoutV1 {
+                native_trace_log2: TRACE_LOG,
+                segment_instances: 1,
+                base_width: self.base_width_v1(),
+                aux_width: NOTE_COPY_AUX_WIDTH_V1,
+            }],
+        )
+        .map_err(|error| error.to_string())?;
+        let maximum_wire_bytes =
+            maximum_encoded_proof_with_deep_bytes_v1(protocol.parameters, &layout)
+                .map_err(|error| error.to_string())?;
+        Ok(ArenaStagedHitLayoutV1 {
+            trace_rows: TRACE_SIZE,
+            minimum_rows: self.compiled.minimum_rows(),
+            base_columns: self.base_width_v1(),
+            aux_columns: NOTE_COPY_AUX_WIDTH_V1,
+            fixed_columns: NOTE_COPY_FIXED_WIDTH_V1 + self.compiled.fixed_width(),
+            profile_constraints: self.compiled.constraint_count(),
+            maximum_wire_bytes,
+            fits_proof_cap: maximum_wire_bytes <= MAX_PROOF_BYTES,
+        })
+    }
+
+    fn columns(&self) -> Result<Vec<Vec<F>>, String> {
+        let (rows, derived) = self.compiled.witness(self.snapshot, TRACE_SIZE)?;
+        if derived != self.expected {
+            return Err("claimed ray result differs from generated witness".into());
+        }
+        let mut columns = vec![vec![F::ZERO; TRACE_SIZE]; self.base_width_v1()];
+        for (index, row) in rows.into_iter().enumerate() {
+            for (column, value) in columns[NOTE_COPY_WIDTH_V1..].iter_mut().zip(row) {
+                column[index] = value;
+            }
+        }
+        Ok(columns)
+    }
+}
