+    #[test]
+    fn staged_trace_rejects_schedule_carry_boundary_and_padding_forgery() {
+        let input = scene();
+        let air = graph(&input);
+        let (trace, output) = air.witness(&input, air.minimum_rows() + 11).unwrap();
+        assert!(accepted(&air, &input, output, &trace));
+        for claim in [
+            ArenaHitOutputV1 {
+                kind: 0,
+                identity: 0,
+                fraction_q20: 0,
+            },
+            ArenaHitOutputV1 {
+                identity: 2,
+                ..output
+            },
+            ArenaHitOutputV1 {
+                fraction_q20: output.fraction_q20 + 1,
+                ..output
+            },
+            ArenaHitOutputV1 { kind: 2, ..output },
+        ] {
+            assert!(!accepted(&air, &input, claim, &trace));
+        }
+        for (row, column) in [
+            (0, NEAREST),
+            (5, TO),
+            (7, LOWER),
+            (9, NEAR),
+            (air.schedule.len(), STOP_ID),
+            (trace.len() - 1, FRACTION),
+            (trace.len() - 1, CARRY * 2),
+        ] {
+            let mut changed = trace.clone();
+            changed[row][column] = changed[row][column].add(F::ONE);
+            assert!(
+                !accepted(&air, &input, output, &changed),
+                "unconstrained row {row} column {column}"
+            );
+        }
+        let mut changed_input = input.clone();
+        changed_input.players[1].protection = 1;
+        assert!(!accepted(&air, &changed_input, output, &trace));
+        changed_input = input.clone();
+        changed_input.yaw = 1;
+        assert!(!accepted(&air, &changed_input, output, &trace));
+
+        // Remove a complete 11-row player visit and replace it with padding;
+        // duplicate it in place of another; reorder two complete visits.
+        let first = 5;
+        let second = first + 11;
+        let mut omitted = trace.clone();
+        omitted.drain(second..second + 11);
+        omitted.extend(std::iter::repeat_n(trace.last().unwrap().clone(), 11));
+        assert!(!accepted(&air, &input, output, &omitted));
+        let mut duplicated = trace.clone();
+        duplicated[second..second + 11].clone_from_slice(&trace[first..first + 11]);
+        assert!(!accepted(&air, &input, output, &duplicated));
+        let mut reordered = trace.clone();
+        reordered[first..first + 11].clone_from_slice(&trace[second..second + 11]);
+        reordered[second..second + 11].clone_from_slice(&trace[first..first + 11]);
+        assert!(!accepted(&air, &input, output, &reordered));
+        assert!(!accepted(
+            &air,
+            &input,
+            output,
+            &trace[..air.minimum_rows() - 1]
+        ));
+        // Removing surplus padding is harmless, but never removes the final
+        // state check at the exact schedule boundary.
+        assert!(accepted(&air, &input, output, &trace[..air.minimum_rows()]));
+    }
+
+    #[test]
+    fn staged_trace_rejects_a_coherently_regenerated_forged_suffix() {
+        let input = scene();
+        let air = graph(&input);
+        let (trace, output) = air.witness(&input, air.minimum_rows()).unwrap();
+        let splice = 16; // First self-player visit is complete, next visit starts.
+        let mut changed = trace.clone();
+        let mut carry = [0_i64; CARRY];
+        // Read negative field elements as their unique signed carry values.
+        for index in 0..CARRY {
+            carry[index] = if trace[splice][index].0 > (1_u64 << 63) {
+                -(F::ZERO.sub(trace[splice][index]).0 as i64)
+            } else {
+                trace[splice][index].0 as i64
+            };
+        }
+        carry[NEAREST] = 1;
+        carry[STOP_KIND] = 2;
+        carry[STOP_ID] = 19;
+        let forged = ArenaHitOutputV1 {
+            kind: 2,
+            identity: 19,
+            fraction_q20: 1,
+        };
+        for row in splice..changed.len() {
+            let fixed = air.fixed_values(&input, forged, row, changed.len());
+            let stage = air.schedule.get(row).map_or(PAD, |entry| entry.0);
+            let bank = air.packed.witness(stage, &carry, &fixed);
+            changed[row] = carry
+                .iter()
+                .chain(bank.iter())
+                .copied()
+                .map(field)
+                .collect();
+            carry = std::array::from_fn(|i| {
+                air.packed
+                    .read_integer(stage, air.outputs[stage][i], &bank, &fixed)
+            });
+        }
+        // Every suffix equation is valid by itself, including the forged public
+        // result. Its incoming edge still disagrees with the proved prefix.
+        for row in splice..changed.len() {
+            let fixed = air.fixed_row(&input, forged, row, changed.len()).unwrap();
+            let next = &changed[(row + 1).min(changed.len() - 1)];
+            assert!(
+                air.residues(&changed[row], next, &fixed)
+                    .unwrap()
+                    .iter()
+                    .all(|v| *v == F::ZERO)
+            );
+        }
+        assert!(!accepted(&air, &input, forged, &changed));
+        assert!(accepted(&air, &input, output, &trace));
+    }
+
+    #[test]
+    fn staged_layout_bounds_are_fixed_and_width_does_not_scale_with_candidates() {
+        let small = StagedArenaHitAirV1::compile(1, 0, 0, 0).unwrap();
+        let full = StagedArenaHitAirV1::compile(12, 64, 48, 11).unwrap();
+        eprintln!(
+            "staged hit: width={} constraints={} fixed={} full_scan_rows={}",
+            full.width(),
+            full.constraint_count(),
+            full.fixed_width(),
+            full.minimum_rows()
+        );
+        assert_eq!(small.width(), full.width());
+        assert_eq!(full.minimum_rows(), 7 + 11 * (12 + 64 + 48));
+        assert!(StagedArenaHitAirV1::compile(0, 0, 0, 0).is_err());
+        assert!(StagedArenaHitAirV1::compile(13, 0, 0, 0).is_err());
+        assert!(StagedArenaHitAirV1::compile(2, 65, 0, 0).is_err());
+        assert!(StagedArenaHitAirV1::compile(2, 0, 49, 0).is_err());
+        assert!(StagedArenaHitAirV1::compile(2, 0, 0, 2).is_err());
+        let mut input = scene();
+        let air = graph(&input);
+        input.players.pop();
+        assert!(air.witness(&input, air.minimum_rows()).is_err());
+        input = scene();
+        input.pitch = 16385;
+        assert!(air.witness(&input, air.minimum_rows()).is_err());
+        input = scene();
+        input.players[0].alive = false;
+        assert!(air.witness(&input, air.minimum_rows()).is_err());
+        input = scene();
+        input.players[0].position[0] = C;
+        assert!(air.witness(&input, air.minimum_rows()).is_err());
+        let valid = scene();
+        let (trace, output) = air.witness(&valid, air.minimum_rows()).unwrap();
+        assert!(air.residues(&trace[0][..1], &trace[1], &[]).is_err());
+        assert!(air.fixed_row(&valid, output, 0, (1 << 19) + 1).is_err());
+    }
