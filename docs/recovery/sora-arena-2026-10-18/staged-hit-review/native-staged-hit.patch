+    #[test]
+    fn coordinate_ranges_and_box_order_reject_even_with_recomputed_field_auxiliaries() {
+        let graph = ArenaGeometryAirV1::compile();
+        let input = [0, 40, 10, 20, 0, 0, -2, 2, 0, 0, -2, 2].map(field);
+        for index in 0..12 {
