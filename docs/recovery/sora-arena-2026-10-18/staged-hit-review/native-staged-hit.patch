+++ b/crates/iroha_core/src/execution_proofs/arena_geometry_air.rs
@@ -0,0 +1,771 @@
+//! Test-only exact Q20 Arena segment/AABB arithmetic over bounded coordinates.
+//!
+//! Coordinates are constrained to +/-2^20 millimetres (about +/-1.05 km); ordered box bounds are
+//! proved. This is the exact truncation-toward-zero behavior of Arena's reference
+//! `Aabb::intersect` in that domain, including its near-zero rounding behavior.
+//! TODO: bind geometry, controls and map custody into a complete execution profile
+//! before any registration or monetary qualification. This module does neither.
+
+use super::{
+    checked_integer_air::{
+        bounded_input_v1, bounded_value_v1, constrain_boolean_v1, divmod_unsigned_bounded_v1,
+        select_v1,
+    },
+    integer_air::{IntegerAirV1, Value},
+};
+
+pub(super) const COORDINATE_LIMIT: i64 = 1 << 20;
+pub(super) const Q20: i64 = 1 << 20;
+
+/// Checked selectors plus their locations for adversarial equation tests.
+struct GeometryCompiler<'a> {
+    air: &'a mut IntegerAirV1,
+    selectors: Vec<Value>,
+    quotients: Vec<Value>,
+}
+
+impl GeometryCompiler<'_> {
+    fn choose(&mut self, condition: Value, yes: Value, no: Value) -> Value {
+        let condition = constrain_boolean_v1(self.air, condition);
+        self.selectors.push(condition.value());
+        select_v1(self.air, condition, yes, no).expect("geometry branch bounds")
+    }
+
+    /// Compute clamp(trunc(numerator / delta), -1, Q20+1) for nonzero delta.
+    /// The zero-delta result is ignored by a separately proved parallel-axis gate.
+    fn plane_fraction(
+        &mut self,
+        start: Value,
+        bound: Value,
+        delta: Value,
+        denominator: Value,
+    ) -> Value {
+        let difference = self.air.sub(bound, start);
+        let numerator = self.air.mul_constant(difference, Q20);
+        let negative_delta = self.air.less(delta, Value::constant(0));
+        let negated = self.air.mul_constant(numerator, -1);
+        let numerator = self.choose(negative_delta, negated, numerator);
+        let negative_denominator = self.air.mul_constant(denominator, -1);
+        let lower_edge = self.air.add_constant(negative_denominator, 1);
+        // Integer truncation reaches -1 exactly when signed numerator <= -denominator.
+        let below = self.air.less(numerator, lower_edge);
+        let upper_edge = self.air.mul_constant(denominator, Q20 + 1);
+        let below_upper = self.air.less(numerator, upper_edge);
+        let above = self.air.not(below_upper);
+        let clipped = self.air.or(below, above);
+        let interior = self.air.not(clipped);
+        let absolute = self.air.absolute(numerator);
+        // Crucially do not divide the potentially enormous exterior quotient.
+        let safe_numerator = self.choose(interior, absolute, Value::constant(0));
+        let (quotient, _) = divmod_unsigned_bounded_v1(self.air, safe_numerator, denominator, Q20)
+            .expect("bounded interior slab division");
+        self.quotients.push(quotient);
+        let negative = self.air.less(numerator, Value::constant(0));
+        let negated = self.air.mul_constant(quotient, -1);
+        let signed = self.choose(negative, negated, quotient);
+        let lower_clipped = self.choose(below, Value::constant(-1), signed);
+        let result = self.choose(above, Value::constant(Q20 + 1), lower_clipped);
+        bounded_value_v1(self.air, result, -1, Q20 + 1).expect("clipped slab interval")
+    }
+}
+
+/// A single signed-rational plane endpoint for a later staged geometry relation.
+/// A parallel plane's fraction is inert; `nonzero` must be checked by the caller.
+pub(super) struct GeometryPlaneV1 {
+    pub(super) fraction: Value,
+    pub(super) nonzero: Value,
+    pub(super) denominator: Value,
+    pub(super) selectors: Vec<Value>,
+    pub(super) quotients: Vec<Value>,
+}
+
+/// Append the same exact signed slab equations used by `intersect_v1` for one
+/// bounded start/end/bound triple. This does not authenticate or join stages.
+pub(super) fn plane_v1(
+    air: &mut IntegerAirV1,
+    start: Value,
+    end: Value,
+    bound: Value,
+) -> GeometryPlaneV1 {
+    let mut compiler = GeometryCompiler {
+        air,
+        selectors: Vec::new(),
+        quotients: Vec::new(),
+    };
+    let start = bounded_value_v1(compiler.air, start, -COORDINATE_LIMIT, COORDINATE_LIMIT)
+        .expect("plane start domain");
+    let end = bounded_value_v1(compiler.air, end, -COORDINATE_LIMIT, COORDINATE_LIMIT)
+        .expect("plane end domain");
+    let bound = bounded_value_v1(compiler.air, bound, -COORDINATE_LIMIT, COORDINATE_LIMIT)
+        .expect("plane bound domain");
+    let delta = compiler.air.sub(end, start);
+    let absolute_delta = compiler.air.absolute(delta);
+    let nonzero = compiler.air.less(Value::constant(0), absolute_delta);
+    let denominator = compiler.choose(nonzero, absolute_delta, Value::constant(1));
+    let denominator = bounded_value_v1(compiler.air, denominator, 1, COORDINATE_LIMIT * 2)
+        .expect("positive safe denominator");
+    let fraction = compiler.plane_fraction(start, bound, delta, denominator);
+    GeometryPlaneV1 {
+        fraction,
+        nonzero,
+        denominator,
+        selectors: compiler.selectors,
+        quotients: compiler.quotients,
+    }
+}
+
+/// Complete intersection of one bounded box axis with the segment interval.
+/// Both plane endpoints share the same constrained ray and ordered box bounds;
+/// a parallel axis requires the start to lie within the box. The three-axis
+/// parent must still combine each axis and authenticate the original geometry.
+pub(super) struct GeometryAxisV1 {
+    pub(super) hit: Value,
+    pub(super) fraction: Value,
+    pub(super) near: Value,
+    pub(super) far: Value,
+    pub(super) planes: [Value; 2],
+}
+
+/// Append one-axis segment/AABB equations to the caller's same-row graph.
+pub(super) fn axis_v1(
+    air: &mut IntegerAirV1,
+    start: Value,
+    end: Value,
+    minimum: Value,
+    maximum: Value,
+) -> GeometryAxisV1 {
+    let mut compiler = GeometryCompiler {
+        air,
+        selectors: Vec::new(),
+        quotients: Vec::new(),
+    };
+    let mut bounded = |value| {
+        bounded_value_v1(compiler.air, value, -COORDINATE_LIMIT, COORDINATE_LIMIT)
+            .expect("axis coordinate domain")
+    };
+    let (start, end, minimum, maximum) = (
+        bounded(start),
+        bounded(end),
+        bounded(minimum),
+        bounded(maximum),
+    );
+    let reversed = compiler.air.less(maximum, minimum);
+    compiler.air.equate(reversed, Value::constant(0));
+    let delta = compiler.air.sub(end, start);
+    let absolute_delta = compiler.air.absolute(delta);
+    let nonzero = compiler.air.less(Value::constant(0), absolute_delta);
+    let denominator = compiler.choose(nonzero, absolute_delta, Value::constant(1));
+    let denominator = bounded_value_v1(compiler.air, denominator, 1, COORDINATE_LIMIT * 2)
+        .expect("axis positive safe denominator");
+    let a = compiler.plane_fraction(start, minimum, delta, denominator);
+    let b = compiler.plane_fraction(start, maximum, delta, denominator);
+    let low = compiler.air.minimum(a, b);
+    let high = compiler.air.maximum(a, b);
+    let axis_near = compiler.choose(nonzero, low, Value::constant(0));
+    let axis_far = compiler.choose(nonzero, high, Value::constant(Q20));
+    let near = compiler.air.maximum(Value::constant(0), axis_near);
+    let far = compiler.air.minimum(Value::constant(Q20), axis_far);
+    let below_box = compiler.air.less(start, minimum);
+    let above_box = compiler.air.less(maximum, start);
+    let outside = compiler.air.or(below_box, above_box);
+    let inside = compiler.air.not(outside);
+    let parallel_valid = compiler.air.or(nonzero, inside);
+    let separated = compiler.air.less(far, near);
+    let overlaps = compiler.air.not(separated);
+    let hit = compiler.air.and(parallel_valid, overlaps);
+    let hit = constrain_boolean_v1(compiler.air, hit).value();
+    let fraction = compiler.choose(hit, near, Value::constant(0));
+    let fraction = bounded_value_v1(compiler.air, fraction, 0, Q20).expect("axis hit fraction");
+    GeometryAxisV1 {
+        hit,
+        fraction,
+        near,
+        far,
+        planes: [a, b],
+    }
+}
+
+/// Fixed-shape one-axis graph for the unregistered native research proof.
+pub(super) struct ArenaGeometryAxisAirV1 {
+    pub(super) air: IntegerAirV1,
+    pub(super) inputs: [Value; 4],
+    pub(super) outputs: GeometryAxisV1,
+}
+
+impl ArenaGeometryAxisAirV1 {
+    pub(super) fn compile() -> Self {
+        let mut air = IntegerAirV1::default();
+        let inputs = std::array::from_fn(|_| {
+            bounded_input_v1(&mut air, -COORDINATE_LIMIT, COORDINATE_LIMIT)
+                .expect("axis bounded input")
+        });
+        let outputs = axis_v1(&mut air, inputs[0], inputs[1], inputs[2], inputs[3]);
+        Self {
+            air,
+            inputs,
+            outputs,
+        }
+    }
+}
+
+struct ArenaGeometryAirV1 {
+    air: IntegerAirV1,
+    hit: Value,
+    fraction: Value,
+    near: Value,
+    far: Value,
+    selectors: Vec<Value>,
+    planes: Vec<Value>,
+}
+
+/// Same-graph intersection outputs. Fractions are canonical zero on a miss.
+pub(super) struct GeometryIntersectionV1 {
+    pub(super) hit: Value,
+    pub(super) fraction: Value,
+    pub(super) near: Value,
+    pub(super) far: Value,
+    pub(super) selectors: Vec<Value>,
+    pub(super) planes: Vec<Value>,
+}
+
+/// Append bounded segment/box equations to the caller's existing same-row graph.
+/// The parent relation remains responsible for map/actor custody and ray origin.
+pub(super) fn intersect_v1(
+    air: &mut IntegerAirV1,
+    from: [Value; 3],
+    to: [Value; 3],
+    minimum: [Value; 3],
+    maximum: [Value; 3],
+) -> GeometryIntersectionV1 {
+    let mut compiler = GeometryCompiler {
+        air,
+        selectors: Vec::new(),
+        quotients: Vec::new(),
+    };
+    let mut near = Value::constant(0);
+    let mut far = Value::constant(Q20);
+    let mut parallel_valid = Value::constant(1);
+    let mut planes = Vec::with_capacity(6);
+    for axis in 0..3 {
+        let mut bounded = |value| {
+            bounded_value_v1(compiler.air, value, -COORDINATE_LIMIT, COORDINATE_LIMIT)
+                .expect("coordinate domain")
+        };
+        let (start, end, minimum, maximum) = (
+            bounded(from[axis]),
+            bounded(to[axis]),
+            bounded(minimum[axis]),
+            bounded(maximum[axis]),
+        );
+        let reversed = compiler.air.less(maximum, minimum);
+        compiler.air.equate(reversed, Value::constant(0));
+        let delta = compiler.air.sub(end, start);
+        let absolute_delta = compiler.air.absolute(delta);
+        let nonzero = compiler.air.less(Value::constant(0), absolute_delta);
+        let denominator = compiler.choose(nonzero, absolute_delta, Value::constant(1));
+        let denominator = bounded_value_v1(compiler.air, denominator, 1, COORDINATE_LIMIT * 2)
+            .expect("positive safe denominator");
+        let mut plane = |bound| compiler.plane_fraction(start, bound, delta, denominator);
+        let a = plane(minimum);
+        let b = plane(maximum);
+        planes.extend([a, b]);
+        let low = compiler.air.minimum(a, b);
+        let high = compiler.air.maximum(a, b);
+        let axis_near = compiler.choose(nonzero, low, Value::constant(0));
+        let axis_far = compiler.choose(nonzero, high, Value::constant(Q20));
+        near = compiler.air.maximum(near, axis_near);
+        far = compiler.air.minimum(far, axis_far);
+        let below_box = compiler.air.less(start, minimum);
+        let above_box = compiler.air.less(maximum, start);
+        let outside = compiler.air.or(below_box, above_box);
+        let inside = compiler.air.not(outside);
+        let valid_axis = compiler.air.or(nonzero, inside);
+        parallel_valid = compiler.air.and(parallel_valid, valid_axis);
+    }
+    // Clamping slab fractions outside [-1,Q20+1] preserves both intersection
+    // with [0,Q20] and its nearest fraction. All missed outputs canonicalize to 0.
+    let separated = compiler.air.less(far, near);
+    let overlaps = compiler.air.not(separated);
+    let hit = compiler.air.and(parallel_valid, overlaps);
+    let hit = constrain_boolean_v1(compiler.air, hit).value();
+    let fraction = compiler.choose(hit, near, Value::constant(0));
+    let fraction =
+        bounded_value_v1(compiler.air, fraction, 0, Q20).expect("returned segment fraction");
+    GeometryIntersectionV1 {
+        hit,
+        fraction,
+        near,
+        far,
+        selectors: compiler.selectors,
+        planes,
+    }
+}
+
+impl ArenaGeometryAirV1 {
+    /// Inputs are three ordered groups of [from, to, min, max], one for each axis.
+    fn compile() -> Self {
+        let mut air = IntegerAirV1::default();
+        let mut values = [[Value::constant(0); 3]; 4];
+        for axis in 0..3 {
+            for group in &mut values {
+                group[axis] = bounded_input_v1(&mut air, -COORDINATE_LIMIT, COORDINATE_LIMIT)
+                    .expect("coordinate input");
+            }
+        }
+        let output = intersect_v1(&mut air, values[0], values[1], values[2], values[3]);
+        Self {
+            air,
+            hit: output.hit,
+            fraction: output.fraction,
+            near: output.near,
+            far: output.far,
+            selectors: output.selectors,
+            planes: output.planes,
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::super::integer_air::{Source, field};
+    use super::*;
+    use crate::privacy_engines::transparent_stark::GoldilocksFieldV1 as F;
+
+    fn column(value: Value) -> usize {
+        let Source::Column(column) = value.source else {
+            panic!("expected witness column")
+        };
+        column
+    }
+
+    fn plane_graph() -> (IntegerAirV1, GeometryPlaneV1) {
+        let mut air = IntegerAirV1::default();
+        // The plane relation itself emits the coordinate range equations.
+        let start = air.input(-COORDINATE_LIMIT, COORDINATE_LIMIT);
+        let end = air.input(-COORDINATE_LIMIT, COORDINATE_LIMIT);
+        let bound = air.input(-COORDINATE_LIMIT, COORDINATE_LIMIT);
+        let plane = plane_v1(&mut air, start, end, bound);
+        (air, plane)
+    }
+
+    fn plane_reference(start: i64, end: i64, bound: i64) -> i64 {
+        let numerator = (bound - start) * Q20;
+        let delta = end - start;
+        // The zero-delta endpoint is an inert arithmetic value in the parent
+        // relation, whose independent parallel-axis gate decides validity.
+        let denominator = if delta == 0 { 1 } else { delta };
+        (numerator / denominator).clamp(-1, Q20 + 1)
+    }
+
+    fn axis_reference(input: [i64; 4]) -> Option<i64> {
+        let [start, end, minimum, maximum] = input;
+        let delta = end - start;
+        if delta == 0 {
+            return (minimum <= start && start <= maximum).then_some(0);
+        }
+        let a = ((minimum - start) << 20) / delta;
+        let b = ((maximum - start) << 20) / delta;
+        let near = a.min(b).max(0);
+        let far = a.max(b).min(Q20);
+        (near <= far).then_some(near)
+    }
+
+    #[test]
+    fn two_plane_axis_relation_matches_integer_reference_and_rejects_forgery() {
+        let graph = ArenaGeometryAxisAirV1::compile();
+        eprintln!(
+            "one-axis AIR: {} columns / {} constraints",
+            graph.air.width(),
+            graph.air.constraint_count()
+        );
+        let cases = [
+            [0, 40, 10, 20],
+            [40, 0, 10, 20],
+            [0, 0, -2, 2],
+            [3, 3, -2, 2],
+            [10, 20, 20, 20],
+            [0, 1, 2, 3],
+            [
+                -COORDINATE_LIMIT + 1,
+                COORDINATE_LIMIT,
+                -COORDINATE_LIMIT,
+                -COORDINATE_LIMIT,
+            ],
+        ];
+        for input in cases {
+            let row = graph.air.witness(&input, &[]);
+            let expected = axis_reference(input);
+            assert_eq!(
+                row[column(graph.outputs.hit)],
+                i64::from(expected.is_some())
+            );
+            assert_eq!(row[column(graph.outputs.fraction)], expected.unwrap_or(0));
+            let fields = row.iter().copied().map(field).collect::<Vec<_>>();
+            assert!(
+                graph
+                    .air
+                    .residues(&fields, &fields, &[])
+                    .iter()
+                    .all(|v| *v == F::ZERO),
+                "honest {input:?}"
+            );
+            let inputs = input.map(field);
+            for value in [
+                graph.outputs.hit,
+                graph.outputs.fraction,
+                graph.outputs.near,
+                graph.outputs.far,
+                graph.outputs.planes[0],
+                graph.outputs.planes[1],
+            ] {
+                let index = column(value);
+                let forged = graph
+                    .air
+                    .field_assignment(&inputs, &[(index, fields[index].add(F::ONE))]);
+                assert!(
+                    graph
+                        .air
+                        .residues(&forged, &forged, &[])
+                        .iter()
+                        .any(|v| *v != F::ZERO),
+                    "forged axis column {index} from {input:?}"
+                );
+            }
+        }
+        let reversed = graph
+            .air
+            .field_assignment(&[field(0), field(40), field(20), field(10)], &[]);
+        assert!(
+            graph
+                .air
+                .residues(&reversed, &reversed, &[])
+                .iter()
+                .any(|v| *v != F::ZERO)
+        );
+    }
+
+    /// Independent direct integer reference, preserving the original early exits.
+    /// It does not clip, normalize divisors, or call any arithmetic graph helper.
+    fn reference(input: &[i64; 12]) -> Option<i64> {
+        let (mut near, mut far) = (0, Q20);
+        for axis in input.chunks_exact(4) {
+            let (start, end, minimum, maximum) = (axis[0], axis[1], axis[2], axis[3]);
+            let delta = end - start;
+            if delta == 0 {
+                if start < minimum || start > maximum {
+                    return None;
+                }
+            } else {
+                let a = ((minimum - start) << 20) / delta;
+                let b = ((maximum - start) << 20) / delta;
+                near = near.max(a.min(b));
+                far = far.min(a.max(b));
+                if near > far {
+                    return None;
+                }
+            }
+        }
+        Some(near)
+    }
+
+    fn valid(graph: &ArenaGeometryAirV1, row: &[F]) -> bool {
+        graph
+            .air
+            .residues(row, row, &[])
+            .iter()
+            .all(|value| *value == F::ZERO)
+    }
+
+    fn valid_plane(air: &IntegerAirV1, row: &[F]) -> bool {
+        air.residues(row, row, &[])
+            .iter()
+            .all(|value| *value == F::ZERO)
+    }
+
+    #[test]
+    fn one_plane_stage_matches_monolithic_signed_rational_boundary_cases() {
+        let (air, plane) = plane_graph();
+        let full = ArenaGeometryAirV1::compile();
+        assert!(air.width() < full.air.width());
+        eprintln!(
+            "one-plane AIR: {} columns / {} constraints; three-axis AIR: {} columns / {} constraints",
+            air.width(),
+            air.constraint_count(),
+            full.air.width(),
+            full.air.constraint_count()
+        );
+        let mut axes = vec![
+            [0, 40, 10, 20],
+            [40, 0, 10, 20],
+            [0, 0, -2, 2],
+            [3, 3, -2, 2],
+            [-3, -3, -2, 2],
+            [2, 2, -2, 2],
+            [0, 10, 10, 10],
+            [0, 3, 1, 2],
+            [3, 0, 1, 2],
+            [0, 1, 2, 3],
+            [
+                -COORDINATE_LIMIT + 1,
+                COORDINATE_LIMIT,
+                -COORDINATE_LIMIT,
+                -COORDINATE_LIMIT,
+            ],
+            [
+                COORDINATE_LIMIT - 1,
+                -COORDINATE_LIMIT,
+                COORDINATE_LIMIT,
+                COORDINATE_LIMIT,
+            ],
+            [0, 1, -COORDINATE_LIMIT, COORDINATE_LIMIT],
+            [
+                -COORDINATE_LIMIT,
+                COORDINATE_LIMIT,
+                -COORDINATE_LIMIT,
+                COORDINATE_LIMIT,
+            ],
+        ];
+        let mut seed = 0x706c616e655f6b65_u64;
+        for _ in 0..128 {
+            let mut axis = [0_i64; 4];
+            for item in &mut axis {
+                seed ^= seed << 13;
+                seed ^= seed >> 7;
+                seed ^= seed << 17;
+                *item = (seed % (2 * COORDINATE_LIMIT + 1) as u64) as i64 - COORDINATE_LIMIT;
+            }
+            if axis[2] > axis[3] {
+                axis.swap(2, 3);
+            }
+            axes.push(axis);
+        }
+        for axis in axes {
+            for dimension in 0..3 {
+                let mut input = [0, 0, -2, 2, 0, 0, -2, 2, 0, 0, -2, 2];
+                input[dimension * 4..dimension * 4 + 4].copy_from_slice(&axis);
+                let full_row = full.air.witness(&input, &[]);
+                for side in 0..2 {
+                    let bound = axis[2 + side];
+                    let row = air.witness(&[axis[0], axis[1], bound], &[]);
+                    assert_eq!(
+                        row[column(plane.fraction)],
+                        plane_reference(axis[0], axis[1], bound)
+                    );
+                    assert_eq!(
+                        row[column(plane.fraction)],
+                        full_row[column(full.planes[dimension * 2 + side])]
+                    );
+                    assert_eq!(row[column(plane.nonzero)], i64::from(axis[0] != axis[1]));
+                    assert!(valid_plane(
+                        &air,
+                        &row.into_iter().map(field).collect::<Vec<_>>()
+                    ));
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn one_plane_stage_rejects_forged_fraction_division_and_noninteger_selectors() {
+        let (air, plane) = plane_graph();
+        for input in [
+            [0, 40, 10],
+            [40, 0, 10],
+            [0, 0, 2],
+            [0, 1, -COORDINATE_LIMIT],
+        ] {
+            let inputs = input.map(field);
+            let honest = air.field_assignment(&inputs, &[]);
+            assert!(valid_plane(&air, &honest), "honest {input:?}");
+            for value in [plane.fraction, plane.nonzero, plane.denominator]
+                .into_iter()
+                .chain(plane.quotients.iter().copied())
+            {
+                let index = column(value);
+                let forged = air.field_assignment(&inputs, &[(index, honest[index].add(F::ONE))]);
+                assert!(
+                    !valid_plane(&air, &forged),
+                    "forged column {index} from {input:?}"
+                );
+            }
+            for selector in &plane.selectors {
+                let forged =
+                    air.field_assignment(&inputs, &[(column(*selector), field(2).inv().unwrap())]);
+                assert!(
+                    !valid_plane(&air, &forged),
+                    "fractional selector from {input:?}"
+                );
+            }
+        }
+        for index in 0..3 {
+            for bad in [
+                field(-COORDINATE_LIMIT - 1),
+                field(COORDINATE_LIMIT + 1),
+                field(2).inv().unwrap(),
+            ] {
+                let mut inputs = [field(0), field(40), field(10)];
+                inputs[index] = bad;
+                let row = air.field_assignment(&inputs, &[]);
+                assert!(!valid_plane(&air, &row), "invalid coordinate {index}");
+            }
+        }
+    }
+
+    fn check(graph: &ArenaGeometryAirV1, input: [i64; 12]) {
+        let row = graph.air.witness(&input, &[]);
