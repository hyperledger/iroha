+/// Exact variable positive-divisor division. Every operand and result receives
+/// real interval equations, independent of the caller's unproved range metadata.
+///
+/// The maximum possible reconstructed numerator stays below 2^49, excluding
+/// Goldilocks modular aliases even for an adversarial quotient/remainder pair.
+/// Reversed ranges, nonpositive divisors and unsafe product bounds are rejected
+/// before adding any nodes. This is a compiler building block, not a game proof.
+pub(super) fn divmod_unsigned_v1(
+    air: &mut IntegerAirV1,
+    numerator: Value,
+    divisor: Value,
+) -> Result<(Value, Value), CheckedIntegerAirErrorV1> {
+    let quotient_high = numerator
+        .high
+        .checked_div(divisor.low)
+        .ok_or(CheckedIntegerAirErrorV1::Bounds)?;
