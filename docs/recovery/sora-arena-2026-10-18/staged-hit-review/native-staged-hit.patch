@@ -0,0 +1,161 @@
+//! Arena aiming arithmetic. No profile, custody or input authentication.
+//! Every direction component is derived from bounded yaw and pitch rather than
+//! accepting a peer's claimed ray. The parent relation must bind canonical controls.
+use super::{
+    checked_integer_air::{bounded_input_v1, bounded_value_v1, divmod_unsigned_v1},
+    integer_air::{IntegerAirV1, Value},
+};
+
+/// Exact Q15 Bhaskara function used by the separate Rust combat reference.
+pub(super) fn sine_v1(air: &mut IntegerAirV1, angle: Value) -> Value {
+    let angle = bounded_value_v1(air, angle, 0, 65535).expect("angle range");
+    let negative = air.less(Value::constant(32768), angle);
+    let second_half = air.sub_constant(angle, 32768);
+    let x = air.select(negative, second_half, angle);
+    let x = bounded_value_v1(air, x, 0, 32768).expect("half turn");
+    let complement = air.sub(Value::constant(32768), x);
+    let product = air.mul(x, complement);
+    // Maximum of x*(32768-x) occurs at x=16384. Emit the actual bound,
+    // rather than relying on the compiler's interval annotation.
+    let product = bounded_value_v1(air, product, 0, 268435456).expect("quadratic bound");
+    let numerator = air.mul_constant(product, 16 * 32767);
+    let four_product = air.mul_constant(product, 4);
+    let denominator = air.sub(Value::constant(5 * 32768_i64 * 32768), four_product);
+    let (absolute, _) = divmod_unsigned_v1(air, numerator, denominator).expect("safe trig ratio");
+    let absolute = bounded_value_v1(air, absolute, 0, 32767).expect("sine amplitude");
+    let negated = air.mul_constant(absolute, -1);
+    air.select(negative, negated, absolute)
+}
+
+pub(super) fn quarter_turn_v1(air: &mut IntegerAirV1, angle: Value) -> Value {
+    let sum = air.add_constant(angle, 16384);
+    let overflow = air.less(Value::constant(65535), sum);
+    let wrapped = air.sub_constant(sum, 65536);
+    let result = air.select(overflow, wrapped, sum);
+    bounded_value_v1(air, result, 0, 65535).expect("wrapped angle")
+}
+
+struct ArenaAimAirV1 {
+    air: IntegerAirV1,
+    outputs: [Value; 3],
+}
+
+/// Append exact bounded yaw/pitch direction equations to an existing same-row graph.
+/// The caller must bind these controls to its authenticated input stream.
+pub(super) fn direction_v1(air: &mut IntegerAirV1, yaw: Value, pitch: Value) -> [Value; 3] {
+    let yaw = bounded_value_v1(air, yaw, 0, 65535).expect("yaw");
+    let pitch = bounded_value_v1(air, pitch, -16384, 16384).expect("pitch");
+    let pitch_negative = air.less(pitch, Value::constant(0));
+    let pitch_unsigned = air.add_constant(pitch, 65536);
+    let pitch_angle = air.select(pitch_negative, pitch_unsigned, pitch);
+    let pitch_angle = bounded_value_v1(air, pitch_angle, 0, 65535).expect("pitch angle");
+    let yaw_cos_angle = quarter_turn_v1(air, yaw);
+    let pitch_cos_angle = quarter_turn_v1(air, pitch_angle);
+    let yaw_sin = sine_v1(air, yaw);
+    let yaw_cos = sine_v1(air, yaw_cos_angle);
+    let pitch_sin = sine_v1(air, pitch_angle);
+    let pitch_cos = sine_v1(air, pitch_cos_angle);
+    let dx = air.mul(yaw_cos, pitch_cos);
+    let dy = air.mul(yaw_sin, pitch_cos);
+    let dx = air.divide(dx, 32767);
+    let dy = air.divide(dy, 32767);
+    [dx, dy, pitch_sin]
+}
+
+impl ArenaAimAirV1 {
+    fn compile() -> Self {
+        let mut air = IntegerAirV1::default();
+        let yaw = bounded_input_v1(&mut air, 0, 65535).expect("yaw");
+        let pitch = bounded_input_v1(&mut air, -16384, 16384).expect("pitch");
+        let outputs = direction_v1(&mut air, yaw, pitch);
+        Self { air, outputs }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::super::integer_air::{Source, field};
+    use super::*;
+    use crate::privacy_engines::transparent_stark::GoldilocksFieldV1 as F;
+
+    /// Independent direct formula; no arithmetic-graph witness operations.
+    fn reference_sine(angle: u16) -> i64 {
+        let half = u32::from(angle) > 32768;
+        let x = i64::from(angle) - if half { 32768 } else { 0 };
+        let product = x * (32768 - x);
+        let value = 16 * product * 32767 / (5 * 32768_i64.pow(2) - 4 * product);
+        if half { -value } else { value }
+    }
+
+    #[test]
+    fn aim_equations_match_reference_quadrants_wrap_and_pitch() {
+        let graph = ArenaAimAirV1::compile();
+        for yaw in [
+            0_u16, 1, 8191, 8192, 16384, 32767, 32768, 32769, 49152, 65535,
+        ] {
+            for pitch in [-16384_i16, -8192, -1, 0, 1, 8192, 16384] {
+                let row = graph.air.witness(&[i64::from(yaw), i64::from(pitch)], &[]);
+                let cp = reference_sine((pitch as u16).wrapping_add(16384));
+                let expected = [
+                    reference_sine(yaw.wrapping_add(16384)) * cp / 32767,
+                    reference_sine(yaw) * cp / 32767,
+                    reference_sine(pitch as u16),
+                ];
+                for (output, expected) in graph.outputs.iter().zip(expected) {
+                    let Source::Column(column) = output.source else {
+                        panic!("column")
+                    };
+                    assert_eq!(row[column], expected, "yaw={yaw}, pitch={pitch}");
+                }
+                let row = row.into_iter().map(field).collect::<Vec<_>>();
+                assert!(
+                    graph
+                        .air
+                        .residues(&row, &row, &[])
+                        .iter()
+                        .all(|v| *v == F::ZERO)
+                );
+            }
+        }
+    }
+
+    #[test]
+    fn false_direction_and_noncanonical_controls_are_rejected() {
+        let graph = ArenaAimAirV1::compile();
+        let row = graph
+            .air
+            .witness(&[12345, -6789], &[])
+            .into_iter()
+            .map(field)
+            .collect::<Vec<_>>();
+        for output in graph.outputs {
+            let Source::Column(column) = output.source else {
+                panic!("column")
+            };
+            let mut forged = row.clone();
+            forged[column] = forged[column].add(F::ONE);
+            assert!(
+                graph
+                    .air
+                    .residues(&forged, &forged, &[])
+                    .iter()
+                    .any(|v| *v != F::ZERO)
+            );
+        }
+        for input in [[65536, 0], [-1, 0], [0, 16385], [0, -16385]] {
+            let row = graph
+                .air
+                .witness(&input, &[])
+                .into_iter()
+                .map(field)
+                .collect::<Vec<_>>();
+            assert!(
+                graph
+                    .air
+                    .residues(&row, &row, &[])
+                    .iter()
+                    .any(|v| *v != F::ZERO)
+            );
+        }
+    }
+}
