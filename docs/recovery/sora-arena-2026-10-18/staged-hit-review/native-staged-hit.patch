+
+    #[test]
+    fn deterministic_varied_boxes_and_segments_match_unclipped_reference() {
+        let graph = ArenaGeometryAirV1::compile();
+        let mut seed = 0x6e796161677975_u64;
+        for _ in 0..384 {
