--- /dev/null
+++ b/crates/iroha_core/src/execution_proofs/arena_staged_hit_air.rs
@@ -0,0 +1,1095 @@
+//! Narrow, ordered Arena ray-stop microcycles over a generic public snapshot.
+//!
+//! Four separate sine rows derive the ray from yaw/pitch. Every static wall,
+//! live entity and original player slot is then scanned, in that order, with
+//! six exact signed Q20 plane rows, three axis folds and one nearest update.
+//! Fixed selectors choose the schedule; polynomial next-row equations carry
+//! all scratch and selection state. No slab fractions or hit decisions are
+//! accepted as public premises. The arithmetic bank does not grow with the
+//! number of candidates.
+//!
+//! TODO: bind this snapshot and controls to the complete execution state's
+//! authenticated boundary and legal attack initiation. This is not a registered
+//! profile, a World transition, a native proof adapter or settlement authority.
+
+use super::{
+    arena_aim_air::{quarter_turn_v1, sine_v1},
+    arena_geometry_air::{COORDINATE_LIMIT as C, Q20, plane_v1},
+    checked_integer_air::{bounded_value_v1, constrain_boolean_v1},
+    integer_air::{IntegerAirV1, PackedIntegerAirV1, Value, field},
+};
+use crate::privacy_engines::transparent_stark::GoldilocksFieldV1 as F;
+
+const SIN_YAW: usize = 0;
+const COS_YAW: usize = 1;
+const SIN_PITCH: usize = 2;
+const COS_PITCH: usize = 3;
+const FROM: usize = 4;
+const TO: usize = 7;
+const MIN: usize = 10;
+const MAX: usize = 13;
+const ELIGIBLE: usize = 16;
+const BOX_KIND: usize = 17;
+const BOX_ID: usize = 18;
+const NEAR: usize = 19;
+const FAR: usize = 20;
+const VALID: usize = 21;
+const LOWER: usize = 22;
+const UPPER: usize = 23;
+const NONZERO: usize = 24;
+const NEAREST: usize = 25;
+const STOP_KIND: usize = 26;
+const STOP_ID: usize = 27;
+const FRACTION: usize = 28;
+const CARRY: usize = 29;
+
+const RAY: usize = 4;
+const WALL: usize = 5;
+const ENTITY: usize = 6;
+const PLAYER: usize = 7;
+const AXES: usize = 8; // Per axis: lower plane, upper plane, interval fold.
+const SELECT: usize = 17;
+const FINISH: usize = 18;
+const PAD: usize = 19;
+const STAGES: usize = 20;
+
+const FIRST: usize = 0;
+const TRANSITION: usize = 1;
+const FINAL: usize = 2;
+const SELECTORS: usize = 3;
+const CONTROL: usize = SELECTORS + STAGES;
+const ACTOR: usize = CONTROL + 6; // position xyz, team, alive
+const CANDIDATE: usize = ACTOR + 5; // wall/player/entity, up to nine fields
+const EXPECTED: usize = CANDIDATE + 9; // kind, id/slot, fraction
+const FIXED: usize = EXPECTED + 3;
+
+/// The exact ray-relevant projection of one permanent player slot.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct ArenaHitPlayerV1 {
+    /// Foot position in integer millimetres.
+    pub position: [i64; 3],
+    /// Canonical team zero or one.
+    pub team: u8,
+    /// Whether the player is alive at the attack boundary.
+    pub alive: bool,
+    /// Remaining spawn-protection ticks; only enemies are filtered by it.
+    pub protection: u16,
+}
+
+/// The exact ray-relevant projection of one entity in retained ID order.
+/// Health/age are deliberately absent: the kernel scans the live vector and
+/// does not test these fields inside `ray_stop`.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct ArenaHitEntityV1 {
+    /// Permanent nonzero entity identity, strictly increasing in the vector.
+    pub id: u32,
+    /// Decoy=1, barricade=2, fire zone=3, ward=4.
+    pub kind: u8,
+    /// Original participant slot that created this entity.
+    pub owner: usize,
+    /// Team retained on the entity at creation.
+    pub team: u8,
+    /// Foot position in integer millimetres.
+    pub position: [i64; 3],
+    /// Horizontal box half-width in millimetres.
+    pub half_x: i64,
+    /// Horizontal box half-depth in millimetres.
+    pub half_y: i64,
+}
+
+/// Generic controls and complete candidate vectors for one initiated ray.
+/// The parent must authenticate these values; local validation is not custody.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct ArenaHitSnapshotV1 {
+    /// Team modes use team equality; free-for-all uses original owner slots.
+    pub team_mode: bool,
+    /// Widen player and decoy horizontal bounds by 180 mm.
+    pub melee: bool,
+    /// Allow living allied player stops, as used by the healing lance.
+    pub allies: bool,
+    /// Exact weapon range in millimetres, in 1..=70,000.
+    pub range_mm: i64,
+    /// Unsigned turn angle from the accepted input.
+    pub yaw: u16,
+    /// Signed pitch in -16,384..=16,384 turn units.
+    pub pitch: i16,
+    /// Every original participant slot, including dead/ineligible players.
+    pub players: Vec<ArenaHitPlayerV1>,
+    /// Every static wall as ordered minimum/maximum coordinate triples.
+    pub walls: Vec<([i64; 3], [i64; 3])>,
+    /// Every retained live entity, including nonblocking kinds, in ID order.
+    pub entities: Vec<ArenaHitEntityV1>,
+}
+
+/// Canonical stop: 0=none, 1=wall, 2=entity, 3=player. Identity is zero for
+/// none/wall, an entity ID or an original zero-based player slot otherwise.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct ArenaHitOutputV1 {
+    /// None=0, wall=1, entity=2, original player=3.
+    pub kind: u8,
+    /// Zero for none/wall; entity ID or zero-based original player slot otherwise.
+    pub identity: u32,
+    /// Nearest Q20 ray fraction; exactly zero for no stop.
+    pub fraction_q20: i64,
+}
+
+impl ArenaHitSnapshotV1 {
+    /// Exact fixture shape: six controls, six values/player, six/wall,
+    /// nine/entity. Dimension and bounds checks are owned by the compiled AIR.
+    pub fn values(&self) -> Vec<i64> {
+        let mut out = vec![
+            i64::from(self.team_mode),
+            i64::from(self.melee),
+            i64::from(self.allies),
+            self.range_mm,
+            i64::from(self.yaw),
+            i64::from(self.pitch),
+        ];
+        for player in &self.players {
+            out.extend(player.position);
+            out.extend([
+                i64::from(player.team),
+                i64::from(player.alive),
+                i64::from(player.protection),
+            ]);
+        }
+        for (minimum, maximum) in &self.walls {
+            out.extend(minimum);
+            out.extend(maximum);
+        }
+        for entity in &self.entities {
+            out.extend([
+                i64::from(entity.id),
+                i64::from(entity.kind),
+                entity.owner as i64,
+                i64::from(entity.team),
+            ]);
+            out.extend(entity.position);
+            out.extend([entity.half_x, entity.half_y]);
+        }
+        out
+    }
+}
+
+fn carry_bounds(index: usize) -> (i64, i64) {
+    match index {
+        0..=3 => (-32767, 32767),
+        FROM..=15 => (-C, C),
+        ELIGIBLE | VALID | NONZERO => (0, 1),
+        BOX_KIND | STOP_KIND => (0, 3),
+        BOX_ID | STOP_ID => (0, i64::from(u32::MAX)),
+        NEAR | FAR | LOWER | UPPER => (-1, Q20 + 1),
+        NEAREST => (0, Q20 + 1),
+        FRACTION => (0, Q20),
+        _ => unreachable!("fixed carry index"),
+    }
+}
+
+fn bounded(air: &mut IntegerAirV1, value: Value, low: i64, high: i64) -> Value {
+    bounded_value_v1(air, value, low, high).expect("closed staged-hit arithmetic bounds")
+}
+
+fn different(air: &mut IntegerAirV1, left: Value, right: Value) -> Value {
+    let delta = air.sub(left, right);
+    let absolute = air.absolute(delta);
+    air.less(Value::constant(0), absolute)
+}
+
+fn stage_program(stage: usize, attacker: usize) -> (IntegerAirV1, [Value; CARRY], [Value; CARRY]) {
+    let mut air = IntegerAirV1::default();
+    // Every input is bound to the carried state by the parent residues. Their
+    // integer domains follow from the fixed first row and proved transitions.
+    let inputs = std::array::from_fn(|index| {
+        let (low, high) = carry_bounds(index);
+        air.input(low, high)
+    });
+    let mut out = inputs;
+    let zero = Value::constant(0);
+    let one = Value::constant(1);
+    let team_mode = Value::fixed(CONTROL, 0, 1);
+    let melee = Value::fixed(CONTROL + 1, 0, 1);
+    let allies = Value::fixed(CONTROL + 2, 0, 1);
+    let actor_team = Value::fixed(ACTOR + 3, 0, 1);
+    if stage < 4 {
+        let angle = if stage <= COS_YAW {
+            Value::fixed(CONTROL + 4, 0, 65535)
+        } else {
+            let pitch = Value::fixed(CONTROL + 5, -16384, 16384);
+            let negative = air.less(pitch, zero);
+            let unsigned = air.add_constant(pitch, 65536);
+            let angle = air.select(negative, unsigned, pitch);
+            bounded(&mut air, angle, 0, 65535)
+        };
+        let angle = if stage == COS_YAW || stage == COS_PITCH {
+            quarter_turn_v1(&mut air, angle)
+        } else {
+            angle
+        };
+        out[stage] = sine_v1(&mut air, angle);
+    } else if stage == RAY {
+        air.equate(Value::fixed(ACTOR + 4, 0, 1), one);
+        let dx = air.mul(inputs[COS_YAW], inputs[COS_PITCH]);
+        let dy = air.mul(inputs[SIN_YAW], inputs[COS_PITCH]);
+        let direction = [
+            air.divide(dx, 32767),
+            air.divide(dy, 32767),
+            inputs[SIN_PITCH],
+        ];
+        for axis in 0..3 {
+            let from = Value::fixed(ACTOR + axis, -C, C);
+            let from = if axis == 2 {
+                air.add_constant(from, 1400)
+            } else {
+                from
+            };
+            out[FROM + axis] = bounded(&mut air, from, -C, C);
+            let scaled = air.mul(direction[axis], Value::fixed(CONTROL + 3, 1, 70000));
+            let offset = air.divide(scaled, 32767);
+            let end = air.add(from, offset);
+            out[TO + axis] = bounded(&mut air, end, -C, C);
+        }
+    } else if matches!(stage, WALL | ENTITY | PLAYER) {
+        out[NEAR] = zero;
+        out[FAR] = Value::constant(Q20);
+        out[VALID] = one;
+        out[LOWER] = zero;
+        out[UPPER] = zero;
+        out[NONZERO] = zero;
+        if stage == WALL {
+            out[BOX_KIND] = one;
+            out[BOX_ID] = zero;
+            out[ELIGIBLE] = one;
+            for axis in 0..3 {
+                out[MIN + axis] = Value::fixed(CANDIDATE + axis, -C, C);
+                out[MAX + axis] = Value::fixed(CANDIDATE + 3 + axis, -C, C);
+            }
+        } else {
+            let (position, half_x, half_y, height) = if stage == ENTITY {
+                let kind_index = air.sub_constant(Value::fixed(CANDIDATE + 1, 1, 4), 1);
+                let kinds = air.lookup_columns(
+                    kind_index,
+                    &[&[1, 0, 0, 0], &[0, 1, 0, 0], &[1700, 2000, 0, 0]],
+                );
+                let team_diff = different(&mut air, actor_team, Value::fixed(CANDIDATE + 3, 0, 1));
+                let owner_diff = different(
+                    &mut air,
+                    Value::constant(attacker as i64),
+                    Value::fixed(CANDIDATE + 2, 0, 11),
+                );
+                let enemy = air.select(team_mode, team_diff, owner_diff);
+                let enemy_decoy = air.and(kinds[0], enemy);
+                out[ELIGIBLE] = air.or(kinds[1], enemy_decoy);
+                out[BOX_KIND] = Value::constant(2);
+                out[BOX_ID] = Value::fixed(CANDIDATE, 1, i64::from(u32::MAX));
+                let expanded = air.and(melee, kinds[0]);
+                let reach = air.mul_constant(expanded, 180);
+                let hx = air.add(Value::fixed(CANDIDATE + 7, 0, C), reach);
+                let hy = air.add(Value::fixed(CANDIDATE + 8, 0, C), reach);
+                (CANDIDATE + 4, hx, hy, kinds[2])
+            } else {
+                let team_diff = different(&mut air, actor_team, Value::fixed(CANDIDATE + 3, 0, 1));
+                let not_team = air.not(team_mode);
+                let enemy_team = air.or(not_team, team_diff);
+                let other = different(
+                    &mut air,
+                    Value::constant(attacker as i64),
+                    Value::fixed(CANDIDATE + 6, 0, 11),
+                );
+                let enemy = air.and(other, enemy_team);
+                let allowed = air.or(enemy, allies);
+                let protected = air.less(zero, Value::fixed(CANDIDATE + 5, 0, 65535));
+                let protected_enemy = air.and(enemy, protected);
+                let unprotected = air.not(protected_enemy);
+                let allowed_other = air.and(other, allowed);
+                let alive = air.and(allowed_other, Value::fixed(CANDIDATE + 4, 0, 1));
+                out[ELIGIBLE] = air.and(alive, unprotected);
+                out[BOX_KIND] = Value::constant(3);
+                out[BOX_ID] = Value::fixed(CANDIDATE + 6, 0, 11);
+                let reach = air.mul_constant(melee, 180);
+                let radius = air.add_constant(reach, 350);
+                (CANDIDATE, radius, radius, Value::constant(1700))
+            };
+            let x = Value::fixed(position, -C, C);
+            let y = Value::fixed(position + 1, -C, C);
+            let z = Value::fixed(position + 2, -C, C);
+            out[MIN] = air.sub(x, half_x);
+            out[MIN + 1] = air.sub(y, half_y);
+            out[MIN + 2] = z;
+            out[MAX] = air.add(x, half_x);
+            out[MAX + 1] = air.add(y, half_y);
+            out[MAX + 2] = air.add(z, height);
+        }
+        out[ELIGIBLE] = constrain_boolean_v1(&mut air, out[ELIGIBLE]).value();
+        for axis in 0..3 {
+            out[MIN + axis] = bounded(&mut air, out[MIN + axis], -C, C);
+            out[MAX + axis] = bounded(&mut air, out[MAX + axis], -C, C);
+            let reversed = air.less(out[MAX + axis], out[MIN + axis]);
+            air.equate(reversed, zero);
+        }
+    } else if (AXES..SELECT).contains(&stage) {
+        let axis = (stage - AXES) / 3;
+        let phase = (stage - AXES) % 3;
+        if phase < 2 {
+            let bound = inputs[if phase == 0 { MIN + axis } else { MAX + axis }];
+            let plane = plane_v1(&mut air, inputs[FROM + axis], inputs[TO + axis], bound);
+            if phase == 0 {
+                out[LOWER] = plane.fraction;
+                out[NONZERO] = plane.nonzero;
+            } else {
+                out[UPPER] = plane.fraction;
+                air.equate(inputs[NONZERO], plane.nonzero);
+            }
+        } else {
+            let low = air.minimum(inputs[LOWER], inputs[UPPER]);
+            let high = air.maximum(inputs[LOWER], inputs[UPPER]);
+            let near = air.maximum(inputs[NEAR], low);
+            let far = air.minimum(inputs[FAR], high);
+            out[NEAR] = air.select(inputs[NONZERO], near, inputs[NEAR]);
+            out[FAR] = air.select(inputs[NONZERO], far, inputs[FAR]);
+            let below = air.less(inputs[FROM + axis], inputs[MIN + axis]);
+            let above = air.less(inputs[MAX + axis], inputs[FROM + axis]);
+            let outside = air.or(below, above);
+            let inside = air.not(outside);
+            let valid = air.or(inputs[NONZERO], inside);
+            out[VALID] = air.and(inputs[VALID], valid);
+        }
+    } else if stage == SELECT {
+        let separated = air.less(inputs[FAR], inputs[NEAR]);
+        let overlaps = air.not(separated);
+        let hit = air.and(inputs[VALID], overlaps);
+        let candidate = air.and(inputs[ELIGIBLE], hit);
+        let closer = air.less(inputs[NEAR], inputs[NEAREST]);
+        let replace = air.and(candidate, closer);
+        let replace = constrain_boolean_v1(&mut air, replace).value();
+        out[NEAREST] = air.select(replace, inputs[NEAR], inputs[NEAREST]);
+        out[STOP_KIND] = air.select(replace, inputs[BOX_KIND], inputs[STOP_KIND]);
+        out[STOP_ID] = air.select(replace, inputs[BOX_ID], inputs[STOP_ID]);
+    } else if stage == FINISH {
+        let has_stop = air.less(zero, inputs[STOP_KIND]);
+        out[FRACTION] = air.select(has_stop, inputs[NEAREST], zero);
+        out[FRACTION] = bounded(&mut air, out[FRACTION], 0, Q20);
+    }
+    (air, inputs, out)
+}
+
+/// Closed layout. Counts and attacker are verifier choices, not witness opcodes.
+pub(super) struct StagedArenaHitAirV1 {
+    players: usize,
+    walls: usize,
+    entities: usize,
+    attacker: usize,
+    packed: PackedIntegerAirV1,
+    inputs: Vec<[Value; CARRY]>,
+    outputs: Vec<[Value; CARRY]>,
+    schedule: Vec<(usize, usize)>,
+}
+
+impl StagedArenaHitAirV1 {
+    pub(super) fn compile(
+        players: usize,
+        walls: usize,
+        entities: usize,
+        attacker: usize,
+    ) -> Result<Self, &'static str> {
+        if !(1..=12).contains(&players) || walls > 64 || entities > 48 || attacker >= players {
+            return Err("invalid fixed player/wall/entity/attacker dimensions");
+        }
+        let mut programs = Vec::new();
+        let mut inputs = Vec::new();
+        let mut outputs = Vec::new();
+        for stage in 0..STAGES {
+            let (program, input, output) = stage_program(stage, attacker);
+            programs.push(program);
+            inputs.push(input);
+            outputs.push(output);
+        }
+        let mut schedule = (0..=RAY).map(|stage| (stage, 0)).collect::<Vec<_>>();
+        for (load, count) in [(WALL, walls), (ENTITY, entities), (PLAYER, players)] {
+            for index in 0..count {
+                schedule.push((load, index));
+                schedule.extend((AXES..=SELECT).map(|stage| (stage, index)));
+            }
+        }
+        schedule.push((FINISH, 0));
+        Ok(Self {
+            players,
+            walls,
+            entities,
+            attacker,
+            packed: PackedIntegerAirV1::new(programs),
+            inputs,
+            outputs,
+            schedule,
+        })
+    }
+
+    pub(super) fn width(&self) -> usize {
+        CARRY + self.packed.width()
+    }
+    pub(super) fn fixed_width(&self) -> usize {
+        FIXED
+    }
+    pub(super) fn minimum_rows(&self) -> usize {
+        self.schedule.len() + 1
+    }
+    pub(super) fn constraint_count(&self) -> usize {
+        self.packed.constraint_count() + STAGES * CARRY + 2 * CARRY + 3 + self.packed.width()
+            - CARRY
+    }
+
+    fn validate(&self, snapshot: &ArenaHitSnapshotV1) -> Result<(), &'static str> {
+        if snapshot.players.len() != self.players
+            || snapshot.walls.len() != self.walls
+            || snapshot.entities.len() != self.entities
+        {
+            return Err("candidate vectors differ from fixed layout");
+        }
+        if !(1..=70000).contains(&snapshot.range_mm)
+            || !(-16384..=16384).contains(&snapshot.pitch)
+            || !snapshot.players[self.attacker].alive
+        {
+            return Err("invalid ray controls or dead attacker");
+        }
+        let coordinate = |x: i64| (-C..=C).contains(&x);
+        for player in &snapshot.players {
+            if player.team > 1 || !player.position.iter().copied().all(coordinate) {
+                return Err("invalid player snapshot");
+            }
+        }
+        for (minimum, maximum) in &snapshot.walls {
+            if !(0..3).all(|i| {
+                coordinate(minimum[i]) && coordinate(maximum[i]) && minimum[i] <= maximum[i]
+            }) {
+                return Err("invalid ordered wall bounds");
+            }
+        }
+        let mut prior_id = 0;
+        for entity in &snapshot.entities {
+            if entity.id <= prior_id
+                || !(1..=4).contains(&entity.kind)
+                || entity.owner >= self.players
+                || entity.team > 1
+                || !entity.position.iter().copied().all(coordinate)
+                || !(0..=C).contains(&entity.half_x)
+                || !(0..=C).contains(&entity.half_y)
+            {
+                return Err("invalid entity projection or retained ID order");
+            }
+            prior_id = entity.id;
+        }
+        Ok(())
+    }
+
+    fn fixed_values(
+        &self,
+        snapshot: &ArenaHitSnapshotV1,
+        expected: ArenaHitOutputV1,
+        row: usize,
+        rows: usize,
+    ) -> Vec<i64> {
+        let (stage, index) = self.schedule.get(row).copied().unwrap_or((PAD, 0));
+        let mut fixed = vec![0; FIXED];
+        fixed[FIRST] = i64::from(row == 0);
+        fixed[TRANSITION] = i64::from(row + 1 < rows);
+        fixed[FINAL] = i64::from(row == self.schedule.len());
+        fixed[SELECTORS + stage] = 1;
+        fixed[CONTROL..ACTOR].copy_from_slice(&[
+            i64::from(snapshot.team_mode),
+            i64::from(snapshot.melee),
+            i64::from(snapshot.allies),
+            snapshot.range_mm,
+            i64::from(snapshot.yaw),
+            i64::from(snapshot.pitch),
+        ]);
+        let actor = &snapshot.players[self.attacker];
+        fixed[ACTOR..ACTOR + 3].copy_from_slice(&actor.position);
+        fixed[ACTOR + 3] = i64::from(actor.team);
+        fixed[ACTOR + 4] = i64::from(actor.alive);
+        if stage == WALL {
+            let (minimum, maximum) = snapshot.walls[index];
+            fixed[CANDIDATE..CANDIDATE + 3].copy_from_slice(&minimum);
+            fixed[CANDIDATE + 3..CANDIDATE + 6].copy_from_slice(&maximum);
+        } else if stage == ENTITY {
+            let entity = &snapshot.entities[index];
+            fixed[CANDIDATE..CANDIDATE + 4].copy_from_slice(&[
+                i64::from(entity.id),
+                i64::from(entity.kind),
+                entity.owner as i64,
+                i64::from(entity.team),
+            ]);
+            fixed[CANDIDATE + 4..CANDIDATE + 7].copy_from_slice(&entity.position);
+            fixed[CANDIDATE + 7] = entity.half_x;
+            fixed[CANDIDATE + 8] = entity.half_y;
+        } else if stage == PLAYER {
+            let player = &snapshot.players[index];
+            fixed[CANDIDATE..CANDIDATE + 3].copy_from_slice(&player.position);
+            fixed[CANDIDATE + 3..CANDIDATE + 7].copy_from_slice(&[
+                i64::from(player.team),
+                i64::from(player.alive),
+                i64::from(player.protection),
+                index as i64,
+            ]);
+        }
+        fixed[EXPECTED..].copy_from_slice(&[
+            i64::from(expected.kind),
+            i64::from(expected.identity),
+            expected.fraction_q20,
+        ]);
+        fixed
+    }
+
+    /// Verifier-owned fixed row. It never accepts witness-supplied stage tags.
+    pub(super) fn fixed_row(
+        &self,
+        snapshot: &ArenaHitSnapshotV1,
+        expected: ArenaHitOutputV1,
+        row: usize,
+        rows: usize,
+    ) -> Result<Vec<F>, &'static str> {
+        self.validate(snapshot)?;
+        if rows < self.minimum_rows()
+            || rows > 1 << 19
+            || row >= rows
+            || expected.kind > 3
+            || !(0..=Q20).contains(&expected.fraction_q20)
+        {
+            return Err("invalid hit trace or public output dimensions");
+        }
+        Ok(self
+            .fixed_values(snapshot, expected, row, rows)
+            .into_iter()
+            .map(field)
+            .collect())
+    }
+
+    /// Generate constrained rows, deriving the result instead of accepting it.
+    /// The caller chooses padding length; a native adapter must fix its domain.
+    pub(super) fn witness(
+        &self,
+        snapshot: &ArenaHitSnapshotV1,
+        rows: usize,
+    ) -> Result<(Vec<Vec<F>>, ArenaHitOutputV1), &'static str> {
+        self.validate(snapshot)?;
+        if rows < self.minimum_rows() || rows > 1 << 19 {
+            return Err("invalid trace row count");
+        }
+        let mut carry = [0_i64; CARRY];
+        carry[NEAREST] = Q20 + 1;
+        let mut trace = Vec::with_capacity(rows);
+        let dummy = ArenaHitOutputV1 {
+            kind: 0,
+            identity: 0,
+            fraction_q20: 0,
+        };
+        for row in 0..rows {
+            let stage = self.schedule.get(row).map_or(PAD, |entry| entry.0);
+            let fixed = self.fixed_values(snapshot, dummy, row, rows);
+            let bank = self.packed.witness(stage, &carry, &fixed);
+            let mut current = carry.iter().copied().map(field).collect::<Vec<_>>();
+            current.extend(bank.iter().copied().map(field));
+            trace.push(current);
+            let mut next = carry;
+            for index in 0..CARRY {
+                next[index] =
+                    self.packed
+                        .read_integer(stage, self.outputs[stage][index], &bank, &fixed);
+                let (low, high) = carry_bounds(index);
+                if !(low..=high).contains(&next[index]) {
+                    return Err("derived ray or body leaves bounded geometry domain");
+                }
+            }
+            carry = next;
+        }
+        Ok((
+            trace,
+            ArenaHitOutputV1 {
+                kind: carry[STOP_KIND] as u8,
+                identity: carry[STOP_ID] as u32,
+                fraction_q20: carry[FRACTION],
+            },
+        ))
+    }
+
+    /// Fixed-schedule constraints, including every carried field and terminal
+    /// claim. PackedIntegerAir evaluates local programs only; all next-row
+    /// links therefore live here, never inside a packed program.
+    pub(super) fn residues(
+        &self,
+        current: &[F],
+        next: &[F],
+        fixed: &[F],
+    ) -> Result<Vec<F>, &'static str> {
+        if current.len() != self.width() || next.len() != self.width() || fixed.len() != FIXED {
+            return Err("invalid hit row width");
+        }
+        let bank = &current[CARRY..];
+        let stages = &fixed[SELECTORS..SELECTORS + STAGES];
+        let mut residues = self.packed.residues(bank, fixed, stages);
+        for index in 0..CARRY {
+            let mut expected = F::ZERO;
+            for stage in 0..STAGES {
+                let input = self
+                    .packed
+                    .read(stage, self.inputs[stage][index], bank, fixed);
+                residues.push(stages[stage].mul(input.sub(current[index])));
+                let output = self
+                    .packed
+                    .read(stage, self.outputs[stage][index], bank, fixed);
+                expected = expected.add(stages[stage].mul(output));
+            }
+            residues.push(fixed[TRANSITION].mul(next[index].sub(expected)));
+            let initial = if index == NEAREST {
+                field(Q20 + 1)
+            } else {
+                F::ZERO
+            };
+            residues.push(fixed[FIRST].mul(current[index].sub(initial)));
+        }
+        for (index, expected) in [STOP_KIND, STOP_ID, FRACTION]
+            .into_iter()
+            .zip(&fixed[EXPECTED..])
+        {
+            residues.push(fixed[FINAL].mul(current[index].sub(*expected)));
+        }
+        // All program inputs are the first CARRY normal columns. Padding uses
+        // the identity program and zeroes every other arithmetic-bank cell.
+        for value in &bank[CARRY..] {
+            residues.push(stages[PAD].mul(*value));
+        }
+        Ok(residues)
+    }
+}
