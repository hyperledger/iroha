+            // A negative numerator of -Q20 divided by a larger delta truncates
+            // to zero. The reference considers that near-start rounding a hit.
+            [
+                -COORDINATE_LIMIT + 1,
+                COORDINATE_LIMIT,
+                -COORDINATE_LIMIT,
+                -COORDINATE_LIMIT,
+            ],
