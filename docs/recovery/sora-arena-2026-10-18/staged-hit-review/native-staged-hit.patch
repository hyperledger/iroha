+/// Inspect the real native layout before allocating a witness or attempting a proof.
+pub fn inspect_staged_hit_v1(
+    snapshot: &ArenaHitSnapshotV1,
+    attacker: usize,
+    expected: ArenaHitOutputV1,
+) -> Result<ArenaStagedHitLayoutV1, String> {
+    Adapter::new(snapshot, attacker, expected)?.layout()
+}
+
+/// Generate a genuine native proof for an explicitly supplied public ray snapshot.
+/// Fail before witness allocation if its conservative wire bound exceeds four MiB.
+pub fn prove_staged_hit_v1(
+    snapshot: &ArenaHitSnapshotV1,
+    attacker: usize,
+    expected: ArenaHitOutputV1,
+) -> Result<Vec<u8>, String> {
+    let adapter = Adapter::new(snapshot, attacker, expected)?;
+    if !adapter.layout()?.fits_proof_cap {
+        return Err("staged hit exceeds unchanged native proof cap".into());
+    }
+    let columns = adapter.columns()?;
+    prove_proof_managed_note_stark_v1(&adapter, &columns).map_err(|error| error.to_string())
+}
+
+/// Verify the native proof without running the ray witness generator or host hit selection.
+pub fn verify_staged_hit_v1(
+    snapshot: &ArenaHitSnapshotV1,
+    attacker: usize,
+    expected: ArenaHitOutputV1,
+    proof: &[u8],
+) -> Result<(), String> {
+    let adapter = Adapter::new(snapshot, attacker, expected)?;
+    if proof.len() > MAX_PROOF_BYTES || !adapter.layout()?.fits_proof_cap {
+        return Err("staged hit exceeds unchanged native proof cap".into());
+    }
+    verify_proof_managed_note_stark_v1(&adapter, proof).map_err(|error| error.to_string())
+}
