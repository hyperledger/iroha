+
+/// Positive-divisor Euclidean division with an explicit, constrained quotient cap.
+///
+/// Unlike interval division, this admits correlated numerator/divisor inputs whose
+/// independent worst-case quotient bound is too large. The cap is a real range
+/// equation: inputs whose quotient exceeds it have no satisfying witness. All
+/// operands receive actual nonnegative range constraints; the reconstruction
+/// remains below 2^49. The <2^47 operand cap also leaves room for the comparison
+/// offset and decomposition slack below the raw compiler's 50-bit boundary.
+///
+/// # Errors
+/// Returns `Bounds` without graph mutation for invalid/unsafe operand intervals,
+/// a negative or excessive quotient cap, or an unsafe reconstruction product.
+pub(super) fn divmod_unsigned_bounded_v1(
+    air: &mut IntegerAirV1,
+    numerator: Value,
+    divisor: Value,
+    max_quotient: i64,
+) -> Result<(Value, Value), CheckedIntegerAirErrorV1> {
+    const LIMIT: i64 = 1_i64 << 47;
+    if numerator.low < 0
+        || numerator.low > numerator.high
+        || numerator.high >= LIMIT
+        || divisor.low <= 0
+        || divisor.low > divisor.high
+        || divisor.high >= LIMIT
+        || !(0..LIMIT).contains(&max_quotient)
+    {
+        return Err(CheckedIntegerAirErrorV1::Bounds);
+    }
+    let quotient_high = max_quotient.min(numerator.high / divisor.low);
+    if i128::from(quotient_high) * i128::from(divisor.high) + i128::from(divisor.high - 1)
+        >= (1_i128 << 49)
+    {
+        return Err(CheckedIntegerAirErrorV1::Bounds);
+    }
+    Ok(air.divmod_unsigned_variable(numerator, divisor, quotient_high))
+}
