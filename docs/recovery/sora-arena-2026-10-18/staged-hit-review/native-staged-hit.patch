+    use super::*;
+
+    fn player(x: i64, y: i64, team: u8) -> ArenaHitPlayerV1 {
+        ArenaHitPlayerV1 {
+            position: [x, y, 0],
+            team,
+            alive: true,
+            protection: 0,
+        }
+    }
+
+    fn scene() -> ArenaHitSnapshotV1 {
+        ArenaHitSnapshotV1 {
+            team_mode: false,
+            melee: false,
+            allies: false,
+            range_mm: 10000,
+            yaw: 0,
+            pitch: 0,
+            players: vec![player(0, 0, 0), player(5000, 0, 1), player(5000, 0, 1)],
+            walls: Vec::new(),
+            entities: Vec::new(),
+        }
+    }
+
+    fn graph(snapshot: &ArenaHitSnapshotV1) -> StagedArenaHitAirV1 {
+        StagedArenaHitAirV1::compile(
+            snapshot.players.len(),
+            snapshot.walls.len(),
+            snapshot.entities.len(),
+            0,
+        )
+        .unwrap()
+    }
+
+    fn accepted(
+        air: &StagedArenaHitAirV1,
+        snapshot: &ArenaHitSnapshotV1,
+        output: ArenaHitOutputV1,
+        trace: &[Vec<F>],
+    ) -> bool {
+        if trace.len() < air.minimum_rows() {
+            return false;
+        }
+        (0..trace.len()).all(|row| {
+            let Ok(fixed) = air.fixed_row(snapshot, output, row, trace.len()) else {
+                return false;
+            };
+            let next = &trace[(row + 1).min(trace.len() - 1)];
+            air.residues(&trace[row], next, &fixed)
+                .is_ok_and(|residues| residues.iter().all(|v| *v == F::ZERO))
+        })
+    }
+
+    fn check(snapshot: &ArenaHitSnapshotV1, kind: u8, identity: u32) {
+        let air = graph(snapshot);
+        let (trace, output) = air.witness(snapshot, air.minimum_rows() + 2).unwrap();
+        assert_eq!((output.kind, output.identity), (kind, identity));
+        assert!(accepted(&air, snapshot, output, &trace));
+        assert_eq!(
+            air.residues(
+                &trace[0],
+                &trace[1],
+                &air.fixed_row(snapshot, output, 0, trace.len()).unwrap()
+            )
+            .unwrap()
+            .len(),
+            air.constraint_count()
+        );
+    }
+
+    #[test]
+    fn staged_scan_preserves_ties_eligibility_parallel_axes_and_melee() {
+        let mut input = scene();
+        check(&input, 3, 1); // Equal bodies retain the original lower slot.
+        input.walls.push(([4650, -100, 0], [4651, 100, 1700]));
+        check(&input, 1, 0); // Wall/player equal fraction.
+        input.walls[0].0[0] += 1;
+        input.walls[0].1[0] += 1;
+        check(&input, 3, 1);
+        input.walls.clear();
+        input.players[1].protection = 1;
+        check(&input, 3, 2);
+        input.players[2].alive = false;
+        check(&input, 0, 0);
+        input.players[1].team = 0;
+        input.team_mode = true;
+        check(&input, 0, 0);
+        input.allies = true;
+        check(&input, 3, 1); // A protected ally can receive healing.
+        input.players[1].position[1] = 350;
+        check(&input, 3, 1); // Parallel-axis inclusive contact.
+        input.players[1].position[1] = 351;
+        check(&input, 0, 0);
+        input.melee = true;
+        check(&input, 3, 1);
+        input.players[1].position[1] = 531;
+        check(&input, 0, 0);
