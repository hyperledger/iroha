+    #[test]
+    fn staged_scan_matches_independent_current_kernel_reference_vectors() {
+        let fixture = norito::json::from_slice_value(include_bytes!(
+            "../../tests/fixtures/arena_staged_hit_reference.json"
+        ))
+        .unwrap();
+        let cases = fixture.as_object().unwrap()["cases"].as_array().unwrap();
+        let integers = |value: &norito::json::Value| {
+            value
+                .as_array()
+                .unwrap()
+                .iter()
+                .map(|v| v.as_i64().unwrap())
+                .collect::<Vec<_>>()
+        };
+        assert_eq!(
+            cases.len(),
+            92,
+            "review changes to the independent reference corpus"
+        );
+        for case in cases {
+            let case = case.as_object().unwrap();
+            let name = case["name"].as_str().unwrap();
+            let controls = integers(&case["controls"]);
+            let players = case["players"]
+                .as_array()
+                .unwrap()
+                .iter()
+                .map(|value| {
+                    let row = integers(value);
+                    ArenaHitPlayerV1 {
+                        position: row[..3].try_into().unwrap(),
+                        team: row[3] as u8,
+                        alive: row[4] != 0,
+                        protection: row[5] as u16,
+                    }
+                })
+                .collect::<Vec<_>>();
+            let walls = case["walls"]
+                .as_array()
+                .unwrap()
+                .iter()
+                .map(|value| {
+                    let row = integers(value);
+                    (row[..3].try_into().unwrap(), row[3..].try_into().unwrap())
+                })
+                .collect::<Vec<_>>();
+            let entities = case["entities"]
+                .as_array()
+                .unwrap()
+                .iter()
+                .map(|value| {
+                    let row = integers(value);
+                    ArenaHitEntityV1 {
+                        id: row[0] as u32,
+                        kind: row[1] as u8,
+                        owner: row[2] as usize,
+                        team: row[3] as u8,
+                        position: row[4..7].try_into().unwrap(),
+                        half_x: row[7],
+                        half_y: row[8],
+                    }
+                })
+                .collect::<Vec<_>>();
+            let input = ArenaHitSnapshotV1 {
+                team_mode: controls[0] != 0,
+                melee: controls[1] != 0,
+                allies: controls[2] != 0,
+                range_mm: controls[3],
+                yaw: controls[4] as u16,
+                pitch: controls[5] as i16,
+                players,
+                walls,
+                entities,
+            };
+            let air = StagedArenaHitAirV1::compile(
+                input.players.len(),
+                input.walls.len(),
+                input.entities.len(),
+                case["attacker"].as_u64().unwrap() as usize,
+            )
+            .unwrap();
+            assert_eq!(
+                input.values().len(),
+                6 + 6 * input.players.len() + 6 * input.walls.len() + 9 * input.entities.len()
+            );
+            let (trace, output) = air
+                .witness(&input, air.minimum_rows())
+                .unwrap_or_else(|error| panic!("{name}: {error}"));
+            let expected = integers(&case["expected"]);
+            assert_eq!(
+                [
+                    i64::from(output.kind),
+                    i64::from(output.identity),
+                    output.fraction_q20
+                ],
+                expected.as_slice(),
+                "{name}"
+            );
+            let ray = case["ray"].as_array().unwrap();
+            for axis in 0..3 {
+                assert_eq!(
+                    trace[RAY + 1][FROM + axis],
+                    field(integers(&ray[0])[axis]),
+                    "{name} ray origin"
+                );
+                assert_eq!(
+                    trace[RAY + 1][TO + axis],
+                    field(integers(&ray[1])[axis]),
+                    "{name} ray end"
+                );
+            }
+            assert!(
+                accepted(&air, &input, output, &trace),
+                "{name} AIR residues"
+            );
+        }
+    }
+}
