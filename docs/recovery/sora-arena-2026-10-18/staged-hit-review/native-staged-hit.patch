+/// Opt-in component experiment with a fresh output directory and retained proof evidence.
+/// The caller supplies a fixture independently derived from the game kernel. This does
+/// not authenticate that fixture. `prove=false` records layout only, never proof success.
+pub fn run_staged_hit_research_v1(
+    snapshot: &ArenaHitSnapshotV1,
+    attacker: usize,
+    expected: ArenaHitOutputV1,
+    output: &Path,
+    prove: bool,
+) -> Result<(), Box<dyn std::error::Error>> {
+    std::fs::create_dir(output)?;
+    let layout = inspect_staged_hit_v1(snapshot, attacker, expected)?;
+    println!("layout={layout:?}");
+    std::fs::write(output.join("layout.txt"), format!("{layout:#?}\n"))?;
+    let source_hex = staged_hit_source_digest_v1()
+        .iter()
+        .map(|byte| format!("{byte:02x}"))
+        .collect::<String>();
+    std::fs::write(
+        output.join("public-statement.txt"),
+        format!(
+            "attacker={attacker}\ncounts={:?}\nsnapshot_values={:?}\nexpected={expected:?}\nsource_digest={source_hex}\n",
+            [
+                snapshot.players.len(),
+                snapshot.walls.len(),
+                snapshot.entities.len()
+            ],
+            snapshot.values(),
+        ),
+    )?;
+    if !layout.fits_proof_cap {
+        return Err("layout exceeds unchanged four-MiB cap; no proof attempted".into());
+    }
+    if !prove {
+        return Ok(());
+    }
+    println!("stage=prove");
+    let started = Instant::now();
+    let proof = prove_staged_hit_v1(snapshot, attacker, expected)?;
+    let prove_ms = started.elapsed().as_millis();
+    std::fs::write(output.join("staged-hit.stark"), &proof)?;
+    println!(
+        "stage=verify proof_bytes={} prove_ms={prove_ms}",
+        proof.len()
+    );
+    let started = Instant::now();
+    verify_staged_hit_v1(snapshot, attacker, expected, &proof)?;
+    let verify_ms = started.elapsed().as_millis();
+    let mut rejected = 0;
+    for (name, changed) in [
+        (
+            "kind",
+            ArenaHitOutputV1 {
+                kind: (expected.kind + 1) % 4,
+                ..expected
+            },
+        ),
+        (
+            "identity",
+            ArenaHitOutputV1 {
+                identity: expected.identity.wrapping_add(1),
+                ..expected
+            },
+        ),
+        (
+            "fraction",
+            ArenaHitOutputV1 {
+                fraction_q20: (expected.fraction_q20 + 1) % ((1 << 20) + 1),
+                ..expected
+            },
+        ),
+    ] {
+        verify_staged_hit_v1(snapshot, attacker, changed, &proof)
+            .err()
+            .ok_or("altered public result accepted")?;
+        println!("altered_{name}=rejected");
+        rejected += 1;
+    }
+    let mut changed = snapshot.clone();
+    changed.yaw = changed.yaw.wrapping_add(1);
+    verify_staged_hit_v1(&changed, attacker, expected, &proof)
+        .err()
+        .ok_or("altered public control accepted")?;
+    println!("altered_yaw=rejected");
+    rejected += 1;
+    let mut changed = snapshot.clone();
+    let x = &mut changed.players[attacker].position[0];
+    *x += if *x < (1 << 20) { 1 } else { -1 };
+    verify_staged_hit_v1(&changed, attacker, expected, &proof)
+        .err()
+        .ok_or("altered public actor accepted")?;
+    println!("altered_actor_position=rejected");
+    rejected += 1;
+    if !snapshot.walls.is_empty() {
+        let mut changed = snapshot.clone();
+        let shift = if changed.walls[0].1[0] < (1 << 20) {
+            1
+        } else {
+            -1
+        };
+        changed.walls[0].0[0] += shift;
+        changed.walls[0].1[0] += shift;
+        verify_staged_hit_v1(&changed, attacker, expected, &proof)
+            .err()
+            .ok_or("altered public wall accepted")?;
+        println!("altered_wall=rejected");
+        rejected += 1;
+    }
+    if !snapshot.entities.is_empty() {
+        let mut changed = snapshot.clone();
+        changed.entities[0].team ^= 1;
+        verify_staged_hit_v1(&changed, attacker, expected, &proof)
+            .err()
+            .ok_or("altered public entity accepted")?;
+        println!("altered_entity_team=rejected");
+        rejected += 1;
+    }
+    let mut trailing = proof.clone();
+    trailing.push(0);
+    let mut corrupt = proof.clone();
+    let index = corrupt.len() / 2;
+    corrupt[index] ^= 1;
+    for (name, bytes) in [
+        ("truncated", &proof[..proof.len() - 1]),
+        ("trailing", trailing.as_slice()),
+        ("tampered", corrupt.as_slice()),
+    ] {
+        verify_staged_hit_v1(snapshot, attacker, expected, bytes)
+            .err()
+            .ok_or("malformed proof accepted")?;
+        println!("{name}_proof=rejected");
+        rejected += 1;
+    }
+    let report = format!(
+        "research_only=true\nqualified=false\nrelation=generic_public_ordered_ray_stop\nproof_bytes={}\nproof_sha256={:x}\nprove_ms={prove_ms}\nverify_ms={verify_ms}\nnegative_verifications={rejected}\n",
+        proof.len(),
+        Sha256::digest(&proof)
+    );
+    std::fs::write(output.join("measurements.txt"), &report)?;
+    print!("{report}");
+    Ok(())
+}
