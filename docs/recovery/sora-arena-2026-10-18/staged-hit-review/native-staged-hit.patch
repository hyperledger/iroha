+                input[which * 4..which * 4 + 4].copy_from_slice(&axis);
+                check(&graph, input);
+            }
+        }
+        // Independent positive/negative slab intervals which overlap at one
+        // fraction, then miss by one integer unit after truncation.
+        check(&graph, [0, 8, 2, 4, 8, 0, 2, 4, 0, 0, -1, 1]);
+        check(&graph, [0, 8, 2, 3, 8, 0, 1, 4, 0, 0, -1, 1]);
+        check(
+            &graph,
+            [0, Q20, 0, Q20 / 2, 0, Q20, Q20 / 2, Q20, 0, 0, -1, 1],
+        );
+        check(
+            &graph,
+            [0, Q20, 0, Q20 / 2, 0, Q20, Q20 / 2 + 1, Q20, 0, 0, -1, 1],
