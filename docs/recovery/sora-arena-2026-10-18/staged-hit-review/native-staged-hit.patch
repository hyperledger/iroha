+//! Unregistered native proof of the generic ordered Arena ray-stop relation.
+//!
+//! The complete ray-relevant public snapshot, attacker and claimed result are
+//! bound into Fiat–Shamir and verifier-reconstructed fixed columns. Aim, signed
+//! slab arithmetic, eligibility and nearest selection are polynomial constraints.
+//! This is a conditional component proof: it establishes neither authenticated
+//! World state, legal attack initiation, damage, a kill, custody nor settlement.
+
+pub use super::arena_staged_hit_air::{
+    ArenaHitEntityV1, ArenaHitOutputV1, ArenaHitPlayerV1, ArenaHitSnapshotV1,
+};
+use super::{
+    arena_staged_hit_air::StagedArenaHitAirV1,
+    stark::{
+        aggregate_stark::{
+            AggregateProofLayoutV1, AggregateStarkDomainsV1, AggregateStarkParametersV1,
+            AggregateTraceGroupLayoutV1, maximum_encoded_proof_with_deep_bytes_v1,
+        },
+        proof_managed_note_stark::{
+            NOTE_COPY_AUX_WIDTH_V1, NOTE_COPY_FIXED_WIDTH_V1, NOTE_COPY_WIDTH_V1,
+            NoteCopyCellPolicyV1, NoteCopyChallengesV1, NoteCopyScheduleV1,
+            ProofManagedNoteStarkAdapterV1, ProofManagedNoteStarkErrorV1 as Error,
+            ProofManagedNoteStarkProtocolV1, prove_proof_managed_note_stark_v1,
+            verify_proof_managed_note_stark_v1,
+        },
+        transparent_stark::{
+            GoldilocksDigest384V1, GoldilocksFieldV1 as F, TransparentStarkDigestContextV1,
+            TransparentTranscriptV1, goldilocks_digest384_frame_v1,
+        },
+    },
+};
+use sha2::{Digest, Sha256};
+use std::{path::Path, time::Instant};
+
+const TRACE_LOG: u8 = 13;
+const TRACE_SIZE: usize = 1 << TRACE_LOG;
+const MAX_PROOF_BYTES: usize = 4 * 1024 * 1024;
+const CONTEXT: TransparentStarkDigestContextV1 =
+    TransparentStarkDigestContextV1::execution_v1(b"arena-staged-hit-research-v1");
+const DESCRIPTOR: &[u8] = b"unregistered-arena-staged-hit-research-v1:players=1..12:walls=0..64:entities=0..48:ordered-public-ray-snapshot:aim=bhaskara-q15:slabs=signed-trunc-q20:wall-entity-player-strict-nearest:fixed-stage-schedule:complete-scratch-carry:trace=8192:degree=4:queries=136:lde=8:fri-terminal=1024:fri-degree=143:composition-chunks=4:proof-cap=4194304:no-world:no-attack-legality:no-damage:no-custody:no-qualification";
