+/// Computational-source tripwire for this unregistered component, not a release profile ID.
+/// Build/toolchain and dependency provenance must additionally be retained by the caller.
+pub fn staged_hit_source_digest_v1() -> [u8; 32] {
+    let sources: &[(&str, &[u8])] = &[
+        (
+            "arena_staged_hit_air.rs",
+            include_bytes!("arena_staged_hit_air.rs"),
+        ),
+        ("arena_aim_air.rs", include_bytes!("arena_aim_air.rs")),
+        (
+            "arena_geometry_air.rs",
+            include_bytes!("arena_geometry_air.rs"),
+        ),
+        (
+            "checked_integer_air.rs",
+            include_bytes!("checked_integer_air.rs"),
+        ),
+        ("integer_air.rs", include_bytes!("integer_air.rs")),
+        (
+            "arena_staged_hit_stark_research.rs",
+            include_bytes!("arena_staged_hit_stark_research.rs"),
+        ),
+        ("stark/mod.rs", include_bytes!("stark/mod.rs")),
+        (
+            "stark/transparent_stark.rs",
+            include_bytes!("stark/transparent_stark.rs"),
+        ),
+        (
+            "stark/aggregate_stark.rs",
+            include_bytes!("stark/aggregate_stark.rs"),
+        ),
+        (
+            "stark/proof_managed_note_stark.rs",
+            include_bytes!("stark/proof_managed_note_stark.rs"),
+        ),
+        (
+            "stark/proof_managed_note_stark_execution_fixed.rs",
+            include_bytes!("stark/proof_managed_note_stark_execution_fixed.rs"),
+        ),
+        (
+            "privacy_engines/transparent_stark.rs",
+            include_bytes!("../privacy_engines/transparent_stark.rs"),
+        ),
+    ];
+    let mut hash = Sha256::new();
+    hash.update(b"iroha:unregistered-arena-staged-hit-source:v1\0");
+    for (name, bytes) in sources {
+        hash.update((name.len() as u64).to_le_bytes());
+        hash.update(name.as_bytes());
+        hash.update((bytes.len() as u64).to_le_bytes());
+        hash.update(bytes);
+    }
+    hash.finalize().into()
+}
