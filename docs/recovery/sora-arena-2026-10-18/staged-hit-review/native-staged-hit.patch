+            valid(graph, &row.into_iter().map(field).collect::<Vec<_>>()),
+            "{input:?}"
+        );
+    }
+
+    #[test]
+    fn exact_slab_relation_covers_signed_parallel_tangent_and_rounding_cases() {
+        let graph = ArenaGeometryAirV1::compile();
