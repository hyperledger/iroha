    "./kotodama-compiler": {
      "types": "./kotodama-compiler.d.ts",
      "browser": "./dist/kotodamaCompiler/browser.js",
      "import": "./dist/kotodamaCompiler/index.js"
    },
    "./race": {
      "browser": "./dist/race.js",
      "import": "./dist/race.js",
      "types": "./race.d.ts"
    },
    "./classed-race": {
      "types": "./classed-race.d.ts",
