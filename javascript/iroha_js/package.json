    },
    "./torii-browser": {
      "import": "./dist/toriiBrowserClient.js",
      "browser": "./dist/toriiBrowserClient.js",
      "types": "./torii-browser.d.ts"
    },
    "./sumeragi-typed": {
      "browser": "./dist/sumeragiTyped.js",
      "import": "./dist/sumeragiTyped.js",
      "types": "./sumeragi-typed.d.ts"
    },
    "./norito": {
      "import": "./dist/public/norito.js",
      "types": "./norito.d.ts"
    },
    "./canonical-request": {
      "browser": "./dist/canonicalRequest.js",
      "import": "./dist/canonicalRequest.js",
      "types": "./canonical-request.d.ts"
    },
    "./sorafs": {
      "import": "./dist/public/sorafs.js",
