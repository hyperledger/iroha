{
  "name": "@iroha/iroha-js",
  "version": "0.0.3",
  "description": "Node.js SDK for interacting with Hyperledger Iroha via Norito payloads and Torii APIs.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./index.d.ts"
    },
    "./nft": {
      "types": "./nft.d.ts",
      "browser": "./dist/nft.js",
      "import": "./dist/nft.js"
    },
    "./address": {
      "browser": "./dist/public/address.js",
      "import": "./dist/public/address.js",
