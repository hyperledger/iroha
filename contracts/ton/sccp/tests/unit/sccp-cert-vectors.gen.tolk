/// `ton_finalize_two_faults` (TON scenario): two faults in one call: a payload of another revision, or one that pays the contract itself, under a checkpoint that is not stored (EVM reports the checkpoint, the TON minter the payload); a finalization after the deadline with a wrong leaf path (the deadline is reported); a void with a wrong nonce argument under a checkpoint that is not stored.
fun vecScenarioTonFinalizeTwoFaults() {
    val env = replayDeploy(
        InitialPin { generation: 5, root: 0x990240eeee78c47b3adbf4deb5473fbf4778a4a2e8bac774bed12295b08956a1, start: 1000, untilMs: 1801209600000 },
