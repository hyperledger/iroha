/// `rotation_sub_second_deadline` (EVM scenario marked `ton_replayable`): a rotation X with a sub-second timestamp_ms installs the sub-second untilMs = t_eff(X) + validity_ms; the whole-second destination clock is Live at the last second at or below untilMs and Frozen at the next one, which is untilMs + 1 ms.
fun vecScenarioRotationSubSecondDeadline() {
    val env = replayDeploy(
        InitialPin { generation: 5, root: 0x990240eeee78c47b3adbf4deb5473fbf4778a4a2e8bac774bed12295b08956a1, start: 1000, untilMs: 1801209600000 },
        [
            "83c23b910a1e9cf60e85d533950243df2a8cef1c3182b1d6e2c5289ae2664b9a884613c59e71224fba05eed8badcfb39".hexToSlice(),
