/// `cheap_path_identity_signature` (EVM scenario marked `ton_replayable`): the cheap path is mandatory and observable: a certificate of X whose signature covers another instance is refused while X is not stored and accepted without a signature check once it is (nothing changes, so NothingToDo); the identity signature is refused before the cheap path.
fun vecScenarioCheapPathIdentitySignature() {
    val env = replayDeploy(
        InitialPin { generation: 5, root: 0x990240eeee78c47b3adbf4deb5473fbf4778a4a2e8bac774bed12295b08956a1, start: 1000, untilMs: 1801209600000 },
