    // step 0: submitCheckpoints -> BadSignature
    val cert0 = certCell(
        "a58938553d201dc1b8bed596eaf9bbd293ec6782c165fe1ed3d2e20b1b7c674f29249ba06b678aed75263ef997d8bb5319af48c0428d89aee9115161d82e2d110c9459204650bfa9fcb7b152e3cb8660b587a1f6d593682965830d772e5ba7e3".hexToSlice(),
