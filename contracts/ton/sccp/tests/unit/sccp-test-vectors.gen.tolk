struct VecNativeTransfer {
    networkId: int
    revision: int
    nonce: int
    owner: int
    amount: int
    recipient: array<slice>
    body: cell
}

/// Every TON native event with the independently encoded exact ext-out body.
fun vecNativeTransfer(index: int): VecNativeTransfer {
    // native transfer nonce 7
    if (index == 0) {
        return {
            networkId: 0x1111111111111111111111111111111111111111111111111111111111111111,
            revision: 1,
            nonce: 7,
            owner: 0x358d800b5bbd68025fa04519afd9118e44b201be55e0e0029b7b0cbe3b8f0170,
            amount: 1000000000,
            recipient: [
                "0201209c67fb22c16242567c197d254541b474fbf2c21ac4d830cf255ca6f273e2f0d8".hexToSlice(),
            ],
            body: parseCellFromHex(""),
        };
    }
    throw VecErrors.BadIndex;
}

