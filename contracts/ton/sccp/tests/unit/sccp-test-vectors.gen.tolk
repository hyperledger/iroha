/// Selects one recorded row from vecAllTreePathPage.
fun vecAllTreePath(index: int): cell {
    assert ((index >= 0) & (index < 665)) throw VecErrors.BadIndex;
    val offset = (index / 16) * 16;
    return vecFixtureCell(index - offset, min(16, 665 - offset), vecAllTreePathPage(index / 16));
}

