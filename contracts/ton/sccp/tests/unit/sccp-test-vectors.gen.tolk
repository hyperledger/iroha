struct VecTreeNegative {
    leaf: int
    index: int
    count: int
    root: int
    path: array<int>
    computed: int
    malformed: bool
}

/// Every transfer/control/node confusion and structural refusal.
fun vecTreeNegative(index: int): VecTreeNegative {
    // internal_node_as_leaf
    if (index == 0) {
        return {
            leaf: 0x70090dc0708e21fdb273539262dcdcf2bc0ac5072901d7c7651aa22ca0f42caf,
            index: 0,
            count: 4,
            root: 0x7c24ce71d576b3d3a2fabdc70762e7cf3e0281088a78dd395e4998d4bae222e,
            path: [
                0x834fdae85d1a59c3e3b528d6e95d9b7eb10ab434e029f33921d916453816adb4,
            ],
            computed: 0,
            malformed: true,
        };
    }
    // transfer_leaf_at_control_position
    if (index == 1) {
        return {
            leaf: 0x1f3c3340d0383d72ec3cd5ff2d6bdcd0c848db68472a22d4d88ecd0de32776ca,
            index: 2,
            count: 3,
            root: 0x4c576fea92dec97bcfa3c0624725f94b24b341053d4739ddc26e971e7e1fd59c,
            path: [
                0x70090dc0708e21fdb273539262dcdcf2bc0ac5072901d7c7651aa22ca0f42caf,
            ],
            computed: 0xe1319cb8b86be80a7dfefe73c06fc187369fe87519a961dbc9c6cdbd8b758eba,
            malformed: false,
        };
    }
    // control_leaf_with_flipped_pause
    if (index == 2) {
        return {
            leaf: 0x4a6f41b0e8d2fc32858753f4395cd78e1c6c503155540d885081ce82f865578c,
            index: 2,
            count: 3,
            root: 0x4c576fea92dec97bcfa3c0624725f94b24b341053d4739ddc26e971e7e1fd59c,
            path: [
                0x70090dc0708e21fdb273539262dcdcf2bc0ac5072901d7c7651aa22ca0f42caf,
            ],
            computed: 0xca4571e1e82fe9b39d2667b6de01d23de61d07c84d9286283a8b26ac990771c9,
            malformed: false,
        };
    }
    // promoted_leaf_with_larger_count
    if (index == 3) {
        return {
            leaf: 0x6c52cbec23014eb6020c27cca74a39cdee321fe8c8b740cce17206b40d5b503a,
            index: 4,
            count: 6,
            root: 0x237d1b0483dcbb93e5e1c926befecf1bd0103d7394997bb65fa7c9292f2b2fae,
            path: [
                0x7c24ce71d576b3d3a2fabdc70762e7cf3e0281088a78dd395e4998d4bae222e,
            ],
            computed: 0,
            malformed: true,
        };
    }
    // unused_sibling
    if (index == 4) {
        return {
            leaf: 0xe87379d0669b521d52ee743edf2ea5d4e72d9d85f6d229f2a3dfb457096b3991,
            index: 1,
            count: 4,
            root: 0x7c24ce71d576b3d3a2fabdc70762e7cf3e0281088a78dd395e4998d4bae222e,
            path: [
                0x7c23a8235d8fb47455367e15d9b2fa0fd51bb86c1c4afd86272ddcec39361de,
                0x834fdae85d1a59c3e3b528d6e95d9b7eb10ab434e029f33921d916453816adb4,
                0x0,
            ],
            computed: 0,
            malformed: true,
        };
    }
    // index_out_of_range
    if (index == 5) {
        return {
            leaf: 0x7c23a8235d8fb47455367e15d9b2fa0fd51bb86c1c4afd86272ddcec39361de,
            index: 4,
            count: 4,
            root: 0x7c24ce71d576b3d3a2fabdc70762e7cf3e0281088a78dd395e4998d4bae222e,
            path: [
                0xe87379d0669b521d52ee743edf2ea5d4e72d9d85f6d229f2a3dfb457096b3991,
                0x834fdae85d1a59c3e3b528d6e95d9b7eb10ab434e029f33921d916453816adb4,
            ],
            computed: 0,
            malformed: true,
        };
    }
    throw VecErrors.BadIndex;
}

