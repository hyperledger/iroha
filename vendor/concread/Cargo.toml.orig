[package]
edition = "2021"
name = "concread"
version = "0.5.10"
authors = ["William Brown <william@blackhats.net.au>"]
build = false
autolib = false
autobins = false
autoexamples = false
autotests = false
autobenches = false
description = "Concurrently readable B+trees and epoch-reclaimed cells for Iroha"
homepage = "https://github.com/kanidm/concread/"
documentation = "https://docs.rs/concread/latest/concread/"
readme = "README.md"
keywords = ["concurrency", "mvcc", "copy-on-write", "transactional-memory"]
categories = ["data-structures", "memory-management", "concurrency"]
license = "MPL-2.0"
repository = "https://github.com/kanidm/concread/"

[features]
default = ["ebr", "maps"]
ebr = ["dep:crossbeam-epoch"]
maps = ["dep:crossbeam-utils"]
# Exercise the same B+tree engine with a smaller node fanout.
skinny = []

[lib]
name = "concread"
path = "src/lib.rs"

[[test]]
name = "bptree_map"
path = "tests/bptree_map.rs"
required-features = ["maps"]

[dependencies]
iroha_allocation = { workspace = true }
crossbeam-epoch = { version = "0.9.18", optional = true }
crossbeam-utils = { version = "0.8.21", optional = true }

[dev-dependencies]
rand = "0.9.2"
