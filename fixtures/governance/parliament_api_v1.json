{
  "schema": "iroha.governance.parliament.api_fixture.v1",
  "api_version": 1,
  "routes": {
    "attempt_draft": "/v1/gov/parliament/attempts/draft",
    "attempt_read": "/v1/gov/parliament/attempts/{governance_attempt_id}",
    "transition_draft": "/v1/gov/parliament/transitions/draft"
  },
  "wire_ids": {
    "attempt_create": "iroha.governance.parliament.attempt.create.v1",
    "transition_submit": "iroha.governance.parliament.transition.submit.v1"
  },
  "proposal_kinds": [
    "DeployContract",
    "RuntimeUpgrade",
    "SccpRouteGovernance",
    "ValidationFeePolicy",
    "ValidationFeePayoutLifecycle",
    "MusubiRegistryGovernance",
    "SorafsProviderGovernance",
    "ContractLifecycleGovernance",
    "ContractEmergencyHold",
    "GlobalDataTriggerPermissionGovernance"
  ],
  "contract_lifecycle_actions": [
    "Activate",
    "Deactivate",
    "OfferOwnership",
    "CancelOwnershipOffer",
    "AcceptParliamentOwnership",
    "CompleteEmergencyHoldRetrospective"
  ],
  "limits": {
    "attempt_state_bytes": 16777216,
    "governance_attempt_sequence_max": 16
  },
  "public_transitions": [
    {"norito_index": 0, "norito_prefix_hex": "00", "json_tag": "EscalateRisk", "json_payload": "required", "event_kind_index": 0},
    {"norito_index": 1, "norito_prefix_hex": "01", "json_tag": "CompleteQualification", "json_payload": "forbidden", "event_kind_index": 1},
    {"norito_index": 2, "norito_prefix_hex": "02", "json_tag": "RegisterSortitionRequest", "json_payload": "required", "event_kind_index": 2},
    {"norito_index": 3, "norito_prefix_hex": "03", "json_tag": "ConsumeSortitionPulseBatch", "json_payload": "required", "event_kind_index": 3},
    {"norito_index": 4, "norito_prefix_hex": "04", "json_tag": "BeginInvitationAcceptance", "json_payload": "required", "event_kind_index": 4},
    {"norito_index": 5, "norito_prefix_hex": "05", "json_tag": "FailBodyElectionNoRoster", "json_payload": "required", "event_kind_index": 5},
    {"norito_index": 6, "norito_prefix_hex": "06", "json_tag": "SealBodyRoster", "json_payload": "required", "event_kind_index": 6},
    {"norito_index": 7, "norito_prefix_hex": "07", "json_tag": "AdvanceBodyPhase", "json_payload": "required", "event_kind_index": 7},
    {"norito_index": 8, "norito_prefix_hex": "08", "json_tag": "RecordAttemptAbsence", "json_payload": "required", "event_kind_index": 8},
    {"norito_index": 9, "norito_prefix_hex": "09", "json_tag": "EndorsePublicFinding", "json_payload": "required", "event_kind_index": 9},
    {"norito_index": 10, "norito_prefix_hex": "0a", "json_tag": "RecordInvitationResponse", "json_payload": "required", "event_kind_index": 13},
    {"norito_index": 11, "norito_prefix_hex": "0b", "json_tag": "FailPublicFindingNoResult", "json_payload": "required", "event_kind_index": 14},
    {"norito_index": 12, "norito_prefix_hex": "0c", "json_tag": "RegisterInitialSortition", "json_payload": "forbidden", "event_kind_index": 15}
  ],
  "automatic_execution_outcomes": [
    {"norito_index": 0, "norito_prefix_hex": "00", "json_tag": "Enacted", "json_payload": "forbidden", "event_kind": "MarkEnacted", "event_kind_index": 10},
    {"norito_index": 1, "norito_prefix_hex": "01", "json_tag": "Superseded", "json_payload": "required", "event_kind": "MarkSuperseded", "event_kind_index": 11},
    {"norito_index": 2, "norito_prefix_hex": "02", "json_tag": "ExecutionFailed", "json_payload": "required", "event_kind": "MarkExecutionFailed", "event_kind_index": 12}
  ],
  "digest_domains": {
    "public_transition": "iroha.governance.parliament.lifecycle_transition.digest.v1",
    "automatic_execution_outcome": "iroha.governance.parliament.automatic_execution_outcome.digest.v1"
  },
  "no_result_kinds": [
    {"norito_index": 0, "json_tag": "PublicFindingQuorumUnreachable"},
    {"norito_index": 1, "json_tag": "PublicFindingDeadlineExpired"},
    {"norito_index": 2, "json_tag": "SortitionRetriesExhausted"},
    {"norito_index": 3, "json_tag": "ConfirmationJuryCapacityUnavailable"},
    {"norito_index": 4, "json_tag": "RandomnessRedrawBudgetExhausted"}
  ],
  "canonical_body_order": [
    "rules-committee",
    "agenda-council",
    "interest-panel",
    "review-panel",
    "coordination-council",
    "mpc-committee",
    "fma-committee",
    "oversight-committee",
    "policy-jury",
    "confirmation-jury"
  ],
  "attempt_read_body_presentation": {
    "required_body_order": "ordered body names from required_bodies",
    "body_state_order": "same order as required_body_order",
    "certificate_body_order": "same order as required_body_order when a certificate is present; otherwise empty",
    "subset_rule": "strictly increasing subset of canonical_body_order"
  },
  "attempt_read_body_state": {
    "json_fields": [
      "body",
      "body_instance_id",
      "status",
      "public_finding_opened_at_height",
      "public_finding_phase_blocks",
      "public_finding_deadline_height",
      "no_result_kind",
      "no_result_height"
    ],
    "ordering": "exact required_bodies order",
    "deadline_semantics": "inclusive"
  },
  "certificate_result_roots": [
    {"name": "public_finding_result_root", "bytes": 32, "zero_forbidden": true, "derivation": "exact result_root endorsed by authority-authenticated seated assignments and finalized automatically at quorum"},
    {"name": "public_finding_endorsement_root", "bytes": 32, "zero_forbidden": true, "domain": "iroha.governance.parliament.public_finding_endorsement.root.v1", "preimage": ["governance_attempt_id", "body_instance_id", "result_root", "endorsing_assignments"]},
    {"name": "execution_failure_root", "bytes": 32, "zero_forbidden": true, "domain": "iroha.governance.parliament.execution_failure.root.v1", "preimage": ["certificate", "enactment_height"]},
    {"name": "governance_certificate_id", "bytes": 32, "zero_forbidden": true, "domain": "iroha.governance.certificate.id.v1", "preimage": ["certificate"]}
  ],
  "certificate_body_binding": {
    "norito_field_order": [
      "body_instance_id",
      "election_attempt_id",
      "election_attempt_sequence",
      "sortition_request_id",
      "sortition_request",
      "body",
      "original_seats",
      "beacon_session_id",
      "beacon_pulse_id",
      "roster_root",
      "assignment_root",
      "result_root",
      "result_height",
      "public_finding",
      "ballot"
    ],
    "original_seats": {"minimum": 1, "immutable": true},
    "public_nonbinding_body": {
      "public_finding": "required",
      "ballot": "forbidden",
      "public_finding_norito_field_order": ["endorsement_root", "endorsing_assignments", "endorsements", "quorum"],
      "endorsement_root_bytes": 32,
      "endorsement_root_zero_forbidden": true,
      "endorsing_assignments": "strictly increasing distinct nonzero assignment ids",
      "endorsements": "endorsing_assignments.length == quorum",
      "quorum": "ceil(2 * original_seats / 3)"
    },
    "private_jury": {
      "public_finding": "forbidden",
      "ballot": "required",
      "original_seats": "ballot.tally.original_seats"
    }
  },
  "negative_json_cases": [
    {"name": "unknown_outer_field", "expected": "reject"},
    {"name": "camel_case_attempt_id_alias", "expected": "reject"},
    {"name": "unsupported_version", "value": 2, "expected": "reject"},
    {"name": "unknown_transition_tag", "value": "PlainBallotFallback", "expected": "reject"},
    {"name": "removed_construct_certificate_tag", "value": "ConstructCertificate", "expected": "reject"},
    {"name": "removed_mark_enacted_tag", "value": "MarkEnacted", "expected": "reject"},
    {"name": "removed_mark_superseded_tag", "value": "MarkSuperseded", "expected": "reject"},
    {"name": "removed_mark_execution_failed_tag", "value": "MarkExecutionFailed", "expected": "reject"}
  ]
}
