seiyaku CompactAbortFirst {
    error enum Failure {
        Low = 3, High = 9
    }

    state int trace;
    hajimari() {
        trace = 0;
    }

    kotoage fn main() authorize("WriteState") {
        trace = 7;
        require(false, Failure::Low);
        require(true, Failure::High);
        trace = 99;
    }
}
