seiyaku PrivateDivisionTrap { permission WriteState;
    state int trace;
    hajimari() {
        trace = 0;
    }

    fn checked(int _ divisor) -> int {
        trace = trace + 1;
        return 5 / divisor;
    }

    kotoage fn main() authorize(WriteState) -> int {
        trace = 40;
        return checked(0);
    }
}
