seiyaku PrivateDiscarded { permission WriteState;
    state int trace;
    hajimari() {
        trace = 0;
    }

    fn update(int _ value) -> int {
        trace = trace * 10 + value;
        return 99;
    }

    kotoage fn main() authorize(WriteState) -> int {
        update(7);
        return trace;
    }
}
