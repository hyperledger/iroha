seiyaku PrivateUnit { permission WriteState;
    state int trace;
    hajimari() {
        trace = 0;
    }

    fn stamp(int _ value) {
        trace = trace * 10 + value;
    }

    kotoage fn main() authorize(WriteState) -> ((), int) {
        let unit = stamp(7);
        return (unit, trace);
    }
}
