seiyaku PrivateOrderedArguments { permission WriteState;
    state int trace;
    hajimari() {
        trace = 0;
    }

    fn next() -> int {
        trace = trace + 1;
        return trace;
    }

    fn combine(int _ left, int _ right) -> int {
        return left * 10 + right;
    }

    kotoage fn main() authorize(WriteState) -> (int, int) {
        let result = combine(next(), next());
        return (result, trace);
    }
}
