seiyaku LocalChainValues { permission WriteState;
    error enum Failure {
        Low = 3,
        High = 9,
    }

    state int trace;
    hajimari() {
        trace = 0;
    }

    fn touch(int _ amount) -> int {
        trace = trace + amount;
        return trace;
    }

    kotoage fn main() authorize(WriteState) -> (int, int, int) {
        require(trace >= 0, Failure::Low);
        let left = (trace + 3) * (trace + 4);
        let noise = touch(1);
        let extra = touch(2);
        let computed = (noise + extra) * (left - extra);
        trace = computed;
        require(trace <= 100, Failure::High);
        if trace > 30 {
            trace = trace + 4;
        } else {
            trace = trace + 9;
        }
        return (trace, left, noise);
    }
}
