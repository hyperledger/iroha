{
  "schema": "iroha.durable_workflow.scenario.v1",
  "id": "cancel_while_ready_to_sign_drops_the_payload",
  "category": "cancellation",
  "rules": [
    "cancellation_is_sticky_and_never_rolls_back"
  ],
  "description": "The unsigned payload is durable and the process stopped inside the signer. Cancellation drops the payload; a later run does not sign or send.",
  "plan": {
    "kind": "issuer_bootstrap",
    "instance": "cancel-while-ready-to-sign-drops-the-payload",
    "driver": {
      "id": "fixture-driver",
      "schema_version": 1
    },
    "steps": [
      {
        "label": "register",
        "kind": "transaction"
      }
    ]
  },
  "calls": [
    {
      "op": "run",
      "script": {
        "builds": [
          "ok"
        ],
        "signs": [
          "interrupt"
        ]
      },
      "expect": {
        "result": "interrupted",
        "effects": [
          "build:0#1",
          "sign:0#1"
        ],
        "status": "in_progress",
        "steps": [
          "ready_to_sign"
        ],
        "partial_completion": {
          "confirmed_steps": [],
          "irreversible_steps": [],
          "unresolved_steps": [],
          "failed_steps": [],
          "not_started_steps": [
            0
          ],
          "rolled_back_steps": []
        }
      }
    },
    {
      "op": "cancel",
      "expect": {
        "result": "ok",
        "effects": [],
        "status": "cancelled",
        "steps": [
          "cancelled_before_submission"
        ],
        "partial_completion": {
          "confirmed_steps": [],
          "irreversible_steps": [],
          "unresolved_steps": [],
          "failed_steps": [],
          "not_started_steps": [
            0
          ],
          "rolled_back_steps": []
        }
      }
    },
    {
      "op": "run",
      "expect": {
        "result": {
          "error": "CancelledBeforeSubmission",
          "stage": "cancel",
          "step": 0,
          "resumable": false
        },
        "effects": [],
        "status": "cancelled",
        "steps": [
          "cancelled_before_submission"
        ],
        "partial_completion": {
          "confirmed_steps": [],
          "irreversible_steps": [],
          "unresolved_steps": [],
          "failed_steps": [],
          "not_started_steps": [
            0
          ],
          "rolled_back_steps": []
        }
      }
    }
  ]
}
