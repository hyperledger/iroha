{
  "schema": "iroha.durable_workflow.scenario.v1",
  "id": "valid_digest_with_a_violated_invariant_is_corruption",
  "category": "storage_corruption",
  "rules": [
    "corruption_is_reported_not_repaired"
  ],
  "description": "The stored record is canonical and its digest is correct, but its status says completed while a step is still unknown. The invariant check reports StorageCorrupted: a digest detects damage, not a wrong journal.",
  "plan": {
    "kind": "issuer_bootstrap",
    "instance": "valid-digest-with-a-violated-invariant-is-corruption",
    "driver": {
      "id": "fixture-driver",
      "schema_version": 1
    },
    "steps": [
      {
        "label": "register",
        "kind": "transaction"
      }
    ]
  },
  "calls": [
    {
      "op": "run",
      "script": {
        "builds": [
          "ok"
        ],
        "signs": [
          "ok"
        ],
        "dispatches": [
          "ambiguous"
        ],
        "statuses": [
          "absent"
        ]
      },
      "expect": {
        "result": {
          "error": "SubmissionOutcomeUnknown",
          "stage": "reconcile",
          "step": 0
        },
        "effects": [
          "build:0#1",
          "sign:0#1",
          "dispatch:0#1",
          "status:0#1"
        ],
        "status": "in_progress",
        "steps": [
          "outcome_unknown"
        ],
        "partial_completion": {
          "confirmed_steps": [],
          "irreversible_steps": [],
          "unresolved_steps": [
            0
          ],
          "failed_steps": [],
          "not_started_steps": [],
          "rolled_back_steps": []
        }
      }
    },
    {
      "op": "corrupt",
      "mode": "status_completed",
      "expect": {
        "result": "ok",
        "effects": [],
        "journal": "unreadable",
        "journal_error": "StorageCorrupted"
      }
    },
    {
      "op": "run",
      "options": {
        "retransmit_identical_bytes": true,
        "retry_rejected_step": true
      },
      "expect": {
        "result": {
          "error": "StorageCorrupted",
          "stage": "load",
          "progress": "unavailable",
          "resumable": false
        },
        "effects": [],
        "journal": "unreadable",
        "journal_error": "StorageCorrupted"
      }
    },
    {
      "op": "recover",
      "expect": {
        "result": {
          "error": "StorageCorrupted",
          "stage": "load",
          "progress": "unavailable"
        },
        "effects": [],
        "journal": "unreadable",
        "journal_error": "StorageCorrupted"
      }
    },
    {
      "op": "cancel",
      "expect": {
        "result": {
          "error": "StorageCorrupted",
          "stage": "load",
          "progress": "unavailable"
        },
        "effects": [],
        "journal": "unreadable",
        "journal_error": "StorageCorrupted"
      }
    },
    {
      "op": "progress",
      "expect": {
        "result": {
          "error": "StorageCorrupted",
          "stage": "load",
          "progress": "unavailable"
        },
        "effects": [],
        "journal": "unreadable",
        "journal_error": "StorageCorrupted"
      }
    }
  ]
}
