{
  "schema": "iroha.durable_workflow.scenario.v1",
  "id": "build_failure_keeps_the_step_resumable",
  "category": "interruption_before_submission",
  "rules": [
    "persist_before_effect"
  ],
  "description": "A locally invalid proof is a typed failure before any payload exists. The identity slot returns to `prepared`, the workflow stays in progress, and a later run builds again.",
  "plan": {
    "kind": "issuer_bootstrap",
    "instance": "build-failure-keeps-the-step-resumable",
    "driver": {
      "id": "fixture-driver",
      "schema_version": 1
    },
    "steps": [
      {
        "label": "register",
        "kind": "transaction"
      }
    ]
  },
  "calls": [
    {
      "op": "run",
      "script": {
        "builds": [
          "fail:ProofInvalid"
        ]
      },
      "expect": {
        "result": {
          "error": "ProofInvalid",
          "stage": "prove",
          "step": 0,
          "resumable": true
        },
        "effects": [
          "build:0#1"
        ],
        "status": "in_progress",
        "steps": [
          "prepared"
        ],
        "partial_completion": {
          "confirmed_steps": [],
          "irreversible_steps": [],
          "unresolved_steps": [],
          "failed_steps": [],
          "not_started_steps": [
            0
          ],
          "rolled_back_steps": []
        }
      }
    },
    {
      "op": "run",
      "script": {
        "builds": [
          "ok"
        ],
        "signs": [
          "ok"
        ],
        "dispatches": [
          "accepted"
        ],
        "statuses": [
          "applied"
        ]
      },
      "expect": {
        "result": "completed",
        "effects": [
          "build:0#1",
          "sign:0#1",
          "dispatch:0#1",
          "status:0#1"
        ],
        "status": "completed",
        "steps": [
          "finalized"
        ],
        "partial_completion": {
          "confirmed_steps": [
            0
          ],
          "irreversible_steps": [
            0
          ],
          "unresolved_steps": [],
          "failed_steps": [],
          "not_started_steps": [],
          "rolled_back_steps": []
        }
      }
    }
  ]
}
