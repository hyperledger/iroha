    "instance": "round-that-never-started-is-started-under-the-same-identity",
    "driver": {
      "id": "fixture-driver",
      "schema_version": 1
    },
    "steps": [
      {
        "label": "collect",
        "kind": "offchain_round",
        "irreversible": true,
        "participants_required": 2,
        "custody_handles_required": 0
      },
      {
        "label": "open",
        "kind": "transaction"
      }
    ]
  },
  "calls": [
    {
      "op": "run",
      "script": {
        "round_starts": [
          "interrupt"
        ]
      },
      "expect": {
        "result": "interrupted",
        "effects": [
          "round_start:0"
        ],
        "status": "in_progress",
        "steps": [
