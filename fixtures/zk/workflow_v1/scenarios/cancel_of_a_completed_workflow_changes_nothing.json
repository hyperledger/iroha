          "ok"
        ],
        "signs": [
          "ok"
        ],
        "dispatches": [
          "accepted"
        ],
        "statuses": [
          "applied"
        ]
      },
      "expect": {
        "result": "completed",
        "effects": [
          "build:0#1",
          "sign:0#1",
          "dispatch:0#1",
          "status:0#1"
