{
  "schema": "iroha.durable_workflow.scenario.v1",
  "id": "interrupted_after_a_finalized_step_reports_partial_completion",
  "category": "interruption_after_irreversible_progress",
  "rules": [
    "per_transaction_atomicity_only",
    "rounds_recover_under_one_identity"
  ],
  "description": "The registration transaction is finalized and the process stops while the dealing round starts. The journal states the partial completion: step 0 confirmed and irreversible, step 1 unresolved, step 2 not started. The resumed run recovers the round under its persisted identity and never touches step 0 again.",
  "plan": {
    "kind": "dkg",
    "instance": "interrupted-after-a-finalized-step-reports-partial-completion",
    "driver": {
      "id": "fixture-driver",
      "schema_version": 1
    },
    "steps": [
      {
        "label": "register",
        "kind": "transaction"
      },
      {
        "label": "deal",
        "kind": "offchain_round",
        "irreversible": true,
        "participants_required": 2,
        "custody_handles_required": 1
      },
      {
        "label": "publish",
        "kind": "transaction"
      }
    ]
  },
  "calls": [
    {
      "op": "run",
      "script": {
        "builds": [
          "ok"
        ],
        "signs": [
          "ok"
        ],
        "dispatches": [
          "accepted"
        ],
        "statuses": [
          "applied"
        ],
        "round_starts": [
          "interrupt"
        ]
      },
      "expect": {
        "result": "interrupted",
        "effects": [
          "build:0#1",
          "sign:0#1",
          "dispatch:0#1",
          "status:0#1",
          "round_start:1"
        ],
        "status": "in_progress",
        "steps": [
          "finalized",
          "round_started",
          "planned"
        ],
        "partial_completion": {
          "confirmed_steps": [
            0
          ],
          "irreversible_steps": [
            0
          ],
          "unresolved_steps": [
            1
          ],
          "failed_steps": [],
          "not_started_steps": [
            2
          ],
          "rolled_back_steps": []
        }
      }
    },
    {
      "op": "run",
      "script": {
        "builds": [
          "ok"
        ],
        "signs": [
          "ok"
        ],
        "dispatches": [
          "accepted"
        ],
        "statuses": [
          "applied"
        ],
        "round_recoveries": [
          "completed:p1,p2"
        ]
      },
      "expect": {
        "result": "completed",
        "effects": [
          "round_recover:1",
          "build:2#1",
          "sign:2#1",
          "dispatch:2#1",
          "status:2#1"
        ],
        "status": "completed",
        "steps": [
          "finalized",
          "round_completed",
          "finalized"
        ],
        "partial_completion": {
          "confirmed_steps": [
            0,
            1,
            2
          ],
          "irreversible_steps": [
            0,
            1,
            2
          ],
          "unresolved_steps": [],
          "failed_steps": [],
          "not_started_steps": [],
          "rolled_back_steps": []
        },
        "identities": {
          "0": [
            {
              "dispatches": 1,
              "possible_admissions": 1,
              "evidence": "applied"
            }
          ]
        }
      }
    }
  ]
}
