{
  "schema": "iroha.durable_workflow.scenario.v1",
  "id": "concurrent_cancel_wins_before_the_dispatch_intent",
  "category": "cancellation",
  "rules": [
    "persist_before_effect",
    "cancellation_is_sticky_and_never_rolls_back"
  ],
  "description": "Another actor cancels right after the signed identity is persisted. The runner loses the compare-and-swap of its dispatch ordinal, reloads, and sends nothing: a stale worker cannot launch an effect after cancellation won.",
  "plan": {
    "kind": "issuer_bootstrap",
    "instance": "concurrent-cancel-wins-before-the-dispatch-intent",
    "driver": {
      "id": "fixture-driver",
      "schema_version": 1
    },
    "steps": [
      {
        "label": "register",
        "kind": "transaction"
      }
    ]
  },
  "calls": [
    {
      "op": "run",
      "script": {
        "builds": [
          "ok"
        ],
        "signs": [
          "ok"
        ]
      },
      "concurrent": {
        "when": "signed",
        "action": "cancel"
      },
      "expect": {
        "result": {
          "error": "CancelledBeforeSubmission",
          "stage": "cancel",
          "step": 0,
          "resumable": false
        },
        "effects": [
          "build:0#1",
          "sign:0#1",
          "concurrent:cancel:cancelled"
        ],
        "status": "cancelled",
        "steps": [
          "cancelled_before_submission"
        ],
        "partial_completion": {
          "confirmed_steps": [],
          "irreversible_steps": [],
          "unresolved_steps": [],
          "failed_steps": [],
          "not_started_steps": [
            0
          ],
          "rolled_back_steps": []
        },
        "identities": {
          "0": [
            {
              "dispatches": 0,
              "possible_admissions": 0
            }
          ]
        }
      }
    }
  ]
}
