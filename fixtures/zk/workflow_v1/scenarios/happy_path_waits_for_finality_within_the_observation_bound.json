{
  "schema": "iroha.durable_workflow.scenario.v1",
  "id": "happy_path_waits_for_finality_within_the_observation_bound",
  "category": "happy_path",
  "rules": [
    "authoritative_outcomes_only"
  ],
  "description": "An acknowledged transaction is polled on the fake clock. Queue observations and a cache-resolved Applied hint do not finalize it; the state-resolved Applied does.",
  "plan": {
    "kind": "issuer_bootstrap",
    "instance": "happy-path-waits-for-finality-within-the-observation-bound",
    "driver": {
      "id": "fixture-driver",
      "schema_version": 1
    },
    "steps": [
      {
        "label": "register",
        "kind": "transaction"
      }
    ]
  },
  "calls": [
    {
      "op": "run",
      "options": {
        "observation_timeout_ms": 2000,
        "poll_interval_ms": 1000
      },
      "script": {
        "builds": [
          "ok"
        ],
        "signs": [
          "ok"
        ],
        "dispatches": [
          "accepted"
        ],
        "statuses": [
          "observed",
          "hint_applied",
          "applied"
        ]
      },
      "expect": {
        "result": "completed",
        "effects": [
          "build:0#1",
          "sign:0#1",
          "dispatch:0#1",
          "status:0#1",
          "sleep:1000",
          "status:0#1",
          "sleep:1000",
          "status:0#1"
        ],
        "status": "completed",
        "steps": [
          "finalized"
        ],
        "partial_completion": {
          "confirmed_steps": [
            0
          ],
          "irreversible_steps": [
            0
          ],
          "unresolved_steps": [],
          "failed_steps": [],
          "not_started_steps": [],
          "rolled_back_steps": []
        }
      }
    }
  ]
}
