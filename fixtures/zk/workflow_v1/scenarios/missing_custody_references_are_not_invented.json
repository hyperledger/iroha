{
  "schema": "iroha.durable_workflow.scenario.v1",
  "id": "missing_custody_references_are_not_invented",
  "category": "offchain_round",
  "rules": [
    "no_secret_in_journal",
    "rounds_recover_under_one_identity"
  ],
  "description": "A dealing round completed but the driver cannot return the reference to the share it holds. The engine records no completion without the declared custody reference and reports a local resource failure. When the reference is recovered, the round completes with its original transcript.",
  "plan": {
    "kind": "dkg",
    "instance": "missing-custody-references-are-not-invented",
    "driver": {
      "id": "fixture-driver",
      "schema_version": 1
    },
    "steps": [
      {
        "label": "deal",
        "kind": "offchain_round",
        "irreversible": true,
        "participants_required": 2,
        "custody_handles_required": 1
      },
      {
        "label": "publish",
        "kind": "transaction"
      }
    ]
  },
  "calls": [
    {
      "op": "run",
      "script": {
        "round_starts": [
          "completed_missing_custody:p1,p2"
        ]
      },
      "expect": {
        "result": {
          "error": "LocalResourceUnavailable",
          "stage": "round",
          "step": 0,
          "resumable": true
        },
        "effects": [
          "round_start:0"
        ],
        "status": "in_progress",
        "steps": [
          "round_started",
          "planned"
        ],
        "partial_completion": {
          "confirmed_steps": [],
          "irreversible_steps": [],
          "unresolved_steps": [
            0
          ],
          "failed_steps": [],
          "not_started_steps": [
            1
          ],
          "rolled_back_steps": []
        }
      }
    },
    {
      "op": "run",
      "script": {
        "round_recoveries": [
          "error:LocalResourceUnavailable"
        ]
      },
      "expect": {
        "result": {
          "error": "LocalResourceUnavailable",
          "stage": "round",
          "step": 0
        },
        "effects": [
          "round_recover:0"
        ],
        "status": "in_progress",
        "steps": [
          "round_started",
          "planned"
        ],
        "partial_completion": {
          "confirmed_steps": [],
          "irreversible_steps": [],
          "unresolved_steps": [
            0
          ],
          "failed_steps": [],
          "not_started_steps": [
            1
          ],
          "rolled_back_steps": []
        }
      }
    },
    {
      "op": "run",
      "script": {
        "builds": [
          "ok"
        ],
        "signs": [
          "ok"
        ],
        "dispatches": [
          "accepted"
        ],
        "statuses": [
          "applied"
        ],
        "round_recoveries": [
          "completed:p1,p2"
        ]
      },
      "expect": {
        "result": "completed",
        "effects": [
          "round_recover:0",
          "build:1#1",
          "sign:1#1",
          "dispatch:1#1",
          "status:1#1"
        ],
        "status": "completed",
        "steps": [
          "round_completed",
          "finalized"
        ],
        "partial_completion": {
          "confirmed_steps": [
            0,
            1
          ],
          "irreversible_steps": [
            0,
            1
          ],
          "unresolved_steps": [],
          "failed_steps": [],
          "not_started_steps": [],
          "rolled_back_steps": []
        }
      }
    }
  ]
}
