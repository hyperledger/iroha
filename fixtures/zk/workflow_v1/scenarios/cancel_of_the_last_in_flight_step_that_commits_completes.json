        "label": "register",
        "kind": "transaction"
      }
    ]
  },
  "calls": [
    {
      "op": "run",
      "script": {
        "builds": [
          "ok"
        ],
        "signs": [
          "ok"
        ],
        "dispatches": [
          "accepted"
        ],
        "statuses": [
          "observed"
        ]
      },
      "expect": {
        "result": {
          "error": "FinalityPending",
          "stage": "reconcile",
          "step": 0
        },
        "effects": [
          "build:0#1",
          "sign:0#1",
          "dispatch:0#1",
          "status:0#1"
        ],
        "status": "in_progress",
        "steps": [
          "pending"
        ],
        "partial_completion": {
          "confirmed_steps": [],
          "irreversible_steps": [],
