      "script": {
        "builds": [
          "empty"
        ]
      },
      "expect": {
        "result": {
          "error": "InvalidInput",
          "stage": "prove",
          "step": 0
        },
        "effects": [
          "build:0#1"
        ],
        "status": "in_progress",
        "steps": [
          "prepared"
        ],
        "partial_completion": {
          "confirmed_steps": [],
          "irreversible_steps": [],
          "unresolved_steps": [],
          "failed_steps": [],
          "not_started_steps": [
            0
          ],
          "rolled_back_steps": []
        }
      }
    },
    {
      "op": "run",
      "script": {
        "builds": [
          "ok"
        ],
        "signs": [
          "wrong_identity"
        ]
      },
      "expect": {
        "result": {
          "error": "BindingMismatch",
          "stage": "sign",
          "step": 0
        },
        "effects": [
