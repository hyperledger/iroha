{
  "schema": "iroha.durable_workflow.scenario.v1",
  "id": "cancel_after_a_rejected_identity_opens_no_replacement",
  "category": "cancellation",
  "rules": [
    "cancellation_is_sticky_and_never_rolls_back",
    "no_replacement_while_unresolved"
  ],
  "description": "The first identity of a step that allows two was rejected. Cancellation ends the workflow; an explicit retry afterwards opens no replacement identity.",
  "plan": {
    "kind": "issuer_bootstrap",
    "instance": "cancel-after-a-rejected-identity-opens-no-replacement",
    "driver": {
      "id": "fixture-driver",
      "schema_version": 1
    },
    "steps": [
      {
        "label": "register",
        "kind": "transaction",
        "max_transaction_identities": 2
      },
      {
        "label": "activate",
        "kind": "transaction"
      }
    ]
  },
  "calls": [
    {
      "op": "run",
      "script": {
        "builds": [
          "ok"
        ],
        "signs": [
          "ok"
        ],
        "dispatches": [
          "accepted"
        ],
        "statuses": [
          "rejected"
        ]
      },
      "expect": {
        "result": {
          "error": "Rejected",
          "stage": "reconcile",
          "step": 0
        },
        "effects": [
          "build:0#1",
          "sign:0#1",
          "dispatch:0#1",
          "status:0#1"
        ],
        "status": "in_progress",
        "steps": [
          "rejected",
          "planned"
        ],
        "partial_completion": {
          "confirmed_steps": [],
          "irreversible_steps": [],
          "unresolved_steps": [],
          "failed_steps": [
            0
          ],
          "not_started_steps": [
            1
          ],
          "rolled_back_steps": []
        }
      }
    },
    {
      "op": "cancel",
      "expect": {
        "result": "ok",
        "effects": [],
        "status": "cancelled",
        "steps": [
          "rejected",
          "planned"
        ],
        "partial_completion": {
          "confirmed_steps": [],
          "irreversible_steps": [],
          "unresolved_steps": [],
          "failed_steps": [
            0
          ],
          "not_started_steps": [
            1
          ],
          "rolled_back_steps": []
        },
        "cancel_requested": true
      }
    },
    {
      "op": "run",
      "options": {
        "retry_rejected_step": true
      },
      "expect": {
        "result": {
          "error": "CancelledBeforeSubmission",
          "stage": "cancel",
          "step": 0,
          "resumable": false
        },
        "effects": [],
        "status": "cancelled",
        "steps": [
          "rejected",
          "planned"
        ],
        "partial_completion": {
          "confirmed_steps": [],
          "irreversible_steps": [],
          "unresolved_steps": [],
          "failed_steps": [
            0
          ],
          "not_started_steps": [
            1
          ],
          "rolled_back_steps": []
        },
        "identities": {
          "0": [
            {
              "dispatches": 1,
              "possible_admissions": 1,
              "evidence": "ledger_rejected"
            }
          ]
        }
      }
    }
  ]
}
