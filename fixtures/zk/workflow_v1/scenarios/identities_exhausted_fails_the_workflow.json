{
  "schema": "iroha.durable_workflow.scenario.v1",
  "id": "identities_exhausted_fails_the_workflow",
  "category": "replacement_identity",
  "rules": [
    "no_replacement_while_unresolved"
  ],
  "description": "The replacement identity expires as well. The step has no identity left, so the workflow fails with Expired and a further explicit retry changes nothing.",
  "plan": {
