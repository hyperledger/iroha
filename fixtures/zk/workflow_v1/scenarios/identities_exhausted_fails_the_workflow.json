      },
      "script": {
        "builds": [
          "ok"
        ],
        "signs": [
          "ok"
        ],
        "dispatches": [
          "accepted"
        ],
        "statuses": [
          "expired"
        ]
      },
      "expect": {
        "result": {
          "error": "Expired",
