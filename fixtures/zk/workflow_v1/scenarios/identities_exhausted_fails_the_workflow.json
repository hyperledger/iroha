          "not_started_steps": [
            1
          ],
          "rolled_back_steps": []
        },
        "identities": {
          "0": [
            {
              "dispatches": 1,
              "possible_admissions": 1,
              "evidence": "ledger_rejected"
            },
            {
              "dispatches": 1,
              "possible_admissions": 1,
              "evidence": "ledger_expired"
            }
          ]
        }
      }
    },
    {
      "op": "run",
      "options": {
        "retry_rejected_step": true
