        "label": "register",
        "kind": "transaction",
        "max_transaction_identities": 2
      },
      {
        "label": "activate",
        "kind": "transaction"
      }
    ]
  },
  "calls": [
    {
      "op": "run",
      "script": {
        "builds": [
          "ok"
        ],
        "signs": [
          "ok"
        ],
        "dispatches": [
          "accepted"
        ],
        "statuses": [
          "rejected"
        ]
      },
