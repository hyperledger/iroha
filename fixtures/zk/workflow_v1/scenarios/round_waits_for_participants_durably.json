{
  "schema": "iroha.durable_workflow.scenario.v1",
  "id": "round_waits_for_participants_durably",
  "category": "offchain_round",
  "rules": [
    "rounds_recover_under_one_identity"
  ],
  "description": "A share-collection round reports one of two participants. The received set is persisted and the call returns RoundPending. An unchanged recovery writes nothing. When the round completes, the opening transaction follows.",
  "plan": {
    "kind": "threshold_opening",
    "instance": "round-waits-for-participants-durably",
    "driver": {
      "id": "fixture-driver",
      "schema_version": 1
    },
    "steps": [
      {
        "label": "collect",
        "kind": "offchain_round",
        "irreversible": true,
        "participants_required": 2,
        "custody_handles_required": 0
      },
      {
        "label": "open",
        "kind": "transaction"
      }
    ]
  },
  "calls": [
    {
      "op": "run",
      "script": {
        "round_starts": [
          "waiting:p1"
        ]
      },
      "expect": {
        "result": {
          "error": "RoundPending",
          "stage": "round",
          "step": 0,
          "resumable": true
        },
        "effects": [
          "round_start:0"
        ],
        "status": "in_progress",
        "steps": [
          "round_waiting",
          "planned"
        ],
        "partial_completion": {
          "confirmed_steps": [],
          "irreversible_steps": [],
          "unresolved_steps": [
            0
          ],
          "failed_steps": [],
          "not_started_steps": [
            1
          ],
          "rolled_back_steps": []
        },
        "participants_received": {
          "0": 1
        },
        "sequence": 3
      }
    },
    {
      "op": "run",
      "script": {
        "round_recoveries": [
          "waiting:p1"
        ]
      },
      "expect": {
        "result": {
          "error": "RoundPending",
          "stage": "round",
          "step": 0
        },
        "effects": [
          "round_recover:0"
        ],
        "status": "in_progress",
        "steps": [
          "round_waiting",
          "planned"
        ],
        "partial_completion": {
          "confirmed_steps": [],
          "irreversible_steps": [],
          "unresolved_steps": [
            0
          ],
          "failed_steps": [],
          "not_started_steps": [
            1
          ],
          "rolled_back_steps": []
        },
        "sequence": 3
      }
    },
    {
      "op": "run",
      "script": {
        "builds": [
          "ok"
        ],
        "signs": [
          "ok"
        ],
        "dispatches": [
          "accepted"
        ],
        "statuses": [
          "applied"
        ],
        "round_recoveries": [
          "completed:p1,p2"
        ]
      },
      "expect": {
        "result": "completed",
        "effects": [
          "round_recover:0",
          "build:1#1",
          "sign:1#1",
          "dispatch:1#1",
          "status:1#1"
        ],
        "status": "completed",
        "steps": [
          "round_completed",
          "finalized"
        ],
        "partial_completion": {
          "confirmed_steps": [
            0,
            1
          ],
          "irreversible_steps": [
            0,
            1
          ],
          "unresolved_steps": [],
          "failed_steps": [],
          "not_started_steps": [],
          "rolled_back_steps": []
        },
        "participants_received": {
          "0": 2
        }
      }
    }
  ]
}
