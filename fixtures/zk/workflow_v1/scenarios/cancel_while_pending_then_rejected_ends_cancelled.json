{
  "schema": "iroha.durable_workflow.scenario.v1",
  "id": "cancel_while_pending_then_rejected_ends_cancelled",
  "category": "cancellation",
  "rules": [
    "cancellation_is_sticky_and_never_rolls_back"
  ],
  "description": "A pending transaction is cancelled and later rejected by the ledger. The workflow ends cancelled without any effect of that step, and no replacement is opened.",
  "plan": {
    "kind": "issuer_bootstrap",
    "instance": "cancel-while-pending-then-rejected-ends-cancelled",
    "driver": {
      "id": "fixture-driver",
      "schema_version": 1
    },
    "steps": [
      {
        "label": "register",
        "kind": "transaction"
      },
      {
        "label": "activate",
        "kind": "transaction"
      }
    ]
  },
  "calls": [
    {
      "op": "run",
      "script": {
        "builds": [
          "ok"
        ],
        "signs": [
          "ok"
        ],
        "dispatches": [
          "accepted"
        ],
        "statuses": [
          "observed"
        ]
      },
      "expect": {
        "result": {
          "error": "FinalityPending",
          "stage": "reconcile",
          "step": 0
        },
        "effects": [
          "build:0#1",
          "sign:0#1",
          "dispatch:0#1",
          "status:0#1"
        ],
        "status": "in_progress",
        "steps": [
          "pending",
          "planned"
        ],
        "partial_completion": {
          "confirmed_steps": [],
          "irreversible_steps": [],
          "unresolved_steps": [
            0
          ],
          "failed_steps": [],
          "not_started_steps": [
            1
          ],
          "rolled_back_steps": []
        }
      }
    },
    {
      "op": "cancel",
      "expect": {
        "result": "ok",
        "effects": [],
        "status": "cancelling",
        "steps": [
          "pending",
          "planned"
        ],
        "partial_completion": {
          "confirmed_steps": [],
          "irreversible_steps": [],
          "unresolved_steps": [
            0
          ],
          "failed_steps": [],
          "not_started_steps": [
            1
          ],
          "rolled_back_steps": []
        }
      }
    },
    {
      "op": "run",
      "options": {
        "retry_rejected_step": true
      },
      "script": {
        "statuses": [
          "rejected"
        ]
      },
      "expect": {
        "result": {
          "error": "CancelledBeforeSubmission",
          "stage": "cancel",
          "step": 0,
          "resumable": false
        },
        "effects": [
          "status:0#1"
        ],
        "status": "cancelled",
        "steps": [
          "rejected",
          "planned"
        ],
        "partial_completion": {
          "confirmed_steps": [],
          "irreversible_steps": [],
          "unresolved_steps": [],
          "failed_steps": [
            0
          ],
          "not_started_steps": [
            1
          ],
          "rolled_back_steps": []
        }
      }
    }
  ]
}
