{
  "schema": "iroha.durable_workflow.scenario.v1",
  "id": "cancel_between_steps_marks_the_planned_step_cancelled",
  "category": "cancellation",
  "rules": [
    "cancellation_is_sticky_and_never_rolls_back",
    "per_transaction_atomicity_only"
  ],
  "description": "The first transaction is finalized and the run stops before the second step opens an identity. Cancellation marks that planned step cancelled_before_submission and ends the workflow cancelled; the finalized step stays confirmed and irreversible.",
  "plan": {
    "kind": "issuer_bootstrap",
    "instance": "cancel-between-steps-marks-the-planned-step-cancelled",
    "driver": {
      "id": "fixture-driver",
      "schema_version": 1
    },
    "steps": [
      {
        "label": "register",
        "kind": "transaction"
      },
      {
        "label": "activate",
        "kind": "transaction"
      }
    ]
  },
  "calls": [
    {
      "op": "run",
      "script": {
        "builds": [
          "ok"
        ],
        "signs": [
          "ok"
        ],
        "dispatches": [
          "accepted"
        ],
        "statuses": [
          "applied"
        ]
      },
      "storage_fault": {
        "store": 9,
        "mode": "unavailable"
      },
      "expect": {
        "result": {
          "error": "LocalResourceUnavailable",
          "stage": "store"
        },
        "effects": [
          "build:0#1",
          "sign:0#1",
          "dispatch:0#1",
          "status:0#1"
        ],
        "status": "in_progress",
        "steps": [
          "finalized",
          "planned"
        ],
        "partial_completion": {
          "confirmed_steps": [
            0
          ],
          "irreversible_steps": [
            0
          ],
          "unresolved_steps": [],
          "failed_steps": [],
          "not_started_steps": [
            1
          ],
          "rolled_back_steps": []
        },
        "sequence": 8
      }
    },
    {
      "op": "cancel",
      "expect": {
        "result": "ok",
        "effects": [],
        "status": "cancelled",
        "steps": [
          "finalized",
          "cancelled_before_submission"
        ],
        "partial_completion": {
          "confirmed_steps": [
            0
          ],
          "irreversible_steps": [
            0
          ],
          "unresolved_steps": [],
          "failed_steps": [],
          "not_started_steps": [
            1
          ],
          "rolled_back_steps": []
        },
        "sequence": 9
      }
    },
    {
      "op": "run",
      "expect": {
        "result": {
          "error": "CancelledBeforeSubmission",
          "stage": "cancel",
          "step": 1,
          "resumable": false
        },
        "effects": [],
        "status": "cancelled",
        "steps": [
          "finalized",
          "cancelled_before_submission"
        ],
        "partial_completion": {
          "confirmed_steps": [
            0
          ],
          "irreversible_steps": [
            0
          ],
          "unresolved_steps": [],
          "failed_steps": [],
          "not_started_steps": [
            1
          ],
          "rolled_back_steps": []
        }
      }
    }
  ]
}
