{
  "schema": "iroha.durable_workflow.scenario.v1",
  "id": "cancel_while_prepared_after_a_failed_build",
  "category": "cancellation",
  "rules": [
    "cancellation_is_sticky_and_never_rolls_back"
  ],
  "description": "A build failed, so the identity slot is open and nothing is computed. Cancellation ends the workflow; a later run does not build.",
  "plan": {
    "kind": "issuer_bootstrap",
    "instance": "cancel-while-prepared-after-a-failed-build",
    "driver": {
      "id": "fixture-driver",
      "schema_version": 1
    },
    "steps": [
      {
        "label": "register",
        "kind": "transaction"
      }
    ]
  },
  "calls": [
    {
      "op": "run",
      "script": {
        "builds": [
          "fail:ProofInvalid"
        ]
      },
      "expect": {
        "result": {
          "error": "ProofInvalid",
          "stage": "prove",
          "step": 0
        },
        "effects": [
          "build:0#1"
        ],
        "status": "in_progress",
        "steps": [
          "prepared"
        ],
        "partial_completion": {
          "confirmed_steps": [],
          "irreversible_steps": [],
          "unresolved_steps": [],
          "failed_steps": [],
          "not_started_steps": [
            0
          ],
          "rolled_back_steps": []
        }
      }
    },
    {
      "op": "cancel",
      "expect": {
        "result": "ok",
        "effects": [],
        "status": "cancelled",
        "steps": [
          "cancelled_before_submission"
        ],
        "partial_completion": {
          "confirmed_steps": [],
          "irreversible_steps": [],
          "unresolved_steps": [],
          "failed_steps": [],
          "not_started_steps": [
            0
          ],
          "rolled_back_steps": []
        },
        "cancel_requested": true
      }
    },
    {
      "op": "run",
      "expect": {
        "result": {
          "error": "CancelledBeforeSubmission",
          "stage": "cancel",
          "step": 0,
          "resumable": false
        },
        "effects": [],
        "status": "cancelled",
        "steps": [
          "cancelled_before_submission"
        ],
        "partial_completion": {
          "confirmed_steps": [],
          "irreversible_steps": [],
          "unresolved_steps": [],
          "failed_steps": [],
          "not_started_steps": [
            0
          ],
          "rolled_back_steps": []
        }
      }
    }
  ]
}
