  "rules": [
    {
      "id": "per_transaction_atomicity_only",
      "statement": "Each transaction step is one atomic ledger transaction. A workflow is never atomic across steps: finalized steps and irreversible rounds are not rolled back by failure, cancellation or interruption, and every result reports them."
    },
    {
      "id": "persist_before_effect",
      "statement": "The dispatch ordinal (`submitting`) and the round identity (`round_started`) are durably stored, by compare-and-swap, before the corresponding external effect starts. A runner that loses the compare-and-swap starts no effect."
    },
    {
      "id": "reconcile_before_decide",
      "statement": "A step found in `submitting`, `outcome_unknown` or `pending` is first reconciled by a read-only query on its persisted signed-transaction identity. Only then does the workflow continue, retry or stop."
    },
    {
      "id": "authoritative_outcomes_only",
      "statement": "Only state-resolved global `Applied`, `Rejected` or `Expired` closes a transaction identity. Exact absence, queue or cache hints, read failures and local deadlines never close it, and expiry is never inferred from a local clock."
    },
    {
      "id": "no_replacement_while_unresolved",
      "statement": "A replacement transaction identity is opened only after the previous identity is authoritatively rejected or expired, or was refused on its only dispatch, only when the caller explicitly asks and only while the step has identities remaining."
    },
    {
      "id": "identical_bytes_only",
      "statement": "The only permitted re-dispatch of an unresolved identity is the exact persisted bytes, explicitly authorized for the call, after a fresh exact-absence read, at most once per call and within the dispatch bound."
    },
    {
      "id": "definite_refusal_is_first_dispatch_only",
      "statement": "A validated definite refusal closes an identity only when no earlier dispatch of the same bytes may have been admitted; otherwise the identity stays unknown."
    },
    {
      "id": "cancellation_is_sticky_and_never_rolls_back",
      "statement": "A cancelled or cancelling workflow never builds, signs, dispatches or starts a round. While a step may still have external effect the workflow is `cancelling` and only read-only reconciliation runs."
    },
    {
      "id": "rounds_recover_under_one_identity",
      "statement": "A round found started or waiting is recovered under its persisted identity and bound context; a restart never creates a fresh round. Participants are strictly ascending and never shrink."
    },
    {
      "id": "no_secret_in_journal",
      "statement": "The journal holds step identity, transaction identities, signed bytes, public round transcripts and custody references. No interface accepts secret material."
    },
    {
      "id": "corruption_is_reported_not_repaired",
      "statement": "A journal that fails its digest, canonical encoding or invariants yields `StorageCorrupted` without a progress snapshot. A valid journal of another workflow yields `BindingMismatch`."
    }
  ],
  "schema": "iroha.durable_workflow.state_machine.v1",
  "stages": [
