{
  "schema": "iroha.zk_operation.scenario.v1",
  "id": "finality_evidence_must_authenticate_the_exact_transaction",
  "category": "finality_modes",
  "rules": [
    "authenticated_finality_by_default",
    "reconcile_read_only_first"
  ],
  "description": "Unavailable finality evidence is EvidenceUnavailable and evidence bound to another transaction is BindingMismatch, both at stage finality; neither is an outcome, so the identity stays pending. Each later run reconciles first and closes the identity only on verified evidence.",
  "request": {
    "actions": [
      {
        "attachments": [
          {
            "kind": "proof",
            "length": 4096
          }
        ]
      }
    ],
    "signer": "handle",
    "finality": "authenticated"
  },
  "calls": [
    {
      "op": "execute",
      "script": {
        "proofs": [
          "ok"
        ],
        "local_verifications": [
          "ok"
        ],
        "builds": [
          "ok"
        ],
        "signs": [
          "ok"
        ],
        "dispatches": [
          "accepted"
        ],
        "statuses": [
          "applied"
        ],
        "finality_proofs": [
          "unavailable"
        ]
      },
      "expect": {
        "result": {
          "error": "EvidenceUnavailable",
          "stage": "finality",
          "resumable": true,
          "has_transaction_identity": true
        },
        "effects": [
          "prove:1",
          "local_verify:1",
          "build:1",
          "sign:1",
          "dispatch:1",
          "status:1",
          "finality:1"
        ],
        "status": "in_progress",
        "state": "pending",
        "identity": {
          "dispatches": 1,
          "possible_admissions": 1
        }
      }
    },
    {
      "op": "execute",
      "script": {
        "statuses": [
          "applied"
        ],
        "finality_proofs": [
          "mismatch"
        ]
      },
      "expect": {
        "result": {
          "error": "BindingMismatch",
          "stage": "finality",
          "resumable": true,
          "has_transaction_identity": true
        },
        "effects": [
          "status:1",
          "finality:1"
        ],
        "status": "in_progress",
        "state": "pending"
      }
    },
    {
      "op": "execute",
      "script": {
        "statuses": [
          "applied"
        ],
        "finality_proofs": [
          "verified"
        ]
      },
      "expect": {
        "result": "completed",
        "effects": [
          "status:1",
          "finality:1"
        ],
        "status": "completed",
        "state": "finalized",
        "identity": {
          "dispatches": 1,
          "possible_admissions": 1,
          "evidence": "applied"
        }
      }
    }
  ]
}
