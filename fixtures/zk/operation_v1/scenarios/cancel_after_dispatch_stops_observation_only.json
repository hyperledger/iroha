{
  "schema": "iroha.zk_operation.scenario.v1",
  "id": "cancel_after_dispatch_stops_observation_only",
  "category": "cancellation",
  "rules": [
    "cancellation_never_recalls",
    "reconcile_read_only_first"
  ],
  "description": "Cancellation cannot recall a dispatched transaction. The operation is cancelling: even with retransmission authorized only reads run. When the transaction turns out applied the operation is completed, not cancelled: cancellation never pretends that a committed transaction did not happen.",
  "request": {
    "actions": [
      {
        "attachments": [
          {
            "kind": "proof",
            "length": 4096
          }
        ]
      }
    ],
    "signer": "handle",
    "finality": "authenticated"
  },
  "calls": [
    {
      "op": "execute",
      "script": {
        "proofs": [
          "ok"
        ],
        "local_verifications": [
          "ok"
        ],
        "builds": [
          "ok"
        ],
        "signs": [
          "ok"
        ],
        "dispatches": [
          "accepted"
        ],
        "statuses": [
          "observed"
        ]
      },
      "expect": {
        "result": {
          "error": "FinalityPending",
          "stage": "reconcile",
          "resumable": true,
          "has_transaction_identity": true
        },
        "effects": [
          "prove:1",
          "local_verify:1",
          "build:1",
          "sign:1",
          "dispatch:1",
          "status:1"
        ],
        "status": "in_progress",
        "state": "pending"
      }
    },
    {
      "op": "cancel",
      "expect": {
        "result": "ok",
        "effects": [],
        "status": "cancelling",
        "state": "pending"
      }
    },
    {
      "op": "execute",
      "options": {
        "retransmit_identical_bytes": true
      },
      "script": {
        "statuses": [
          "absent"
        ]
      },
      "expect": {
        "result": {
          "error": "FinalityPending",
          "stage": "reconcile",
          "resumable": true,
          "has_transaction_identity": true
        },
        "effects": [
          "status:1"
        ],
        "status": "cancelling",
        "state": "pending",
        "identity": {
          "dispatches": 1,
          "possible_admissions": 1
        }
      }
    },
    {
      "op": "recover",
      "script": {
        "statuses": [
          "applied"
        ],
        "finality_proofs": [
          "verified"
        ]
      },
      "expect": {
        "result": "ok",
        "effects": [
          "status:1",
          "finality:1"
        ],
        "status": "completed",
        "state": "finalized",
        "identity": {
          "dispatches": 1,
          "possible_admissions": 1,
          "evidence": "applied"
        }
      }
    }
  ]
}
