{
  "schema": "iroha.zk_operation.scenario.v1",
  "id": "private_material_upload_is_refused",
  "category": "custody",
  "rules": [
    "custody_stays_local"
  ],
  "description": "The capability driver can only prove by sending the witness, and then a share, to a remote prover. Each attempt is refused with UnsupportedOperation at stage prove before any network effect: no effect of the contract carries private material. The operation stays prepared, so a driver that proves locally can resume it.",
  "request": {
    "actions": [
      {
        "attachments": [
          {
            "kind": "proof",
            "length": 4096
          }
        ]
      }
    ],
    "signer": "handle",
    "finality": "authenticated"
  },
  "calls": [
    {
      "op": "execute",
      "script": {
        "proofs": [
          "upload_required:witness"
        ]
      },
      "expect": {
        "result": {
          "error": "UnsupportedOperation",
          "stage": "prove",
          "resumable": true
        },
        "effects": [
          "prove:1"
        ],
        "status": "in_progress",
        "state": "prepared"
      }
    },
    {
      "op": "execute",
      "script": {
        "proofs": [
          "upload_required:share"
        ]
      },
      "expect": {
        "result": {
          "error": "UnsupportedOperation",
          "stage": "prove",
          "resumable": true
        },
        "effects": [
          "prove:1"
        ],
        "status": "in_progress",
        "state": "prepared"
      }
    },
    {
      "op": "execute",
      "script": {
        "proofs": [
          "ok"
        ],
        "local_verifications": [
          "ok"
        ],
        "builds": [
          "ok"
        ],
        "signs": [
          "ok"
        ],
        "dispatches": [
          "accepted"
        ],
        "statuses": [
          "applied"
        ],
        "finality_proofs": [
          "verified"
        ]
      },
      "expect": {
        "result": "completed",
        "effects": [
          "prove:1",
          "local_verify:1",
          "build:1",
          "sign:1",
          "dispatch:1",
          "status:1",
          "finality:1"
        ],
        "status": "completed",
        "state": "finalized",
        "identity": {
          "dispatches": 1,
          "possible_admissions": 1,
          "evidence": "applied"
        }
      }
    }
  ]
}
