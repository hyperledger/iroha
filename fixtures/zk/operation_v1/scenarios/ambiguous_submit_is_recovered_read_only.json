{
  "schema": "iroha.zk_operation.scenario.v1",
  "id": "ambiguous_submit_is_recovered_read_only",
  "category": "interruption_after_ambiguous_submission",
  "rules": [
    "reconcile_read_only_first",
    "no_clock_closes_an_identity",
    "identical_bytes_only"
  ],
  "description": "The dispatch result cannot be established and the first read finds nothing: the call returns SubmissionOutcomeUnknown with the transaction identity. Read-only recovery never proves, builds, signs or dispatches; a failed read changes nothing, and the identity closes only when its outcome is authenticated. The bytes were sent exactly once.",
  "request": {
    "actions": [
      {
        "attachments": [
          {
            "kind": "proof",
            "length": 4096
          }
        ]
      }
    ],
    "signer": "handle",
    "finality": "authenticated"
  },
  "calls": [
    {
      "op": "execute",
      "script": {
        "proofs": [
          "ok"
        ],
        "local_verifications": [
          "ok"
        ],
        "builds": [
          "ok"
        ],
        "signs": [
          "ok"
        ],
        "dispatches": [
          "ambiguous"
        ],
        "statuses": [
          "absent"
        ]
      },
      "expect": {
        "result": {
          "error": "SubmissionOutcomeUnknown",
          "stage": "reconcile",
          "resumable": true,
          "has_transaction_identity": true
        },
        "effects": [
          "prove:1",
          "local_verify:1",
          "build:1",
          "sign:1",
          "dispatch:1",
          "status:1"
        ],
        "status": "in_progress",
        "state": "outcome_unknown",
        "identity": {
          "dispatches": 1,
          "possible_admissions": 1
        }
      }
    },
    {
      "op": "recover",
      "script": {
        "statuses": [
          "read_failed"
        ]
      },
      "expect": {
        "result": "ok",
        "effects": [
          "status:1"
        ],
        "status": "in_progress",
        "state": "outcome_unknown"
      }
    },
    {
      "op": "progress",
      "expect": {
        "result": "ok",
        "effects": [],
        "status": "in_progress",
        "state": "outcome_unknown"
      }
    },
    {
      "op": "recover",
      "script": {
        "statuses": [
          "applied"
        ],
        "finality_proofs": [
          "verified"
        ]
      },
      "expect": {
        "result": "ok",
        "effects": [
          "status:1",
          "finality:1"
        ],
        "status": "completed",
        "state": "finalized",
        "identity": {
          "dispatches": 1,
          "possible_admissions": 1,
          "evidence": "applied"
        }
      }
    },
    {
      "op": "execute",
      "expect": {
        "result": "completed",
        "effects": [],
        "status": "completed",
        "state": "finalized"
      }
    }
  ]
}
