{
  "schema": "iroha.zk_operation.scenario.v1",
  "id": "torii_status_mode_is_explicit_and_trusts_the_queried_torii",
  "category": "finality_modes",
  "rules": [
    "authenticated_finality_by_default"
  ],
  "description": "The weaker mode is selected explicitly by the request. The queried Torii's state-resolved Applied closes the identity without any finality read: the caller trusts that Torii.",
  "request": {
    "actions": [
      {
        "attachments": [
          {
            "kind": "proof",
            "length": 4096
          }
        ]
      }
    ],
    "signer": "handle",
    "finality": "torii_status"
  },
  "calls": [
    {
      "op": "execute",
      "script": {
        "proofs": [
          "ok"
        ],
        "local_verifications": [
          "ok"
        ],
        "builds": [
          "ok"
        ],
        "signs": [
          "ok"
        ],
        "dispatches": [
          "accepted"
        ],
        "statuses": [
          "applied"
        ]
      },
      "expect": {
        "result": "completed",
        "effects": [
          "prove:1",
          "local_verify:1",
          "build:1",
          "sign:1",
          "dispatch:1",
          "status:1"
        ],
        "status": "completed",
        "state": "finalized",
        "identity": {
          "dispatches": 1,
          "possible_admissions": 1,
          "evidence": "applied"
        }
      }
    }
  ]
}
