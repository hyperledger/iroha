{
  "schema": "iroha.zk_operation.scenario.v1",
  "id": "non_admissions_keep_the_signed_identity_dispatchable",
  "category": "dispatch_classification",
  "rules": [
    "dispatch_classified_by_closed_table",
    "persist_before_dispatch"
  ],
  "description": "A failure before any byte left the client and a validated backpressure row are definite non-admissions: each is reported by its code at stage submit, the dispatch ordinal is released and the signed bytes stay dispatchable without proving or signing again. A validated already-known row is existence, not finality: the identity closes on authenticated evidence.",
  "request": {
    "actions": [
      {
        "attachments": [
          {
            "kind": "proof",
            "length": 4096
          }
        ]
      }
    ],
    "signer": "handle",
    "finality": "authenticated"
  },
  "calls": [
    {
      "op": "execute",
      "script": {
        "proofs": [
          "ok"
        ],
        "local_verifications": [
          "ok"
        ],
        "builds": [
          "ok"
        ],
        "signs": [
          "ok"
        ],
        "dispatches": [
          "not_dispatched:LocalResourceUnavailable"
        ]
      },
      "expect": {
        "result": {
          "error": "LocalResourceUnavailable",
          "stage": "submit",
          "resumable": true,
          "has_transaction_identity": true
        },
        "effects": [
          "prove:1",
          "local_verify:1",
          "build:1",
          "sign:1",
          "dispatch:1"
        ],
        "status": "in_progress",
        "state": "signed",
        "identity": {
          "dispatches": 0,
          "possible_admissions": 0
        }
      }
    },
    {
      "op": "execute",
      "script": {
        "dispatches": [
          "deferred"
        ]
      },
      "expect": {
        "result": {
          "error": "LocalResourceUnavailable",
          "stage": "submit",
          "resumable": true,
          "has_transaction_identity": true
        },
        "effects": [
          "dispatch:1"
        ],
        "status": "in_progress",
        "state": "signed",
        "identity": {
          "dispatches": 0,
          "possible_admissions": 0
        }
      }
    },
    {
      "op": "execute",
      "script": {
        "dispatches": [
          "already_known"
        ],
        "statuses": [
          "applied"
        ],
        "finality_proofs": [
          "verified"
        ]
      },
      "expect": {
        "result": "completed",
        "effects": [
          "dispatch:1",
          "status:1",
          "finality:1"
        ],
        "status": "completed",
        "state": "finalized",
        "identity": {
          "dispatches": 1,
          "possible_admissions": 1,
          "evidence": "applied"
        }
      }
    }
  ]
}
