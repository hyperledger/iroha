{
  "schema": "iroha.zk_operation.scenario.v1",
  "id": "one_call_finalizes_on_authenticated_evidence",
  "category": "happy_path",
  "rules": [
    "authenticated_finality_by_default",
    "local_verification_before_signing",
    "persist_before_dispatch"
  ],
  "description": "The one-call proves, verifies the proof locally, builds, signs with the opaque signer handle and dispatches the persisted bytes once, then observes within its bound. A queue observation does not finalize the transaction, and in the default mode neither does the state-resolved Applied status: it selects the candidate whose finality proof the verifier authenticates. Running again changes nothing.",
  "request": {
    "actions": [
      {
        "attachments": [
          {
            "kind": "proof",
            "length": 4096
          }
        ]
      }
    ],
    "signer": "handle",
    "finality": "authenticated"
  },
  "calls": [
    {
      "op": "execute",
      "options": {
        "observation_timeout_ms": 1000,
        "poll_interval_ms": 1000
      },
      "script": {
        "proofs": [
          "ok"
        ],
        "local_verifications": [
          "ok"
        ],
        "builds": [
          "ok"
        ],
        "signs": [
          "ok"
        ],
        "dispatches": [
          "accepted"
        ],
        "statuses": [
          "observed",
          "applied"
        ],
        "finality_proofs": [
          "verified"
        ]
      },
      "expect": {
        "result": "completed",
        "effects": [
          "prove:1",
          "local_verify:1",
          "build:1",
          "sign:1",
          "dispatch:1",
          "status:1",
          "sleep:1000",
          "status:1",
          "finality:1"
        ],
        "status": "completed",
        "state": "finalized",
        "identity": {
          "dispatches": 1,
          "possible_admissions": 1,
          "evidence": "applied"
        }
      }
    },
    {
      "op": "execute",
      "expect": {
        "result": "completed",
        "effects": [],
        "status": "completed",
        "state": "finalized"
      }
    }
  ]
}
