{
  "schema": "iroha.zk_operation.scenario.v1",
  "id": "interrupt_while_proving_proves_and_verifies_again",
  "category": "interruption_before_submission",
  "rules": [
    "persist_before_dispatch",
    "local_verification_before_signing"
  ],
  "description": "The process stops while proving. Proofs are never durable, so the resumed run proves and verifies them locally again before it builds, signs and dispatches exactly once.",
  "request": {
    "actions": [
      {
        "attachments": [
          {
            "kind": "proof",
            "length": 4096
          }
        ]
      }
    ],
    "signer": "handle",
    "finality": "authenticated"
  },
  "calls": [
    {
      "op": "execute",
      "script": {
        "proofs": [
          "interrupt"
        ]
      },
      "expect": {
        "result": "interrupted",
        "effects": [
          "prove:1"
        ],
        "status": "in_progress",
        "state": "proving"
      }
    },
    {
      "op": "execute",
      "script": {
        "proofs": [
          "ok"
        ],
        "local_verifications": [
          "ok"
        ],
        "builds": [
          "ok"
        ],
        "signs": [
          "ok"
        ],
        "dispatches": [
          "accepted"
        ],
        "statuses": [
          "applied"
        ],
        "finality_proofs": [
          "verified"
        ]
      },
      "expect": {
        "result": "completed",
        "effects": [
          "prove:1",
          "local_verify:1",
          "build:1",
          "sign:1",
          "dispatch:1",
          "status:1",
          "finality:1"
        ],
        "status": "completed",
        "state": "finalized",
        "identity": {
          "dispatches": 1,
          "possible_admissions": 1,
          "evidence": "applied"
        }
      }
    }
  ]
}
