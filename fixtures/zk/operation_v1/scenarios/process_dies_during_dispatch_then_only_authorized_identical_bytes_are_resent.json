{
  "schema": "iroha.zk_operation.scenario.v1",
  "id": "process_dies_during_dispatch_then_only_authorized_identical_bytes_are_resent",
  "category": "interruption_after_ambiguous_submission",
  "rules": [
    "reconcile_read_only_first",
    "identical_bytes_only",
    "persist_before_dispatch"
  ],
  "description": "The process stops inside the dispatch call. The persisted ordinal has no recorded result, so the resumed run treats the outcome as unknown and only reads; exact absence never closes the identity. With explicit authorization, after a fresh exact-absence read, the exact persisted bytes are sent once more. Nothing is proved, built or signed again.",
  "request": {
    "actions": [
      {
        "attachments": [
          {
            "kind": "proof",
            "length": 4096
          }
        ]
      }
    ],
    "signer": "handle",
    "finality": "authenticated"
  },
  "calls": [
    {
      "op": "execute",
      "script": {
        "proofs": [
          "ok"
        ],
        "local_verifications": [
          "ok"
        ],
        "builds": [
          "ok"
        ],
        "signs": [
          "ok"
        ],
        "dispatches": [
          "interrupt"
        ]
      },
      "expect": {
        "result": "interrupted",
        "effects": [
          "prove:1",
          "local_verify:1",
          "build:1",
          "sign:1",
          "dispatch:1"
        ],
        "status": "in_progress",
        "state": "submitting",
        "identity": {
          "dispatches": 1,
          "possible_admissions": 0
        }
      }
    },
    {
      "op": "execute",
      "script": {
        "statuses": [
          "absent"
        ]
      },
      "expect": {
        "result": {
          "error": "SubmissionOutcomeUnknown",
          "stage": "reconcile",
          "resumable": true,
          "has_transaction_identity": true
        },
        "effects": [
          "status:1"
        ],
        "status": "in_progress",
        "state": "outcome_unknown",
        "identity": {
          "dispatches": 1,
          "possible_admissions": 1
        }
      }
    },
    {
      "op": "execute",
      "options": {
        "retransmit_identical_bytes": true
      },
      "script": {
        "statuses": [
          "absent",
          "applied"
        ],
        "dispatches": [
          "accepted"
        ],
        "finality_proofs": [
          "verified"
        ]
      },
      "expect": {
        "result": "completed",
        "effects": [
          "status:1",
          "dispatch:1",
          "status:1",
          "finality:1"
        ],
        "status": "completed",
        "state": "finalized",
        "identity": {
          "dispatches": 2,
          "possible_admissions": 2,
          "evidence": "applied"
        }
      }
    }
  ]
}
