// Production DLMM pool for one base/quote pair.
//
// Financial values use Kotodama V1 `quantity`; prices and fee growth use
// `decimal`. Bins are held in a bounded sorted linked index, so swaps traverse
// initialized liquidity rather than scanning the numeric bin-id space.
seiyaku DlmmPool {
    permission SwapQuotePublic;
    permission Admin;
    permission AssetOps;
    permission OperatePool;
    error enum DlmmPoolError {
        IdenticalAssets = 1,
        InvalidFeePips = 2,
        InvalidBinStep = 3,
        InvalidBinId = 4,
        InvalidImpactCap = 5,
        InvalidMaxBinsPerSwap = 6,
        BinCapBelowBaseFloor = 7,
        BinCapBelowQuoteFloor = 8,
        PoolOwnerMismatch = 9,
        VaultOperatorMismatch = 10,
        TooManyBins = 11,
        BinIndexCorrupt = 12,
        NoExecutableLiquidity = 13,
        ZeroLiquidity = 14,
        BaseReserveCap = 15,
        QuoteReserveCap = 16,
        PositionNotFound = 17,
        PositionOwnerMismatch = 18,
        PositionBinMismatch = 19,
        InvalidShares = 20,
        InsufficientPositionShares = 21,
        InsufficientSharesOut = 22,
        ZeroRemoval = 23,
        CollectBaseFeesFirst = 24,
        CollectQuoteFeesFirst = 25,
        NothingToCollect = 26,
        FeeGrowthRegression = 27,
        AssetNotInPool = 28,
        InsufficientInputUsed = 29,
        PartialFill = 30,
        Slippage = 31,
        InvalidCadence = 32,
        InvalidDrift = 33,
        InvalidEnabled = 34,
        UnexpectedRecipient = 35,
        InvalidAmount = 36,
        AdminAlreadyRenounced = 37,
        AdminRenounced = 38,
        AssetDefinitionMissing = 39,
        InvalidAssetPrecision = 40,
    }

    state int PoolInitialized;
    state AccountId PoolOwner;
    state int AdminRenounced;
    state AssetDefinitionId BaseAsset;
    state AssetDefinitionId QuoteAsset;
    state AccountId VaultAccount;
    state int FeePips;
    state int BinStep;
    state int ActiveBin;
    state int ImpactCapBps;
    state quantity MinReserveBase;
    state quantity MinReserveQuote;
    state int MaxBinsPerSwap;
    state quantity BinLiquidityCap;
    state int IndexedBinCount;
    state int FirstIndexedBin;
    state int LastIndexedBin;
    state StateMap<int, int> BinIndexed;
    state StateMap<int, int> PreviousIndexedBin;
    state StateMap<int, int> NextIndexedBin;
    state StateMap<int, quantity> BinReserveBase;
    state StateMap<int, quantity> BinReserveQuote;
    state StateMap<int, quantity> BinShareSupply;
    state StateMap<int, decimal> BinFeeGrowthBase;
    state StateMap<int, decimal> BinFeeGrowthQuote;
    state StateMap<Name, AccountId> PositionOwner;
    state StateMap<Name, int> PositionBinId;
    state StateMap<Name, quantity> PositionShares;
    state StateMap<Name, decimal> PositionFeeDebtBase;
    state StateMap<Name, decimal> PositionFeeDebtQuote;
    state StateMap<Name, quantity> PositionCreditBase;
    state StateMap<Name, quantity> PositionCreditQuote;
    state int RangeGovernorEnabled;
    state int RangeGovernorCadenceSlots;
    state int RangeGovernorNextSlot;
    state int RangeGovernorMaxFeePips;
    state int RangeGovernorTargetActiveBin;
    state int RangeGovernorMaxActiveBinDrift;
    state int RangeGovernorLastSlot;
    state int RangeGovernorLastAction;
    trigger soraswap_range_governor_tick -> native_range_governor_tick {
        on time pre_commit;
        repeats indefinitely;
        metadata {
            "tag": "soraswap";
            "module": "dlmm.dlmm_pool";
            "__enabled": false;
        }
    }

    // Precision is native ledger state, never an argument or mutable pool setting.
    // An unconstrained definition permits the numeric domain's full 28 places.
    fn asset_scale(AssetDefinitionId _ asset) -> int {
        let definition = ledger::query::asset_definition(asset).expect(
            DlmmPoolError::AssetDefinitionMissing,
        );
        return definition.numeric_scale.unwrap_or(28);
    }

    fn floor_asset_amount(quantity amount, int scale) -> quantity {
        require(scale >= 0 && scale <= 28, DlmmPoolError::InvalidAssetPrecision);
        return amount.div_round(divisor: 1.0, scale: scale, mode: Rounding::floor);
    }

    fn ceil_asset_amount(quantity amount, int scale) -> quantity {
        require(scale >= 0 && scale <= 28, DlmmPoolError::InvalidAssetPrecision);
        return amount.div_round(divisor: 1.0, scale: scale, mode: Rounding::ceil);
    }

    fn zero_quantity() -> quantity {
        let quantity zero = 0;
        return zero;
    }

    fn zero_decimal() -> decimal {
        let decimal zero = 0;
        return zero;
    }

    fn abs_int(int _ value) -> int {
        if value < 0 {
            return 0 - value;
        }
        return value;
    }

    fn min_quantity(quantity left, quantity right) -> quantity {
        if left <= right {
            return left;
        }
        return right;
    }

    fn assert_valid_fee(int _ fee_pips) {
        require(fee_pips >= 0, DlmmPoolError::InvalidFeePips);
        require(fee_pips < 1_000_000, DlmmPoolError::InvalidFeePips);
    }

    fn assert_valid_bin_step(int _ bin_step) {
        require(bin_step > 0, DlmmPoolError::InvalidBinStep);
        require(bin_step <= 100_000, DlmmPoolError::InvalidBinStep);
    }

    fn assert_valid_bin_id(int _ bin_id) {
        require(abs_int(bin_id) <= 200_000, DlmmPoolError::InvalidBinId);
    }

    fn assert_pool_owner() {
        require(AdminRenounced == 0, DlmmPoolError::AdminRenounced);
        require(PoolOwner == context::authority(), DlmmPoolError::PoolOwnerMismatch);
    }

    fn assert_vault_operator() {
        require(VaultAccount == context::authority(), DlmmPoolError::VaultOperatorMismatch);
    }

    fn renounce_admin_impl() {
        require(AdminRenounced == 0, DlmmPoolError::AdminAlreadyRenounced);
        require(PoolOwner == context::authority(), DlmmPoolError::PoolOwnerMismatch);
        RangeGovernorEnabled = 0;
        RangeGovernorNextSlot = 0;
        AdminRenounced = 1;
    }

    fn fee_multiplier(int _ fee_pips) -> decimal {
        assert_valid_fee(fee_pips);
        let decimal scale = 1_000_000;
        let fee = decimal::from_int(fee_pips);
        return (scale - fee) / scale;
    }

    fn fee_adjusted_amount(quantity amount_in, int fee_pips) -> quantity {
        return amount_in.mul_div_round(
            multiplier: fee_multiplier(fee_pips),
            divisor: 1.0,
            scale: 28,
            mode: Rounding::floor,
        );
    }

    fn fee_paid_amount(quantity amount_in, int fee_pips) -> quantity {
        return amount_in - fee_adjusted_amount(amount_in: amount_in, fee_pips: fee_pips);
    }

    fn gross_from_net(quantity net_amount, int fee_pips) -> quantity {
        return net_amount.div_round(
            divisor: fee_multiplier(fee_pips),
            scale: 28,
            mode: Rounding::ceil,
        );
    }

    fn bin_price(int bin_id, int bin_step) -> decimal {
        assert_valid_bin_id(bin_id);
        assert_valid_bin_step(bin_step);
        let decimal scale = 1_000_000;
        let offset = decimal::from_int(abs_int(bin_id) * bin_step);
        if bin_id >= 0 {
            return (scale + offset) / scale;
        }
        return scale.div_round(divisor: scale + offset, scale: 28, mode: Rounding::floor);
    }

    fn price_impact_bps(decimal start_price, decimal current_price) -> int {
        var delta = current_price - start_price;
        if delta < 0 {
            delta = 0 - delta;
        }
        let ratio = delta.div_round(divisor: start_price, scale: 12, mode: Rounding::ceil);
        return decimal::to_int_round(ratio * 10_000, mode: Rounding::ceil);
    }

    fn bin_reserve_base_value(int _ bin_id) -> quantity {
        return BinReserveBase.get(bin_id).unwrap_or(zero_quantity());
    }

    fn bin_reserve_quote_value(int _ bin_id) -> quantity {
        return BinReserveQuote.get(bin_id).unwrap_or(zero_quantity());
    }

    fn bin_share_supply_value(int _ bin_id) -> quantity {
        return BinShareSupply.get(bin_id).unwrap_or(zero_quantity());
    }

    fn bin_fee_growth_base_value(int _ bin_id) -> decimal {
        return BinFeeGrowthBase.get(bin_id).unwrap_or(zero_decimal());
    }

    fn bin_fee_growth_quote_value(int _ bin_id) -> decimal {
        return BinFeeGrowthQuote.get(bin_id).unwrap_or(zero_decimal());
    }

    fn position_shares_value(Name _ position_id) -> quantity {
        return PositionShares.get(position_id).unwrap_or(zero_quantity());
    }

    fn position_fee_debt_base_value(Name _ position_id) -> decimal {
        return PositionFeeDebtBase.get(position_id).unwrap_or(zero_decimal());
    }

    fn position_fee_debt_quote_value(Name _ position_id) -> decimal {
        return PositionFeeDebtQuote.get(position_id).unwrap_or(zero_decimal());
    }

    fn position_credit_base_value(Name _ position_id) -> quantity {
        return PositionCreditBase.get(position_id).unwrap_or(zero_quantity());
    }

    fn position_credit_quote_value(Name _ position_id) -> quantity {
        return PositionCreditQuote.get(position_id).unwrap_or(zero_quantity());
    }

    fn position_owner_value(Name _ position_id) -> AccountId {
        require(PositionOwner.contains(position_id), DlmmPoolError::PositionNotFound);
        return PositionOwner.get(position_id).unwrap_or(context::authority());
    }

    fn position_bin_value(Name _ position_id) -> int {
        require(PositionBinId.contains(position_id), DlmmPoolError::PositionNotFound);
        return PositionBinId.get(position_id).unwrap_or(ActiveBin);
    }

    fn move_asset_if_needed(
        AccountId source,
        AccountId destination,
        AssetDefinitionId asset,
        quantity amount,
    ) {
        if amount > zero_quantity() && source != destination {
            ledger::asset::transfer(
                source: source,
                destination: destination,
                asset_definition: asset,
                amount: amount,
            );
        }
    }

    fn ensure_bin_indexed(int _ bin_id) {
        assert_valid_bin_id(bin_id);
        if BinIndexed.contains(bin_id) {
            return;
        }
        require(IndexedBinCount < 64, DlmmPoolError::TooManyBins);
        if IndexedBinCount == 0 {
            FirstIndexedBin = bin_id;
            LastIndexedBin = bin_id;
        } else {
            var cursor = FirstIndexedBin;
            var inserted = 0;
            for _index_step in range(64) {
                if inserted == 1 {
                    break;
                }
                require(BinIndexed.contains(cursor), DlmmPoolError::BinIndexCorrupt);
                require(cursor != bin_id, DlmmPoolError::BinIndexCorrupt);
                if bin_id < cursor {
                    if PreviousIndexedBin.contains(cursor) {
                        let previous = PreviousIndexedBin.get(cursor).unwrap_or(cursor);
                        require(previous < bin_id, DlmmPoolError::BinIndexCorrupt);
                        NextIndexedBin[previous] = bin_id;
                        PreviousIndexedBin[bin_id] = previous;
                    } else {
                        FirstIndexedBin = bin_id;
                    }
                    NextIndexedBin[bin_id] = cursor;
                    PreviousIndexedBin[cursor] = bin_id;
                    inserted = 1;
                } else {
                    if NextIndexedBin.contains(cursor) {
                        let next = NextIndexedBin.get(cursor).unwrap_or(cursor);
                        require(next > cursor, DlmmPoolError::BinIndexCorrupt);
                        cursor = next;
                    } else {
                        NextIndexedBin[cursor] = bin_id;
                        PreviousIndexedBin[bin_id] = cursor;
                        LastIndexedBin = bin_id;
                        inserted = 1;
                    }
                }
            }
            require(inserted == 1, DlmmPoolError::BinIndexCorrupt);
        }
        BinIndexed[bin_id] = 1;
        BinReserveBase[bin_id] = zero_quantity();
        BinReserveQuote[bin_id] = zero_quantity();
        BinShareSupply[bin_id] = zero_quantity();
        BinFeeGrowthBase[bin_id] = zero_decimal();
        BinFeeGrowthQuote[bin_id] = zero_decimal();
        IndexedBinCount = IndexedBinCount + 1;
    }

    fn liquidity_value(int bin_id, quantity base_amount, quantity quote_amount) -> quantity {
        return quote_amount + base_amount * bin_price(bin_id: bin_id, bin_step: BinStep);
    }

    fn share_mint_for_deposit(int bin_id, quantity base_amount, quantity quote_amount) -> quantity {
        let deposit_value = liquidity_value(
            bin_id: bin_id,
            base_amount: base_amount,
            quote_amount: quote_amount,
        );
        require(deposit_value > zero_quantity(), DlmmPoolError::ZeroLiquidity);
        let share_supply = bin_share_supply_value(bin_id);
        let current_value = liquidity_value(
            bin_id: bin_id,
            base_amount: bin_reserve_base_value(bin_id),
            quote_amount: bin_reserve_quote_value(bin_id),
        );
        if share_supply == zero_quantity() || current_value == zero_quantity() {
            return deposit_value;
        }
        let share_ratio = deposit_value.ratio_round(
            divisor: current_value,
            scale: 28,
            mode: Rounding::floor,
        );
        let minted = share_supply * share_ratio;
        require(minted > zero_quantity(), DlmmPoolError::ZeroLiquidity);
        return minted;
    }

    fn credit_bin_fee_growth_base(int bin_id, quantity fee_paid) {
        let supply = bin_share_supply_value(bin_id);
        if fee_paid == zero_quantity() || supply == zero_quantity() {
            return;
        }
        let growth = fee_paid.ratio_round(divisor: supply, scale: 28, mode: Rounding::floor);
        BinFeeGrowthBase[bin_id] = bin_fee_growth_base_value(bin_id) + growth;
    }

    fn credit_bin_fee_growth_quote(int bin_id, quantity fee_paid) {
        let supply = bin_share_supply_value(bin_id);
        if fee_paid == zero_quantity() || supply == zero_quantity() {
            return;
        }
        let growth = fee_paid.ratio_round(divisor: supply, scale: 28, mode: Rounding::floor);
        BinFeeGrowthQuote[bin_id] = bin_fee_growth_quote_value(bin_id) + growth;
    }

    fn accrue_position_fees(Name _ position_id) {
        let bin_id = position_bin_value(position_id);
        let shares = position_shares_value(position_id);
        let growth_base = bin_fee_growth_base_value(bin_id);
        let growth_quote = bin_fee_growth_quote_value(bin_id);
        let debt_base = position_fee_debt_base_value(position_id);
        let debt_quote = position_fee_debt_quote_value(position_id);
        require(growth_base >= debt_base, DlmmPoolError::FeeGrowthRegression);
        require(growth_quote >= debt_quote, DlmmPoolError::FeeGrowthRegression);
        if shares > zero_quantity() {
            PositionCreditBase[position_id] = position_credit_base_value(position_id)
                + shares * (growth_base - debt_base);
            PositionCreditQuote[position_id] = position_credit_quote_value(position_id)
                + shares * (growth_quote - debt_quote);
        }
        PositionFeeDebtBase[position_id] = growth_base;
        PositionFeeDebtQuote[position_id] = growth_quote;
    }

    fn find_quote_liquidity_from_active() -> int {
        require(IndexedBinCount > 0, DlmmPoolError::NoExecutableLiquidity);
        var cursor = FirstIndexedBin;
        var found = 0;
        var candidate = ActiveBin;
        for _index_step in range(64) {
            if found == 1 {
                break;
            }
            require(BinIndexed.contains(cursor), DlmmPoolError::BinIndexCorrupt);
            if cursor >= ActiveBin && bin_reserve_quote_value(cursor) > MinReserveQuote {
                candidate = cursor;
                found = 1;
            } else {
                if NextIndexedBin.contains(cursor) {
                    let next = NextIndexedBin.get(cursor).unwrap_or(cursor);
                    require(next > cursor, DlmmPoolError::BinIndexCorrupt);
                    cursor = next;
                } else {
                    break;
                }
            }
        }
        require(found == 1, DlmmPoolError::NoExecutableLiquidity);
        ActiveBin = candidate;
        return candidate;
    }

    fn find_base_liquidity_from_active() -> int {
        require(IndexedBinCount > 0, DlmmPoolError::NoExecutableLiquidity);
        var cursor = LastIndexedBin;
        var found = 0;
        var candidate = ActiveBin;
        for _index_step in range(64) {
            if found == 1 {
                break;
            }
            require(BinIndexed.contains(cursor), DlmmPoolError::BinIndexCorrupt);
            if cursor <= ActiveBin && bin_reserve_base_value(cursor) > MinReserveBase {
                candidate = cursor;
                found = 1;
            } else {
                if PreviousIndexedBin.contains(cursor) {
                    let previous = PreviousIndexedBin.get(cursor).unwrap_or(cursor);
                    require(previous < cursor, DlmmPoolError::BinIndexCorrupt);
                    cursor = previous;
                } else {
                    break;
                }
            }
        }
        require(found == 1, DlmmPoolError::NoExecutableLiquidity);
        ActiveBin = candidate;
        return candidate;
    }

    hajimari(
        AssetDefinitionId base_asset,
        AssetDefinitionId quote_asset,
        AccountId vault_account,
        int fee_pips,
        int bin_step,
        int active_bin,
        int impact_cap_bps,
        quantity min_reserve_base,
        quantity min_reserve_quote,
        int max_bins_per_swap,
        quantity bin_liquidity_cap,
    ) {
        require(base_asset != quote_asset, DlmmPoolError::IdenticalAssets);
        assert_valid_fee(fee_pips);
        assert_valid_bin_step(bin_step);
        assert_valid_bin_id(active_bin);
        require(impact_cap_bps >= 0, DlmmPoolError::InvalidImpactCap);
        require(max_bins_per_swap > 0, DlmmPoolError::InvalidMaxBinsPerSwap);
        require(max_bins_per_swap <= 64, DlmmPoolError::InvalidMaxBinsPerSwap);
        if bin_liquidity_cap > zero_quantity() {
            require(bin_liquidity_cap >= min_reserve_base, DlmmPoolError::BinCapBelowBaseFloor);
            require(bin_liquidity_cap >= min_reserve_quote, DlmmPoolError::BinCapBelowQuoteFloor);
        }
        PoolInitialized = 1;
        PoolOwner = context::authority();
        AdminRenounced = 0;
        BaseAsset = base_asset;
        QuoteAsset = quote_asset;
        VaultAccount = vault_account;
        FeePips = fee_pips;
        BinStep = bin_step;
        ActiveBin = active_bin;
        ImpactCapBps = impact_cap_bps;
        MinReserveBase = min_reserve_base;
        MinReserveQuote = min_reserve_quote;
        MaxBinsPerSwap = max_bins_per_swap;
        BinLiquidityCap = bin_liquidity_cap;
        IndexedBinCount = 0;
        FirstIndexedBin = active_bin;
        LastIndexedBin = active_bin;
        RangeGovernorEnabled = 0;
        RangeGovernorCadenceSlots = 0;
        RangeGovernorNextSlot = 0;
        RangeGovernorMaxFeePips = fee_pips;
        RangeGovernorTargetActiveBin = active_bin;
        RangeGovernorMaxActiveBinDrift = 0;
        RangeGovernorLastSlot = 0;
        RangeGovernorLastAction = 0;
    }

    view fn main() authorize(anyone) -> int {
        return ActiveBin;
    }

    kotoage fn add_position_liquidity(
        Name position_id,
        int bin_id,
        quantity base_amount,
        quantity quote_amount,
        quantity min_shares_out,
    ) authorize(OperatePool) -> quantity {
        return add_position_liquidity_impl(
            position_id: position_id,
            provider: context::authority(),
            bin_id: bin_id,
            base_amount: base_amount,
            quote_amount: quote_amount,
            min_shares_out: min_shares_out,
        );
    }

    // Bootstrap and launchpad seeding is represented by an owned position so
    // shares and earned fees can never become anonymous or permanently trapped.
    kotoage fn seed_bin(
        Name position_id,
        int bin_id,
        quantity base_amount,
        quantity quote_amount,
    ) authorize(OperatePool) -> quantity {
        return add_position_liquidity_impl(
            position_id: position_id,
            provider: context::authority(),
            bin_id: bin_id,
            base_amount: base_amount,
            quote_amount: quote_amount,
            min_shares_out: zero_quantity(),
        );
    }

    kotoage fn seed_bin_c2c(
        Name position_id,
        int bin_id,
        quantity base_amount,
        quantity quote_amount,
    ) authorize(AssetOps) -> quantity {
        return add_position_liquidity_impl(
            position_id: position_id,
            provider: context::authority(),
            bin_id: bin_id,
            base_amount: base_amount,
            quote_amount: quote_amount,
            min_shares_out: zero_quantity(),
        );
    }

    fn add_position_liquidity_impl(
        Name position_id,
        AccountId provider,
        int bin_id,
        quantity base_amount,
        quantity quote_amount,
        quantity min_shares_out,
    ) -> quantity {
        ensure_bin_indexed(bin_id);
        let reserve_base = bin_reserve_base_value(bin_id);
        let reserve_quote = bin_reserve_quote_value(bin_id);
        if BinLiquidityCap > zero_quantity() {
            require(reserve_base + base_amount <= BinLiquidityCap, DlmmPoolError::BaseReserveCap);
            require(
                reserve_quote + quote_amount <= BinLiquidityCap,
                DlmmPoolError::QuoteReserveCap,
            );
        }
        let minted = share_mint_for_deposit(
            bin_id: bin_id,
            base_amount: base_amount,
            quote_amount: quote_amount,
        );
        require(minted >= min_shares_out, DlmmPoolError::InsufficientSharesOut);
        if PositionOwner.contains(position_id) {
            require(
                position_owner_value(position_id) == provider,
                DlmmPoolError::PositionOwnerMismatch,
            );
            require(position_bin_value(position_id) == bin_id, DlmmPoolError::PositionBinMismatch);
            accrue_position_fees(position_id);
        } else {
            PositionOwner[position_id] = provider;
            PositionBinId[position_id] = bin_id;
            PositionShares[position_id] = zero_quantity();
            PositionCreditBase[position_id] = zero_quantity();
            PositionCreditQuote[position_id] = zero_quantity();
        }
        move_asset_if_needed(
            source: provider,
            destination: VaultAccount,
            asset: BaseAsset,
            amount: base_amount,
        );
        move_asset_if_needed(
            source: provider,
            destination: VaultAccount,
            asset: QuoteAsset,
            amount: quote_amount,
        );
        BinReserveBase[bin_id] = reserve_base + base_amount;
        BinReserveQuote[bin_id] = reserve_quote + quote_amount;
        BinShareSupply[bin_id] = bin_share_supply_value(bin_id) + minted;
        PositionShares[position_id] = position_shares_value(position_id) + minted;
        PositionFeeDebtBase[position_id] = bin_fee_growth_base_value(bin_id);
        PositionFeeDebtQuote[position_id] = bin_fee_growth_quote_value(bin_id);
        return minted;
    }

    kotoage fn remove_position_liquidity(
        Name position_id,
        quantity shares,
    ) authorize(AssetOps) -> quantity {
        let recipient = context::authority();
        require(recipient == position_owner_value(position_id), DlmmPoolError::UnexpectedRecipient);
        accrue_position_fees(position_id);
        require(
            position_credit_base_value(position_id) == zero_quantity(),
            DlmmPoolError::CollectBaseFeesFirst,
        );
        require(
            position_credit_quote_value(position_id) == zero_quantity(),
            DlmmPoolError::CollectQuoteFeesFirst,
        );
        let bin_id = position_bin_value(position_id);
        let owned_shares = position_shares_value(position_id);
        let supply = bin_share_supply_value(bin_id);
        require(shares > zero_quantity(), DlmmPoolError::InvalidShares);
        require(shares <= owned_shares, DlmmPoolError::InsufficientPositionShares);
        require(shares <= supply, DlmmPoolError::BinIndexCorrupt);
        let ratio = shares.ratio_round(divisor: supply, scale: 28, mode: Rounding::floor);
        let reserve_base = bin_reserve_base_value(bin_id);
        let reserve_quote = bin_reserve_quote_value(bin_id);
        let base_out = reserve_base * ratio;
        let quote_out = reserve_quote * ratio;
        require(
            base_out > zero_quantity() || quote_out > zero_quantity(),
            DlmmPoolError::ZeroRemoval,
        );
        PositionShares[position_id] = owned_shares - shares;
        BinShareSupply[bin_id] = supply - shares;
        BinReserveBase[bin_id] = reserve_base - base_out;
        BinReserveQuote[bin_id] = reserve_quote - quote_out;
        PositionFeeDebtBase[position_id] = bin_fee_growth_base_value(bin_id);
        PositionFeeDebtQuote[position_id] = bin_fee_growth_quote_value(bin_id);
        move_asset_if_needed(
            source: VaultAccount,
            destination: recipient,
            asset: BaseAsset,
            amount: base_out,
        );
        move_asset_if_needed(
            source: VaultAccount,
            destination: recipient,
            asset: QuoteAsset,
            amount: quote_out,
        );
        return base_out + quote_out;
    }

    kotoage fn collect_position_fees(Name position_id) authorize(AssetOps) -> quantity {
        let recipient = context::authority();
        require(recipient == position_owner_value(position_id), DlmmPoolError::UnexpectedRecipient);
        accrue_position_fees(position_id);
        let bin_id = position_bin_value(position_id);
        let reserve_base = bin_reserve_base_value(bin_id);
        let reserve_quote = bin_reserve_quote_value(bin_id);
        let available_base = (reserve_base > MinReserveBase)
            ? reserve_base - MinReserveBase
            : zero_quantity();
        let available_quote = (reserve_quote > MinReserveQuote)
            ? reserve_quote - MinReserveQuote
            : zero_quantity();
        let payout_base = min_quantity(
            left: position_credit_base_value(position_id),
            right: available_base,
        );
        let payout_quote = min_quantity(
            left: position_credit_quote_value(position_id),
            right: available_quote,
        );
        require(
            payout_base > zero_quantity() || payout_quote > zero_quantity(),
            DlmmPoolError::NothingToCollect,
        );
        PositionCreditBase[position_id] = position_credit_base_value(position_id) - payout_base;
        PositionCreditQuote[position_id] = position_credit_quote_value(position_id) - payout_quote;
        BinReserveBase[bin_id] = reserve_base - payout_base;
        BinReserveQuote[bin_id] = reserve_quote - payout_quote;
        move_asset_if_needed(
            source: VaultAccount,
            destination: recipient,
            asset: BaseAsset,
            amount: payout_base,
        );
        move_asset_if_needed(
            source: VaultAccount,
            destination: recipient,
            asset: QuoteAsset,
            amount: payout_quote,
        );
        return payout_base + payout_quote;
    }

    // The two private directions share traversal/custody logic while keeping
    // their inverse price operations and exact floor/ceil policies explicit.
    fn swap_output_from_gross(
        quantity gross,
        int fee_pips,
        decimal price,
        int output_scale,
        int base_input,
    ) -> quantity {
        let net = fee_adjusted_amount(amount_in: gross, fee_pips: fee_pips);
        if base_input == 1 {
            return net.mul_div_round(
                multiplier: price,
                divisor: 1.0,
                scale: output_scale,
                mode: Rounding::floor,
            );
        }
        return net.div_round(divisor: price, scale: output_scale, mode: Rounding::floor);
    }

    fn swap_net_for_available(quantity available, decimal price, int base_input) -> quantity {
        if base_input == 1 {
            return available.div_round(divisor: price, scale: 28, mode: Rounding::ceil);
        }
        return available.mul_div_round(
            multiplier: price,
            divisor: 1.0,
            scale: 28,
            mode: Rounding::ceil,
        );
    }

    fn swap_direction(
        AccountId trader,
        AccountId recipient,
        quantity amount_in,
        quantity min_out,
        int require_full_fill,
        int base_input,
    ) -> quantity {
        let input_asset = base_input == 1 ? BaseAsset : QuoteAsset;
        let input_scale = asset_scale(input_asset);
        let output_asset = base_input == 1 ? QuoteAsset : BaseAsset;
        let output_scale = asset_scale(output_asset);
        require(
            floor_asset_amount(amount: amount_in, scale: input_scale) == amount_in,
            DlmmPoolError::InvalidAmount,
        );
        let fee_pips = FeePips;
        let start_bin = base_input == 1
            ? find_quote_liquidity_from_active()
            : find_base_liquidity_from_active();
        let start_price = bin_price(bin_id: start_bin, bin_step: BinStep);
        var current_bin = start_bin;
        var amount_remaining = amount_in;
        var amount_used = zero_quantity();
        var amount_out = zero_quantity();
        var bins_visited = 0;
        for _index_step in range(64) {
            if amount_remaining == zero_quantity() || bins_visited >= MaxBinsPerSwap {
                break;
            }
            require(BinIndexed.contains(current_bin), DlmmPoolError::BinIndexCorrupt);
            let price = bin_price(bin_id: current_bin, bin_step: BinStep);
            if ImpactCapBps > 0
                && price_impact_bps(start_price: start_price, current_price: price) > ImpactCapBps
            {
                break;
            }
            let reserve_base = bin_reserve_base_value(current_bin);
            let reserve_quote = bin_reserve_quote_value(current_bin);
            let reserve_in = base_input == 1 ? reserve_base : reserve_quote;
            let reserve_out = base_input == 1 ? reserve_quote : reserve_base;
            let floor_out = base_input == 1 ? MinReserveQuote : MinReserveBase;
            let available = reserve_out > floor_out ? reserve_out - floor_out : zero_quantity();
            var gross_limit = amount_remaining;
            if BinLiquidityCap > zero_quantity() {
                if reserve_in >= BinLiquidityCap {
                    gross_limit = zero_quantity();
                } else {
                    gross_limit = min_quantity(
                        left: gross_limit,
                        right: BinLiquidityCap - reserve_in,
                    );
                }
            }
            gross_limit = floor_asset_amount(amount: gross_limit, scale: input_scale);
            var gross_used = gross_limit;
            var output = swap_output_from_gross(
                gross: gross_limit,
                fee_pips: fee_pips,
                price: price,
                output_scale: output_scale,
                base_input: base_input,
            );
            if output > available && available > zero_quantity() {
                let net_needed = swap_net_for_available(
                    available: available,
                    price: price,
                    base_input: base_input,
                );
                gross_used = min_quantity(
                    left: gross_limit,
                    right: ceil_asset_amount(
                        amount: gross_from_net(net_amount: net_needed, fee_pips: fee_pips),
                        scale: input_scale,
                    ),
                );
                output = swap_output_from_gross(
                    gross: gross_used,
                    fee_pips: fee_pips,
                    price: price,
                    output_scale: output_scale,
                    base_input: base_input,
                );
                if output > available {
                    output = available;
                }
            }
            // Reserve deltas exactly equal ledger-payable quantities. Fractional
            // execution dust stays with liquidity and is never transferred or credited.
            output = floor_asset_amount(
                amount: min_quantity(left: output, right: available),
                scale: output_scale,
            );
            if gross_used > zero_quantity() && output > zero_quantity() {
                if base_input == 1 {
                    BinReserveBase[current_bin] = reserve_base + gross_used;
                    BinReserveQuote[current_bin] = reserve_quote - output;
                    credit_bin_fee_growth_base(
                        bin_id: current_bin,
                        fee_paid: fee_paid_amount(amount_in: gross_used, fee_pips: fee_pips),
                    );
                } else {
                    BinReserveQuote[current_bin] = reserve_quote + gross_used;
                    BinReserveBase[current_bin] = reserve_base - output;
                    credit_bin_fee_growth_quote(
                        bin_id: current_bin,
                        fee_paid: fee_paid_amount(amount_in: gross_used, fee_pips: fee_pips),
                    );
                }
                amount_remaining = amount_remaining - gross_used;
                amount_used = amount_used + gross_used;
                amount_out = amount_out + output;
            }
            bins_visited = bins_visited + 1;
            if amount_remaining > zero_quantity() {
                if base_input == 1 {
                    if NextIndexedBin.contains(current_bin) {
                        let next = NextIndexedBin.get(current_bin).unwrap_or(current_bin);
                        require(next > current_bin, DlmmPoolError::BinIndexCorrupt);
                        current_bin = next;
                        ActiveBin = next;
                    } else {
                        break;
                    }
                } else {
                    if PreviousIndexedBin.contains(current_bin) {
                        let previous = PreviousIndexedBin.get(current_bin).unwrap_or(current_bin);
                        require(previous < current_bin, DlmmPoolError::BinIndexCorrupt);
                        current_bin = previous;
                        ActiveBin = previous;
                    } else {
                        break;
                    }
                }
            } else {
                ActiveBin = current_bin;
            }
        }
        require(amount_used > zero_quantity(), DlmmPoolError::InsufficientInputUsed);
        if require_full_fill == 1 {
            require(amount_used == amount_in, DlmmPoolError::PartialFill);
        }
        require(amount_out >= min_out, DlmmPoolError::Slippage);
        move_asset_if_needed(
            source: trader,
            destination: VaultAccount,
            asset: input_asset,
            amount: amount_used,
        );
        move_asset_if_needed(
            source: VaultAccount,
            destination: recipient,
            asset: output_asset,
            amount: amount_out,
        );
        return amount_out;
    }

    fn swap_exact_in_impl(
        AccountId trader,
        AccountId recipient,
        AssetDefinitionId input_asset,
        quantity amount_in,
        quantity min_out,
        int require_full_fill,
    ) -> quantity {
        let base_input = input_asset == BaseAsset ? 1 : 0;
        if base_input == 0 {
            require(input_asset == QuoteAsset, DlmmPoolError::AssetNotInPool);
        }
        return swap_direction(
            trader: trader,
            recipient: recipient,
            amount_in: amount_in,
            min_out: min_out,
            require_full_fill: require_full_fill,
            base_input: base_input,
        );
    }

    kotoage fn swap_exact_in(
        AssetDefinitionId input_asset,
        quantity amount_in,
        quantity min_out,
    ) authorize(AssetOps) -> quantity {
        return swap_exact_in_impl(
            trader: context::authority(),
            recipient: context::authority(),
            input_asset: input_asset,
            amount_in: amount_in,
            min_out: min_out,
            require_full_fill: 0,
        );
    }

    kotoage fn swap_exact_in_base(
        quantity amount_in,
        quantity min_out,
    ) authorize(AssetOps) -> quantity {
        return swap_exact_in_impl(
            trader: context::authority(),
            recipient: context::authority(),
            input_asset: BaseAsset,
            amount_in: amount_in,
            min_out: min_out,
            require_full_fill: 0,
        );
    }

    kotoage fn swap_exact_in_quote(
        quantity amount_in,
        quantity min_out,
    ) authorize(AssetOps) -> quantity {
        return swap_exact_in_impl(
            trader: context::authority(),
            recipient: context::authority(),
            input_asset: QuoteAsset,
            amount_in: amount_in,
            min_out: min_out,
            require_full_fill: 0,
        );
    }

    // This selector has its own instance permission, `SwapQuotePublic`.
    // Its exact address-and-name grant is held by the caller. The surface deliberately has no
    // trader or recipient parameter: the caller funds the complete quote-asset
    // input and receives the base-asset output.
    kotoage fn swap_exact_in_quote_public(
        quantity amount_in,
        quantity min_out,
    ) authorize(SwapQuotePublic) -> quantity {
        require(amount_in > zero_quantity(), DlmmPoolError::InvalidAmount);
        return swap_exact_in_impl(
            trader: context::authority(),
            recipient: context::authority(),
            input_asset: QuoteAsset,
            amount_in: amount_in,
            min_out: min_out,
            require_full_fill: 1,
        );
    }

    kotoage fn swap_exact_in_base_for(
        AccountId recipient,
        quantity amount_in,
        quantity min_out,
    ) authorize(AssetOps) -> quantity {
        return swap_exact_in_impl(
            trader: context::authority(),
            recipient: recipient,
            input_asset: BaseAsset,
            amount_in: amount_in,
            min_out: min_out,
            require_full_fill: 1,
        );
    }

    kotoage fn swap_exact_in_quote_for(
        AccountId recipient,
        quantity amount_in,
        quantity min_out,
    ) authorize(AssetOps) -> quantity {
        return swap_exact_in_impl(
            trader: context::authority(),
            recipient: recipient,
            input_asset: QuoteAsset,
            amount_in: amount_in,
            min_out: min_out,
            require_full_fill: 1,
        );
    }

    kotoage fn bind_custody_account(AccountId vault_account) authorize(Admin) {
        assert_pool_owner();
        VaultAccount = vault_account;
    }

    // Permanently freezes every owner-controlled pool setting. The pool has no
    // `kaizen`, owner rotation, or recovery entrypoint, so this transition
    // cannot be reversed by contract code.
    kotoage fn renounce_admin() authorize(OperatePool) {
        renounce_admin_impl();
    }

    kotoage fn configure_range_governor(
        int cadence_slots,
        int max_fee_pips,
        int target_active_bin,
        int max_active_bin_drift,
        int enabled,
    ) authorize(Admin) {
        assert_pool_owner();
        require(cadence_slots >= 0, DlmmPoolError::InvalidCadence);
        assert_valid_fee(max_fee_pips);
        assert_valid_bin_id(target_active_bin);
        require(max_active_bin_drift >= 0, DlmmPoolError::InvalidDrift);
        require(enabled == 0 || enabled == 1, DlmmPoolError::InvalidEnabled);
        RangeGovernorCadenceSlots = cadence_slots;
        RangeGovernorMaxFeePips = max_fee_pips;
        RangeGovernorTargetActiveBin = target_active_bin;
        RangeGovernorMaxActiveBinDrift = max_active_bin_drift;
        RangeGovernorEnabled = enabled;
        RangeGovernorNextSlot = context::block_height() + cadence_slots;
        ledger::trigger::set_enabled(
            trigger: Name::parse("soraswap_range_governor_tick"),
            enabled: enabled == 1,
        );
    }

    kotoage fn native_range_governor_tick() authorize(Admin) {
        if RangeGovernorEnabled == 0 {
            return;
        }
        let current_slot = context::block_height();
        if RangeGovernorNextSlot > 0 && current_slot < RangeGovernorNextSlot {
            return;
        }
        var action = 0;
        if FeePips > RangeGovernorMaxFeePips {
            FeePips = RangeGovernorMaxFeePips;
            action = 1;
        }
        let drift = abs_int(ActiveBin - RangeGovernorTargetActiveBin);
        if RangeGovernorMaxActiveBinDrift > 0 && drift > RangeGovernorMaxActiveBinDrift {
            if BinIndexed.contains(RangeGovernorTargetActiveBin) {
                ActiveBin = RangeGovernorTargetActiveBin;
                action = action + 2;
            }
        }
        RangeGovernorLastSlot = current_slot;
        RangeGovernorLastAction = action;
        RangeGovernorNextSlot = current_slot + RangeGovernorCadenceSlots;
    }

    view fn mirror_state() authorize(anyone) -> (
        int,
        int,
        int,
        int,
        quantity,
        quantity,
        quantity,
        quantity,
        int,
        quantity,
        quantity,
        int,
        quantity
    ) {
        let reserve_base = bin_reserve_base_value(ActiveBin);
        let reserve_quote = bin_reserve_quote_value(ActiveBin);
        return (
            PoolInitialized,
            ActiveBin,
            FeePips,
            BinStep,
            reserve_base,
            reserve_quote,
            reserve_base + reserve_quote,
            bin_share_supply_value(ActiveBin),
            ImpactCapBps,
            MinReserveBase,
            MinReserveQuote,
            MaxBinsPerSwap,
            BinLiquidityCap
        );
    }

    view fn pool_config() authorize(anyone) -> (
        AssetDefinitionId,
        AssetDefinitionId,
        AccountId,
        int,
        int,
        int
    ) {
        return (BaseAsset, QuoteAsset, VaultAccount, FeePips, BinStep, ActiveBin);
    }

    view fn configured_base_asset() authorize(anyone) -> AssetDefinitionId {
        return BaseAsset;
    }

    view fn configured_quote_asset() authorize(anyone) -> AssetDefinitionId {
        return QuoteAsset;
    }

    view fn configured_vault_account() authorize(anyone) -> AccountId {
        return VaultAccount;
    }

    view fn custody_account() authorize(anyone) -> AccountId {
        return VaultAccount;
    }

    view fn risk_config() authorize(anyone) -> (int, quantity, quantity, int, quantity) {
        return (ImpactCapBps, MinReserveBase, MinReserveQuote, MaxBinsPerSwap, BinLiquidityCap);
    }

    view fn mirror_bin(
        int bin_id,
    ) authorize(anyone) -> (quantity, quantity, quantity, decimal, decimal) {
        assert_valid_bin_id(bin_id);
        return (
            bin_reserve_base_value(bin_id),
            bin_reserve_quote_value(bin_id),
            bin_share_supply_value(bin_id),
            bin_fee_growth_base_value(bin_id),
            bin_fee_growth_quote_value(bin_id)
        );
    }

    view fn mirror_bin_index(int bin_id) authorize(anyone) -> (int, int, int, int) {
        assert_valid_bin_id(bin_id);
        let registered = BinIndexed.contains(bin_id) ? 1 : 0;
        return (
            registered,
            PreviousIndexedBin.get(bin_id).unwrap_or(bin_id),
            NextIndexedBin.get(bin_id).unwrap_or(bin_id),
            IndexedBinCount
        );
    }

    view fn mirror_position(
        Name position_id,
    ) authorize(anyone) -> (int, int, quantity, decimal, decimal, quantity, quantity) {
        let registered = PositionOwner.contains(position_id) ? 1 : 0;
        return (
            registered,
            PositionBinId.get(position_id).unwrap_or(ActiveBin),
            position_shares_value(position_id),
            position_fee_debt_base_value(position_id),
            position_fee_debt_quote_value(position_id),
            position_credit_base_value(position_id),
            position_credit_quote_value(position_id)
        );
    }

    view fn quote_position_fees(Name position_id) authorize(anyone) -> (quantity, quantity) {
        let bin_id = position_bin_value(position_id);
        let shares = position_shares_value(position_id);
        let growth_base = bin_fee_growth_base_value(bin_id);
        let growth_quote = bin_fee_growth_quote_value(bin_id);
        let debt_base = position_fee_debt_base_value(position_id);
        let debt_quote = position_fee_debt_quote_value(position_id);
        require(growth_base >= debt_base, DlmmPoolError::FeeGrowthRegression);
        require(growth_quote >= debt_quote, DlmmPoolError::FeeGrowthRegression);
        return (
            position_credit_base_value(position_id) + shares * (growth_base - debt_base),
            position_credit_quote_value(position_id) + shares * (growth_quote - debt_quote)
        );
    }

    view fn range_governor_state() authorize(anyone) -> (int, int, int, int, int, int, int, int) {
        return (
            RangeGovernorEnabled,
            RangeGovernorCadenceSlots,
            RangeGovernorNextSlot,
            RangeGovernorMaxFeePips,
            RangeGovernorTargetActiveBin,
            RangeGovernorMaxActiveBinDrift,
            RangeGovernorLastSlot,
            RangeGovernorLastAction
        );
    }

    view fn admin_state() authorize(anyone) -> (AccountId, int) {
        return (PoolOwner, AdminRenounced);
    }
}
