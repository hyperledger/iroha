
        seiyaku ResultPropagation {
            view fn main(Result<int, bool> value) authorize(anyone) -> Result<(int, int), bool> {
                let payload = match value {
                    Result::ok(payload) => payload,
                    Result::err(failure) => { return Result::err(failure); },
                };
                Result::ok((payload, payload))
            }
        }
    
