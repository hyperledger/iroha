seiyaku AssetOps {
    permission Admin;
    kotoage fn execute() authorize(Admin) {
        // Typed pointer‑ABI arguments via constructors
        let alice = context::authority();
        let bob = context::authority();
        let coin = AssetDefinitionId::parse("6pEP9RjNoZ7beWkT3pLfKoM1dyfi");
        ledger::asset::mint(account: alice, asset_definition: coin, amount: 1000);
        ledger::asset::transfer(
            source: alice,
            destination: bob,
            asset_definition: coin,
            amount: 500,
        );
        ledger::asset::burn(account: bob, asset_definition: coin, amount: 100);
    }
}
