// Constant-product asset swap using the strict branded V1 surface.
seiyaku KotodamaSwap {
    permission Admin;
    hajimari() {
        debug::info("initialized");
    }

    kotoage fn swap(
        AccountId trader,
        AccountId pool,
        AssetDefinitionId input_asset,
        AssetDefinitionId output_asset,
        quantity amount_in,
        quantity reserve_in,
        quantity reserve_out,
    ) authorize(Admin) -> quantity {
        let decimal fee_numerator = 997;
        let decimal fee_denominator = 1000;
        let effective = (amount_in * fee_numerator) / fee_denominator;
        let out = reserve_out * (effective / (reserve_in + effective));
        ledger::asset::transfer(
            source: trader,
            destination: pool,
            asset_definition: input_asset,
            amount: amount_in,
        );
        ledger::asset::transfer(
            source: pool,
            destination: trader,
            asset_definition: output_asset,
            amount: out,
        );
        return out;
    }
}
