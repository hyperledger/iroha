
seiyaku Counter { permission CanIncrement;
    const int initial = 1;
    const int step = 2;

    state int value;

    hajimari() {
        value = initial;
    }

    kotoage fn increment() authorize(CanIncrement) {
        value = value + step;
    }

    view fn current() authorize(anyone) -> int {
        return value;
    }
}
