
        seiyaku LifecycleReachability { permission Entry;
            state int Counter;

            fn initialize() {
                Counter = 0;
            }

            fn improve() {
                Counter = Counter + 1;
            }

            fn handle_trigger() {
                Counter = Counter + 1;
            }

            fn orphan() {
                Counter = 777;
            }

            hajimari() {
                initialize();
                initialize();
            }

            kaizen() {
                improve();
                improve();
            }

            kotoage fn run() authorize(Entry) {
                handle_trigger();
                handle_trigger();
            }

            trigger wake -> run {
                on time pre_commit;
            }

            view fn inspect() authorize(anyone) -> int {
                return Counter;
            }
        }
        