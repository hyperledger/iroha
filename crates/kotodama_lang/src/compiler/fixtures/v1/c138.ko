
seiyaku ExpressionHintMatch {
  state StateMap<int, int> Entries;

  fn identity(int value) -> int { value }

  view fn scan(Option<int> maybe) authorize(anyone) -> int {
    return identity(value: match maybe {
      Option::some(seed) => {
        var int total = seed;
        for (key, value) in Entries.page(after: Option::none, limit: 2).items {
          total = total + key + value;
        }
        total
      },
      Option::none => 0,
    });
  }
}
