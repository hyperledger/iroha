
            seiyaku Demo { permission Run;
                kotoage fn run(int count) authorize(Run) -> int { return count + 1; }

                #[test]
                fn drive_run() {
                    let next = test::invoke_kotoage(kotoage: Name::parse("run"), arguments: {count: 7});
                    test::assert_eq(actual: next, expected: 8);
                }
            }
            