
            seiyaku Demo { permission Run;
                kotoage fn run(int count) authorize(Run) -> int { return count + 1; }

                #[test]
                fn drive_run() {
                    let next = test::invoke_kotoage_as(
                        actor: "issuer",
                        kotoage: "run",
                        arguments: {count: 7},
                    );
                    let acct = test::actor_account("issuer");
                    let pk = test::actor_public_key("issuer");
                    let sig = test::actor_sign(actor: "issuer", payload: b"demo");
                    test::expect_any_reject_as(
                        actor: "issuer",
                        kotoage: "run",
                        arguments: {count: -1},
                    );
                    let _ = (next, acct, pk, sig);
                }
            }
            