
            seiyaku Demo { permission Run;
                kotoage fn run(int count) authorize(Run) -> (int, int) { return (count, count + 1); }

                #[test]
                fn drive_run() {
                    let _pair = test::invoke_kotoage_as(
                        actor: "issuer",
                        kotoage: "run",
                        arguments: {count: 7},
                    );
                }
            }
            