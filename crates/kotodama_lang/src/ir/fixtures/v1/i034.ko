
            seiyaku ForeachPhi { permission WriteState;
                state StateMap<int, int> Values;

                kotoage fn f() authorize(WriteState) -> int {
                    var seen = 0;
                    for (key, value) in Values.take(2) {
                        seen = seen + 1;
                        if (key == value) { continue; }
                        if (seen == 2) { break; }
                    }
                    return seen;
                }
            }
        