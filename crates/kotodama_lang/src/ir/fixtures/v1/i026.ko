
            seiyaku Demo { permission Entry;
                kotoage fn run(int count) authorize(Entry) -> int { return count + 1; }

                #[test]
                fn drive_run() {
                    let next = test::invoke_kotoage(kotoage: "run", arguments: {count: 7});
                    test::assert_eq(actual: next, expected: 8);
                }
            }
        