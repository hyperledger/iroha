seiyaku ListRuntime {
                view fn count(List<int, 4> values) authorize(anyone) -> int {
                    let length = values.len();
                    let _contains = values.contains(1);
                    let _first = values.get(0);
                    var List<int, 4> copy = [];
                    let _ = copy.try_push(1);
                    return length;
                }
                #[test]
                fn runtime_projection_exists() { test::assert(true); }
            }
