
        seiyaku C { permission WriteState;
            state StateMap<Name, int> Foo;

            fn read_value(Name key) -> int {
                return Foo.get_or_insert(key, 0);
            }

            kotoage fn main() authorize(WriteState) -> int {
                Foo[Name::parse("alice")] = 1;
                return read_value(key: Name::parse("alice"));
            }
        }
    
