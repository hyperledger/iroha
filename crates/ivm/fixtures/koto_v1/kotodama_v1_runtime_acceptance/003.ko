
seiyaku ResultIfLetRuntime {
  fn via_ok(Result<int, bool> value) -> int {
    if let Result::ok(item) = value { item } else { 9 }
  }

  fn via_err(Result<int, bool> value) -> int {
    if let Result::err(failure) = value {
      if failure { 7 } else { 6 }
    } else {
      8
    }
  }

  view fn run() authorize(anyone) -> int {
    via_ok(value: Result::ok(4)) * 1000
      + via_ok(value: Result::err(true)) * 100
      + via_err(value: Result::err(true)) * 10
      + via_err(value: Result::ok(5))
  }
}
