
seiyaku NativeJsonRuntimeAcceptance {
  view fn run() authorize(anyone) -> Json {
    let List<string, 4> labels = ["primary", "secondary"];
    var List<bytes, 2> blobs = [];
    let _ = blobs.try_push(b"\xaa");
    let _ = blobs.try_push(b"\xbb");
    let Option<quantity> maybe = Option::some(1.25);
    json {
      z_bytes: b"\xab\x01",
      maybe: maybe,
      labels: labels,
      blobs: blobs,
      amount: 1.25,
    }
  }
}
