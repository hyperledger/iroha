
        seiyaku StructState { permission WriteState;
            struct Ledger { int counter, bool flag }
            state Ledger ledger;

            hajimari() {
                ledger = Ledger { counter: 0, flag: false };
            }

            fn read_counter(Ledger entry) -> int {
                return entry.counter;
            }

            fn score(Ledger entry) -> int {
                var value = read_counter(entry: entry);
                if (entry.flag) {
                    value = value + 1;
                }
                return value;
            }

            kotoage fn main() authorize(WriteState) -> int {
                ledger = Ledger { counter: 7, flag: true };
                return score(entry: ledger);
            }
        }
    
