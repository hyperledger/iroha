
        seiyaku Context {
          view fn f() authorize(anyone) -> (int, bytes, bytes, bytes) {
            let height = context::block_height();
            let chain = context::chain_id();
            let contract_address = context::seiyaku_address();
            let name = context::kotoage();
            return (height, chain, contract_address, name);
          }
        }
    
