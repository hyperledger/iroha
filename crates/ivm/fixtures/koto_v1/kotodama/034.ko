
        seiyaku MixedStructTupleFields {
        struct A { int x }
        struct B { A a }
        struct D { (B, int) c }
        view fn f() authorize(anyone) -> int {
            let a = A { x: 7 };
            let b = B { a };
            let d = D { c: (b, 99) };
            return d.c.0.a.x;
        }
        }
    
