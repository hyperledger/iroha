
        seiyaku NestedStructFields {
        struct A { int x }
        struct B { A a }
        struct C { B b }
        struct D { C c }
        view fn f() authorize(anyone) -> int {
            let a = A { x: 5 };
            let b = B { a };
            let c = C { b };
            let d = D { c };
            return d.c.b.a.x;
        }
        }
    
