// Operations for Makoto Free Cash (MFC) token.
// Provides a simple transfer function and a looped
// transfer across a range of quantities.
seiyaku MakotoFreeCash {
    permission ManageMfc;
    fn send_mfc(AccountId from_account, AccountId to_account, quantity amount) {
        // Use constant asset id 1 representing the Makoto Free Cash token
        let mfc = mfc_asset();
        ledger::asset::transfer(
            source: from_account,
            destination: to_account,
            asset_definition: mfc,
            amount: amount,
        );
    }

    fn loop_mfc(AccountId from_account, AccountId to_account) {
        let mfc = mfc_asset();
        var quantity current_quantity = 369;
        for _offset in range(64) {
            ledger::asset::transfer(
                source: from_account,
                destination: to_account,
                asset_definition: mfc,
                amount: current_quantity,
            );
            current_quantity = current_quantity + 1;
        }
    }

    // Example kotoage/言挙げ declaration demonstrating asset creation and usage.
    // It first registers the Makoto Free Cash asset, mints some
    // quantity to the caller, then performs the transfers.
    kotoage fn main(AccountId from, AccountId to) authorize(ManageMfc) {
        // Register the asset definition before minting any tokens.
        let mfc = mfc_asset();
        ledger::asset::register(
            asset_definition: mfc,
            name: "MFC",
            spec: NumericSpec::integer(),
            mintable: Mintable::Infinitely,
        );
        ledger::asset::mint(account: from, asset_definition: mfc, amount: 1337);
        let dest = to;
        send_mfc(from_account: from, to_account: dest, amount: 369);
        loop_mfc(from_account: from, to_account: dest);
    }

    fn mfc_asset() -> AssetDefinitionId {
        let mfc = AssetDefinitionId::parse("62Fk4FPcMuLvW5QjDGNF2a4jAmjM");
        return mfc;
    }
}
