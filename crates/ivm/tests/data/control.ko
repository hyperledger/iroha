// Example illustrating control flow with a loop and branches.
// Loops from `a` up to `b` and
// uses different checked arithmetic depending on the condition.
seiyaku Example {
    permission Entry;
    kotoage fn control(int a, int b) authorize(Entry) {
        for offset in range(64) {
            let i = a + offset;
            if i > b {
                break;
            }
            if i == b {
                let matched = i + b;
            } else {
                let pending = i - a;
            }
        }
    }
}
