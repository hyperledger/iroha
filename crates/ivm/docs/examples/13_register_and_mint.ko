// Register a fixed-supply asset definition, then mint its supply.
seiyaku RegisterAndMint {
    permission AssetManager;
    kotoage fn register_and_mint() authorize(AssetManager) {
        let asset = AssetDefinitionId::parse("62Fk4FPcMuLvW5QjDGNF2a4jAmjM");
        // The display name, numeric spec and mintability are exactly what the
        // host registers: whole units only, and a single mint.
        ledger::asset::register(
            asset_definition: asset,
            name: "ROSE",
            spec: NumericSpec::integer(),
            mintable: Mintable::Once,
        );
        // Mint 250 ROSE to Alice; `Mintable::Once` rejects any later mint.
        let to = AccountId::parse("sorauﾛ1PﾉｳﾇmEｴWｵebHﾑ6ﾔﾙｲヰiwuCWErJ7uｽoPGｱﾔnjﾑKﾋTCW2PV");
        ledger::asset::mint(account: to, asset_definition: asset, amount: 250);
    }
}
