module ContractFlowTests {
    koto_test { target: "19_contract_flow_test.ko" }

    fixture actors {
        actor(
            "issuer",
            AccountId::parse("sorauﾛ1QEnRヰ7Dﾑzmg1ﾊｻ4ﾈAcckｻsafiｳヱufｴｻｻPﾆｴﾖﾁﾉDR1Y5PX"),
            "0x0909090909090909090909090909090909090909090909090909090909090909",
        );
        grant_seiyaku_permission("issuer", "Entry");
        grant_seiyaku_lifecycle_permission("issuer", "hajimari");
    }

    #[test(fixture = "actors")]
    fn actor_helpers_roundtrip() {
        let acct = test::actor_account("issuer");
        test::assert(
            acct == AccountId::parse("sorauﾛ1QEnRヰ7Dﾑzmg1ﾊｻ4ﾈAcckｻsafiｳヱufｴｻｻPﾆｴﾖﾁﾉDR1Y5PX"),
        );
        test::actor_public_key("issuer");
        test::actor_sign(actor: "issuer", payload: b"native-flow");
    }

    #[test(fixture = "actors")]
    fn invoke_kotoage_as_runs_the_seiyaku() {
        test::invoke_kotoage_as(actor: "issuer", kotoage: "hajimari", arguments: {});
        test::invoke_kotoage_as(actor: "issuer", kotoage: "increment", arguments: {});
        test::assert(counter == 5);
        test::invoke_kotoage_as(actor: "issuer", kotoage: "remember_caller", arguments: {});
        test::assert(
            last_actor == AccountId::parse("sorauﾛ1QEnRヰ7Dﾑzmg1ﾊｻ4ﾈAcckｻsafiｳヱufｴｻｻPﾆｴﾖﾁﾉDR1Y5PX"),
        );
    }

    #[test(fixture = "actors")]
    fn expect_reject_as_captures_seiyaku_rejection() {
        test::invoke_kotoage_as(actor: "issuer", kotoage: "hajimari", arguments: {});
        test::expect_reject_as(
            actor: "issuer",
            kotoage: "reject_me",
            arguments: {},
            expected: ExampleError::Rejected,
        );
    }
}
