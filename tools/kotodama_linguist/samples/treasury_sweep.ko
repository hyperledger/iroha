// Representative trigger sample for Kotodama grammar validation.
seiyaku TreasurySweep {
    permission Admin;
    error enum SweepError {
        EmptyTreasury = 1,
    }

    state int LastSweepHeight;
    hajimari() {
        LastSweepHeight = 0;
    }

    trigger settle_block -> sweep {
        on pipeline block;
        repeats 1;
        authority "sorauﾛ1PﾉｳﾇmEｴWｵebHﾑ6ﾔﾙｲヰiwuCWErJ7uｽoPGｱﾔnjﾑKﾋTCW2PV";
        metadata {
            tag: "treasury";
            enabled: true;
        }
    }

    kotoage fn sweep() authorize(Admin) {
        let balance = 1_000_000;
        require(balance > 0, SweepError::EmptyTreasury);
        LastSweepHeight = LastSweepHeight + 1;
        debug::info("treasury_swept");
    }
}
